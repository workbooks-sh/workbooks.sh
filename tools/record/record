#!/usr/bin/env sh
# tools/record/record — the Linux capture rig CLI.
#
# Records an X/Wayland app headlessly inside the Workbooks Linux substrate
# (krunvm container locally, Linux in the cloud). The Mac host only triggers
# this; capture happens here, on Linux, the same substrate as the Nexus path.
#
# Canon: NO native exec in the *guest*. This rig is a HOST-side service — it
# runs in the trusted Linux host/container that owns the display + encoder,
# never compiled into a wasm tenant. The seam to the guest is intent-only
# (see RECORDING-SYSTEM-FINDINGS.md §4): a future Workbooks.Browse provider
# brokers screenshot/click/type to this rig; the guest never drives a display.
#
# Verbs:
#   record  deps           dependency check (alias: tools/record/lib/deps.sh)
#   record  display-up      start an Xvfb virtual display (idempotent)
#   record  display-down    stop the Xvfb virtual display
#   record  run -- CMD...   launch an app on the virtual display (backgrounded)
#   record  start [out.mp4] begin screen capture (x11grab/kmsgrab/wayland)
#   record  stop            end capture, finalize MP4
#   record  shot [out.png]  grab a single still from the virtual display
#   record  gif IN OUT      MP4 -> GIF (gifski, else ffmpeg palette)
#   record  record-flow F   run a flow file: display+app+capture+steps+stop
#   record  pipeline RECIPE  THE full proof-loop: seed->capture->drive->verify->retry
#   record  selftest        synthetic capture if a display can be made, else dry-run
#
# POSIX sh. No bashisms. Env knobs documented in lib/common.sh + README.md.

set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$HERE/lib/common.sh"

# ---------------------------------------------------------------- display mgmt
display_up() {
  if ! is_linux; then
    err "display-up only works on Linux (the capture substrate). Host is $(uname -s)."
    err "Trigger this inside the krunvm container or cloud Linux. Doing nothing."
    return 2
  fi
  have Xvfb || die "Xvfb missing — run: $HERE/lib/deps.sh install"
  d="$WB_REC_DISPLAY"
  if xdpyinfo -display "$d" >/dev/null 2>&1; then
    log "display $d already up"
    return 0
  fi
  Xvfb "$d" -screen 0 "${WB_REC_W}x${WB_REC_H}x${WB_REC_DEPTH}" -nolisten tcp >/dev/null 2>&1 &
  xvfb_pid=$!
  # wait until it answers (max ~5s)
  i=0
  while [ $i -lt 50 ]; do
    if DISPLAY="$d" xdpyinfo >/dev/null 2>&1; then break; fi
    i=$((i+1)); sleep 0.1 2>/dev/null || sleep 1
  done
  DISPLAY="$d" xdpyinfo >/dev/null 2>&1 || die "Xvfb failed to come up on $d"
  printf '{ "xvfb_pid": %s, "display": "%s", "w": %s, "h": %s }\n' \
    "$xvfb_pid" "$d" "$WB_REC_W" "$WB_REC_H" > "${WB_REC_STATE}.display"
  log "Xvfb up on $d (${WB_REC_W}x${WB_REC_H}x${WB_REC_DEPTH}) pid=$xvfb_pid"
}

display_down() {
  f="${WB_REC_STATE}.display"
  [ -f "$f" ] || { log "no display state; nothing to stop"; return 0; }
  pid=$(state_file_get "$f" xvfb_pid)
  [ -n "${pid:-}" ] && kill "$pid" 2>/dev/null || true
  rm -f "$f"
  log "Xvfb stopped (pid=${pid:-?})"
}

# state read against an arbitrary file — shared helper lives in common.sh
# (state_file_get_any FILE KEY). Thin alias kept for the existing call sites.
state_file_get() { state_file_get_any "$1" "$2"; }

# ---------------------------------------------------------------- run an app
run_app() {
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || die "run: nothing to launch (record run -- CMD...)"
  d="$WB_REC_DISPLAY"
  DISPLAY="$d" "$@" >/dev/null 2>&1 &
  app_pid=$!
  printf '{ "app_pid": %s, "cmd": "%s" }\n' "$app_pid" "$*" > "${WB_REC_STATE}.app"
  log "launched on $d pid=$app_pid: $*"
}

# ---------------------------------------------------------------- capture
start_capture() {
  out="${1:-$WB_REC_OUT/capture-$(date -u +%Y%m%d-%H%M%S).mp4}"
  ensure_out
  have ffmpeg || die "ffmpeg missing — run: $HERE/lib/deps.sh install"
  srv=$(display_server)
  draw=0; [ "$WB_REC_CURSOR" = "1" ] && draw=1

  case "$srv" in
    wayland)
      have wf-recorder || die "wayland detected but wf-recorder missing"
      wf-recorder -f "$out" >/dev/null 2>&1 &
      cap_pid=$!
      mode=wayland
      ;;
    x11)
      d="$WB_REC_DISPLAY"; [ -n "${DISPLAY:-}" ] && d="$DISPLAY"
      # Prefer GPU kmsgrab when present + permitted, else x11grab.
      if ffmpeg -hide_banner -f kmsgrab -i - -t 0 -f null - >/dev/null 2>&1; then
        ffmpeg -y -f kmsgrab -framerate "$WB_REC_FPS" -i - \
          -vf 'hwmap=derive_device=vaapi,scale_vaapi=format=nv12' \
          -c:v h264_vaapi "$out" >/dev/null 2>&1 &
        cap_pid=$!; mode="x11/kmsgrab(gpu)"
      else
        ffmpeg -y -video_size "${WB_REC_W}x${WB_REC_H}" -framerate "$WB_REC_FPS" \
          -f x11grab -draw_mouse "$draw" -i "${d}.0+0,0" \
          -c:v libx264 -preset veryfast -crf "$WB_REC_CRF" -pix_fmt yuv420p \
          -movflags +faststart "$out" >/dev/null 2>&1 &
        cap_pid=$!; mode="x11grab"
      fi
      ;;
    *)
      die "no capturable display server (need Xvfb/X11 or Wayland+wf-recorder). Run: record display-up"
      ;;
  esac

  printf '{ "cap_pid": %s, "out": "%s", "mode": "%s", "display": "%s" }\n' \
    "$cap_pid" "$out" "$mode" "${DISPLAY:-$WB_REC_DISPLAY}" > "$WB_REC_STATE"
  log "capture started ($mode) -> $out  pid=$cap_pid"
}

stop_capture() {
  [ -f "$WB_REC_STATE" ] || { log "no active capture"; return 0; }
  pid=$(state_get cap_pid); out=$(state_get out)
  if [ -n "${pid:-}" ]; then
    # ffmpeg finalizes the moov atom on SIGINT; give it a moment.
    kill -INT "$pid" 2>/dev/null || true
    i=0; while kill -0 "$pid" 2>/dev/null && [ $i -lt 50 ]; do i=$((i+1)); sleep 0.1 2>/dev/null || sleep 1; done
    kill -0 "$pid" 2>/dev/null && kill "$pid" 2>/dev/null || true
  fi
  rm -f "$WB_REC_STATE"
  if [ -n "${out:-}" ] && [ -f "$out" ]; then
    log "capture stopped -> $out ($(du -h "$out" 2>/dev/null | cut -f1))"
  else
    log "capture stopped (output: ${out:-unknown})"
  fi
}

# ---------------------------------------------------------------- still
shot() {
  out="${1:-$WB_REC_OUT/shot-$(date -u +%Y%m%d-%H%M%S).png}"
  ensure_out
  d="$WB_REC_DISPLAY"; [ -n "${DISPLAY:-}" ] && d="$DISPLAY"
  if have ffmpeg; then
    ffmpeg -y -f x11grab -video_size "${WB_REC_W}x${WB_REC_H}" -i "${d}.0+0,0" \
      -frames:v 1 "$out" >/dev/null 2>&1 || die "still capture failed"
  elif have import; then
    DISPLAY="$d" import -window root "$out" || die "import failed"
  else
    die "need ffmpeg or imagemagick for stills"
  fi
  log "still -> $out"
}

# ---------------------------------------------------------------- gif
make_gif() {
  in="${1:?gif IN.mp4 OUT.gif}"; out="${2:?gif IN.mp4 OUT.gif}"
  enc=$(gif_encoder)
  case "$enc" in
    gifski)
      tmpd=$(mktemp -d)
      ffmpeg -y -i "$in" -vf "fps=15,scale=720:-1:flags=lanczos" "$tmpd/f%05d.png" >/dev/null 2>&1
      gifski -o "$out" --fps 15 "$tmpd"/f*.png >/dev/null 2>&1 || die "gifski failed"
      rm -rf "$tmpd"
      ;;
    ffmpeg)
      pal=$(mktemp).png
      ffmpeg -y -i "$in" -vf "fps=15,scale=720:-1:flags=lanczos,palettegen" "$pal" >/dev/null 2>&1
      ffmpeg -y -i "$in" -i "$pal" -lavfi "fps=15,scale=720:-1:flags=lanczos[x];[x][1:v]paletteuse" "$out" >/dev/null 2>&1 || die "ffmpeg gif failed"
      rm -f "$pal"
      ;;
    *) die "no gif encoder (gifski or ffmpeg)";;
  esac
  log "gif ($enc) -> $out"
}

# ---------------------------------------------------------------- record-flow
# A flow file is a line-oriented script. Lines:
#   app   -- CMD...        launch the app on the display
#   wait  <seconds>        sleep
#   step  <shell...>       run a driver step (xdotool, MCP client, curl, etc.)
#   shot  <out.png>        capture a still mid-flow
#   note  <text>           log a marker
# The runner brings the display up, starts capture, runs steps, stops, makes a gif.
record_flow() {
  flow="${1:?record-flow FLOWFILE}"
  [ -f "$flow" ] || die "flow file not found: $flow"
  out="${2:-$WB_REC_OUT/flow-$(date -u +%Y%m%d-%H%M%S).mp4}"
  ensure_out
  display_up || die "could not bring display up"
  start_capture "$out"
  # small lead-in so the app paints before we start issuing steps
  sleep 1 2>/dev/null || sleep 1
  while IFS= read -r line; do
    case "$line" in
      ''|\#*) continue;;
      app*)  set -- $line; shift; run_app "$@"; sleep 2;;
      wait*) set -- $line; sleep "${2:-1}";;
      shot*) set -- $line; shot "${2:-}";;
      note*) log "FLOW: ${line#note }";;
      step*) sh -c "DISPLAY=$WB_REC_DISPLAY ${line#step }" || err "step failed: ${line#step }";;
      *) err "unknown flow line: $line";;
    esac
  done < "$flow"
  stop_capture
  make_gif "$out" "${out%.mp4}.gif" || log "gif step skipped"
  log "flow complete -> $out"
}

# ---------------------------------------------------------------- selftest
selftest() {
  log "=== capture-rig selftest ==="
  "$HERE/lib/deps.sh" check || log "(deps incomplete — continuing with dry-run where blocked)"
  if ! is_linux; then
    log "host is $(uname -s), not Linux: DRY-RUN only (capture is Linux-only by design)."
    log "verified: scripts parse, deps probed. Real capture must run in krunvm/cloud Linux."
    return 0
  fi
  if ! have Xvfb || ! have ffmpeg; then
    log "missing Xvfb/ffmpeg: DRY-RUN. Install with lib/deps.sh install, then re-run selftest."
    return 0
  fi
  # Real tiny synthetic capture: Xvfb + xterm/xeyes (whichever exists) -> 2s mp4 -> still -> gif.
  ensure_out
  display_up
  if have xterm; then run_app -- xterm -geometry 80x24 -e "sh -c 'echo Workbooks capture rig; sleep 4'"
  elif have xeyes; then run_app -- xeyes
  else log "no test app (xterm/xeyes) — capturing blank root instead"; fi
  out="$WB_REC_OUT/selftest.mp4"
  start_capture "$out"
  sleep 2 2>/dev/null || sleep 2
  shot "$WB_REC_OUT/selftest.png" || true
  stop_capture
  [ -f "$out" ] && make_gif "$out" "$WB_REC_OUT/selftest.gif" || true
  display_down
  log "selftest artifacts in $WB_REC_OUT:"; ls -la "$WB_REC_OUT" >&2 || true
}

usage() {
  sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
}

# ---------------------------------------------------------------- dispatch
cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  deps)         "$HERE/lib/deps.sh" "${1:-check}";;
  display-up)   display_up;;
  display-down) display_down;;
  run)          run_app "$@";;
  start)        start_capture "${1:-}";;
  stop)         stop_capture;;
  shot)         shot "${1:-}";;
  gif)          make_gif "${1:-}" "${2:-}";;
  cursor)       "$HERE/lib/cursor.sh" "$@";;
  term)         "$HERE/lib/term.sh" "$@";;
  record-flow)  record_flow "${1:-}" "${2:-}";;
  pipeline)     exec "$HERE/pipeline" "$@";;
  selftest)     selftest;;
  help|-h|--help) usage;;
  *) err "unknown verb: $cmd"; usage; exit 1;;
esac
