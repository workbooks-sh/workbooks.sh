# The interface

The interface is a `client` block — the browser island. It opens an `EventSource` on the
`swarm` live source and turns the stream into a **task list**: one card per agent, each
showing what it's doing and how many sources it has read. Click a task to see its sources
and finding in the detail panel; when the run finishes everything collapses to a summary
and the report renders as a clean document.

client :app do
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/rough-notation/lib/rough-notation.iife.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

  <style>
    :root{ --paper:#ffffff; --bg:#f7f6f3; --ink:#37352f; --soft:#787066; --line:#ece9e3;
      --accent:#ffd643; --mint:#cdeede; --sky:#d6e9fb; --peach:#fbe0cd; --lilac:#e9dcfb; --radius:14px; }
    *{box-sizing:border-box}
    body{max-width:none!important;margin:0!important;padding:0!important;background:var(--bg)!important;
      color:var(--ink)!important;font:16px/1.6 'Inter',system-ui,sans-serif!important}
    /* The running app IS the client island. The literate prose/headings/nav are source-level
       documentation (read the .work files for those) — hidden in the live app view. */
    nav.wb-nav, section.file > h1, section.file > h2, section.file > h3,
    section.file > h4, section.file > p, section.file > ul, section.file > pre,
    section.file > .decl, section.file > figure{display:none!important}
    section.file{display:block;margin:0;padding:0;max-width:none;border:0}
    #ss{max-width:980px;margin:0 auto;padding:38px 22px 120px}
    #ss .top{text-align:center;margin:18px 0 30px}
    #ss .mark{font-size:34px;font-weight:700;letter-spacing:-.02em;display:inline-flex;gap:10px;align-items:center}
    #ss .tag{color:var(--soft);margin-top:10px;font-size:16px}
    .composer{background:var(--paper);border:1px solid var(--line);border-radius:18px;
      box-shadow:0 8px 30px rgba(55,53,47,.06);padding:14px 16px;margin:22px auto 14px;max-width:720px}
    .composer textarea{width:100%;border:0;outline:0;resize:none;font:17px/1.5 'Inter',sans-serif;
      color:var(--ink);background:transparent;min-height:30px}
    .composer textarea::placeholder{color:#b6afa4}
    .crow{display:flex;align-items:center;justify-content:space-between;margin-top:10px}
    .depth{display:inline-flex;gap:4px;background:var(--bg);border-radius:11px;padding:4px}
    .dep{border:0;background:transparent;font:500 14px 'Inter';color:var(--soft);padding:6px 13px;
      border-radius:8px;cursor:pointer;transition:.15s}
    .dep.active{background:var(--paper);color:var(--ink);box-shadow:0 1px 4px rgba(55,53,47,.1)}
    .go{border:0;background:var(--ink);color:#fff;font:600 15px 'Inter';padding:10px 20px;
      border-radius:11px;cursor:pointer;display:inline-flex;gap:7px;align-items:center;transition:.15s}
    .go:hover{transform:translateY(-1px)}
    .chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:6px auto 4px;max-width:720px}
    .chip{background:var(--paper);border:1px solid var(--line);border-radius:20px;padding:7px 14px;
      font-size:14px;color:var(--soft);cursor:pointer;transition:.15s}
    .chip:hover{color:var(--ink);border-color:#d8d3ca}
    .recent{max-width:720px;margin:20px auto 0}
    .recent h4{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:#b6afa4;margin:0 0 8px}
    .rrow{display:flex;gap:10px;align-items:center;padding:9px 12px;border-radius:10px;cursor:pointer;
      color:var(--ink);transition:.12s}
    .rrow:hover{background:var(--paper)}
    .rrow .q{flex:1;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .rrow .m{font-size:12px;color:var(--soft)}

    #run{display:none;margin-top:8px}
    #run.on{display:block}
    .qtitle{font-size:26px;font-weight:700;letter-spacing:-.02em;margin:8px 0 4px}
    .meta{display:flex;gap:14px;align-items:center;color:var(--soft);font-size:14px;margin-bottom:18px;flex-wrap:wrap}
    .meta .dot{width:7px;height:7px;border-radius:50%;background:var(--accent);animation:pulse 1.1s infinite}
    @keyframes pulse{0%,100%{opacity:.35;transform:scale(.85)}50%{opacity:1;transform:scale(1.15)}}
    .pill{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:4px 11px;font-size:13px;font-weight:500}

    .summary{display:none;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);
      padding:14px 18px;margin-bottom:20px;align-items:center;gap:20px;cursor:pointer}
    .summary.on{display:flex}
    .summary .s{display:flex;flex-direction:column}
    .summary .s b{font-size:20px;font-weight:700}
    .summary .s span{font-size:12px;color:var(--soft);text-transform:uppercase;letter-spacing:.06em}
    .summary .grow{flex:1}
    .summary .chev{color:var(--soft);font-size:13px}

    .stage{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:#b6afa4;margin:18px 0 10px}
    .tasks{display:flex;flex-direction:column;gap:9px;margin-bottom:14px}
    .task{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:13px 15px;
      display:flex;gap:13px;align-items:center;cursor:pointer;transition:.15s;animation:pop .3s ease}
    @keyframes pop{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
    .task:hover{border-color:#d8d3ca;box-shadow:0 4px 16px rgba(55,53,47,.05)}
    .task.sel{border-color:var(--ink)}
    .ava{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;font-size:19px;flex:none}
    .task .b{flex:1;min-width:0}
    .task .t{font-weight:600;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .task .s{font-size:13px;color:var(--soft);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px}
    .badge{display:inline-flex;gap:5px;align-items:center;background:var(--bg);border-radius:18px;
      padding:5px 11px;font-size:13px;font-weight:600;color:var(--ink);flex:none}
    .stp{font-size:12px;font-weight:600;padding:4px 10px;border-radius:16px;flex:none}
    .stp.searching{background:var(--sky)} .stp.reading{background:var(--peach)}
    .stp.thinking{background:var(--lilac)} .stp.done{background:var(--mint)}

    .digest{background:#fffaf0;border:1px solid #f3e6c8;border-radius:var(--radius);padding:11px 15px;
      font-size:14px;color:#7a6a3f;margin-bottom:12px;display:flex;gap:9px;align-items:flex-start}

    .report{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:34px 40px;margin-top:8px}
    .report h1{font-size:28px;font-weight:700;letter-spacing:-.02em;margin:0 0 14px}
    .report h2{font-size:20px;font-weight:600;margin:26px 0 10px}
    .report p{margin:0 0 13px} .report ul{margin:0 0 13px;padding-left:20px}
    .report li{margin:4px 0} .report a{color:#2f6fed;text-decoration:none} .report a:hover{text-decoration:underline}
    .report strong{font-weight:600}

    #detail{position:fixed;top:0;right:0;width:430px;max-width:92vw;height:100vh;background:var(--paper);
      border-left:1px solid var(--line);box-shadow:-12px 0 40px rgba(55,53,47,.1);padding:26px 24px;
      overflow-y:auto;transform:translateX(110%);transition:.28s cubic-bezier(.2,.8,.2,1);z-index:50}
    #detail.on{transform:none}
    #detail .x{position:absolute;top:18px;right:18px;border:0;background:var(--bg);width:30px;height:30px;
      border-radius:9px;cursor:pointer;font-size:15px;color:var(--soft)}
    #detail h3{font-size:18px;margin:0 32px 4px 0;display:flex;gap:9px;align-items:flex-start}
    #detail .dsub{color:var(--soft);font-size:13px;margin-bottom:16px}
    #detail .src{display:flex;gap:10px;align-items:flex-start;padding:10px;border-radius:10px;margin-bottom:7px;
      background:var(--bg)}
    #detail .src img{width:18px;height:18px;border-radius:4px;flex:none;margin-top:2px}
    #detail .src .sd{flex:1;min-width:0}
    #detail .src .sd b{font-size:13px;font-weight:600;display:block}
    #detail .src .sd p{font-size:12px;color:var(--soft);margin:3px 0 0;line-height:1.4}
    #detail .read{font-size:11px;color:#3a9d63;font-weight:600} #detail .pend{font-size:11px;color:#b6afa4}
    #detail .finding{background:var(--mint);border-radius:11px;padding:13px 15px;font-size:14px;margin-top:8px}
    .float{position:fixed;font-size:24px;opacity:.5;pointer-events:none;animation:drift 9s ease-in-out infinite}
    @keyframes drift{0%,100%{transform:translateY(0) rotate(-6deg)}50%{transform:translateY(-16px) rotate(6deg)}}
  </style>

  <div class="float" style="top:14%;left:6%">🔍</div>
  <div class="float" style="top:22%;right:8%;animation-delay:-3s">📄</div>
  <div class="float" style="bottom:18%;left:9%;animation-delay:-5s">✨</div>

  <div id="ss">
    <div class="top">
      <div class="mark">🐝 <span id="wordmark">Search Swarm</span></div>
      <div class="tag">Ask anything — a swarm of agents researches the live web for you.</div>
    </div>

    <div class="composer">
      <textarea id="q" rows="1" placeholder="What do you want to understand?"></textarea>
      <div class="crow">
        <div class="depth">
          <button class="dep" data-depth="quick" type="button">🍃 Quick</button>
          <button class="dep active" data-depth="standard" type="button">⚖️ Standard</button>
          <button class="dep" data-depth="deep" type="button">🔬 Deep</button>
        </div>
        <button class="go" id="go" type="button">Search <span>→</span></button>
      </div>
    </div>

    <div class="chips" id="chips">
      <span class="chip">How does the BEAM scheduler work?</span>
      <span class="chip">Best practices for WASM component model</span>
      <span class="chip">State of small open-weight LLMs in 2026</span>
    </div>

    <div class="recent" id="recent"></div>

    <div id="run">
      <div class="qtitle" id="qt"></div>
      <div class="meta" id="meta"><span class="dot"></span><span id="ptxt">Planning…</span></div>
      <div class="summary" id="summary"></div>
      <div id="digests"></div>
      <div class="stage" id="stage" style="display:none">Agents</div>
      <div class="tasks" id="tasks"></div>
      <div class="report" id="report" style="display:none"></div>
    </div>
  </div>

  <aside id="detail">
    <button class="x" id="dx" type="button">✕</button>
    <div id="dbody"></div>
  </aside>

  <script>
  (function(){
    var AVA=['🐝','🔍','📚','🧭','🔬','📰','🗂️','🛰️','🧪','🪐','📡','🧠'];
    var fav=function(u){try{return 'https://www.google.com/s2/favicons?sz=64&domain='+new URL(u).hostname}catch(e){return ''}};
    var dom=function(u){try{return new URL(u).hostname.replace('www.','')}catch(e){return u}};
    var $=function(s){return document.querySelector(s)};
    var ss=$('#ss'),run=$('#run'),tasks=$('#tasks'),report=$('#report'),detail=$('#detail');
    var es=null, curDepth='standard', tk={}, order=[], t0=0, openId=null;

    // depth segmented control
    [].forEach.call(document.querySelectorAll('.dep'),function(d){d.addEventListener('click',function(){
      [].forEach.call(document.querySelectorAll('.dep'),function(x){x.classList.remove('active')});
      d.classList.add('active');curDepth=d.dataset.depth;});});

    // scribble underline on the wordmark
    if(window.RoughNotation){var a=RoughNotation.annotate($('#wordmark'),{type:'underline',color:'#ffd643',strokeWidth:3,padding:2});setTimeout(function(){a.show()},500);}

    $('#q').addEventListener('input',function(){this.style.height='auto';this.style.height=this.scrollHeight+'px';});
    $('#q').addEventListener('keydown',function(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();start();}});
    $('#go').addEventListener('click',start);
    [].forEach.call(document.querySelectorAll('#chips .chip'),function(c){c.addEventListener('click',function(){$('#q').value=c.textContent;start();});});
    $('#dx').addEventListener('click',function(){detail.classList.remove('on');if(openId&&tk[openId])tk[openId].el.classList.remove('sel');openId=null;});

    loadRecent();
    function loadRecent(){
      if(!window.nexus||!nexus.data)return;
      nexus.data.all('Session').then(function(rows){
        rows=(rows||[]).slice(-6).reverse();
        if(!rows.length)return;
        var h='<h4>Recent</h4>';
        rows.forEach(function(r){h+='<div class="rrow" data-q="'+enc(r.prompt)+'"><span>🕘</span><span class="q">'+esc(r.prompt)+'</span><span class="m">'+(r.agents||0)+' agents</span></div>';});
        $('#recent').innerHTML=h;
        [].forEach.call(document.querySelectorAll('.rrow'),function(x){x.addEventListener('click',function(){$('#q').value=x.dataset.q;start();});});
      }).catch(function(){});
    }

    function start(){
      var query=$('#q').value.trim(); if(!query)return;
      if(es)es.close(); tk={};order=[];openId=null;t0=Date.now();
      $('#chips').style.display='none';$('#recent').style.display='none';
      $('#qt').textContent=query; run.classList.add('on'); run.scrollIntoView({behavior:'smooth',block:'start'});
      tasks.innerHTML='';report.style.display='none';report.innerHTML='';
      $('#digests').innerHTML='';$('#summary').className='summary';$('#summary').innerHTML='';
      $('#stage').style.display='none';$('#meta').style.display='flex';$('#ptxt').textContent='Planning…';
      es=new EventSource('/live/swarm?q='+encodeURIComponent(query)+'&depth='+curDepth);
      es.onmessage=function(e){var d;try{d=JSON.parse(e.data)}catch(_){return} on(d);};
      es.onerror=function(){};
    }

    function card(id){
      if(tk[id])return tk[id];
      $('#stage').style.display='block';
      var el=document.createElement('div');el.className='task';
      el.innerHTML='<div class="ava"></div><div class="b"><div class="t"></div><div class="s"></div></div>'+
        '<span class="badge" style="display:none">📄 <i>0</i></span><span class="stp searching">searching</span>';
      var i=order.length; el.querySelector('.ava').textContent=AVA[i%AVA.length];
      var tints=['var(--mint)','var(--sky)','var(--peach)','var(--lilac)']; el.querySelector('.ava').style.background=tints[i%4];
      tasks.appendChild(el);
      var o={el:el,sources:[],pages:{},finding:'',srcN:0,read:0,query:''};
      el.addEventListener('click',function(){openDetail(id);});
      tk[id]=o;order.push(id);return o;
    }

    function on(d){
      if(d.type==='fleet'){$('#ptxt').textContent='Dispatching the swarm…';}
      else if(d.type==='round'){}
      else if(d.type==='spawn'){var c=card(d.id);c.query=d.query;c.el.querySelector('.t').textContent=d.query;}
      else if(d.type==='state'){var c=card(d.id);var st=c.el.querySelector('.stp');st.className='stp '+d.status;
        st.textContent=d.status; c.el.querySelector('.s').textContent=labelFor(d);}
      else if(d.type==='source'){var c=card(d.id);c.sources.push(d.url);c.srcN++;updBadge(c);}
      else if(d.type==='page'){var c=card(d.id);c.pages[d.url]=d.preview||'';c.read++;updBadge(c);if(openId===d.id)renderDetail(d.id);}
      else if(d.type==='done'){var c=card(d.id);c.finding=d.finding||'';var st=c.el.querySelector('.stp');st.className='stp done';st.textContent='done';
        c.el.querySelector('.s').textContent=c.read+' pages read · '+c.srcN+' sources';if(openId===d.id)renderDetail(d.id);}
      else if(d.type==='digest'){var n=document.createElement('div');n.className='digest';
        var note=(d.note||'').slice(0,200);
        n.innerHTML='<span>'+(d.continue?'🔁':'✅')+'</span><span>'+esc(note)+'</span>';$('#digests').appendChild(n);}
      else if(d.type==='synth'){$('#ptxt').textContent='Compiling the final report…';}
      else if(d.type==='report'){renderReport(d.content);}
      else if(d.type==='fleet_done'){finish();}
      else if(d.type==='end'){finish();if(es)es.close();loadRecent();}
    }

    function labelFor(d){
      if(d.status==='searching')return '🔍 searching the web';
      if(d.status==='reading')return '📄 reading '+(d.action||'');
      if(d.status==='thinking')return '🧠 '+(d.action||'writing finding');
      return d.action||'';
    }
    function updBadge(c){var b=c.el.querySelector('.badge');b.style.display='inline-flex';b.querySelector('i').textContent=c.read+'/'+c.srcN;}

    function openDetail(id){
      if(openId&&tk[openId])tk[openId].el.classList.remove('sel');
      openId=id;tk[id].el.classList.add('sel');renderDetail(id);detail.classList.add('on');
    }
    function renderDetail(id){
      var c=tk[id];var h='<h3><span>'+c.el.querySelector('.ava').textContent+'</span><span>'+esc(c.query)+'</span></h3>';
      h+='<div class="dsub">'+c.read+' of '+c.srcN+' sources read</div>';
      c.sources.forEach(function(u){var read=c.pages.hasOwnProperty(u);
        h+='<div class="src"><img src="'+fav(u)+'" onerror="this.style.visibility=\'hidden\'"><div class="sd">'+
          '<b>'+esc(dom(u))+'</b>'+(read?'<p>'+esc(c.pages[u]||'')+'</p>':'')+
          '</div><span class="'+(read?'read':'pend')+'">'+(read?'✓ read':'·')+'</span></div>';});
      if(c.finding)h+='<div class="finding">🧩 '+esc(c.finding)+'</div>';
      $('#dbody').innerHTML=h;
    }

    function renderReport(md){
      report.style.display='block';
      report.innerHTML=window.marked?marked.parse(md||''):('<pre>'+esc(md||'')+'</pre>');
    }

    function finish(){
      $('#meta').style.display='none';
      var agents=order.length,src=0,pages=0;
      order.forEach(function(id){src+=tk[id].srcN;pages+=tk[id].read;});
      var secs=Math.max(1,Math.round((Date.now()-t0)/1000));
      var cost=(agents*0.0008+pages*0.0003); // est, gemma + browser pulls
      var s=$('#summary');s.className='summary on';
      s.innerHTML='<div class="s"><b>'+agents+'</b><span>agents</span></div>'+
        '<div class="s"><b>'+src+'</b><span>sources</span></div>'+
        '<div class="s"><b>'+pages+'</b><span>pages read</span></div>'+
        '<div class="s"><b>'+secs+'s</b><span>elapsed</span></div>'+
        '<div class="s"><b>~$'+cost.toFixed(3)+'</b><span>est. cost</span></div>'+
        '<div class="grow"></div><div class="chev" id="chev">▾ tasks</div>';
      var collapsed=false;
      s.addEventListener('click',function(){collapsed=!collapsed;
        $('#tasks').style.display=collapsed?'none':'flex';$('#stage').style.display=collapsed?'none':'block';
        $('#chev').textContent=(collapsed?'▸':'▾')+' tasks';});
    }

    function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]});}
    function enc(s){return esc(s).replace(/'/g,'&#39;');}
  })();
  </script>
end
