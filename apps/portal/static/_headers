# Cache policy for brandnana portal — fixes the stale-bundle 404 trap.
#
# HTML must NEVER be cached (else browsers ship requests for JS bundles
# whose hashes no longer exist on the latest deploy).
# Hashed assets under /_app/immutable/* are content-addressed → cache forever.

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
