# Elixir / Erlang
**/_build/
**/deps/
**/*.beam
**/erl_crash.dump
**/tmp/

# Rust
**/target/

# JS build
**/node_modules/
**/dist/
**/.svelte-kit/
**/.wrangler/

# Wasm build cache + toolchain (regenerated; keep build/commands)
runtime/build/cache/
runtime/build/tools/
# Content-addressed command artifacts are regenerated build outputs (sha256 names);
# curated commands (jq/grep) keep their plain names and stay tracked.
runtime/build/commands/*.wasm
!runtime/build/commands/jq.wasm
!runtime/build/commands/grep.wasm

# Secrets / local
.env
.env.local
**/workbook.local.json
*.pem

# OS
**/.DS_Store
.claude/
scratch/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/

# The deploy-kit RECIPE (Dockerfiles, fly.toml, providers, deploy.sh) is GENERIC infra and must
# be tracked so CI + fresh clones can build the runtime image. Only server-specific STATE stays
# out: real deployment configs + secrets. Anchored to the repo ROOT so nested dirs like
# runtime/host/deploy/ stay tracked.
/deploy/*
!/deploy/Dockerfile
!/deploy/Dockerfile.compilers
!/deploy/fly.toml
!/deploy/deploy.sh
!/deploy/storage.env.example
!/deploy/providers/
/deploy/deployments/
/deploy/storage.env
# unaudited example trees stay local until a secrets-scrub pass publishes them;
# their README.md stubs ARE public (the gallery shows every example honestly)
/examples/brandnana/*
!/examples/brandnana/README.md
/examples/adbuy/*
!/examples/adbuy/README.md

# local-production build-lock (per-machine artifact provenance)
scripts/.build-lock.tsv

# stray publish/test output (not source)
.publish_out/
runtime/.publish_out/

# CLAUDE.md is a local-only symlink → AGENTS.md (single source of truth, vendor-neutral)
/CLAUDE.md
secrets.env

examples/groundwork/runs/
examples/groundwork/app/native/node_modules/
examples/groundwork/app/native/ios/
examples/groundwork/app/native/www/
examples/groundwork/app/native/package-lock.json

# audio build intermediates — regenerable, never served (de-bloat 2026-06-13)
web/learn/audio/raw/
web/learn/audio/align/
web/learn/audio/cues/
web/learn/audio/scripts/
web/learn/audio/episodes/
toolkits/.live.json

# scratch model weights (never commit)
ether/spike/
*.gguf

# content-addressed compiled-component cache (regenerated; pre-warmed at deploy)
nexus/build/components

# control-plane registry (durable, regenerated; lives on the /data volume in prod)
nexus/control-plane.dets
nexus/**/*.dets

# Working docs — kept on disk, never committed
docs/
!templates/docs/        # the unbranded docs starter TEMPLATE is real, tracked source
!dogfood/docs/          # our real docs surface (dogfood) is tracked source
!dogfood/docs/**

# Runtime DETS state must never be tracked (token hashes, org records, waitlist emails)
**/*.dets

# model weights / large artifacts — never commit
constellation/spike/dflash/granite-*/
/tools/
constellation/spike/dflash/*/
*.gguf
*.safetensors

# nexus durable-state dir (runtime artifacts: telemetry ring, repos, keys)
nexus/.nexus/

# dogfood runtime residue — local Store DB + SQLite WAL/SHM sidecars, and empty ws_* workspace
# provisioning leftovers from local runs. Recreated on boot; never source (were partially tracked).
dogfood/.nexus/
dogfood/ws_*/
