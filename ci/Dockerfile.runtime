# The GENERIC Workbooks runtime image — just the BEAM engine, no toolkits baked.
# This is the ONE image the deploy-kit runs: locally in a krunvm/libkrun microVM
# (`wb deploy local`, pulled from ghcr) and on a cloud machine. Brandnana + other
# toolkits layer ON TOP via their own images / profiles; this stays lean.
#
# Build CONTEXT = repo root. Published multi-arch to ghcr by
# .github/workflows/runtime-image.yml → ghcr.io/workbooks-sh/runtime:latest.

# The compilers layer (Dockerfile.compilers), referenced as a named stage. Docker forbids a variable
# in `COPY --from`, but a GLOBAL ARG in `FROM` is allowed — so we alias it to `compilers` here and
# COPY from that stage below. `compilers:local` for a local build (Workbooks.Deploy.Image builds it
# first); the ghcr ref for publish (push once via `wb deploy publish-compilers`).
ARG COMPILERS_REF=compilers:local
FROM ${COMPILERS_REF} AS compilers

# --- build: the Elixir release ----------------------------------------------
FROM elixir:1.18-otp-27 AS build
ENV MIX_ENV=prod LANG=C.UTF-8
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git curl \
    && rm -rf /var/lib/apt/lists/*
# Rust toolchain for any rustler NIF (oql.wasm itself is pre-built + committed).
RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"
RUN mix local.hex --force && mix local.rebar --force
# Opt-in in-BEAM CLIP (ONNX/Ortex) — off by default, gated on WB_CLIP=1 (mix.exs).
ARG INCLUDE_CLIP=false
ENV WB_CLIP=""
COPY runtime/mix.exs runtime/mix.lock ./
# wasmex is a VENDORED path dep ({:wasmex, path: "vendor/wasmex"}) — its source must exist before
# deps.compile, so copy it alongside the manifests (still before the full tree, to keep dep caching).
COPY runtime/vendor ./vendor
RUN if [ "$INCLUDE_CLIP" = "true" ]; then export WB_CLIP=1; fi \
    && mix deps.get --only prod && mix deps.compile
COPY runtime/ .
RUN if [ "$INCLUDE_CLIP" = "true" ]; then export WB_CLIP=1; fi \
    && mix compile && mix release

# --- run --------------------------------------------------------------------
FROM debian:bookworm-slim AS app
LABEL org.opencontainers.image.source="https://github.com/workbooks-sh/workbooks.sh"
LABEL org.opencontainers.image.description="Workbooks runtime — the BEAM engine (generic, no toolkits)"
ENV LANG=C.UTF-8 WB_WEB=1 PORT=4000
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
      libstdc++6 openssl libncurses6 ca-certificates curl xz-utils \
      git jq sqlite3 openssh-client unzip \
    && rm -rf /var/lib/apt/lists/*

# bun — the JS toolchain the build engine shells to for js_project workbooks
# (Workbooks.Build: a Svelte/Vite project builds ITSELF; bun runs the build).
RUN curl -fsSL https://bun.sh/install | bash \
    && mv /root/.bun/bin/bun /usr/local/bin/bun \
    && bun --version
RUN curl -fsSL https://wasmtime.dev/install.sh | bash \
    && cp /root/.wasmtime/bin/wasmtime /usr/local/bin/wasmtime

# Bake the default semantic embedding model (Model2Vec/potion, ~30 MB) so the
# runtime never downloads it. Checked before the WB_DATA cache.
ENV WB_MODELS_DIR=/opt/models
RUN mkdir -p /opt/models/potion-base-8M \
    && for f in config.json vocab.txt model.safetensors; do \
         curl -fsSL "https://huggingface.co/minishlab/potion-base-8M/resolve/main/$f" \
           -o "/opt/models/potion-base-8M/$f"; \
       done

COPY --from=build /app/_build/prod/rel/workbooks ./
COPY --from=build /app/build ./build
# The in-sandbox compilers, from the standalone compilers LAYER (the `compilers` stage above) so CI
# never rebuilds the hours-long provision chain. default_root() resolves "compilers" at the app CWD,
# so cloud AND local-container deployments compile Rust/C/Zig/Go/JS identically to dev.
COPY --from=compilers /compilers ./compilers

EXPOSE 4000
CMD ["bin/workbooks", "start"]
