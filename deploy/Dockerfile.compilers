# The in-sandbox COMPILERS as a standalone OCI layer — mrustc/clang/libstd/zig/yaegi/qjs+tsc/c4,
# the LEAN ~600M slice from runtime/scripts/stage-tools.sh (NOT the ~6.6G provisioned scratch tree).
# The wasm tools are platform-agnostic, so one image serves amd64 + arm64.
#
# WHY a separate image: the compilers are gitignored build artifacts from an hours-long provision
# chain that CI can't reproduce per-build. Publishing them ONCE (when they change) as
# ghcr.io/workbooks-sh/compilers lets the runtime image pull them via `COPY --from=...` — so
# `wb deploy publish` stays fast and every deployment (cloud + local container) compiles identically.
#
# Build CONTEXT = repo root. Run `scripts/stage-tools.sh` first (the deploy verbs do this).
#   maintainer (provisioned machine):  wb deploy publish-compilers   # build + push, when they change
#   runtime build:                     COPY --from=<this image> /compilers
FROM scratch
# Auto-link the package to the repo on push (like the runtime image) so workbooks-sh CI can pull
# it during the runtime-image build without making it public — self-hosters pull the baked runtime.
LABEL org.opencontainers.image.source="https://github.com/workbooks-sh/workbooks.sh"
LABEL org.opencontainers.image.description="Workbooks in-sandbox compilers (mrustc/clang/libstd/zig/yaegi/qjs/c4) — the lean runtime slice"
COPY runtime/compilers-dist /compilers
