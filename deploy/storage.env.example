# ─────────────────────────────────────────────────────────────────────────────
# Workbooks runtime — storage + identity config (the deploy-kit "one screen").
#
# Set these as platform secrets (Fly: `fly secrets set KEY=value`), NEVER bake
# them into the image. The runtime code is IDENTICAL across every deployment —
# only this config changes. Pick a blob backend + (optionally) a database; the
# defaults are a simple single-box deploy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identity (REQUIRED for a stable DID across redeploys) ────────────────────
# 32-byte Ed25519 seed, base64. Without it the DID is regenerated every deploy
# and prior signatures/ledgers stop verifying. Generate once:
#   elixir -e 'IO.puts(Base.encode64(:crypto.strong_rand_bytes(32)))'
WB_SIGNING_KEY=
# Which tenant the signing key belongs to (single-tenant deploys: leave default).
WB_PRIMARY_TENANT=dev

# ── Blob storage (workbooks, bundles, artifacts) ─────────────────────────────
# local = filesystem under WB_DATA (mount it on a persistent volume → durable).
# s3 / r2 = object store (same adapter; R2 is S3-compatible).
WB_STORAGE=local
WB_DATA=/data                       # mount a Fly volume here for `local` durability

# S3 / R2 (only when WB_STORAGE=s3 or r2):
#   AWS S3:  endpoint https://s3.<region>.amazonaws.com   region <region>
#   CF R2:   endpoint https://<account>.r2.cloudflarestorage.com   region auto
WB_S3_ENDPOINT=
WB_S3_BUCKET=
WB_S3_KEY=
WB_S3_SECRET=
WB_S3_REGION=auto

# ── Structured data (vars, memory, telemetry/ledger index, registry) ─────────
# Unset → local SQLite (simple). Set → Postgres; ANY provider, it's just a URL:
#   Fly PG:      postgres://user:pass@<app>.flycast:5432/db
#   CrunchyData: postgres://user:pass@<host>.crunchybridge.com:5432/db
#   Railway:     postgres://user:pass@<host>.railway.app:5432/railway
#   Neon:        postgres://user:pass@<host>.neon.tech/db?sslmode=require
#   Supabase:    postgres://postgres:pass@db.<ref>.supabase.co:5432/postgres
# SSL is on by default for non-localhost hosts (append ?sslmode=disable to opt out).
WB_DATABASE_URL=

# ── Semantic search embedder ─────────────────────────────────────────────────
# hash = zero-dep lexical baseline (default, offline, instant).
# local = real semantic via Model2Vec/potion static embeddings (PURE ELIXIR, no
#   native NIF, no runtime) — downloads a ~30MB matrix once to WB_DATA/_models.
# openrouter = external /embeddings via the LLM key (per-query cost).
WB_EMBED=local                            # semantic ON by default (potion, baked in)
WB_EMBED_MODEL=minishlab/potion-base-8M   # any Model2Vec/potion variant (2M…32M)
# Vector backend is the SEPARATE knob above: WB_DATABASE_URL set → pgvector ANN
# (scales sub-linearly); unset → SQLite brute-force (fine to ~10k vectors).

# ── Auth (unchanged — BetterAuth → Guardian) ─────────────────────────────────
# JWTs are verified via the issuer's JWKS and scoped to organizationId = tenant.
# Every storage + db op is tenant-scoped ABOVE the backend, so swapping backends
# can't widen access. Set your issuer's JWKS/config via the existing auth knob.
