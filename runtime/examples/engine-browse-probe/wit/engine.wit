package workbooks:engine-browse;

// A Dock subset: session-info + browse-fetch. The host provides browse-fetch
// under the network/posix profiles (which grant the `browse` cap). Route B —
// the host (Workbooks.Browse) owns network egress; this component never opens a
// socket (no wasi:http/sockets). It fetches a URL purely through the typed Dock.
world engine {
  import session-info: func() -> string;
  import browse-fetch: func(url: string) -> string;
  export run: func(input: string) -> string;
}
