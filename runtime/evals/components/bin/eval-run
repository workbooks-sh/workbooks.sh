#!/usr/bin/env bash
# eval-run — run ONE (or all) component-emit eval case(s) through the runtime
# harness. Mirrors runtime/wavelet/evals/bin/eval-run, but the runner lives in
# the BEAM (Workbooks.Evals.Components) so this is a thin `mix run` shim.
#
# Usage:
#   eval-run                 # whole pack
#   eval-run chart-not-table # one case (substring of the spec filename)
#
# Needs (live run): WB_EVAL_MODEL (default xiaomi/mimo-v2.5) + an LLM key
# (OPENROUTER_API_KEY / WB_LLM_KEY). The mount-and-screenshot path additionally
# needs a local headless Chrome (WB_CHROME_BIN / system Chrome / puppeteer
# cache); without it the judge scores from the emitted source only.
set -euo pipefail

FILTER="${1:-}"
# runtime/ is two dirs up from evals/components/bin/
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$ROOT"

if [[ -n "$FILTER" ]]; then
  exec mix run --no-halt -e "IO.puts(Workbooks.Evals.Components.run(\"$FILTER\")); System.halt(0)"
else
  exec mix run --no-halt -e "IO.puts(Workbooks.Evals.Components.run()); System.halt(0)"
fi
