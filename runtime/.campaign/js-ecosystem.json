{
  "meta": {
    "goal": "Drive the ENTIRE JS/TS npm ecosystem surface to a terminal verdict in-sandbox. Deep + thorough: each item's EVERY surface, never surface-level. Do not stop until every surface is live or deferred and we are ~90% confident the whole ecosystem is usable in the sandbox.",
    "verdict_ladder": "pending < probing < live | deferred",
    "live_means": "proven in-sandbox through the REAL pipeline (Npm.install_tree -> Compilers.esbuild_bundle_dir -> JsEngine.run_program, or the relevant lane) + a skip-guarded test + recorded here and in FORGE-CAPABILITIES.md",
    "deferred_means": "empirically blocked in-guest; record the WALL (bedrock|bridge|forge) + the concrete reason + any host-broker escape. Deferred is a terminal verdict too \u2014 it counts as 'covered'.",
    "engine": "JsEngine.run_program/2 = StarlingMonkey default + QuickJS thin fallback (SM lacks regex \\p{}; QJS lacks WebCrypto).",
    "walls": "bedrock = no native exec in guest (V8 JIT, .node addons, child_process spawn) -> only via trusted host-service broker. bridge = browser/DOM-bound. forge = toolchain gap we can build from source.",
    "git": "PATH-SPECIFIC commits only (concurrent worker shares repo). Never git stash / git add -A.",
    "loop": "2-min cron; each tick drives ONE next pending surface to a terminal verdict, deeply, then commits. Multitask within a tick when cheap.",
    "known_ceiling": "Bundles ~10MB+ (e.g. full typescript) exceed the SM eval-host string / QuickJS wasm runtime limit. Most libs are well under; tree-shaking + minify helps. Filed under lib-ast."
  },
