# Linux agent image for the local microVM ACP orchestrator (EXPERIMENTAL, wb-xiei.8).
# Built arm64 (the Mac host is aarch64; krunvm runs aarch64 guests). The real agent
# CLIs run natively here — this is the whole point of the microVM (they're native
# binaries that cannot run in the wasm sandbox).
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates ripgrep curl \
 && rm -rf /var/lib/apt/lists/*

# The user's subscribed agents. Both install a native binary via npm postinstall.
RUN npm install -g @openai/codex @anthropic-ai/claude-code

# Auth is MOUNTED at run time (never baked): /root/.codex (file) or /root/.claude
# (keychain-bridged credentials). The worktree mounts at /work.
WORKDIR /work
