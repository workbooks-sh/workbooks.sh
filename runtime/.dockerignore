_build
deps
node_modules
.elixir_ls
erl_crash.dump
commands/*/target
kernel/target
tmp

# the ~6.6G provisioned scratch tree — the lean compilers-dist/ ships instead (stage-tools.sh)
compilers

# cargo build artifacts (rebuilt in-image)
**/target
vendor/**/target

# stale prebuilt rustler NIF (host-arch) — build fresh in-image
**/priv/native/*.so

# Runtime-generated WASM compile cache (content-addressed; the engine regenerates
# it on demand). Never ship it — it bloated local deploy builds by ~290MB.
build/cache

# Runtime-generated WASM command store (content-addressed; same regenerate-on-demand
# contract as build/cache above). Was leaking ~420MB into every image because only
# build/cache was excluded. Keep ONLY the named prebuilt externals (jq/grep) that the
# engine does not synthesize from a compiler.
build/commands/*
!build/commands/jq.wasm
!build/commands/grep.wasm
