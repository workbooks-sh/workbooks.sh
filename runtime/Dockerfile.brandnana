# The clean-room WASM runtime engine + the brandnana brand-book toolkit.
# Same BEAM+wasmtime+litestream base as Dockerfile, PLUS the brandnana CLI
# (built from source — the local v0.1.0 lacks harvest-all), the `wb` meta-CLI,
# and the brandnana profile/boards baked at /opt/profile.
#
# Build CONTEXT = the MONOREPO ROOT (brandnana CLI + profile live there, not in
# the worktree). Use scripts/build-brandnana-engine.sh, which runs:
#   docker build -f <this>/Dockerfile.brandnana -t bn-engine-clean <monorepo-root>
# Deploy: a NEW Fly app (bn-engine-clean) — never the live bn-engine.

# The clean-room app's path inside the build context. The build script stages a
# clean context (the worktree lives under .claude/, which the root .dockerignore
# excludes — so we assemble the context outside it); there the app is ./runtime.
ARG WORKTREE=runtime

# --- brandnana CLI: self-contained bun binary (mirrors engine-profile) -------
FROM oven/bun:1 AS brandnana-cli
WORKDIR /src/brandnana
COPY projects/brandnana/package.json projects/brandnana/bun.lock ./
COPY projects/brandnana/packages ./packages
COPY projects/brandnana/apps/cli ./apps/cli
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --ignore-scripts && bash apps/cli/scripts/build-binary.sh linux-x64

# --- wb meta-CLI (Rust; own workspace) ---------------------------------------
FROM rust:1-bookworm AS wb-cli
WORKDIR /build/cli
COPY cli/Cargo.toml cli/Cargo.lock ./
COPY cli/src ./src
COPY cli/deploy-kit ./deploy-kit
RUN cargo build --release -p wb-cli

# --- clean-room engine (Elixir release) --------------------------------------
FROM elixir:1.18-otp-27 AS build
ARG WORKTREE
ENV MIX_ENV=prod LANG=C.UTF-8
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git \
    && rm -rf /var/lib/apt/lists/*
RUN mix local.hex --force && mix local.rebar --force
COPY ${WORKTREE}/mix.exs ${WORKTREE}/mix.lock ./
RUN mix deps.get --only prod && mix deps.compile
COPY ${WORKTREE}/ .
RUN mix compile && mix release

# --- run: slim image with the release + the toolkit binaries -----------------
FROM debian:bookworm-slim AS app
ENV LANG=C.UTF-8 WB_WEB=1 PORT=4000 WB_PROFILE_DIR=/opt/profile
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
      libstdc++6 openssl libncurses6 ca-certificates curl xz-utils \
      git jq sqlite3 imagemagick \
    && rm -rf /var/lib/apt/lists/*

# wasmtime — runs in-WASM commands (jq/grep) and components.
RUN curl -fsSL https://wasmtime.dev/install.sh | bash \
    && cp /root/.wasmtime/bin/wasmtime /usr/local/bin/wasmtime

# (litestream/VFS-replication omitted — the brand-book run needs no off-box
#  durability; add it back with the persistent volume once the port is proven.)

# The brandnana brand-book toolkit: CLI + wb + the profile (agents + skills) + boards.
COPY --from=brandnana-cli /src/brandnana/apps/cli/dist/brandnana-linux-x64 /usr/local/bin/brandnana
COPY --from=wb-cli /build/cli/target/release/wbx /usr/local/bin/wb
COPY substrates/brandnana/profile /opt/profile
COPY substrates/brandnana/boards /opt/profile/boards

COPY --from=build /app/_build/prod/rel/workbooks ./
COPY --from=build /app/build ./build

EXPOSE 4000
CMD ["bin/workbooks", "start"]
