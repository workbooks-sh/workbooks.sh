diff --git a/src/hir_conv/constant_evaluation.cpp b/src/hir_conv/constant_evaluation.cpp
index 039349b6..b7f3752e 100644
--- a/src/hir_conv/constant_evaluation.cpp
+++ b/src/hir_conv/constant_evaluation.cpp
@@ -2890,6 +2890,20 @@ namespace HIR {
                     auto ofs = local_state.read_param_uint(Target_GetPointerBits(), e.args.at(1));
                     dst.write_ptr(state, ptr_pair.first + ofs.truncate_u64() * element_size, ptr_pair.second);
                 }
+                // wb-bdk: `arith_offset<T>(dst: *const T, offset: isize)` — the WRAPPING twin of
+                // `offset`. Same const-eval math (ptr + offset*size; two's-complement offset wraps).
+                // type-param shape differs: arith_offset's m_types[0] is the pointee T directly
+                // (offset's is the pointer type Ptr). Needed by 1.74 core ptr::wrapping_offset under
+                // --cfg debug_assertions (else MIR_TODO abort).
+                else if( te->name == "arith_offset" ) {
+                    auto ty = local_state.monomorph_expand(te->params.m_types.at(0));
+                    size_t element_size;
+                    if( !Target_GetSizeOf(state.sp, resolve, ty, element_size) )
+                        throw Defer();
+                    auto ptr_pair = local_state.read_param_ptr(e.args.at(0));
+                    auto ofs = local_state.read_param_uint(Target_GetPointerBits(), e.args.at(1));
+                    dst.write_ptr(state, ptr_pair.first + ofs.truncate_u64() * element_size, ptr_pair.second);
+                }
                 else if( te->name == "write_bytes" ) {
                     auto ty = local_state.monomorph_expand(te->params.m_types.at(0));
                     size_t element_size;
@@ -2926,6 +2940,13 @@ namespace HIR {
                 else if( te->name == "is_val_statically_known" ) {
                     dst.write_uint(state, 8, e.args.at(0).is_Constant() || e.args.at(0).is_Borrow());
                 }
+                // wb-bdk: `ptr_guaranteed_cmp<T>(a,b) -> u8` (0=ne, 1=eq, 2=unknown). Consumer
+                // guaranteed_eq maps 2->None, so returning 2 is ALWAYS correct (conservative — no
+                // wrong eq/ne result), avoiding alloc-identity comparison subtleties at const-eval.
+                // Needed by 1.74 core ptr cmp under --cfg debug_assertions (else MIR_TODO abort).
+                else if( te->name == "ptr_guaranteed_cmp" ) {
+                    dst.write_uint(state, 8, 2);
+                }
                 else {
                     MIR_TODO(state, "Call intrinsic \"" << te->name << "\" - " << terminator);
                 }
