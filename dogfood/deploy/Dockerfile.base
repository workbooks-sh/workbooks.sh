# dogfood-base — the RUNTIME layer of the dogfood image: the Elixir release + litestream, WITHOUT the
# dogfood content tree. Rebuilt ONLY when nexus/ (the runtime) changes (see dogfood-deploy.yml). The
# deployed image is then `FROM dogfood-base + COPY dogfood` (dogfood/deploy/Dockerfile), so a
# content-only change (cloud .js views, lander copy, deploy config) rebuilds just the content layer in
# seconds instead of recompiling the whole BEAM release.
#
# The in-sandbox compilers + agent kits ride in from the standalone compilers layer (same mechanism as
# nexus/Dockerfile) so agents RUNNING on this nexus can execute their tools — the coreutils/web kits are
# wasm CLIs run via wasmtime — and compile. `compilers:local` for a local build; the ghcr ref in CI.
ARG COMPILERS_REF=compilers:local
FROM ${COMPILERS_REF} AS compilers

FROM elixir:1.19-otp-27 AS build
ENV MIX_ENV=prod LANG=C.UTF-8
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git curl && rm -rf /var/lib/apt/lists/*
RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"
RUN mix local.hex --force && mix local.rebar --force
COPY nexus/mix.exs nexus/mix.lock ./
COPY nexus/vendor/wasmex /app/vendor/wasmex
# BuildKit cache mounts: deps/ + _build/ PERSIST across builds (shared ids carry _build from this step
# into the compile step). A source-only change busts the `COPY nexus/` layer, but `mix compile` then
# reuses cached _build and recompiles ONLY changed modules — the ~5.5min full rebuild → seconds. Mounts
# are ephemeral (not in a layer), so the release is copied OUT to /app/rel for the final COPY.
RUN --mount=type=cache,target=/app/deps,id=nexus-deps \
    --mount=type=cache,target=/app/_build,id=nexus-build \
    mix deps.get --only prod && mix deps.compile
COPY nexus/ .
RUN --mount=type=cache,target=/app/deps,id=nexus-deps \
    --mount=type=cache,target=/app/_build,id=nexus-build \
    mix compile && mix release nexus --overwrite && rm -rf /app/rel && cp -a _build/prod/rel/nexus /app/rel

FROM debian:bookworm-slim AS app
ENV LANG=C.UTF-8 PORT=4000 WB_DATA=/srv/dogfood WB_NEXUS=dogfood
WORKDIR /app
# git is REQUIRED at runtime: the nexus is a git remote — it shells to `git` to init bare repos, run
# http-backend (push/fetch), and check workspaces out (Nexus.Git / Nexus.GitHttp). Without it, the first
# push 500s with :enoent. (Tests passed only because dev hosts already have git.)
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 openssl libncurses6 ca-certificates sqlite3 curl git xz-utils && rm -rf /var/lib/apt/lists/*
# Litestream — streams the tenant SQLite WAL to R2 (egress-free) + restores on boot. Generic
# durability mechanism; activates only when WB_S3_* secrets are injected (see entrypoint).
ARG LITESTREAM_VERSION=v0.3.13
RUN curl -fsSL "https://github.com/benbjohnson/litestream/releases/download/${LITESTREAM_VERSION}/litestream-${LITESTREAM_VERSION}-linux-amd64.tar.gz" \
    | tar -xz -C /usr/local/bin litestream && litestream version
# jj (Jujutsu) — the op-log / undo / snapshot substrate colocated over each workspace's git repo
# (Nexus.JJ). Required at runtime when jj-substrate is on, else maybe_colocate/import_refs silently
# no-op and the nexus falls back to pure git. Static musl binary.
# PINNED to v0.41.0: v0.42 removed `jj describe --author`, which Nexus.JJ.commit_change uses for
# agent/user attribution. Bump only alongside a Nexus.JJ update that drops the removed flag.
ARG JJ_VERSION=v0.41.0
# The jj tarball stores the binary as `./jj` (alongside README/LICENSE), so the member name is `./jj`,
# not `jj` — extract that exact path into /usr/local/bin.
RUN curl -fsSL "https://github.com/jj-vcs/jj/releases/download/${JJ_VERSION}/jj-${JJ_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
    | tar -xz -C /usr/local/bin ./jj && jj --version
# wasmtime — the WASI runtime the agent sandbox shells to: Nexus.Sandbox runs `wasmtime run <kit>.wasm`
# for the agent's coreutils/web kits, and the compile lanes use it too. Must be on PATH. Same pin as
# nexus/Dockerfile. (The lean base previously omitted it, so deployed agents couldn't execute any kit.)
ARG WASMTIME_VERSION=v45.0.1
RUN curl -fsSL https://wasmtime.dev/install.sh | bash -s -- --version ${WASMTIME_VERSION} \
    && cp /root/.wasmtime/bin/wasmtime /usr/local/bin/wasmtime && wasmtime --version
# wasmer — the WASIX runtime the AGENT SHELL runs on: Nexus.Wasmer shells to `wasmer run sharrattj/bash`
# (+ our coreutils + python) over /work, giving a real wasm-linux sandbox. (Dual-runtime during the
# migration: wasmtime still backs the compiler lane; wasmer backs the agent shell.) Must be on PATH.
RUN curl -fsSL https://get.wasmer.io | sh && cp /root/.wasmer/bin/wasmer /usr/local/bin/wasmer && wasmer --version
COPY --from=build /app/rel ./
# The agent KIT wasm, from the compilers layer (the compilers-image workflow stages nexus/kits/*.wasm
# into /compilers/kits). Copy ONLY the kits subdir — the dogfood surfaces don't compile, so the full
# ~600M toolchain stays out; Nexus.Agent.Kits.root resolves "compilers/kits" at the app CWD.
COPY --from=compilers /compilers/kits ./compilers/kits
COPY nexus/scripts/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
EXPOSE 4000
# CMD lives in the base so the thin image only adds content. The deploy config + workbook tree are
# COPY'd in by the thin image at /srv/dogfood (Nexus.Config reads $WB_DATA/index.work there).
CMD ["/app/entrypoint.sh"]
