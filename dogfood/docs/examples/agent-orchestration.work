# Agent orchestration

A `server` block fans out a fleet of agents — each researches a different surface — and streams their findings back into one synthesized answer. Here it is running (staged data, no keys):

client :agent_orchestration do
  <iframe class="demo-frame" title="Agent orchestration demo" loading="lazy" sandbox="allow-scripts" srcdoc="
    <!doctype html>
    <html lang=&quot;en&quot;>
    <head>
    <meta charset=&quot;utf-8&quot; />
    <meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1&quot; />
    <title>Swarm</title>
    <!-- Single-file workbook. The `workbook-spec` marker is what the desktop's grid
         scan keys on. Swarm is a live deep-research console: a fleet of agents fans
         out, each searches a different surface, findings synthesize in the center.
         Self-contained (no runtime, no network) — it animates itself on load so the
         orchestration reads as alive on camera, then settles. -->
    <script id=&quot;workbook-spec&quot; type=&quot;application/json&quot;>
    { &quot;name&quot;: &quot;Swarm&quot;, &quot;version&quot;: &quot;0.1.0&quot;, &quot;kind&quot;: &quot;app&quot; }
    </script>
    <style>
      :root{
        color-scheme: dark;
        --bg:#0c0e12; --panel:#13161c; --panel-2:#171b22; --line:#242a34;
        --fg:#e7e9ee; --muted:#8b919e; --faint:#5b616e;
        --green:#33d17a; --green-dim:#1d7a48; --cyan:#46c6ff; --amber:#f5b54a;
        --violet:#9a86ff;
        --mono: ui-monospace,&quot;SF Mono&quot;,Menlo,Consolas,monospace;
        --sans: ui-sans-serif,system-ui,-apple-system,&quot;SF Pro&quot;,sans-serif;
      }
      *{box-sizing:border-box}
      html,body{height:100%}
      body{margin:0;background:
          radial-gradient(1200px 500px at 80% -10%, rgba(70,198,255,.06), transparent 60%),
          radial-gradient(900px 500px at 0% 110%, rgba(154,134,255,.06), transparent 60%),
          var(--bg);
        color:var(--fg);font:13.5px/1.5 var(--sans);overflow:hidden}
      .app{height:100vh;display:flex;flex-direction:column}
    
      /* top bar */
      header{display:flex;align-items:center;gap:16px;padding:16px 22px;border-bottom:1px solid var(--line)}
      .brand{display:flex;align-items:center;gap:10px;font-weight:600;font-size:15px;letter-spacing:-.01em}
      .brand .mark{width:22px;height:22px;color:var(--green)}
      .q{flex:1;display:flex;align-items:center;gap:10px;background:var(--panel);border:1px solid var(--line);
         border-radius:10px;padding:9px 13px;min-width:0}
      .q svg{width:15px;height:15px;color:var(--muted);flex:none}
      .q .text{color:var(--fg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .q .caret{width:1.5px;height:15px;background:var(--green);animation:blink 1.1s step-end infinite}
      @keyframes blink{50%{opacity:0}}
      .pill{font:600 11px/1 var(--sans);color:var(--cyan);background:rgba(70,198,255,.1);
         border:1px solid rgba(70,198,255,.25);padding:6px 9px;border-radius:999px;white-space:nowrap}
      .live{display:flex;align-items:center;gap:6px;color:var(--muted);font-size:12px;white-space:nowrap}
      .live .dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 0 rgba(51,209,122,.5);animation:pulse 1.8s infinite}
      @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(51,209,122,.45)}70%{box-shadow:0 0 0 7px rgba(51,209,122,0)}100%{box-shadow:0 0 0 0 rgba(51,209,122,0)}}
    
      /* body grid */
      .main{flex:1;display:grid;grid-template-columns:380px 1fr;gap:0;min-height:0}
      .left{border-right:1px solid var(--line);padding:16px 16px 0;overflow:hidden;display:flex;flex-direction:column}
      .sec{font:600 11px/1 var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:2px 4px 12px;display:flex;justify-content:space-between}
    
      .agent{display:flex;gap:12px;align-items:flex-start;background:var(--panel);border:1px solid var(--line);
         border-radius:11px;padding:11px 12px;margin-bottom:9px;opacity:.45;transition:opacity .4s,border-color .4s,background .4s}
      .agent.active{opacity:1;border-color:#2f3845}
      .agent.done{opacity:1;background:linear-gradient(180deg,rgba(51,209,122,.06),var(--panel));border-color:var(--green-dim)}
      .agent .ic{width:30px;height:30px;border-radius:8px;flex:none;display:grid;place-items:center;
         background:var(--panel-2);border:1px solid var(--line);color:var(--muted)}
      .agent.active .ic{color:var(--cyan);border-color:rgba(70,198,255,.4)}
      .agent.done .ic{color:var(--green);border-color:var(--green-dim)}
      .agent .ic svg{width:16px;height:16px}
      .agent .body{flex:1;min-width:0}
      .agent .name{font-weight:600;font-size:13px;display:flex;justify-content:space-between;align-items:center}
      .agent .src{font:11px/1 var(--mono);color:var(--muted)}
      .agent.done .src{color:var(--green)}
      .agent .status{font-size:11.5px;color:var(--muted);margin-top:2px;height:14px}
      .agent .bar{height:3px;border-radius:2px;background:var(--line);margin-top:8px;overflow:hidden}
      .agent .bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--cyan),var(--green));transition:width .3s linear}
      .spin{width:12px;height:12px;border:1.5px solid var(--line);border-top-color:var(--cyan);border-radius:50%;animation:spin .7s linear infinite}
      @keyframes spin{to{transform:rotate(360deg)}}
      .check{width:13px;height:13px;color:var(--green)}
    
      /* right: findings */
      .right{padding:18px 22px;overflow:hidden;display:flex;flex-direction:column;min-width:0}
      .answer{font-size:19px;line-height:1.4;font-weight:600;letter-spacing:-.01em;margin:0 0 4px;max-width:62ch}
      .answer .accent{color:var(--green)}
      .sub{color:var(--muted);font-size:12.5px;margin-bottom:18px}
      .findings{list-style:none;margin:0;padding:0;overflow:hidden}
      .finding{display:flex;gap:12px;padding:13px 0;border-top:1px solid var(--line);opacity:0;transform:translateY(8px);
         transition:opacity .45s,transform .45s}
      .finding.in{opacity:1;transform:none}
      .finding .n{font:600 11px/1.6 var(--mono);color:var(--bg);background:var(--green);width:20px;height:20px;
         border-radius:6px;text-align:center;flex:none}
      .finding .ftext{font-size:13.5px;line-height:1.55;color:#d7dae1}
      .finding .ftext b{color:#fff;font-weight:600}
      .cite{display:inline-block;font:600 10px/1.4 var(--mono);color:var(--cyan);background:rgba(70,198,255,.1);
         border:1px solid rgba(70,198,255,.22);border-radius:5px;padding:0 5px;margin-left:5px;vertical-align:1px}
    
      /* footer stats */
      footer{display:flex;gap:26px;align-items:center;padding:13px 22px;border-top:1px solid var(--line);color:var(--muted);font-size:12px}
      footer .stat{display:flex;align-items:baseline;gap:7px}
      footer .stat b{font:600 15px/1 var(--mono);color:var(--fg)}
      footer .grow{flex:1}
      .ring{--p:0;width:34px;height:34px;border-radius:50%;flex:none;
         background:conic-gradient(var(--green) calc(var(--p)*1%), var(--line) 0);
         display:grid;place-items:center;transition:--p .3s}
      .ring::after{content:&quot;&quot;;width:26px;height:26px;border-radius:50%;background:var(--bg)}
      .ring span{position:absolute;font:600 10px/1 var(--mono);color:var(--green)}
      .ringwrap{position:relative;display:grid;place-items:center}
    </style>
    </head>
    <body>
    <div class=&quot;app&quot;>
      <header>
        <div class=&quot;brand&quot;>
          <svg class=&quot;mark&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;><circle cx=&quot;12&quot; cy=&quot;12&quot; r=&quot;2.5&quot;/><circle cx=&quot;5&quot; cy=&quot;6&quot; r=&quot;1.8&quot;/><circle cx=&quot;19&quot; cy=&quot;6&quot; r=&quot;1.8&quot;/><circle cx=&quot;5&quot; cy=&quot;18&quot; r=&quot;1.8&quot;/><circle cx=&quot;19&quot; cy=&quot;18&quot; r=&quot;1.8&quot;/><path d=&quot;M6.6 7 10.4 10.5M17.4 7 13.6 10.5M6.6 17l3.8-3.5M17.4 17l-3.8-3.5&quot;/></svg>
          Swarm
        </div>
        <div class=&quot;q&quot;>
          <svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot;><circle cx=&quot;11&quot; cy=&quot;11&quot; r=&quot;7&quot;/><path d=&quot;m21 21-4.3-4.3&quot;/></svg>
          <span class=&quot;text&quot;>Compare the leading WebAssembly runtimes for server-side sandboxing</span>
          <span class=&quot;caret&quot;></span>
        </div>
        <span class=&quot;pill&quot;>depth · deep</span>
        <span class=&quot;live&quot;><span class=&quot;dot&quot;></span><span id=&quot;liveLabel&quot;>orchestrating</span></span>
      </header>
    
      <div class=&quot;main&quot;>
        <div class=&quot;left&quot;>
          <div class=&quot;sec&quot;><span>Agent fleet</span><span id=&quot;fleetCount&quot;>0 / 6 done</span></div>
          <div id=&quot;fleet&quot;></div>
        </div>
    
        <div class=&quot;right&quot;>
          <h1 class=&quot;answer&quot; id=&quot;answer&quot;>Synthesizing across <span class=&quot;accent&quot;>6 agents</span>…</h1>
          <div class=&quot;sub&quot; id=&quot;answerSub&quot;>Reading filings, benchmarks, docs, and forum threads in parallel.</div>
          <ul class=&quot;findings&quot; id=&quot;findings&quot;></ul>
        </div>
      </div>
    
      <footer>
        <div class=&quot;ringwrap&quot;><div class=&quot;ring&quot; id=&quot;ring&quot;></div><span id=&quot;ringTxt&quot;>0%</span></div>
        <div class=&quot;stat&quot;><b id=&quot;cAgents&quot;>0</b> agents</div>
        <div class=&quot;stat&quot;><b id=&quot;cSources&quot;>0</b> sources read</div>
        <div class=&quot;stat&quot;><b id=&quot;cThreads&quot;>0</b> surfaces searched</div>
        <div class=&quot;grow&quot;></div>
        <div class=&quot;stat&quot;>synthesized in <b id=&quot;cTime&quot;>0.0</b>s</div>
      </footer>
    </div>
    
    <script>
    const ICON = {
      web:'<path d=&quot;M2 12h20M12 2a15 15 0 0 1 0 20A15 15 0 0 1 12 2z&quot;/><circle cx=&quot;12&quot; cy=&quot;12&quot; r=&quot;10&quot;/>',
      doc:'<path d=&quot;M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z&quot;/><path d=&quot;M14 2v6h6&quot;/>',
      news:'<path d=&quot;M4 4h16v16H4z&quot;/><path d=&quot;M8 8h8M8 12h8M8 16h5&quot;/>',
      chat:'<path d=&quot;M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z&quot;/>',
      book:'<path d=&quot;M4 19.5A2.5 2.5 0 0 1 6.5 17H20&quot;/><path d=&quot;M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z&quot;/>',
      merge:'<circle cx=&quot;18&quot; cy=&quot;18&quot; r=&quot;3&quot;/><circle cx=&quot;6&quot; cy=&quot;6&quot; r=&quot;3&quot;/><path d=&quot;M6 21V9a9 9 0 0 0 9 9&quot;/>',
    };
    const AGENTS = [
      { name:&quot;Docs Crawler&quot;,   ic:&quot;web&quot;,   sources:14, status:&quot;reading runtime docs &amp; specs&quot; },
      { name:&quot;Benchmark Wire&quot;, ic:&quot;news&quot;,  sources:9,  status:&quot;pulling perf benchmarks&quot; },
      { name:&quot;Source &amp; Issues&quot;,ic:&quot;doc&quot;,   sources:11, status:&quot;scanning repos and changelogs&quot; },
      { name:&quot;Forums&quot;,         ic:&quot;chat&quot;,  sources:8,  status:&quot;mining HN / Reddit threads&quot; },
      { name:&quot;Academic&quot;,       ic:&quot;book&quot;,  sources:6,  status:&quot;isolation &amp; sandbox papers&quot; },
      { name:&quot;Synthesizer&quot;,    ic:&quot;merge&quot;, sources:0,  status:&quot;merging into one answer&quot;, synth:true },
    ];
    const FINDINGS = [
      ['<b>Wasmtime</b> (Bytecode Alliance) leads for server sandboxing — Cranelift JIT, mature WASI + Component Model, and per-instance fuel/epoch limits for hard isolation.', 3],
      ['<b>WasmEdge</b> wins on cold-start and edge density (AOT, ~ms startup), with first-class async networking — favored for serverless and inference sidecars.', 2],
      ['<b>Wasmer</b> emphasizes portability and a package registry; multiple backends (Cranelift/LLVM/Singlepass) trade compile time against peak throughput.', 2],
      ['Across benchmarks, <b>LLVM-tier AOT</b> closes most of the gap to native for compute, while JIT tiers win on startup — the right pick depends on cold-start vs steady-state.', 4],
      ['Consensus on isolation: pair the engine with <b>resource metering</b> (fuel/epoch), capability-scoped WASI, and one-instance-per-request to bound a hostile guest.', 3],
    ];
    const SURFACES = 23;
    
    const $ = s => document.querySelector(s);
    const fleet = $('#fleet');
    const cards = AGENTS.map(a => {
      const el = document.createElement('div');
      el.className = 'agent';
      el.innerHTML = `
        <div class=&quot;ic&quot;><svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;>${ICON[a.ic]}</svg></div>
        <div class=&quot;body&quot;>
          <div class=&quot;name&quot;><span>${a.name}</span><span class=&quot;state&quot;></span></div>
          <div class=&quot;src&quot;>queued</div>
          <div class=&quot;status&quot;>${a.status}</div>
          <div class=&quot;bar&quot;><i></i></div>
        </div>`;
      fleet.appendChild(el);
      return el;
    });
    
    const ease = t => 1 - Math.pow(1 - t, 3);
    function countUp(node, to, ms, fmt = v => Math.round(v)) {
      const t0 = performance.now();
      (function step(now){
        const p = Math.min(1, (now - t0) / ms);
        node.textContent = fmt(to * ease(p));
        if (p < 1) requestAnimationFrame(step);
        else node.textContent = fmt(to);
      })(t0);
    }
    
    let sourcesTotal = AGENTS.reduce((s,a)=>s+a.sources,0);
    let done = 0, sourcesShown = 0;
    const ring = $('#ring'), ringTxt = $('#ringTxt');
    function setProgress(p){ ring.style.setProperty('--p', p); ringTxt.textContent = Math.round(p)+'%'; }
    
    function runAgent(i){
      const el = cards[i], a = AGENTS[i];
      el.classList.add('active');
      el.querySelector('.state').innerHTML = '<span class=&quot;spin&quot;></span>';
      el.querySelector('.src').textContent = a.synth ? 'merging…' : 'searching…';
      const bar = el.querySelector('.bar i');
      const dur = 1100 + Math.random()*500;
      const t0 = performance.now();
      let srcDone = 0;
      (function step(now){
        const p = Math.min(1, (now - t0)/dur);
        bar.style.width = (p*100)+'%';
        const want = Math.round(a.sources * p);
        while (srcDone < want){ srcDone++; sourcesShown++; $('#cSources').textContent = sourcesShown; }
        if (!a.synth) el.querySelector('.src').textContent = srcDone + ' sources';
        if (p < 1) requestAnimationFrame(step);
        else finishAgent(i);
      })(t0);
    }
    function finishAgent(i){
      const el = cards[i], a = AGENTS[i];
      el.classList.remove('active'); el.classList.add('done');
      el.querySelector('.state').innerHTML = '<svg class=&quot;check&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;3&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;><path d=&quot;M20 6 9 17l-5-5&quot;/></svg>';
      el.querySelector('.src').textContent = a.synth ? 'answer ready' : a.sources + ' sources';
      el.querySelector('.status').textContent = a.synth ? 'done' : 'done · ranked';
      done++;
      $('#fleetCount').textContent = done + ' / 6 done';
      setProgress(done/AGENTS.length*100);
      if (i === AGENTS.length-1) finalize();
    }
    
    // findings stream in as the search progresses
    const findingsEl = $('#findings');
    FINDINGS.forEach((f,k)=>{
      const li = document.createElement('li');
      li.className = 'finding';
      li.innerHTML = `<span class=&quot;n&quot;>${k+1}</span><span class=&quot;ftext&quot;>${f[0]}<span class=&quot;cite&quot;>${f[1]} sources</span></span>`;
      findingsEl.appendChild(li);
    });
    const findingNodes = [...findingsEl.children];
    
    function finalize(){
      $('#answer').innerHTML = 'Wasmtime is the safest default for <span class=&quot;accent&quot;>server-side sandboxing</span>; WasmEdge wins cold-start, Wasmer wins portability.';
      $('#answerSub').textContent = 'Synthesized from 6 agents across 23 surfaces — every claim cited.';
      $('#liveLabel').textContent = 'complete';
      setProgress(100);
    }
    
    // ── timeline ──────────────────────────────────────────────────────────────
    let elapsed = 0;
    $('#cTime').textContent = '0.0';
    const clock = setInterval(()=>{ elapsed += 0.1; $('#cTime').textContent = elapsed.toFixed(1); }, 100);
    
    countUp($('#cAgents'), AGENTS.length, 700);
    countUp($('#cThreads'), SURFACES, 1600);
    
    // stagger agents; reveal findings between completions
    AGENTS.forEach((a,i)=> setTimeout(()=>runAgent(i), 250 + i*620));
    findingNodes.forEach((n,k)=> setTimeout(()=> n.classList.add('in'), 1400 + k*900));
    setTimeout(()=> clearInterval(clock), 9200);
    </script>
    </body>
    </html>
    
  "></iframe>
end

**What to notice**

- Many agents dispatched from a single server unit
- Progress streamed live over Server-Sent Events
- Findings synthesize in the center as they land

Every example here is a real, self-contained demo running in the page — the same shape
you'd weave and ship. Browse the [templates](/introduction/what-is-the-work-cli) the
`work new` command scaffolds to start from one.
