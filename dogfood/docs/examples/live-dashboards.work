# Live dashboards

Real metrics, rendered client-side and animated as they update — the kind of dashboard you'd normally wire a frontend framework for, declared in one workbook:

client :live_dashboards do
  <iframe class="demo-frame" title="Live dashboards demo" loading="lazy" sandbox="allow-scripts" srcdoc="
    <!doctype html>
    <html lang=&quot;en&quot;>
    <head>
    <meta charset=&quot;utf-8&quot; />
    <meta name=&quot;viewport&quot; content=&quot;width=1440, initial-scale=1&quot; />
    <title>Pulse — Product Analytics</title>
    <script id=&quot;workbook-spec&quot; type=&quot;application/json&quot;>
    { &quot;name&quot;: &quot;Pulse&quot;, &quot;version&quot;: &quot;0.1.0&quot;, &quot;kind&quot;: &quot;app&quot; }
    </script>
    <style>
      :root{
        --bg:#fbfbfd; --surface:#ffffff; --ink:#15171c; --muted:#6b7280; --hair:#ebedf1;
        --indigo:#5b5bd6; --teal:#12a4a4; --amber:#f5a524; --pink:#e93d82; --green:#30a46c;
        --sans: ui-sans-serif, system-ui, -apple-system, sans-serif;
        --mono: ui-monospace, Menlo, monospace;
      }
      *{box-sizing:border-box;}
      html,body{margin:0;padding:0;}
      body{
        width:100%; height:100%; overflow:hidden;
        background:var(--bg); color:var(--ink);
        font-family:var(--sans); -webkit-font-smoothing:antialiased;
        font-size:14px; line-height:1.4;
      }
      .app{display:flex; flex-direction:column; height:100%;}
    
      /* Top bar */
      .topbar{
        display:flex; align-items:center; gap:16px;
        height:64px; padding:0 28px; flex:none;
        border-bottom:1px solid var(--hair); background:var(--surface);
      }
      .brand{display:flex; align-items:center; gap:10px; font-weight:700; font-size:18px; letter-spacing:-0.02em;}
      .brand .glyph{width:26px; height:26px; border-radius:8px; background:linear-gradient(135deg,var(--indigo),var(--pink));
        display:flex; align-items:center; justify-content:center;}
      .nav{display:flex; gap:6px; margin-left:18px;}
      .nav a{padding:7px 12px; border-radius:9px; color:var(--muted); text-decoration:none; font-weight:500; font-size:13px;}
      .nav a.active{background:#f1f1fb; color:var(--indigo);}
      .spacer{flex:1;}
      .pill{
        display:flex; align-items:center; gap:8px; padding:7px 13px;
        border:1px solid var(--hair); border-radius:999px; font-size:13px; font-weight:500;
        color:var(--ink); background:var(--surface);
      }
      .pill svg{display:block;}
      .live{
        display:flex; align-items:center; gap:9px; padding:7px 14px;
        border:1px solid var(--hair); border-radius:999px; font-size:13px; font-weight:600;
        background:#f4fbf6;
      }
      .dot{width:9px; height:9px; border-radius:50%; background:var(--green); box-shadow:0 0 0 0 rgba(48,163,108,.5);
        animation:ping 2.4s ease-out infinite;}
      @keyframes ping{0%{box-shadow:0 0 0 0 rgba(48,163,108,.45);}70%{box-shadow:0 0 0 7px rgba(48,163,108,0);}100%{box-shadow:0 0 0 0 rgba(48,163,108,0);}}
      .live .num{font-family:var(--mono); color:var(--green);}
      .avatar{width:32px; height:32px; border-radius:50%; background:linear-gradient(135deg,var(--teal),var(--indigo));
        color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13px;}
    
      /* Layout */
      .content{flex:1; padding:24px 28px; display:flex; flex-direction:column; gap:18px; min-height:0;}
      .row{display:flex; gap:18px;}
      .card{
        background:var(--surface); border:1px solid var(--hair); border-radius:16px;
        box-shadow:0 1px 2px rgba(20,23,28,.04), 0 8px 24px rgba(20,23,28,.04);
        padding:18px 20px;
      }
      .card-h{display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;}
      .card-h h3{margin:0; font-size:14px; font-weight:600; letter-spacing:-0.01em;}
      .card-h .sub{font-size:12px; color:var(--muted);}
    
      /* KPI row */
      .kpis{display:grid; grid-template-columns:repeat(4,1fr); gap:18px;}
      .kpi .label{font-size:12.5px; color:var(--muted); font-weight:500; margin-bottom:8px; display:flex; align-items:center; gap:7px;}
      .kpi .label .ic{width:16px; height:16px; opacity:.85;}
      .kpi .val{font-family:var(--mono); font-size:30px; font-weight:600; letter-spacing:-0.02em; line-height:1;}
      .kpi .foot{display:flex; align-items:center; gap:8px; margin-top:12px;}
      .chip{display:inline-flex; align-items:center; gap:4px; font-size:12px; font-weight:600;
        padding:3px 8px; border-radius:999px; background:#eaf7f0; color:var(--green);}
      .chip svg{display:block;}
      .kpi .since{font-size:12px; color:var(--muted);}
    
      /* Main chart */
      .main-chart{flex:1;}
      .grid-line{stroke:var(--hair); stroke-width:1;}
      .axis-lbl{fill:var(--muted); font-size:11px; font-family:var(--sans);}
      .area-line{fill:none; stroke:var(--indigo); stroke-width:2.5; stroke-linecap:round; stroke-linejoin:round;}
    
      /* lower row */
      .lower{display:grid; grid-template-columns:1fr 1fr; gap:18px; flex:1; min-height:0;}
    
      /* sources bars */
      .bars{display:flex; flex-direction:column; gap:14px; margin-top:4px;}
      .bar-row{display:flex; align-items:center; gap:12px;}
      .bar-row .name{width:78px; font-size:13px; font-weight:500;}
      .bar-track{flex:1; height:14px; background:#f3f4f7; border-radius:7px; overflow:hidden;}
      .bar-fill{height:100%; width:0; border-radius:7px; transition:none;}
      .bar-row .cnt{width:54px; text-align:right; font-family:var(--mono); font-size:13px; color:var(--muted);}
    
      /* pages table */
      table{width:100%; border-collapse:collapse;}
      th{text-align:left; font-size:11px; font-weight:600; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; padding:0 0 10px;}
      td{padding:9px 0; border-top:1px solid var(--hair); font-size:13px; vertical-align:middle;}
      td.path{font-family:var(--mono); color:var(--ink);}
      td.v{font-family:var(--mono); text-align:right; color:var(--muted); width:64px;}
      .pbar-wrap{width:120px;}
      .pbar{height:8px; background:#f3f4f7; border-radius:5px; overflow:hidden;}
      .pbar span{display:block; height:100%; width:0; border-radius:5px; background:var(--teal);}
    
      /* heatmap */
      .heat{display:flex; gap:18px; align-items:center;}
      .heatgrid{display:grid; grid-template-rows:repeat(7,1fr); grid-auto-flow:column; grid-auto-columns:1fr; gap:4px;}
      .cell{width:15px; height:15px; border-radius:4px; background:#eef0f3;}
      .legend{display:flex; align-items:center; gap:6px; font-size:11px; color:var(--muted);}
      .legend .sw{width:13px; height:13px; border-radius:4px;}
    </style>
    </head>
    <body>
    <div class=&quot;app&quot;>
      <div class=&quot;topbar&quot;>
        <div class=&quot;brand&quot;>
          <span class=&quot;glyph&quot;>
            <svg width=&quot;16&quot; height=&quot;16&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;#fff&quot; stroke-width=&quot;2.4&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;><path d=&quot;M3 12h4l2.5-7 4 14 2.5-7H21&quot;/></svg>
          </span>
          Pulse
        </div>
        <nav class=&quot;nav&quot;>
          <a href=&quot;#&quot; class=&quot;active&quot;>Overview</a>
          <a href=&quot;#&quot;>Funnels</a>
          <a href=&quot;#&quot;>Retention</a>
          <a href=&quot;#&quot;>Sessions</a>
        </nav>
        <div class=&quot;spacer&quot;></div>
        <div class=&quot;pill&quot;>
          <svg width=&quot;15&quot; height=&quot;15&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;#6b7280&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;><rect x=&quot;3&quot; y=&quot;4&quot; width=&quot;18&quot; height=&quot;18&quot; rx=&quot;2&quot;/><path d=&quot;M16 2v4M8 2v4M3 10h18&quot;/></svg>
          Last 30 days
          <svg width=&quot;13&quot; height=&quot;13&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;#9aa0aa&quot; stroke-width=&quot;2.4&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;><path d=&quot;M6 9l6 6 6-6&quot;/></svg>
        </div>
        <div class=&quot;live&quot;><span class=&quot;dot&quot;></span><span class=&quot;num&quot; id=&quot;online&quot;>1,284</span> online</div>
        <div class=&quot;avatar&quot;>SM</div>
      </div>
    
      <div class=&quot;content&quot;>
        <!-- KPIs -->
        <div class=&quot;kpis&quot;>
          <div class=&quot;card kpi&quot;>
            <div class=&quot;label&quot;><svg class=&quot;ic&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;#5b5bd6&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;><circle cx=&quot;12&quot; cy=&quot;8&quot; r=&quot;4&quot;/><path d=&quot;M4 21c0-4 4-6 8-6s8 2 8 6&quot;/></svg>Visitors</div>
            <div class=&quot;val&quot; data-count=&quot;48200&quot; data-fmt=&quot;k&quot;>0</div>
            <div class=&quot;foot&quot;><span class=&quot;chip&quot;><svg width=&quot;11&quot; height=&quot;11&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;#30a46c&quot; stroke-width=&quot;3&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;><path d=&quot;M5 15l7-7 7 7&quot;/></svg>12%</span><span class=&quot;since&quot;>vs prev 30d</span></div>
          </div>
          <div class=&quot;card kpi&quot;>
            <div class=&quot;label&quot;><svg class=&quot;ic&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;#12a4a4&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;><path d=&quot;M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2&quot;/><circle cx=&quot;9&quot; cy=&quot;7&quot; r=&quot;4&quot;/><path d=&quot;M19 8v6M22 11h-6&quot;/></svg>Signups</div>
            <div class=&quot;val&quot; data-count=&quot;3910&quot; data-fmt=&quot;comma&quot;>0</div>
            <div class=&quot;foot&quot;><span class=&quot;chip&quot;><svg width=&quot;11&quot; height=&quot;11&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;#30a46c&quot; stroke-width=&quot;3&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;><path d=&quot;M5 15l7-7 7 7&quot;/></svg>8%</span><span class=&quot;since&quot;>vs prev 30d</span></div>
          </div>
          <div class=&quot;card kpi&quot;>
            <div class=&quot;label&quot;><svg class=&quot;ic&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;#f5a524&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;><path d=&quot;M3 3v18h18&quot;/><path d=&quot;M7 14l4-4 3 3 5-6&quot;/></svg>Conversion</div>
            <div class=&quot;val&quot; data-count=&quot;4.7&quot; data-fmt=&quot;pct&quot;>0</div>
            <div class=&quot;foot&quot;><span class=&quot;chip&quot;><svg width=&quot;11&quot; height=&quot;11&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;#30a46c&quot; stroke-width=&quot;3&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;><path d=&quot;M5 15l7-7 7 7&quot;/></svg>0.6pt</span><span class=&quot;since&quot;>vs prev 30d</span></div>
          </div>
          <div class=&quot;card kpi&quot;>
            <div class=&quot;label&quot;><svg class=&quot;ic&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;#e93d82&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;><path d=&quot;M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6&quot;/></svg>Revenue</div>
            <div class=&quot;val&quot; data-count=&quot;74300&quot; data-fmt=&quot;dollark&quot;>0</div>
            <div class=&quot;foot&quot;><span class=&quot;chip&quot;><svg width=&quot;11&quot; height=&quot;11&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;#30a46c&quot; stroke-width=&quot;3&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;><path d=&quot;M5 15l7-7 7 7&quot;/></svg>15%</span><span class=&quot;since&quot;>vs prev 30d</span></div>
          </div>
        </div>
    
        <!-- Main chart -->
        <div class=&quot;card main-chart&quot;>
          <div class=&quot;card-h&quot;>
            <h3>Traffic over time</h3>
            <div class=&quot;sub&quot;>Daily unique visitors · last 30 days</div>
          </div>
          <div style=&quot;height:200px;width:100%;position:relative&quot;><canvas id=&quot;trafficChart&quot;></canvas></div>
        </div>
    
        <!-- Lower -->
        <div class=&quot;lower&quot;>
          <div class=&quot;card&quot;>
            <div class=&quot;card-h&quot;><h3>Top sources</h3><div class=&quot;sub&quot;>by sessions</div></div>
            <div style=&quot;height:188px;width:100%;position:relative&quot;><canvas id=&quot;sources&quot;></canvas></div>
          </div>
          <div class=&quot;card&quot;>
            <div class=&quot;card-h&quot;><h3>Top pages</h3><div class=&quot;sub&quot;>views · 30d</div></div>
            <table>
              <thead><tr><th>Page</th><th>Views</th><th style=&quot;text-align:right&quot;>Share</th></tr></thead>
              <tbody id=&quot;pages&quot;></tbody>
            </table>
            <div class=&quot;card-h&quot; style=&quot;margin:16px 0 10px&quot;><h3 style=&quot;font-size:13px&quot;>Activity</h3><div class=&quot;legend&quot;><span>Less</span><span class=&quot;sw&quot; style=&quot;background:#eef0f3&quot;></span><span class=&quot;sw&quot; style=&quot;background:#bfe7d0&quot;></span><span class=&quot;sw&quot; style=&quot;background:#7fd0a3&quot;></span><span class=&quot;sw&quot; style=&quot;background:#30a46c&quot;></span><span class=&quot;sw&quot; style=&quot;background:#1f7a4d&quot;></span><span>More</span></div></div>
            <div class=&quot;heatgrid&quot; id=&quot;heat&quot;></div>
          </div>
        </div>
      </div>
    </div>
    
    <script src=&quot;https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js&quot;></script>
    <script>
    (function(){
      // ---- traffic data (30 days) ----
      var data=[820,910,870,1040,1180,990,1120,1260,1190,1340,1410,1280,1490,1560,1430,1620,1710,1590,1780,1850,1690,1920,2010,1880,2090,2180,2040,2260,2350,2480];
    
      // ---- traffic chart (Chart.js) ----
      if(typeof Chart!=='undefined'){
        var tctx=document.getElementById('trafficChart').getContext('2d');
        var tlabels=data.map(function(_,i){return 'Day '+(i+1);});
        var tgrad=tctx.createLinearGradient(0,0,0,200);
        tgrad.addColorStop(0,'rgba(91,91,214,0.22)');
        tgrad.addColorStop(1,'rgba(91,91,214,0)');
        new Chart(tctx,{
          type:'line',
          data:{labels:tlabels,datasets:[{
            data:data,borderColor:'#5b5bd6',borderWidth:2.5,
            backgroundColor:tgrad,fill:true,tension:0.4,
            pointRadius:0,pointHoverRadius:4,pointHoverBackgroundColor:'#5b5bd6',
            pointHoverBorderColor:'#fff',pointHoverBorderWidth:2
          }]},
          options:{
            responsive:true,maintainAspectRatio:false,
            animation:{duration:900,easing:'easeOutCubic'},
            plugins:{legend:{display:false},tooltip:{
              backgroundColor:'#15171c',padding:10,cornerRadius:8,displayColors:false,
              callbacks:{label:function(c){return c.parsed.y.toLocaleString()+' visitors';}}
            }},
            interaction:{intersect:false,mode:'index'},
            scales:{
              x:{grid:{display:false},border:{display:false},
                 ticks:{color:'#9aa0aa',font:{size:11},maxRotation:0,
                   autoSkip:false,callback:function(v,i){return [0,7,14,21,29].indexOf(i)>=0?this.getLabelForValue(v):'';}}},
              y:{grid:{color:'#ebedf1'},border:{display:false},beginAtZero:false,
                 ticks:{color:'#9aa0aa',font:{size:11},maxTicksLimit:4}}
            }
          }
        });
      }
    
      // ---- sources chart (Chart.js horizontal bar) ----
      var sources=[
        {n:'Direct', v:18420, c:'#5b5bd6'},
        {n:'Search', v:14210, c:'#12a4a4'},
        {n:'Social', v:9870, c:'#e93d82'},
        {n:'Referral', v:6340, c:'#f5a524'},
        {n:'Email', v:3920, c:'#30a46c'}
      ];
      if(typeof Chart!=='undefined'){
        var sctx=document.getElementById('sources').getContext('2d');
        new Chart(sctx,{
          type:'bar',
          data:{labels:sources.map(function(s){return s.n;}),datasets:[{
            data:sources.map(function(s){return s.v;}),
            backgroundColor:sources.map(function(s){return s.c;}),
            borderRadius:6,barThickness:18
          }]},
          options:{
            indexAxis:'y',responsive:true,maintainAspectRatio:false,
            animation:{duration:900,easing:'easeOutCubic'},
            plugins:{legend:{display:false},tooltip:{
              backgroundColor:'#15171c',padding:10,cornerRadius:8,displayColors:false,
              callbacks:{label:function(c){return c.parsed.x.toLocaleString()+' sessions';}}
            }},
            scales:{
              x:{grid:{display:false},border:{display:false},ticks:{display:false},beginAtZero:true},
              y:{grid:{display:false},border:{display:false},ticks:{color:'#15171c',font:{size:13,weight:'500'}}}
            }
          }
        });
      }
    
      // ---- pages ----
      var pages=[
        {p:'/', v:21840, pct:100},
        {p:'/pricing', v:12310, pct:56},
        {p:'/docs', v:9870, pct:45},
        {p:'/blog/launch', v:6420, pct:29},
        {p:'/signup', v:4180, pct:19}
      ];
      var pbody=document.getElementById('pages'), pbars=[];
      pages.forEach(function(pg){
        var tr=document.createElement('tr');
        tr.innerHTML='<td class=&quot;path&quot;>'+pg.p+'</td><td class=&quot;v&quot;>'+pg.v.toLocaleString()+'</td><td><div class=&quot;pbar-wrap&quot; style=&quot;margin-left:auto&quot;><div class=&quot;pbar&quot;><span></span></div></div></td>';
        pbody.appendChild(tr);
        pbars.push({el:tr.querySelector('.pbar span'),pct:pg.pct});
      });
    
      // ---- heatmap ----
      var heat=document.getElementById('heat'); var hcols=['#eef0f3','#bfe7d0','#7fd0a3','#30a46c','#1f7a4d'];
      var seed=7;
      function rnd(){seed=(seed*9301+49297)%233280;return seed/233280;}
      for(var c=0;c<10;c++){for(var r=0;r<7;r++){
        var lvl=Math.min(4,Math.floor(rnd()*rnd()*6));
        var cell=document.createElement('div'); cell.className='cell';
        cell.dataset.bg=hcols[lvl];
        heat.appendChild(cell);
      }}
    
      // ---- animation ----
      var counters=[].slice.call(document.querySelectorAll('.val[data-count]'));
      function fmt(v,type){
        if(type==='k') return (v/1000).toFixed(1).replace(/\.0$/,'')+'K';
        if(type==='dollark') return '$'+(v/1000).toFixed(1).replace(/\.0$/,'')+'K';
        if(type==='comma') return Math.round(v).toLocaleString();
        if(type==='pct') return v.toFixed(1)+'%';
        return Math.round(v);
      }
      var t0=null;
      function ease(t){return 1-Math.pow(1-t,3);}
      function frame(ts){
        if(!t0)t0=ts;
        var e=ts-t0;
        // counters ~900ms
        var cp=Math.min(1,e/900), ce=ease(cp);
        counters.forEach(function(el){
          var target=parseFloat(el.dataset.count);
          el.textContent=fmt(target*ce,el.dataset.fmt);
        });
        // page bars grow ~1000ms
        var bp=Math.min(1,e/1000), be=ease(bp);
        pbars.forEach(function(f){f.el.style.width=(f.pct*be)+'%';});
        // heatmap fade-in staggered ~1200ms
        var cells=heat.children;
        for(var i=0;i<cells.length;i++){
          var delay=i*8, prog=Math.min(1,Math.max(0,(e-delay)/300));
          if(prog>0&amp;&amp;cells[i].style.background!==cells[i].dataset.bg){
            cells[i].style.background=cells[i].dataset.bg;
            cells[i].style.opacity=1;
          }
        }
        if(e<1500) requestAnimationFrame(frame);
        else {
          counters.forEach(function(el){el.textContent=fmt(parseFloat(el.dataset.count),el.dataset.fmt);});
          pbars.forEach(function(f){f.el.style.width=f.pct+'%';});
          for(var j=0;j<heat.children.length;j++){heat.children[j].style.background=heat.children[j].dataset.bg;}
        }
      }
      requestAnimationFrame(frame);
    
      // ---- live online fluctuation ----
      var online=document.getElementById('online'), base=1284;
      setInterval(function(){
        base+=Math.round((Math.random()-0.45)*7);
        if(base<1240)base=1240; if(base>1340)base=1340;
        online.textContent=base.toLocaleString();
      },2200);
    })();
    </script>
    </body>
    </html>
    
  "></iframe>
end

**What to notice**

- KPIs + charts drawn in a `client` island
- Numbers count up and sparklines animate on load
- No build step, no framework — just the block

Every example here is a real, self-contained demo running in the page — the same shape
you'd weave and ship. Browse the [templates](/introduction/what-is-the-work-cli) the
`work new` command scaffolds to start from one.
