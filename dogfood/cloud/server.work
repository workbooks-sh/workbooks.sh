server :cloud do
  # CLI access tokens are minted through the AUTHENTICATED control-plane API (`/api/platform/tokens`,
  # Nexus.ControlPlane.Token) — the dashboard Settings page calls that, and git-push + the CLI Bearer
  # both accept it (one credential, Nexus.Auth.Cloud + Nexus.GitHttp). The old `/cloud/token` route
  # minted an Auth.Token with NO auth (default tenant) — an open token-mint hole — and was unused by the
  # dashboard, so it's removed. (Mobile device tokens still mint Auth.Token directly in dogfood/mobile.)

  # Agent chat + session history. Sessions are scoped to {tenant (org), user} — the user key comes from
  # the client's /me identity for now (req carries only tenant; threading server-derived identity into
  # req is a follow-up, after which `u` is ignored). Store is in-process (beachhead); move to a durable
  # resource for cross-restart history.
  route "GET /cloud/agent/sessions", :agent_sessions, auth: :user
  route "GET /cloud/agent/session", :agent_session, auth: :user
  route "POST /cloud/agent/chat", :agent_chat, auth: :member
  # Durable channel chat — the new model: a message is a Message ROW in a channel (not an in-process
  # session turn). The write fires a live-shapes :insert delta, so every subscriber on that channel
  # (WB.liveShapes('msgs', channel)) sees it instantly. Read is the shape snapshot, not a fetch route.
  route "POST /cloud/chat/send", :chat_send, auth: :member
  # Studio sessions are grouped by WORKSPACE (the declared subtrees) — no separate spaces store; the
  # workspace list comes from the deploy manifest (client reads WB.ws.list). A session carries a
  # `workspace` id (or none = the "General" / system-level group).

  # Launch a NAMED agent on a brief and persist a durable Run record. Non-streaming (returns the
  # final answer + run id); the Studio prefers the live SSE source `agent_run` (GET /live/agent_run)
  # for token-by-token visibility, but this is the simple fire-and-get path + what tests hit.
  route "POST /cloud/agent/run", :agent_run, auth: :member
  # The durable run ledger for the Studio Runs view — most-recent agent runs for this tenant.
  route "GET /cloud/runs", :runs_list, auth: :user

  # The personal "You" surface — the signed-in user's editable profile (resource Profile) plus their
  # REAL contribution stats, derived live from the same primitives the rest of the dashboard reads:
  # tokens burned + runs launched (resource Run), and work shipped/open (resource Todo, by author).
  # GET returns {profile, stats, contributions}; POST upserts the editable fields. Keyed by `u` (email).
  route "GET /cloud/profile", :profile_get, auth: :user
  route "POST /cloud/profile", :profile_save, auth: :user

  # Author device keys (epic wb-kodp, slice 2). One identity, many device keys — the browser, the CLI,
  # an editor, a nexus agent each register their own signing key under the user via proof-of-possession.
  route "GET /cloud/keys", :keys_list, auth: :user
  route "POST /cloud/keys", :key_register, auth: :user
  route "POST /cloud/keys/revoke", :key_revoke, auth: :user
  # Recovery (wb-13gz): an ADMIN re-attests a new device key for a locked-out member (lost all keys).
  route "POST /cloud/keys/recover", :key_recover, auth: :admin

  # Skill-KB — the inverted skill registry. Recall a capability + source skills for a topic, or author a
  # fresh targeted skill on demand. The KB is built lazily on first call (ingest the shipped corpus →
  # embed via the configured provider → cluster → harvest edges) and cached in the store.
  route "GET /cloud/skills/stats", :skills_stats, auth: :user
  route "POST /cloud/skills/recall", :skills_recall, auth: :user
  route "POST /cloud/skills/author", :skills_author, auth: :member
  route "POST /cloud/skills/build", :skills_build, auth: :admin   # (re)build the index

  # Task management + planning (the orchestration backbone). Tasks live in resource Todo; a plan is a
  # parent task + subtasks. Dispatch launches a Run (reuses do_run) and links it. Plan asks Workhorse to
  # decompose a goal into assigned subtasks. THE LINE: the store + board are ours, the bus is standard.
  route "GET /cloud/tasks", :tasks_list, auth: :user
  route "POST /cloud/tasks", :task_create, auth: :member
  route "POST /cloud/task/update", :task_update, auth: :member
  route "POST /cloud/task/dispatch", :task_dispatch, auth: :member
  route "POST /cloud/plan", :plan_create, auth: :member

  # Issues — the failure-model queue. A failed run auto-files an issue (kind="issue" Todo); agents or
  # humans can file one explicitly; the triage view separates agent- from human-filed and lets you
  # re-dispatch (assign + run a fix) or resolve. Issues ARE tasks, so update/dispatch reuse the above.
  route "GET /cloud/issues", :issues_list, auth: :user
  route "POST /cloud/issues", :issue_file, auth: :member

  # Inbox — the email-style unified feed. /cloud/inbox joins Event + Todo(issue) into semantic THREADS
  # (one subject = a run/session/issue, its events as a timeline), each carrying a server-classified
  # {semantic, severity, blame, friendly title + snippet} so the client renders meaning, never raw
  # codes. Per-user read/archive state + saved filter views back the inbox-as-mailbox feel.
  route "GET /cloud/inbox", :inbox, auth: :user
  route "POST /cloud/inbox/state", :inbox_state_set, auth: :member
  route "GET /cloud/inbox/views", :inbox_views_list, auth: :user
  route "POST /cloud/inbox/views", :inbox_view_save, auth: :member
  route "POST /cloud/inbox/views/delete", :inbox_view_delete, auth: :member

  # Autopoet management — ADMIN ONLY. The autopoet is secluded under admin: its heartbeat (on/off +
  # cadence), what it can access (managed/frozen agents, ceilings, leases), and its logs.
  route "GET /cloud/autopoet", :autopoet_status, auth: :admin
  route "POST /cloud/autopoet/heartbeat", :autopoet_heartbeat, auth: :admin
  route "POST /cloud/autopoet/run", :autopoet_run, auth: :admin

  # Scheduling — the time arm. Schedule a named agent to run on a brief at an interval/cron/time, fired
  # by Nexus.Scheduler (durable, re-armed on boot). Schedules live in resource Schedule; firing persists
  # a Run + an activity event, exactly like a manual run. Completes the tasks/runs/issues/schedules fabric.
  route "GET /cloud/schedules", :schedules_list, auth: :user
  route "POST /cloud/schedules", :schedule_create, auth: :member
  route "POST /cloud/schedule/cancel", :schedule_cancel, auth: :member

  # GitHub App webhook — GitHub POSTs pull_request/push/issues events here. We HMAC-verify the raw body
  # against GITHUB_WEBHOOK_SECRET, then emit a `github.<event>` #event onto the bus so the workflow layer
  # (reviewer/merger agent hook, fetch-back) reacts. Generic plumbing (Nexus.GitHub); policy is ours.
  route "POST /cloud/github/webhook", :github_webhook, auth: :public
  # Sanity-check the GitHub App wiring in production: is it configured, does the App JWT sign, and which
  # installations does GitHub report? Hit this after injecting the secrets to confirm everything's live.
  route "GET /cloud/github/status", :github_status, auth: :user
  # Available models for the Studio composer dropdown — live from the provider (OpenRouter), with a
  # curated fallback. No key on the nexus → the fallback set; the dropdown is never empty.
  route "GET /cloud/models", :models, auth: :user

  # Lint diagnostics for the workedit editor (P3): parse a .work buffer with the ONE shared parser
  # (Nexus.Literate) + a per-block Elixir syntax check, return line-keyed diagnostics. The editor's
  # lint source POSTs the buffer here; the parser is the open standard, the dashboard lint UI is ours.
  route "POST /cloud/parse", :parse, auth: :user

  # Workspace file tree — REAL files on the data volume. The mounts (deployed surfaces) are the
  # top-level folders; `path` walks within one. Path-traversal guarded (resolved must stay under root).
  route "GET /cloud/tree", :tree, auth: :user

  # File search across all workspaces (mounts) — filename substring match over the real data volume.
  route "GET /cloud/search", :search, auth: :user

  # Hosted apps — the workbook surfaces served by THIS nexus (org-level access: a user who's in the
  # org/nexus can launch any). The Apps tab in the sidebar renders these as a grid; Files is the
  # deeper, file-level view. Apps inherit a declared workspace's name+emoji where one exists.
  route "GET /cloud/apps", :apps, auth: :user

  # Items of a workspace — its kind-typed surfaces (agents · apps · workflows · databases · chats), built
  # from the REAL .work declarations (Nexus.Literate parse → block kind → item kind). Sub-mounts are app
  # surfaces; standalone .work files declaring agent/flow/chat/resource are those kinds; pure-infra files
  # (the workspace's own server/client dashboard) are skipped. The Studio sidebar renders these per ws.
  route "GET /cloud/items", :items, auth: :user

  # The app store — vendored OSS apps. An app is a folder `<ws>/apps/<aid>/` holding its prebuilt static
  # bundle (served by the runtime's serve_static at `/<ws>/apps/<aid>/…`, off-image, durable via the
  # workspace git repo) + an `app.work` manifest (name/entry/lane/license/source). This route DISCOVERS them.
  # (Distinct from /cloud/apps, which lists hosted SURFACES.)
  route "GET /cloud/appstore", :apps_list, auth: :user

  # Persist a drag-reorder: rewrite the workspace index.work `workspace do …` item order (custom order).
  route "POST /cloud/items/reorder", :items_reorder, auth: :member

  # The workspace's .work knowledge graph — nodes (units) + [[backlink]]/dep edges, from Nexus.Graph. The
  # Graph view renders it force-directed; agents query the same graph (why/near) for understanding.
  route "GET /cloud/graph", :graph, auth: :user

  # Phase 2 — enrich the structural graph with an LLM pass (domains + per-node summaries) and persist the
  # KnowledgeGraph. The Graph view's "Rebuild" triggers it; agents can too. Member-gated (it spends inference).
  route "POST /cloud/graph/build", :graph_build, auth: :member

  # Phase 4 — agent-queryable graph: any agent/nexus reasons over the workspace graph via these ops
  # (why = reverse deps · near = neighbourhood · search = nodes by name). The Graph view + an agent tool
  # both call this. GET ?ws=&op=why|near|search&node=<name>.
  route "GET /cloud/graph/query", :graph_query, auth: :user

  # Phase A — the FULL .work structure (not the runtime's stripped graph_summary): each node carries its
  # real exports/imports/types/calls + title; edges are the real typed relationships. The actual content.
  route "GET /cloud/graph/rich", :graph_rich, auth: :user

  # Phase E — pre-commit diff-impact: the workspace's currently-changed files (git status), so the Graph
  # view can highlight the blast radius of an in-flight change before you commit it.
  route "GET /cloud/graph/changed", :graph_changed, auth: :user

  # Real object-store sizes for THIS nexus — one bucket per mounted surface, bytes summed off the data
  # volume (same source as the `storage` Live dial). The Storage admin page reads this instead of the
  # generic platform endpoint so it shows the true amount.
  route "GET /cloud/storage", :storage, auth: :user

  # ── Data page ────────────────────────────────────────────────────────────────────────────────────
  # The Data explorer: every `resource` ("table") declared across the deploy, tenant-scoped — see
  # [[data-unit-is-resource]]. List → grouped resources + counts + tier badges. Rows → a real PAGED,
  # filtered, sorted slice (Nexus.Store.page; SQLite serves it natively). Health → the storage overview
  # (durable DB size, cold/Litestream replication, totals). Assets → media files on the volume + upload.
  route "GET /cloud/data", :data_list, auth: :user
  route "GET /cloud/data/rows", :data_rows, auth: :user
  route "GET /cloud/data/health", :data_health, auth: :user
  route "GET /cloud/assets", :assets_list, auth: :user
  route "POST /cloud/asset/upload", :asset_upload, auth: :member

  # Injected / deploy-time secrets (Fly secrets → Nexus.Secrets) — the Secrets page lists their NAMES +
  # whether each is set (present), NEVER values. Read-only, admin-only. Complements the editable
  # control-plane env store (/api/platform/env).
  route "GET /cloud/secrets/injected", :injected_secrets, auth: :admin

  # Agents defined across the mounted workbooks — the Studio "Agents" tab lists these. Read from the
  # live registry (Nexus.Agent.all, populated at bringup from each workbook's `agent` blocks).
  route "GET /cloud/agents", :agents_list, auth: :user
  # Per-org agent overrides (model + prompt) — the agent editor reads/writes these. The shipped agent
  # block is the default; an override layers on top (applied at run time). OUR cloud product, not the std.
  route "GET /cloud/agent/config", :agent_config_get, auth: :user
  route "POST /cloud/agent/config", :agent_config_save, auth: :admin

  # Workbooks Inference — our default LLM provider (Cloudflare AI Gateway, branded "Workbooks Inference").
  # Catalog of routable provider/model ids; per-org balance + default-model + caps; top-off intent.
  # THE LINE: gateway account, pricing (5% CF + 0.5% WB), and branding are OUR cloud product, not the std.
  route "GET /cloud/inference/models", :inference_models, auth: :user
  route "GET /cloud/generators", :generators, auth: :user
  route "GET /cloud/inference", :inference_status, auth: :user
  route "POST /cloud/inference/config", :inference_config_save, auth: :admin
  route "POST /cloud/inference/topup", :inference_topup, auth: :admin
  # Model-access registry — admin-curated model GROUPS (preset rules + pin/exclude) and per-modality
  # capability switches that gate AI across the whole org. Saving recomputes the resolved allow-list +
  # caps into the inference config the money-boundary gate (Nexus.Inference.Admission) enforces.
  route "GET /cloud/inference/registry", :inference_registry, auth: :user
  route "POST /cloud/inference/registry", :inference_registry_save, auth: :admin

  # Billing — Polar (merchant-of-record). Onboarding subscription checkout (tier → Polar subscription
  # product) and the Polar webhook that SETTLES purchases (credits the org inference ledger / activates
  # the subscription). The inference credit top-up shares the same webhook via product metadata. THE LINE:
  # Polar token + webhook secret are SECRETS; server + product UUIDs are OUR cloud config — the mechanism
  # (Nexus.Polar) is generic. Webhook is HMAC-verified (Standard Webhooks) and emits a billing #event.
  route "GET /cloud/billing", :billing_status, auth: :user
  route "POST /cloud/billing/checkout", :billing_checkout, auth: :admin
  route "POST /cloud/polar/webhook", :polar_webhook, auth: :public

  # Drafts + visibility (Phase 2). A draft is a REAL nexus folder gated `draft` (a per-folder permission
  # in the control plane) until promoted to `private`/`public`. Create scaffolds the folder + commits it
  # so it's a live surface; visibility sets the permission. THE LINE: folders + git are the standard; the
  # draft/visibility permission overlay is OUR product.
  route "POST /cloud/draft", :draft_create, auth: :member
  route "POST /cloud/visibility", :set_visibility, auth: :member

  # Read a single file's TEXT content for the Workspace explorer (ship 3 — read-only IDE). `path` is
  # `<mount>/<rel>`. Same mount + traversal guard as :tree. Caps at 2MB; flags binary so the client
  # falls back to /cloud/raw (images/pdf streamed with the right Content-Type).
  route "GET /cloud/file", :file_read, auth: :user
  route "GET /cloud/raw", :file_raw, auth: :user
  # Save an edit (ship 4): write the file on the volume + commit it into the workspace's repo (mirrors
  # to GitHub if configured) + recompile changed units. The git mechanism is the open standard; saving
  # from the dashboard is our product.
  route "POST /cloud/file/save", :file_save, auth: :member
  # File-tree mutations from the right-click context menu (our product). Each writes the volume + commits
  # into the workspace repo (attributed, mirrored) like :file_save. Path(s) are `<mount>/<rel>`, mount +
  # traversal guarded. The git mechanism stays the open standard; these dashboard verbs are ours.
  route "POST /cloud/file/new", :file_new, auth: :member
  route "POST /cloud/file/mkdir", :file_mkdir, auth: :member
  route "POST /cloud/file/rename", :file_rename, auth: :member
  route "POST /cloud/file/delete", :file_delete, auth: :member

  # The nexus AS a git remote (wb): per-workspace push URL + the current GitHub mirror. The git
  # mechanism (bare repo + post-receive + mirror) is the open standard (Nexus.Git / Nexus.GitHttp);
  # surfacing the URL + binding a GitHub mirror in the dashboard is OUR product.
  route "GET /cloud/workspace/git", :workspace_git, auth: :user

  # Real git branches per workspace (branches ARE environments). List / switch / create over the repo.
  route "GET /cloud/workspace/branches", :workspace_branches, auth: :user
  route "POST /cloud/workspace/checkout", :workspace_checkout, auth: :member
  route "POST /cloud/workspace/branch", :workspace_branch, auth: :member
  route "POST /cloud/workspace/mirror", :workspace_mirror, auth: :admin

  # Activity feed — our cloud product over the nexus reactive layer (THE LINE: the bus/hook/effect
  # engine is the open standard; persisting + displaying events as a "feed" is OUR consumer). The
  # `log` effect (registered in register/0) persists events to the durable `resource :Event`; this
  # route reads them back for the Activity page.
  route "GET /cloud/activity", :activity, auth: :user

  @agent_store {:cloud_agent_sessions}

  def agent_sessions(req) do
    sessions =
      sessions_for(req.tenant, user_key(req))
      |> Enum.map(fn s -> %{id: s.id, title: s.title, updated: s.updated,
                            workspace: Map.get(s, :workspace), agent: Map.get(s, :agent)} end)

    %{sessions: sessions}
  end

  def agent_session(req) do
    case Enum.find(sessions_for(req.tenant, user_key(req)), &(&1.id == (req.query["id"] || ""))) do
      nil -> {404, %{error: "not found"}}
      s -> %{id: s.id, title: s.title, messages: s.messages, workspace: Map.get(s, :workspace), agent: Map.get(s, :agent)}
    end
  end

  # The provider model catalog. Nexus.Llm.models/0 does a LIVE OpenRouter fetch every call, and the
  # Studio hit this on first paint — a slow external round-trip in the critical path. Cache it (10-min
  # TTL) so only the first load pays for it; subsequent loads are instant.
  def models(_req), do: %{models: cached_models()}

  defp cached_models do
    now = System.os_time(:second)
    case :persistent_term.get({:cloud_models_cache}, nil) do
      {ts, list} when now - ts < 600 -> list
      _ ->
        list = Nexus.Llm.models()
        :persistent_term.put({:cloud_models_cache}, {now, list})
        list
    end
  end

  # Known block kinds (generous superset) — anything else opening a do…end block is flagged.
  @work_kinds ~w(data def defp server client flow sandbox agent record resource hook check toolkit
                 test design app auth task user type deps checks theme show query workbook nexus
                 grant route trigger step match wait module schema component view)

  def parse(req) do
    content = (is_map(req.body) && req.body["content"]) || ""
    %{diagnostics: workedit_diagnostics(content)}
  end

  defp workedit_diagnostics(content) do
    nodes = try do
      Nexus.Literate.parse(content)
    rescue
      _ -> []
    end

    Enum.flat_map(List.wrap(nodes), fn
      %{type: :code} = n -> kind_diag(n) ++ syntax_diag(n)
      _ -> []
    end)
  end

  defp kind_diag(%{kind: kind, line: line}) when is_binary(kind) do
    if kind in @work_kinds, do: [], else: [%{line: line, severity: "warning", message: "Unknown block kind: #{kind}"}]
  end

  defp kind_diag(_), do: []

  # Per-block Elixir syntax check — body starts on the line AFTER the opener, so add n.line to the
  # error's in-body line. Tolerant of Elixir version differences in the error tuple shape.
  defp syntax_diag(%{lang: lang, body: body, line: base}) when lang in [nil, "elixir"] and is_binary(body) do
    case Code.string_to_quoted(body, columns: true) do
      {:ok, _} ->
        []

      {:error, {loc, msg, _token}} ->
        {l, c} = error_loc(loc)
        [%{line: base + l, col: c, severity: "error", message: error_msg(msg)}]

      _ ->
        []
    end
  end

  defp syntax_diag(_), do: []

  defp error_loc(loc) when is_list(loc), do: {Keyword.get(loc, :line, 1), Keyword.get(loc, :column, 1)}
  defp error_loc(line) when is_integer(line), do: {line, 1}
  defp error_loc(_), do: {1, 1}

  defp error_msg({a, b}), do: to_string(a) <> to_string(b)
  defp error_msg(m) when is_binary(m), do: m
  defp error_msg(m), do: inspect(m)

  # Post a durable message into a channel. Server-assigns the id + ts and derives the author from the
  # authenticated identity (never the client's word). The Store.create fires the :insert shape delta.
  def chat_send(req) do
    user = user_key(req)
    channel = (is_map(req.body) && req.body["channel"]) || ""
    body = (is_map(req.body) && req.body["body"]) || ""
    parent = (is_map(req.body) && req.body["parent"]) || ""

    if channel == "" or body == "" do
      {400, %{error: "channel and body are required"}}
    else
      id = gen_id()

      {:ok, _} =
        Nexus.Store.create(
          Message,
          %{id: id, channel: channel, author: user, body: body, parent: parent, ts: System.os_time(:millisecond)},
          req.tenant
        )

      %{id: id}
    end
  end

  def agent_chat(req) do
    user = user_key(req)
    msg = (is_map(req.body) && req.body["message"]) || ""
    id = is_map(req.body) && req.body["id"]
    model = is_map(req.body) && req.body["model"]
    agent = is_map(req.body) && req.body["agent"]
    workspace = is_map(req.body) && req.body["workspace"]
    sessions = sessions_for(req.tenant, user)
    {match, rest} = Enum.split_with(sessions, &(&1.id == id))

    session =
      case match do
        [s] -> s
        # New session: capture the chosen agent + workspace — both fixed for the session's life
        # (the composer locks both selectors once a session has any messages).
        _ -> %{id: gen_id(), title: title_from(msg), messages: [], updated: 0, agent: agent, workspace: workspace}
      end

    # Run via the session's pinned agent (existing session) or the just-chosen one (new session). Model
    # precedence: the composer's explicit pick > the agent's per-org override > nil (runtime default).
    agent_name = Map.get(session, :agent) || agent
    eff_model = (is_binary(model) and model != "" and model) || Map.get(agent_override(req.tenant, agent_name), :model)
    # Selected capabilities, clamped to what this agent admits, surfaced to the run (original msg is stored).
    sel = (is_map(req.body) && req.body["capabilities"]) || []
    sel = if is_list(sel), do: sel, else: []
    caps = Nexus.Agent.admitted(Nexus.Agent.get(agent_name), sel)
    # Attached context (files / workspaces / spaces from the composer) resolved + inlined into the brief so
    # the agent actually SEES it. Files get their (capped) contents; workspaces/spaces a scope reference.
    ctx_items = (is_map(req.body) && req.body["context"]) || []
    brief = capability_prefix(caps) <> context_brief(ctx_items) <> msg

    case run_agent(brief, eff_model, agent_name, req.tenant) do
      # Refused at the money boundary — DON'T persist a turn or bill anything; tell the client to pop the
      # credit/policy modal (admin vs member copy is decided client-side from the viewer's role).
      {:blocked, reason} ->
        %{id: session.id, title: session.title, blocked: true, reason: reason,
          reply: if(reason == "insufficient_credit", do: "Your team is out of inference credit.", else: "This request was blocked by your team's AI policy.")}

      {:ok, reply} ->
        turns = session.messages ++ [%{role: "user", text: msg}, %{role: "assistant", text: reply}]
        session = %{session | messages: turns, updated: System.os_time(:second)}
        save_sessions(req.tenant, user, [session | rest])

        # A real event onto the bus — hook :activity matches #event and the `log` effect persists it.
        Nexus.Events.emit(
          %{kind: "agent.chat", actor: user, title: session.title, target: session.id,
            tags: ["event", "agent"], scope: "member"},
          tenant: req.tenant
        )

        %{id: session.id, title: session.title, reply: reply}
    end
  end

  # Recent activity for this tenant, newest first. Members don't see admin-scoped events. Gated on the
  # SERVER-DERIVED session role (req.role), never the client's claim.
  def activity(req) do
    admin? = Nexus.Auth.role_at_least?(Map.get(req, :role, "viewer"), "admin")

    events =
      Event
      |> Nexus.Store.all(req.tenant || Nexus.Store.default_tenant())
      |> Enum.map(&Map.from_struct/1)
      |> Enum.reject(&(not admin? and &1.scope == "admin"))
      |> Enum.sort_by(& &1.at, :desc)
      |> Enum.take(200)
      |> Enum.map(fn e -> %{e | tags: String.split(e.tags || "", ",", trim: true)} end)

    %{events: events}
  end

  # Run a named agent (deck/research/workhorse/…) on a brief; persist a durable Run; return the answer.
  def agent_run(req) do
    agent = (is_map(req.body) && req.body["agent"]) || ""
    task = (is_map(req.body) && req.body["task"]) || ""
    tenant = req.tenant || Nexus.Store.default_tenant()
    user = user_key(req)

    ws = (is_map(req.body) && req.body["workspace"]) || nil

    cond do
      agent == "" or task == "" ->
        {400, %{error: "agent and task are required"}}

      is_nil(Nexus.Agent.get(agent)) ->
        {404, %{error: "no such agent: #{agent}"}}

      # Per-workspace write ACL (fix wb-913c) — an agent run that targets a workspace honors its
      # draft/private ACL, exactly like file_save and the SSE twin. Role was already gated by gate(:write).
      not workspace_write_ok?(req, ws) ->
        forbidden()

      # A GENERAL (tree-wide) agent stages + can write EVERY workspace's files, bypassing the per-workspace
      # ACL above — so running one requires admin+, not just member. Without this any member could drive
      # workhorse across the whole org. Multi-tenant only; single-tenant is the one trusted operator.
      # (red-team wb-fgg8)
      Nexus.Auth.multi?() and Nexus.Agent.general?(Nexus.Agent.get(agent)) and
          not Nexus.Auth.role_at_least?(Map.get(req, :role, "viewer"), "admin") ->
        forbidden()

      true ->
        model = (is_map(req.body) && req.body["model"]) || nil
        # Eval/dev isolation: snapshot the workspace tree before, restore after — the run leaves no trace.
        isolate = (is_map(req.body) && req.body["isolate"]) == true
        # Selected toolkit capabilities, clamped to what THIS agent admits (Workhorse :all, Autopoet :none).
        selected = (is_map(req.body) && req.body["capabilities"]) || []
        selected = if is_list(selected), do: selected, else: []
        caps = Nexus.Agent.admitted(Nexus.Agent.get(agent), selected)
        {rid, status, turns, answer} = do_run(agent, task, tenant, user, fn _ -> :ok end, workspace: ws, capabilities: caps, model: model, isolate: isolate)
        %{run: rid, agent: agent, status: status, turns: turns, answer: answer, capabilities: caps}
    end
  end

  # The durable run ledger for this tenant, newest first.
  def runs_list(req) do
    # Read-side scoping (wb-ate4): a member sees only their OWN runs; admins (and single-tenant dev) see
    # all. The prior version returned every user's run history (prompts/metering) to any caller.
    all_runs? = not Nexus.Auth.multi?() or Nexus.Auth.role_at_least?(Map.get(req, :role, "viewer"), "admin")
    uid = to_string(server_uid(req))

    runs =
      Run
      |> Nexus.Store.all(req.tenant || Nexus.Store.default_tenant())
      |> Enum.map(&Map.from_struct/1)
      |> Enum.filter(&(all_runs? or mine?(&1.user, uid)))
      |> Enum.sort_by(& &1.started, :desc)
      |> Enum.take(100)

    %{runs: runs}
  end

  # ── The "You" surface — profile + live contribution stats ──────────────────────────────────────
  # Read the folded Profile row for this user (latest by :updated), then attach REAL stats computed from
  # the durable Run + Todo stores. Nothing is faked: tokens/runs come from the agent-run ledger this very
  # person launched; "shipped" is the work they authored that reached `done`. Empty profile → sane blanks
  # the client merges over the session /me identity.
  def profile_get(req) do
    with {:ok, uid} <- auth_uid(req) do
    tenant = req.tenant || Nexus.Store.default_tenant()

    rdid = runtime_did_safe()

    %{
      profile: latest_profile(tenant, uid) || %{uid: uid},
      stats: profile_stats(tenant, uid, rdid),
      activity: profile_activity(tenant, uid, rdid),
      contributions: profile_contributions(tenant, uid),
      # The nexus's published runtime DID — the key the client expects to have counter-signed metering.
      runtime_did: rdid,
      # The user's registered device keys (slice 2) — browser/CLI/editor/agent, each a signer under them.
      keys: device_keys(tenant, uid)
    }
    else
      :error -> {401, %{error: "authentication required"}}
    end
  end

  # The PINNED trust anchor used to verify metering (fix wb-8hax) — the published Config ledger_did,
  # NOT the live running key (which an attacker-run nexus could mint + self-trust). nil ⇒ fail closed
  # (everything reads unverified). Resolved defensively so the ledger never blocks the profile rendering.
  defp runtime_did_safe do
    try do
      Nexus.Ledger.expected_did()
    rescue
      _ -> nil
    catch
      _, _ -> nil
    end
  end

  # Is this run's stored metering attestation valid AND signed by our runtime key?
  defp verified_run?(%{attest: a}, rdid) when is_binary(a) and a != "" and is_binary(rdid),
    do: Nexus.Attest.verify(Nexus.Ledger.decode(a), rdid)

  defp verified_run?(_, _), do: false

  # Upsert the editable identity layer. Append-only (write a fresh row; the fold keeps newest), matching
  # how Todo persists. Only the expressive fields are writable — name/email/role stay owned by /me.
  def profile_save(req) do
    with {:ok, uid} <- auth_uid(req) do
    tenant = req.tenant || Nexus.Store.default_tenant()
    b = if is_map(req.body), do: req.body, else: %{}

    attrs = %{
      uid: uid,
      display: to_string(b["display"] || ""),
      tagline: to_string(b["tagline"] || ""),
      bio: to_string(b["bio"] || ""),
      avatar: to_string(b["avatar"] || ""),
      accent: to_string(b["accent"] || ""),
      location: to_string(b["location"] || ""),
      links: to_string(b["links"] || ""),
      updated: System.os_time(:microsecond)
    }

    Nexus.Store.create(Profile, attrs, tenant)
    %{ok: true, profile: attrs}
    else
      :error -> {401, %{error: "authentication required"}}
    end
  end

  # ── Author device keys (slice 2) ────────────────────────────────────────────────────────────────
  # List this user's registered device keys (folded by did, newest wins; revoked rows supersede active).
  def keys_list(req) do
    case auth_uid(req) do
      :error -> {401, %{error: "authentication required"}}
      {:ok, uid} -> %{keys: device_keys(req.tenant || Nexus.Store.default_tenant(), uid)}
    end
  end

  # Register a device key under the user, gated by proof-of-possession: the client must have signed
  # Nexus.Authorship.registration_message(uid, did) with the key's private half. The session/PAT fixes
  # the uid, so a key can only be bound to the authenticated user.
  def key_register(req) do
    with {:ok, uid} <- auth_uid(req) do
    tenant = req.tenant || Nexus.Store.default_tenant()
    b = if is_map(req.body), do: req.body, else: %{}
    did = to_string(b["did"] || "")
    sig = to_string(b["sig"] || "")

    cond do
      did == "" ->
        {400, %{error: "did required"}}

      not Nexus.Authorship.verify_registration(uid, did, sig) ->
        {400, %{error: "invalid key proof"}}

      true ->
        Nexus.Store.create(
          DeviceKey,
          %{uid: uid, did: did, label: to_string(b["label"] || ""),
            surface: to_string(b["surface"] || "browser"),
            registered: System.os_time(:second), revoked: 0},
          tenant
        )

        rebuild_allowed_signers(tenant)
        %{ok: true, did: did}
    end
    else
      :error -> {401, %{error: "authentication required"}}
    end
  end

  # Revoke a device key (append a revoked row; the fold by did makes it win). Only over the user's own keys.
  def key_revoke(req) do
    with {:ok, uid} <- auth_uid(req) do
    tenant = req.tenant || Nexus.Store.default_tenant()
    b = if is_map(req.body), do: req.body, else: %{}
    did = to_string(b["did"] || "")

    case Enum.find(device_keys(tenant, uid), &(&1.did == did)) do
      nil ->
        {404, %{error: "no such key"}}

      k ->
        Nexus.Store.create(
          DeviceKey,
          %{uid: uid, did: did, label: k.label, surface: k.surface,
            registered: System.os_time(:second), revoked: 1},
          tenant
        )

        rebuild_allowed_signers(tenant)
        %{ok: true}
    end
    else
      :error -> {401, %{error: "authentication required"}}
    end
  end

  # ── Skill-KB ────────────────────────────────────────────────────────────────
  # A shared, nexus-wide knowledge base (one tenant), not per-user: the skills are common knowledge.
  @skillkb_tenant "skillkb"

  def skills_stats(_req), do: Nexus.SkillKB.Service.stats(@skillkb_tenant)

  def skills_recall(req) do
    q = skills_query(req)
    if q == "", do: {400, %{error: "query required"}}, else: Nexus.SkillKB.Service.recall(q, tenant: @skillkb_tenant)
  end

  def skills_author(req) do
    q = skills_query(req)
    if q == "", do: {400, %{error: "query required"}}, else: Nexus.SkillKB.Service.author(q, tenant: @skillkb_tenant)
  end

  def skills_build(req) do
    b = if is_map(req.body), do: req.body, else: %{}
    Nexus.SkillKB.Service.ensure_built(@skillkb_tenant, tenant: @skillkb_tenant, rebuild: b["rebuild"] == true, llm_summaries: b["llm_summaries"] == true)
  end

  defp skills_query(req) do
    b = if is_map(req.body), do: req.body, else: %{}
    (b["query"] || b["q"] || "") |> to_string() |> String.trim()
  end

  # Recover a locked-out member (wb-13gz): an ADMIN re-attests a NEW device key under the member's uid.
  # Takes BOTH the admin's authority AND proof-of-possession of the new key bound to the target — neither
  # alone suffices (Nexus.Authorship.recover_ok?). The new key then signs as that member; old keys stay
  # revoked. (Rotation = key_register a new key + key_revoke the old; no separate path needed.)
  def key_recover(req) do
    tenant = req.tenant || Nexus.Store.default_tenant()
    b = if is_map(req.body), do: req.body, else: %{}
    target = b["uid"] |> to_string() |> String.downcase()
    did = to_string(b["did"] || "")
    sig = to_string(b["sig"] || "")

    cond do
      target == "" or did == "" ->
        {400, %{error: "uid and did required"}}

      not Nexus.Authorship.recover_ok?(Map.get(req, :role, "viewer"), target, did, sig) ->
        forbidden()

      true ->
        Nexus.Store.create(
          DeviceKey,
          %{uid: target, did: did, label: to_string(b["label"] || "recovered"),
            surface: "recovery", registered: System.os_time(:second), revoked: 0},
          tenant
        )

        rebuild_allowed_signers(tenant)
        %{ok: true, uid: target, did: did}
    end
  end

  # Rebuild the deploy's allowed-signers file from EVERY live device key in the org (fix wb-i2c8): the
  # git pre-receive sig-gate verifies pushed commits against it. Best-effort — a write failure never
  # blocks key management. THE LINE: Nexus.GitSign is generic; we supply our registry's dids.
  defp rebuild_allowed_signers(tenant) do
    rows = DeviceKey |> Nexus.Store.all(tenant) |> Enum.map(&Map.from_struct/1)

    live =
      rows
      |> Enum.map(fn r -> %{did: r.did, op: (if r.revoked == 1, do: :revoke, else: :register), ts: r.registered} end)
      |> Nexus.Authorship.fold_device_keys()
      |> MapSet.new(& &1.did)

    # {owner_uid, did} per live key (fix wb-3e2y) — the allowed-signers principal is the key's owner, so
    # the git ingress binds a commit's committer to THAT owner's key, not just any registered org key.
    entries =
      rows
      |> Enum.filter(&MapSet.member?(live, &1.did))
      |> Enum.uniq_by(& &1.did)
      |> Enum.map(fn r -> {String.downcase(to_string(r.uid)), r.did} end)

    try do Nexus.GitSign.write_allowed_signers(entries) rescue _ -> :ok catch _, _ -> :ok end
  end

  # This user's device keys, folded by did (latest `registered` wins).
  defp device_keys(tenant, uid) do
    rows =
      DeviceKey
      |> Nexus.Store.all(tenant)
      |> Enum.map(&Map.from_struct/1)
      |> Enum.filter(&(String.downcase(to_string(&1.uid)) == uid))

    # Terminal revocation (fix wb-9mid): fold the rows as an event log where a revoke kills a did for
    # good — a re-register after revoke can NOT resurrect it. Then re-attach each live did's latest row
    # (label/surface) for display.
    live =
      rows
      |> Enum.map(fn r -> %{did: r.did, op: (if r.revoked == 1, do: :revoke, else: :register), ts: r.registered} end)
      |> Nexus.Authorship.fold_device_keys()
      |> MapSet.new(& &1.did)

    rows
    |> Enum.filter(&MapSet.member?(live, &1.did))
    |> Enum.group_by(& &1.did)
    |> Enum.map(fn {_did, versions} -> Enum.max_by(versions, & &1.registered) end)
    |> Enum.sort_by(& &1.registered, :desc)
    |> Enum.map(&Map.delete(&1, :id))
  end

  # The profile fold key: the signed-in email (passed as `u`, same convention as user_key), lower-cased.
  # The authenticated person key. The SERVER-DERIVED uid (req.user, set by Nexus.Auth) WINS — a client
  # `u` is only a fallback for public/dev (auth=None) with no session identity. Fix wb-q7w5: an
  # authenticated caller can no longer act as another user by passing u=victim.
  defp server_uid(req) do
    case Map.get(req, :user) do
      u when is_binary(u) and u != "" -> u
      _ -> nil
    end
  end

  defp profile_uid(req) do
    raw = server_uid(req) || (is_map(req.body) && req.body["u"]) || req.query["u"] || "anon"
    raw |> to_string() |> String.downcase()
  end

  # Authorization gate for mutating routes (wb-b0ti). Single-tenant/dev (auth=None) is trusted → allow;
  # a multi-tenant deploy enforces the action's role minimum via Nexus.Authz. Pairs with auth_uid (WHO):
  # this is WHAT a role may do. A gated handler reads `def h(req), do: gate(req, :write) && do_h(req) || ...`.
  defp gate(req, action), do: not Nexus.Auth.multi?() or Nexus.Authz.may?(Map.get(req, :role, "viewer"), action)
  defp forbidden, do: {403, %{error: "forbidden — insufficient role for this action"}}

  # Identity-scoped routes (profile, device keys) MUST act as the authenticated person — the wb-q7w5
  # deploy fix. In a multi-tenant deploy (Nexus.Auth adapter != None) a request with NO server-derived
  # user is rejected (`:error` → the handler returns 401), so a client `u=victim` can never act for
  # another user. Single-tenant/dev (auth=None, no real users) keeps the public uid so local just works.
  defp auth_uid(req) do
    case server_uid(req) do
      u when is_binary(u) and u != "" -> {:ok, String.downcase(u)}
      _ -> if Nexus.Auth.multi?(), do: :error, else: {:ok, profile_uid(req)}
    end
  end

  defp latest_profile(tenant, uid) do
    Profile
    |> Nexus.Store.all(tenant)
    |> Enum.map(&Map.from_struct/1)
    |> Enum.filter(&(String.downcase(to_string(&1.uid)) == uid))
    |> case do
      [] -> nil
      rows -> rows |> Enum.max_by(& &1.updated) |> Map.delete(:id)
    end
  end

  # Does this run/task belong to the person? EXACT uid equality only (fix wb-nw7e via Nexus.Authorship.mine?)
  # — the old loose match (local-part / literal "me") let one user claim another's contributions.
  defp mine?(value, uid),
    do: Nexus.Authorship.mine?(value |> to_string() |> String.downcase(), to_string(uid))

  defp profile_stats(tenant, uid, rdid) do
    runs =
      Run |> Nexus.Store.all(tenant) |> Enum.map(&Map.from_struct/1)
      |> Enum.filter(&mine?(&1.user, uid))

    verified = Enum.filter(runs, &verified_run?(&1, rdid))

    tasks = current_tasks(tenant) |> Enum.filter(&mine?(&1.created_by, uid))
    {done, open} = Enum.split_with(tasks, &(&1.status == "done"))

    %{
      tokens: Enum.reduce(runs, 0, &((&1.tokens || 0) + &2)),
      runs: length(runs),
      runs_ok: Enum.count(runs, &(&1.status == "ok")),
      agents: runs |> Enum.map(& &1.agent) |> Enum.uniq() |> length(),
      shipped: length(done),
      open: length(open),
      # Verified slice — runs whose metering our runtime key counter-signed (the trustworthy subset).
      verified_runs: length(verified),
      verified_tokens: Enum.reduce(verified, 0, &((&1.tokens || 0) + &2)),
      first_run: runs |> Enum.map(& &1.started) |> Enum.reject(&is_nil/1) |> Enum.min(fn -> nil end)
    }
  end

  # The GitHub-style daily activity series — one bucket per calendar day (ISO "YYYY-MM-DD"), per metric.
  # The client renders a year-long heatmap and lets you switch which metric drives the colour: tokens
  # burned & runs launched (resource Run, by start day), work shipped (resource Todo done, by update
  # day), and distinct agents driven that day. Real counts only — empty days simply don't appear.
  defp profile_activity(tenant, uid, rdid) do
    runs =
      Run |> Nexus.Store.all(tenant) |> Enum.map(&Map.from_struct/1)
      |> Enum.filter(&mine?(&1.user, uid))

    verified = Enum.filter(runs, &verified_run?(&1, rdid))

    done =
      current_tasks(tenant)
      |> Enum.filter(&(mine?(&1.created_by, uid) and &1.status == "done"))

    %{
      tokens: day_sum(runs, fn r -> {day_key(r.started), r.tokens || 0} end),
      runs: day_sum(runs, fn r -> {day_key(r.started), 1} end),
      shipped: day_sum(done, fn t -> {t.updated && day_key(div(t.updated, 1_000_000)), 1} end),
      agents: agents_by_day(runs),
      # Per-day VERIFIED overlay for the run-derived metrics — the client marks these days as attested.
      verified: %{
        tokens: day_sum(verified, fn r -> {day_key(r.started), r.tokens || 0} end),
        runs: day_sum(verified, fn r -> {day_key(r.started), 1} end),
        agents: agents_by_day(verified)
      }
    }
  end

  defp agents_by_day(runs) do
    runs
    |> Enum.group_by(fn r -> day_key(r.started) end)
    |> Enum.reject(fn {d, _} -> is_nil(d) end)
    |> Map.new(fn {d, rs} -> {d, rs |> Enum.map(& &1.agent) |> Enum.uniq() |> length()} end)
  end

  # Fold a list into %{"YYYY-MM-DD" => summed_value}, dropping anything with no resolvable day.
  defp day_sum(items, mapper) do
    Enum.reduce(items, %{}, fn it, acc ->
      case mapper.(it) do
        {nil, _} -> acc
        {k, v} -> Map.update(acc, k, v, &(&1 + v))
      end
    end)
  end

  defp day_key(nil), do: nil

  defp day_key(unix_sec) when is_integer(unix_sec) do
    case DateTime.from_unix(unix_sec) do
      {:ok, dt} -> dt |> DateTime.to_date() |> Date.to_iso8601()
      _ -> nil
    end
  end

  defp day_key(_), do: nil

  # The work this person authored, newest first — each tagged shipped|open so the client can render the
  # "systems you authored that got implemented" list directly.
  defp profile_contributions(tenant, uid) do
    current_tasks(tenant)
    |> Enum.filter(&mine?(&1.created_by, uid))
    |> Enum.sort_by(& &1.updated, :desc)
    |> Enum.take(20)
    |> Enum.map(fn t ->
      %{tid: t.tid, kind: t.kind || "task", title: t.title, status: t.status,
        agent: t.agent || "", run: t.run || "", updated: t.updated}
    end)
  end

  # Resolve a workspace (mount) name into the jj-worktree run opts the agent loop expects, or nil if no
  # workspace given / the mount is unknown. The agent's edits then commit to `agent/<agent>`, attributed.
  defp workspace_run_opts(nil, _agent, _user), do: nil
  defp workspace_run_opts("", _agent, _user), do: nil

  defp workspace_run_opts(mount, agent, _user) do
    case List.keyfind(mounts(), mount, 0) do
      {_, root} ->
        bare = Nexus.Git.bare_path(Nexus.GitHttp.repos_root(), mount)
        Nexus.Git.provision_remote(bare, root)
        %{bare: bare, work_dir: root, name: agent, author: "#{agent} <#{agent}>", branch: "agent/#{agent}"}

      _ ->
        nil
    end
  end

  # Shared run driver: streams the loop's typed events through `emit`, persists a Run row, returns a
  # summary tuple. Used by both the SSE live source (real-time) and POST /cloud/agent/run (blocking).
  defp do_run(agent, task, tenant, user, emit, opts \\ []) do
    rid = gen_id()
    started = System.os_time(:second)
    # Active capabilities (already admission-clamped) + any attached context are surfaced to the agent in
    # the brief so it leans on them — the structured injection of capability workflows is a later step.
    caps = opts[:capabilities] || []
    task = capability_prefix(caps) <> context_brief(opts[:context] || []) <> task

    emit.(%{type: "start", run: rid, agent: agent, task: task})

    # Workspace-scoped run: if opts[:workspace] names a mount, run the agent in a jj worktree of that
    # workspace (real FS) so its file edits commit to the agent's branch, attributed. Else ephemeral.
    run_opts =
      case workspace_run_opts(opts[:workspace], agent, user) do
        nil -> [emit: emit]
        ws -> [emit: emit, workspace: ws]
      end

    # Eval/dev isolation for a GENERAL run: work only in the staging copy, never sync back to prod (so
    # production is touched zero times — no provision, no remount). Threaded to Nexus.Agent.setup_vfs.
    run_opts = Keyword.put(run_opts, :isolate, opts[:isolate] == true)

    # Optional per-run model override (e.g. `work agent run --model workers-ai/@cf/…`); nil ⇒ the agent's
    # declared model / configured default.
    run_opts = if opts[:model] in [nil, ""], do: run_opts, else: Keyword.put(run_opts, :model, opts[:model])

    # Surface the active capabilities + tenant to the run so host-brokered capability commands (e.g. the
    # image/video/speak generators) can gate on / scope by them — not just the prose brief above.
    run_opts = run_opts |> Keyword.put(:capabilities, caps) |> Keyword.put(:tenant, tenant)

    result =
      try do
        Nexus.Agent.run_named(agent, task, run_opts)
      rescue
        e -> {:error, e}
      catch
        _, e -> {:error, e}
      end

    {status, turns, answer, run_tokens} =
      case result do
        {:ok, %{answer: a, turns: t} = r} -> {"ok", t, to_string(a), Map.get(r, :tokens)}
        {:error, {:timeout, t}} -> {"timeout", t, "", nil}
        # The money-boundary gate refused the run (out of credit / model not allowed / capability off).
        # A distinct "blocked" status so the client can pop the right modal instead of treating it as a crash.
        {:error, {:inference_blocked, _}} -> {"blocked", 0, "", nil}
        {:error, reason} -> {"error", 0, "run failed: #{inspect(reason)}", nil}
        _ -> {"error", 0, "", nil}
      end

    block_reason =
      case result do
        {:error, {:inference_blocked, why}} -> to_string(why)
        _ -> nil
      end

    # Prefer THIS run's correlated token total (fix wb-r0zy) — the agent loop returns it per-run. Only
    # fall back to the agent-keyed telemetry head when absent (e.g. an error before any completion).
    tokens =
      run_tokens ||
        case Nexus.Telemetry.runs(agent) do
          [%{tokens: %{total: n}} | _] -> n
          _ -> 0
        end

    ended = System.os_time(:second)

    # ── Ownership ledger (epic wb-kodp): the runtime counter-signs this run's metering so the analytics
    # are verifiable, not self-reported. The attestation is stored on the Run row (verifiable anywhere);
    # when the run produced a workspace commit, it's ALSO attached as a git note keyed by that commit —
    # the content-addressed, Radicle-native anchor.
    attest =
      sign_run_meter(
        %{run: rid, agent: agent, user: user, model: to_string(opts[:model] || ""),
          tokens: tokens, turns: turns, status: status, started: started, ended: ended},
        run_opts
      )

    # Attribute the run to the AGENT's signing identity (wb-kxfa) — a stable, self-verifying did:key
    # (Nexus.AgentId.of?(author, agent) re-derives it), so agent authorship is a cryptographic fact,
    # not an anonymous string. Distinct from `user` (who launched it) and the runtime-signed `attest`.
    Nexus.Store.create(
      Run,
      %{rid: rid, agent: agent, user: user, task: String.slice(task, 0, 500), status: status,
        turns: turns, tokens: tokens, answer: String.slice(answer, 0, 2000),
        started: started, ended: ended, attest: attest, author: Nexus.AgentId.did(agent)},
      tenant
    )

    # Surface the run on the activity bus too (Studio Activity + any hook can react).
    Nexus.Events.emit(
      %{kind: "agent.run", actor: user, title: "#{agent}: #{title_from(task)}", target: rid,
        tags: ["event", "agent"], scope: "member"},
      tenant: tenant
    )

    # Debit the org's inference ledger for what this run actually spent (tokens × model rate). Best-effort
    # and idempotent-safe; admission already pre-gated on a positive balance, this settles the real cost.
    if status == "ok" and tokens && tokens > 0 do
      # `@inference_default_model` is defined later in the module (textually below do_run), so don't read
      # it here — a nil model just means run_cost finds no catalog match and debits 0 (safe).
      model = to_string(opts[:model] || inference_config(tenant)[:default_model] || "")
      Nexus.Inference.Admission.charge(tenant, run_cost(model, tokens))
    end

    # Close the run stream FIRST — the failure-model issue (and its cheap-model title summary, which can
    # take a second) must never delay the client's `done`. `reason` carries the block cause when gated.
    emit.(%{type: "done", run: rid, status: status, turns: turns, tokens: tokens, reason: block_reason})

    # The failure model: instead of crashing or blindly retrying, a failed run FILES AN ISSUE that a
    # human or another agent can pick up. A "blocked" run is NOT a glitch (it's expected billing gating),
    # so it never files an issue. `file_issue: false` (dispatch path) opts out where the task already tracks it.
    if status not in ["ok", "blocked"] and Keyword.get(opts, :file_issue, true) do
      # Store a clean cheap-model subject as the title (falls back to a template if CF is unreachable);
      # the Inbox then shows "We hit a glitch…" as the headline and this gist as the preview line.
      file_issue(tenant, %{
        title: summarize_title(task) || title_from(task),
        detail: "Agent #{agent} could not complete the task.\n\nTask: #{String.slice(task, 0, 400)}\n\nOutcome (#{status}): #{String.slice(answer, 0, 600)}",
        agent: agent, run: rid, created_by: agent
      })
    end

    {rid, status, turns, answer}
  end

  # Counter-sign a run's metering with the nexus runtime key and return the encoded attestation (or "").
  # Best-effort: any failure (no key, git absent) degrades to "" — a run is never blocked by the ledger.
  # When the run had a workspace, also anchor the attestation as a git note on the branch's new HEAD.
  defp sign_run_meter(fields, run_opts) do
    try do
      {:ok, att} = {:ok, Nexus.Attest.sign(Nexus.Ledger.runtime_key(), fields)}
      encoded = Nexus.Ledger.encode(att)

      with %{bare: bare, branch: branch} <- run_opts[:workspace],
           {sha, 0} <- System.cmd("git", ["--git-dir=#{bare}", "rev-parse", branch], stderr_to_stdout: true) do
        Nexus.Git.add_note(bare, String.trim(sha), encoded)
      end

      encoded
    rescue
      _ -> ""
    catch
      _, _ -> ""
    end
  end

  # ── Task management + planning ───────────────────────────────────────────────────────────────────
  # Tasks are stored append-only (resource Todo has no in-place update); the CURRENT state of a task is
  # the row with its tid and the newest `updated`. current_tasks/1 folds the log to live state.
  # NOTE: the resource is `Todo`, NOT `Task` — `Task` is Elixir's stdlib concurrency module (the web
  # server's socket acceptors spawn through `Task.start_link/3`); a workbook resource named `Task`
  # compiled to `Elixir.Task` and clobbered it, killing nexus boot. `Nexus.Uid.guard/1` now refuses
  # any unit name that would shadow a runtime-critical module.
  defp current_tasks(tenant) do
    Todo
    |> Nexus.Store.all(tenant)
    |> Enum.map(&Map.from_struct/1)
    |> Enum.group_by(& &1.tid)
    |> Enum.map(fn {_tid, versions} -> Enum.max_by(versions, & &1.updated) end)
    |> Enum.reject(&(&1.status == "cancelled"))
    |> Enum.map(fn t -> Map.put(t, :kind, t.kind || "task") end)
  end

  defp latest_task(tenant, tid), do: Enum.find(current_tasks(tenant), &(&1.tid == tid))

  # Persist a task version (create or fold-update). Always writes a NEW row; the fold picks the newest
  # by `updated`. `updated` is microseconds (monotone within a second) and is FORCED fresh here so a
  # fold-update of an existing row (which already carries an older :updated) can't keep the stale one.
  defp put_task(tenant, attrs) do
    now = System.os_time(:microsecond)
    attrs = Map.put(attrs, :updated, now)
    Nexus.Store.create(Todo, attrs, tenant)
    persist_task_file(attrs)
    Nexus.Events.emit(
      %{kind: "task.#{attrs[:status] || "update"}", actor: to_string(attrs[:created_by] || "system"),
        title: to_string(attrs[:title] || attrs[:tid]), target: to_string(attrs[:tid]),
        tags: ["event", "task"], scope: "member"},
      tenant: tenant
    )
    attrs
  end

  # Git-backed store (wb-xxks): the SOURCE OF TRUTH for a task/issue is a committed `.work` file at
  # `<home-workspace>/.nexus/{tasks,issues}/<tid>.work` — versioned, jj-covered, diffable. The SQLite
  # rows stay the fast READ index (write-through). Gated on jj-substrate + best-effort: off / no mount /
  # any error → SQLite-only (the board never breaks). Commit attributed to whoever filed it.
  defp persist_task_file(attrs) do
    with true <- Nexus.JJ.substrate?(),
         {mount, root} when is_binary(mount) <- home_ws() do
      sub = if attrs[:kind] == "issue", do: "issues", else: "tasks"
      rel = ".nexus/#{sub}/#{attrs[:tid]}.work"
      abs = Path.join(root, rel)
      File.mkdir_p!(Path.dirname(abs))
      File.write!(abs, task_to_work(attrs))
      bare = Nexus.Git.bare_path(Nexus.GitHttp.repos_root(), mount)
      Nexus.Git.provision_remote(bare, root)
      who = to_string(attrs[:created_by] || "system")
      Nexus.Git.commit_file(bare, root, rel, "#{sub}/#{attrs[:tid]}: #{attrs[:status]}", author: "#{who} <#{who}>")
    else
      _ -> :skip
    end
  rescue
    _ -> :skip
  end

  # The home workspace tasks/issues live under (first mount). nil if none mounted.
  defp home_ws, do: List.first(mounts())

  # Render a task/issue to its `.work` source of truth — prose (title + detail) + a `task` block of the
  # structured fields. The block is the canonical record; the SQLite index is rebuildable from it.
  defp task_to_work(t) do
    title = (t[:title] || t[:tid] || "") |> to_string() |> String.replace("\n", " ")
    """
    # #{title} ##{t[:kind] || "task"}

    #{t[:detail] || ""}

    task :#{t[:tid]} do
      kind "#{t[:kind] || "task"}"
      status "#{t[:status]}"
      agent "#{t[:agent] || ""}"
      parent "#{t[:parent] || ""}"
      priority #{t[:priority] || 2}
      created_by "#{t[:created_by] || ""}"
      run "#{t[:run] || ""}"
      created #{t[:created] || 0}
    end
    """
  end

  # Parse a task `.work` file back to a field map (for index rebuild / round-trip). Reads the `task`
  # block's `field "value"` / `field 123` lines.
  defp work_to_task(content) do
    case Nexus.Literate.parse(content) |> Enum.find(&(&1.type == :code)) do
      %{name: tid, body: body} ->
        fields =
          Regex.scan(~r/^\s*([a-z_]+)\s+(?:"([^"]*)"|(\d+))\s*$/m, body)
          |> Map.new(fn
            # scan trims the trailing empty group: quoted → [_, k, s]; number → [_, k, "", n].
            [_, k, s] -> {String.to_atom(k), s}
            [_, k, s, ""] -> {String.to_atom(k), s}
            [_, k, "", n] -> {String.to_atom(k), String.to_integer(n)}
          end)

        Map.put(fields, :tid, to_string(tid))

      _ ->
        nil
    end
  end

  def tasks_list(req) do
    tenant = req.tenant || Nexus.Store.default_tenant()
    tasks = current_tasks(tenant) |> Enum.reject(&(&1.kind == "issue"))
      |> Enum.sort_by(&{&1.priority || 2, -(&1.updated || 0)})
    %{tasks: tasks}
  end

  # The issue queue — tasks of kind "issue" (filed by a failed run or explicitly by an agent/human).
  # Newest first; the triage view separates agent-filed from human-filed by created_by.
  def issues_list(req) do
    tenant = req.tenant || Nexus.Store.default_tenant()
    agents = Nexus.Agent.all() |> Enum.map(&Nexus.Agent.def_from_unit(&1).name) |> MapSet.new()
    issues =
      current_tasks(tenant)
      |> Enum.filter(&(&1.kind == "issue"))
      |> Enum.sort_by(&(-(&1.updated || 0)))
      |> Enum.map(fn i -> Map.put(i, :by, if(MapSet.member?(agents, i.created_by), do: "agent", else: "human")) end)
    %{issues: issues}
  end

  # File an issue (a kind="issue" Todo). Used by the failure model (auto-filed on a failed run) and
  # available as an explicit endpoint. `run` links the failing/relevant run.
  def issue_file(req) do
    b = req.body || %{}
    if to_string(b["title"] || "") == "" do
      {400, %{error: "title is required"}}
    else
      issue = file_issue(req.tenant || Nexus.Store.default_tenant(), %{
        title: String.slice(to_string(b["title"]), 0, 160), detail: to_string(b["detail"] || ""),
        agent: to_string(b["agent"] || ""), run: to_string(b["run"] || ""), created_by: user_key(req)
      })
      %{issue: issue}
    end
  end

  defp file_issue(tenant, attrs) do
    now = System.os_time(:second)
    put_task(tenant, Map.merge(%{
      tid: gen_id(), kind: "issue", status: "open", agent: "", parent: "", priority: 1,
      run: "", created: now, title: "", detail: "", created_by: "system"
    }, attrs))
  end

  # ── Inbox — the email-style unified feed ─────────────────────────────────────────────────────────
  # /cloud/inbox folds the raw Event log + the issue queue into semantic THREADS. A thread is one
  # SUBJECT (a run / a chat session / an issue) with its events as a timeline; the server CLASSIFIES it
  # into {semantic, severity, blame, friendly title + snippet} so the client renders meaning, never the
  # raw run-id / FunctionClauseError / task-prompt that used to leak to the top. Per-user read/archive
  # state (resource InboxState) makes it behave like a mailbox. Members never see admin-scoped threads.
  def inbox(req) do
    tenant = req.tenant || Nexus.Store.default_tenant()
    uid = user_key(req)
    admin? = Nexus.Auth.role_at_least?(Map.get(req, :role, "viewer"), "admin")

    events =
      Event
      |> Nexus.Store.all(tenant)
      |> Enum.map(&Map.from_struct/1)
      |> Enum.reject(&(not admin? and &1.scope == "admin"))

    issues = current_tasks(tenant) |> Enum.filter(&(&1.kind == "issue"))
    issue_by_tid = Map.new(issues, &{&1.tid, &1})
    state = inbox_state_for(tenant, uid)

    ev_groups = Enum.group_by(events, &event_subject(&1, issue_by_tid))
    iss_groups = Enum.group_by(issues, &issue_subject/1)
    subjects = (Map.keys(ev_groups) ++ Map.keys(iss_groups)) |> Enum.uniq()

    threads =
      subjects
      |> Enum.map(fn subj ->
        evs = Map.get(ev_groups, subj, []) |> Enum.sort_by(& &1.at)
        iss = case Map.get(iss_groups, subj, []) do
          [] -> nil
          list -> Enum.max_by(list, &(&1.updated || 0))
        end
        build_thread(subj, evs, iss, Map.get(state, subj, %{}))
      end)
      |> Enum.reject(&(&1.archived and not &1.needs_you))
      |> Enum.sort_by(&{(if &1.needs_you, do: 0, else: 1), -&1.at})

    %{threads: threads, views: inbox_views_for(tenant, uid)}
  end

  defp build_thread(subject, evs, iss, st) do
    last = List.last(evs) || %{}
    iss_at = if iss, do: (iss.updated && div(iss.updated, 1_000_000)) || iss.created || 0, else: 0
    at = max(last[:at] || 0, iss_at)
    c = classify_thread(evs, iss)
    timeline = Enum.map(evs, fn e -> %{kind: e.kind, actor: e.actor, at: e.at, label: timeline_label(e)} end)
    needs_you = c.needs_you and st[:cleared] != 1

    %{
      subject: subject, semantic: c.semantic, severity: c.severity, blame: c.blame,
      title: c.title, snippet: c.snippet, actor: c.actor, at: at,
      needs_you: needs_you, read: st[:read] == 1, archived: st[:archived] == 1,
      timeline: timeline,
      tech: %{run: (iss && iss.run) || subject_run(subject), detail: iss && iss.detail,
              tid: iss && iss.tid, status: iss && iss.status}
    }
  end

  # The semantic classifier — raw kinds + outcomes → operator-facing meaning. Pure + deterministic (no
  # model on the hot path); the friendly copy lives here so the CLI/mobile can reuse it later.
  defp classify_thread(evs, iss) do
    last = List.last(evs) || %{}
    actor = (iss && iss.created_by) || last[:actor] || "system"

    cond do
      iss && iss.status != "done" ->
        blame = blame_of(iss.detail)
        %{semantic: "needs_you", blame: blame, actor: actor, needs_you: true,
          severity: (if blame == "task", do: "med", else: "high"),
          title: fail_title(iss.agent, blame), snippet: (issue_gist(iss) || fail_snippet(blame))}

      iss && iss.status == "done" ->
        %{semantic: "resolved", blame: blame_of(iss.detail), actor: actor, needs_you: false,
          severity: "low", title: "Resolved — #{agent_name(iss.agent)}",
          snippet: "This was handled. Nothing needed from you."}

      true ->
        kind = last[:kind] || "event"
        base = %{blame: nil, actor: actor, needs_you: false, severity: "low"}
        info =
          cond do
            String.starts_with?(kind, "agent.run") ->
              %{semantic: "run_done", title: "#{agent_name(last[:actor])} finished a task",
                snippet: clean_subject(last[:title])}
            String.starts_with?(kind, "agent.chat") ->
              %{semantic: "chat", title: "Chat — #{clean_subject(last[:title])}",
                snippet: "A conversation with your agent."}
            String.starts_with?(kind, "task.") ->
              %{semantic: "task", title: clean_subject(last[:title]), snippet: "A task on the board moved."}
            String.starts_with?(kind, "workspace.") ->
              %{semantic: "change", title: "#{actor} edited files", snippet: "Workspace changes were saved."}
            String.starts_with?(kind, "github.") ->
              %{semantic: "connected", title: "GitHub — #{clean_subject(last[:title])}",
                snippet: "An update from a connected repository."}
            String.starts_with?(kind, "billing.") ->
              %{semantic: "billing", title: "Billing — #{clean_subject(last[:title])}",
                snippet: "A change to your plan or usage."}
            true ->
              %{semantic: "event", title: clean_subject(last[:title] || kind), snippet: ""}
          end
        Map.merge(base, info)
    end
  end

  # Whose fault was the failure? internal = our platform bug (an Elixir exception leaked), input = the
  # agent waits on a human, task = the agent genuinely couldn't complete. Drives copy + severity.
  defp blame_of(detail) do
    d = to_string(detail)
    cond do
      d =~ ~r/needs (your|human) (input|decision)/i -> "input"
      d =~ ~r/\(timeout\)/i -> "task"
      d =~ ~r/(%\w*Error\{|\*\* \(|FunctionClauseError|no function clause|ArgumentError|KeyError)/ -> "internal"
      true -> "task"
    end
  end

  defp fail_title(agent, "internal"), do: "We hit a glitch running #{agent_name(agent)}"
  defp fail_title(agent, "input"), do: "#{agent_name(agent)} needs your input"
  defp fail_title(agent, _), do: "#{agent_name(agent)} couldn’t finish a task"

  defp fail_snippet("internal"), do: "Something on our end interrupted the run. Re-dispatch to try again."
  defp fail_snippet("input"), do: "The agent is waiting on a decision from you."
  defp fail_snippet(_), do: "The agent stopped before finishing. Re-dispatch to retry, or resolve."

  # The clean task gist stored on a freshly-filed issue (the cheap-model subject). nil for legacy issues
  # whose title is still our raw "Run failed: …" string, so the caller falls back to the generic snippet.
  defp issue_gist(iss) do
    t = to_string(iss.title || "")
    cond do
      t == "" -> nil
      String.starts_with?(t, "Run failed:") -> nil
      true -> clean_subject(t)
    end
  end

  # A short, plain inbox subject for a task, via a cheap Workers AI model (Cloudflare AI Gateway — the
  # prod-ready CF path). Best-effort: any failure (CF secret absent, timeout, empty) returns nil and the
  # caller uses the deterministic template, so the feed never depends on the model being reachable.
  defp summarize_title(text) do
    txt = String.slice(to_string(text), 0, 600)
    if String.trim(txt) == "" do
      nil
    else
      case Nexus.Llm.complete(
        [%{role: "system", content: "Rewrite the user's task as a short, plain inbox subject line of at most 8 words. No quotes, no trailing period, no preamble — output only the subject."},
         %{role: "user", content: txt}],
        model: cheap_model(), timeout: 8_000, retries: 0, max_tokens: 24
      ) do
        {:ok, %{content: c}} when is_binary(c) and c != "" ->
          c |> String.trim() |> String.replace(~r/\A["']+|["'.]+\z/u, "") |> String.slice(0, 80)
        _ -> nil
      end
    end
  rescue
    _ -> nil
  catch
    _, _ -> nil
  end

  defp cheap_model, do: "workers-ai/@cf/meta/llama-3.1-8b-instruct-fast"

  defp agent_name(""), do: "An agent"
  defp agent_name(nil), do: "An agent"
  defp agent_name(a), do: to_string(a)

  defp clean_subject(t) do
    to_string(t || "")
    |> String.replace(~r/^Run failed:\s*\S+\s*—\s*/u, "")
    |> String.replace(~r/^\S+:\s*/u, "")
    |> String.trim()
    |> String.slice(0, 80)
  end

  defp timeline_label(e) do
    k = to_string(e[:kind] || "")
    cond do
      String.starts_with?(k, "agent.run") -> "ran"
      String.starts_with?(k, "agent.chat") -> "chatted"
      k == "task.open" -> "filed"
      k == "task.done" -> "resolved"
      String.starts_with?(k, "task.") -> "updated"
      String.starts_with?(k, "workspace.") -> "edited files"
      true -> clean_subject(e[:title]) |> String.slice(0, 40)
    end
  end

  # Subject correlation — a run's filed issue, the run event, and the run share ONE subject (the rid), so
  # they collapse into a single thread. Task events on an issue map to that issue's subject.
  defp event_subject(e, issue_by_tid) do
    t = to_string(e.target || "")
    cond do
      Map.has_key?(issue_by_tid, t) -> issue_subject(issue_by_tid[t])
      t != "" -> t
      true -> "kind:" <> to_string(e.kind || "event")
    end
  end

  defp issue_subject(iss), do: (if to_string(iss.run || "") != "", do: to_string(iss.run), else: to_string(iss.tid))
  defp subject_run("kind:" <> _), do: nil
  defp subject_run(s), do: s

  # Fold InboxState to live per-user state: %{subject => %{read, archived, cleared}}.
  defp inbox_state_for(tenant, uid) do
    InboxState
    |> Nexus.Store.all(tenant)
    |> Enum.map(&Map.from_struct/1)
    |> Enum.filter(&(&1.uid == uid))
    |> Enum.group_by(& &1.subject)
    |> Map.new(fn {subj, rows} ->
      r = Enum.max_by(rows, &(&1.updated || 0))
      {subj, %{read: r.read, archived: r.archived, cleared: r.cleared}}
    end)
  end

  def inbox_state_set(req) do
    b = req.body || %{}
    subject = to_string(b["subject"] || "")
    if subject == "" do
      {400, %{error: "subject is required"}}
    else
      tenant = req.tenant || Nexus.Store.default_tenant()
      uid = user_key(req)
      cur = Map.get(inbox_state_for(tenant, uid), subject, %{read: 0, archived: 0, cleared: 0})
      Nexus.Store.create(InboxState, %{
        uid: uid, subject: subject,
        read: bit(b["read"], cur[:read]),
        archived: bit(b["archived"], cur[:archived]),
        cleared: bit(b["cleared"], cur[:cleared]),
        updated: System.os_time(:microsecond)
      }, tenant)
      %{ok: true}
    end
  end

  defp bit(nil, prev), do: prev || 0
  defp bit(true, _), do: 1
  defp bit(false, _), do: 0
  defp bit(1, _), do: 1
  defp bit(0, _), do: 0
  defp bit(_, prev), do: prev || 0

  # ── Saved views — the funnel presets. Ships defaults in code; a user's own views override by name. ──
  defp default_views do
    [
      %{name: "Needs you", icon: "star", emoji: "★", filters: "status=needs_you", position: 0, builtin: true},
      %{name: "Sessions", icon: "clock", emoji: "◷", filters: "semantic=run_done,chat", position: 1, builtin: true},
      %{name: "Changes & deploys", icon: "edit", emoji: "✎", filters: "semantic=change", position: 2, builtin: true},
      %{name: "Customer & billing", icon: "card", emoji: "❡", filters: "semantic=billing,connected", position: 3, builtin: true}
    ]
  end

  defp inbox_views_for(tenant, uid) do
    saved =
      SavedView
      |> Nexus.Store.all(tenant)
      |> Enum.map(&Map.from_struct/1)
      |> Enum.filter(&(&1.uid == uid))
      |> Enum.group_by(& &1.name)
      |> Enum.map(fn {_n, rows} -> Enum.max_by(rows, &(&1.updated || 0)) end)
      |> Enum.reject(&(to_string(&1.filters) == "__deleted__"))
      |> Enum.map(&%{name: &1.name, emoji: &1.emoji, filters: &1.filters, position: &1.position, builtin: false})

    names = MapSet.new(saved, & &1.name)
    (Enum.reject(default_views(), &MapSet.member?(names, &1.name)) ++ saved)
    |> Enum.sort_by(&(&1.position || 99))
  end

  def inbox_views_list(req) do
    %{views: inbox_views_for(req.tenant || Nexus.Store.default_tenant(), user_key(req))}
  end

  def inbox_view_save(req) do
    b = req.body || %{}
    name = String.slice(to_string(b["name"] || ""), 0, 60)
    if name == "" do
      {400, %{error: "name is required"}}
    else
      tenant = req.tenant || Nexus.Store.default_tenant()
      Nexus.Store.create(SavedView, %{
        uid: user_key(req), name: name, emoji: to_string(b["emoji"] || "▦"),
        filters: to_string(b["filters"] || ""), position: b["position"] || 10,
        updated: System.os_time(:microsecond)
      }, tenant)
      %{views: inbox_views_for(tenant, user_key(req))}
    end
  end

  def inbox_view_delete(req) do
    b = req.body || %{}
    name = to_string(b["name"] || "")
    tenant = req.tenant || Nexus.Store.default_tenant()
    if name != "" do
      Nexus.Store.create(SavedView, %{
        uid: user_key(req), name: name, emoji: "", filters: "__deleted__",
        position: 99, updated: System.os_time(:microsecond)
      }, tenant)
    end
    %{views: inbox_views_for(tenant, user_key(req))}
  end

  def task_create(req) do
    b = req.body || %{}
    title = b["title"] || ""
    if title == "" do
      {400, %{error: "title is required"}}
    else
      now = System.os_time(:second)
      task = put_task(req.tenant || Nexus.Store.default_tenant(), %{
        tid: gen_id(), kind: "task", title: String.slice(title, 0, 160), detail: to_string(b["detail"] || ""),
        status: "open", agent: to_string(b["agent"] || ""), parent: to_string(b["parent"] || ""),
        priority: b["priority"] || 2, created_by: user_key(req), run: "", created: now
      })
      %{task: task}
    end
  end

  def task_update(req) do
    b = req.body || %{}
    tenant = req.tenant || Nexus.Store.default_tenant()
    case latest_task(tenant, b["tid"] || "") do
      nil -> {404, %{error: "no such task"}}
      cur ->
        merged = cur
          |> maybe_put(:status, b["status"])
          |> maybe_put(:agent, b["agent"])
          |> maybe_put(:priority, b["priority"])
          |> maybe_put(:title, b["title"])
          |> maybe_put(:detail, b["detail"])
        %{task: put_task(tenant, merged)}
    end
  end

  defp maybe_put(map, _key, nil), do: map
  defp maybe_put(map, key, val), do: Map.put(map, key, val)

  # Dispatch a task: launch its assignee agent on the brief (reusing do_run), link the run, set status.
  def task_dispatch(req) do
    tenant = req.tenant || Nexus.Store.default_tenant()
    case latest_task(tenant, (req.body || %{})["tid"] || "") do
      nil -> {404, %{error: "no such task"}}
      cur ->
        agent = cur.agent
        cond do
          agent == "" -> {400, %{error: "task has no assignee — assign an agent first"}}
          is_nil(Nexus.Agent.get(agent)) -> {400, %{error: "assignee '#{agent}' is not a known agent"}}
          true ->
            put_task(tenant, Map.merge(cur, %{status: "in_progress"}))
            brief = if(cur.detail != "", do: "#{cur.title}\n\n#{cur.detail}", else: cur.title)
            {rid, status, _turns, _answer} = do_run(agent, brief, tenant, user_key(req), fn _ -> :ok end, file_issue: false)
            final = if status == "ok", do: "done", else: "blocked"
            task = put_task(tenant, Map.merge(cur, %{status: final, run: rid}))
            %{task: task, run: rid, run_status: status}
        end
    end
  end

  # Plan-with-Workhorse: decompose a goal into a parent task + assigned subtasks. Workhorse emits strict lines
  # we parse; the assignees are constrained to the registered agents.
  def plan_create(req) do
    tenant = req.tenant || Nexus.Store.default_tenant()
    goal = (req.body || %{})["goal"] || ""
    if goal == "" do
      {400, %{error: "goal is required"}}
    else
      agents = Nexus.Agent.all() |> Enum.map(&Nexus.Agent.def_from_unit(&1).name)
      list = Enum.join(agents, ", ")
      prompt = """
      Decompose this goal into 3 to 7 concrete subtasks. Assign each to the best agent.
      Output ONLY one line per subtask, EXACTLY in this format and nothing else:
      TASK | <assignee> | <title>
      where <assignee> is one of: #{list}.

      GOAL: #{goal}
      """

      subtasks =
        case Nexus.Agent.run_named("workhorse", prompt) do
          {:ok, %{answer: a}} when is_binary(a) -> parse_plan(a, agents)
          _ -> []
        end

      now = System.os_time(:second)
      pid = gen_id()
      parent = put_task(tenant, %{tid: pid, title: String.slice(goal, 0, 160), detail: "Plan",
        status: "open", agent: "workhorse", parent: "", priority: 1, created_by: user_key(req), run: "", created: now})

      children =
        Enum.map(subtasks, fn {assignee, title} ->
          put_task(tenant, %{tid: gen_id(), title: title, detail: "", status: "open", agent: assignee,
            parent: pid, priority: 2, created_by: "workhorse", run: "", created: now})
        end)

      %{plan: parent, subtasks: children}
    end
  end

  # Parse Workhorse's plan lines: `TASK | <assignee> | <title>`. Assignee must be a known agent.
  defp parse_plan(text, agents) do
    text
    |> String.split("\n", trim: true)
    |> Enum.flat_map(fn line ->
      case String.split(line, "|") do
        [tag, who, title | _] ->
          if String.contains?(tag, "TASK") do
            a = who |> String.trim() |> String.downcase()
            a = if(a in agents, do: a, else: "workhorse")
            [{a, String.trim(title) |> String.slice(0, 160)}]
          else
            []
          end
        _ -> []
      end
    end)
  end

  # ── Scheduling ───────────────────────────────────────────────────────────────────────────────────
  @sched_modes ~w(every cron at after)

  defp current_schedules(tenant) do
    Schedule
    |> Nexus.Store.all(tenant)
    |> Enum.map(&Map.from_struct/1)
    |> Enum.group_by(& &1.sid)
    |> Enum.map(fn {_sid, vs} -> Enum.max_by(vs, & &1.created) end)
    |> Enum.filter(&(&1.enabled == 1))
  end

  def schedules_list(req) do
    %{schedules: current_schedules(req.tenant || Nexus.Store.default_tenant()) |> Enum.sort_by(&(-(&1.created || 0)))}
  end

  def schedule_create(req) do
    b = req.body || %{}
    tenant = req.tenant || Nexus.Store.default_tenant()
    agent = to_string(b["agent"] || "")
    task = to_string(b["task"] || "")
    mode = to_string(b["mode"] || "")
    spec = to_string(b["spec"] || "")

    cond do
      agent == "" or task == "" or spec == "" -> {400, %{error: "agent, task and spec are required"}}
      mode not in @sched_modes -> {400, %{error: "mode must be one of: #{Enum.join(@sched_modes, ", ")}"}}
      is_nil(Nexus.Agent.get(agent)) -> {404, %{error: "no such agent: #{agent}"}}
      true ->
        sched = %{sid: gen_id(), agent: agent, task: task, mode: mode, spec: spec,
                  owner: user_key(req), created: System.os_time(:second), enabled: 1}
        Nexus.Store.create(Schedule, sched, tenant)
        case arm_schedule(tenant, sched) do
          :ok -> %{schedule: sched}
          {:error, e} -> {400, %{error: "bad time spec: #{inspect(e)}"}}
        end
    end
  end

  def schedule_cancel(req) do
    tenant = req.tenant || Nexus.Store.default_tenant()
    sid = (req.body || %{})["sid"] || ""
    case Enum.find(current_schedules(tenant), &(&1.sid == sid)) do
      nil -> {404, %{error: "no such schedule"}}
      s ->
        Nexus.Scheduler.disarm("sched:#{sid}", tenant: tenant)
        Nexus.Store.create(Schedule, %{s | enabled: 0, created: System.os_time(:second)}, tenant)
        %{ok: true}
    end
  end

  # Arm one schedule into Nexus.Scheduler. The fired effect (scheduled_run, registered in register/0)
  # runs the agent + persists a Run. Returns :ok | {:error, reason}.
  defp arm_schedule(tenant, %{sid: sid, agent: agent, task: task, mode: mode, spec: spec}) do
    mode_atom = case mode do
      "every" -> :every
      "cron" -> :cron
      "at" -> :at
      "after" -> :after
      _ -> :every
    end
    time = [{mode_atom, spec}]
    effects = [%{name: "scheduled_run", args: %{"agent" => agent, "task" => task, "sid" => sid}}]
    case Nexus.Scheduler.arm("sched:#{sid}", time, effects, tenant: tenant) do
      {:error, e} -> {:error, e}
      _ -> :ok
    end
  rescue
    e -> {:error, Exception.message(e)}
  end

  # GitHub App webhook receiver. HMAC-verify the raw body, then surface the event on the bus + activity
  # feed. The reactive layer (a `pr.opened` hook → reviewer/merger agent) + fetch-back consume these.
  def github_webhook(req) do
    sig = (req[:headers] || %{})["x-hub-signature-256"]
    raw = req[:raw_body] || ""

    if Nexus.GitHub.verify_webhook(raw, sig) do
      event = (req[:headers] || %{})["x-github-event"] || "unknown"
      payload = (is_map(req.body) && req.body) || %{}
      repo = get_in(payload, ["repository", "full_name"]) || ""
      actor = get_in(payload, ["sender", "login"]) || "github"
      action = payload["action"] || ""

      Nexus.Events.emit(
        %{kind: "github.#{event}", actor: actor, title: String.trim("#{event} #{action} #{repo}"),
          target: repo, tags: ["event", "github"], scope: "member"},
        tenant: req.tenant || Nexus.Store.default_tenant()
      )

      %{ok: true}
    else
      {401, %{error: "invalid signature"}}
    end
  end

  # GitHub App wiring check (production sanity). Reports configured? + whether the App JWT signs + the
  # installations GitHub reports (proves the App id + private key are valid and the App is installed).
  def github_status(_req) do
    if Nexus.GitHub.configured?() do
      jwt_ok = match?({:ok, _}, Nexus.GitHub.app_jwt())

      installs =
        case Nexus.GitHub.installations() do
          {:ok, list} -> list
          {:error, e} -> %{error: inspect(e)}
        end

      %{configured: true, app_jwt: jwt_ok, installations: installs,
        webhook_secret: Nexus.Secrets.has?("GITHUB_WEBHOOK_SECRET")}
    else
      %{configured: false,
        need: ["GITHUB_APP_ID", "GITHUB_APP_PRIVATE_KEY", "GITHUB_APP_CLIENT_ID",
               "GITHUB_APP_CLIENT_SECRET", "GITHUB_WEBHOOK_SECRET"]}
    end
  end

  # Attribution key for runs/tasks/schedules. The SERVER-derived uid wins; in a multi-tenant deploy the
  # client `u` fallback is DROPPED (fix wb-q7w5) so an unauthenticated caller is "anon", never a claimed
  # victim — no run/task can be attributed to someone else. Single-tenant/dev keeps `u` for convenience.
  defp user_key(req) do
    server_uid(req) ||
      if Nexus.Auth.multi?(),
        do: "anon",
        else: (is_map(req.body) && req.body["u"]) || req.query["u"] || "anon"
  end
  defp sessions_for(tenant, user), do: Map.get(:persistent_term.get(@agent_store, %{}), {tenant, user}, [])

  defp save_sessions(tenant, user, list) do
    all = :persistent_term.get(@agent_store, %{})
    :persistent_term.put(@agent_store, Map.put(all, {tenant, user}, Enum.sort_by(list, & &1.updated, :desc)))
  end


  defp gen_id, do: Base.url_encode64(:crypto.strong_rand_bytes(9), padding: false)
  defp title_from(msg), do: msg |> String.trim() |> String.slice(0, 48) |> then(&if(&1 == "", do: "New chat", else: &1))

  # Returns `{:ok, text} | {:blocked, reason}`. The `tenant` MUST be threaded so the money-boundary gate
  # (Nexus.Inference.Admission) sees the org — without it inference would run ungated, subverting billing.
  defp run_agent(msg, model \\ nil, agent \\ nil, tenant \\ nil) do
    run_opts = [task: msg, timeout_ms: 60_000]
    run_opts = if is_binary(model) and model != "", do: Keyword.put(run_opts, :model, model), else: run_opts
    # Route the turn through the named agent when one is pinned to the session (else the default brain).
    run_opts = if is_binary(agent) and agent != "", do: Keyword.put(run_opts, :agent, agent), else: run_opts
    run_opts = if is_binary(tenant), do: Keyword.put(run_opts, :tenant, tenant), else: run_opts

    try do
      case Nexus.Agent.run(run_opts) do
        {:ok, %{answer: a} = r} when is_binary(a) ->
          # Settle the real cost against the org ledger (admission already pre-gated on balance > 0).
          if is_binary(tenant) and is_number(Map.get(r, :tokens)) and r.tokens > 0,
            do: Nexus.Inference.Admission.charge(tenant, run_cost(to_string(model || ""), r.tokens))
          {:ok, a}

        {:ok, a} when is_binary(a) -> {:ok, a}
        {:error, {:inference_blocked, reason}} -> {:blocked, to_string(reason)}
        {:error, _} -> {:ok, "I couldn't reach the agent runtime just now — try again in a moment."}
        _ -> {:ok, "(no answer)"}
      end
    rescue
      _ -> {:ok, "The agent isn't available on this nexus yet (no model key configured)."}
    catch
      _, _ -> {:ok, "The agent run failed unexpectedly."}
    end
  end

  # ── brief composition: capabilities + attached context are prepended to the user's message so the agent
  # actually sees them. Generator capabilities also name their bash command so the agent knows HOW to use
  # them (image/video/speak are host-brokered commands gated on the capability being active).
  @capability_commands %{
    "image-generation" => "`image <prompt>` to generate an image",
    "video-generation" => "`video <prompt>` to generate a video",
    "speech" => "`speak <text>` to generate spoken audio"
  }

  defp capability_prefix(caps) when is_list(caps) and caps != [] do
    hints =
      caps
      |> Enum.map(&Map.get(@capability_commands, &1))
      |> Enum.reject(&is_nil/1)

    base = "Active capabilities for this run: #{Enum.join(caps, ", ")} — use them where they fit."
    extra = if hints == [], do: "", else: " Run " <> Enum.join(hints, "; ") <> "."
    base <> extra <> "\n\n"
  end

  defp capability_prefix(_), do: ""

  # Resolve composer context items ({type, name, ref}) into a brief block. Files are inlined (capped, text
  # only); workspaces/spaces become a scope reference. Caps total volume so a brief never blows up.
  @context_file_cap 6_000
  @context_total_cap 40_000
  @context_max_items 12

  defp context_brief(items) when is_list(items) and items != [] do
    blocks =
      items
      |> Enum.take(@context_max_items)
      |> Enum.map(&context_block/1)
      |> Enum.reject(&(&1 in [nil, ""]))
      |> cap_total(@context_total_cap)

    if blocks == [], do: "", else: "Context the user attached for this run:\n\n" <> Enum.join(blocks, "\n\n") <> "\n\n"
  end

  defp context_brief(_), do: ""

  # Keep prepending blocks until the running total would exceed the cap; drop the rest.
  defp cap_total(blocks, cap) do
    {kept, _} =
      Enum.reduce(blocks, {[], 0}, fn b, {acc, n} ->
        len = String.length(b)
        if n + len > cap, do: {acc, n}, else: {[b | acc], n + len}
      end)

    Enum.reverse(kept)
  end

  defp context_block(it) when is_map(it) do
    type = to_string(Map.get(it, "type") || Map.get(it, :type) || "file")
    name = to_string(Map.get(it, "name") || Map.get(it, :name) || "")
    ref = to_string(Map.get(it, "ref") || Map.get(it, :ref) || name)

    case type do
      "file" -> file_context_block(name, ref)
      "workspace" -> "- Workspace in scope: **#{name}** (`#{ref}`)."
      "space" -> "- Related space: **#{name}**."
      _ -> if name == "", do: "", else: "- #{name}"
    end
  end

  defp context_block(_), do: ""

  defp file_context_block(name, ref) do
    label = if name == "", do: ref, else: name

    case resolve_file(ref) do
      {:ok, abs} ->
        case File.read(abs) do
          {:ok, bin} ->
            if String.valid?(bin) do
              "File `#{ref}`:\n```\n#{String.slice(bin, 0, @context_file_cap)}\n```"
            else
              "- File: #{label} (`#{ref}`) — binary, not inlined."
            end

          _ ->
            "- File: #{label} (`#{ref}`)"
        end

      _ ->
        # Unresolvable ref (e.g. a dropped local upload or a stale path) — still name it as context.
        "- Attached: #{label}"
    end
  end

  def register do
    # Live-shapes the dashboard subscribes to over /ws. The shape MECHANISM (Nexus.Shapes) is the open
    # standard; declaring WHICH of our resources are client-subscribable (and the field that scopes each)
    # is OUR product opinion, so it lives here in our workbook, not in the runtime allowlist. The chat
    # lane is the beachhead: messages scoped by channel, reactions by message, read cursors by channel.
    Nexus.Shapes.register("msgs", Message, :channel)
    Nexus.Shapes.register("reactions", Reaction, :message)
    Nexus.Shapes.register("cursors", Cursor, :channel)

    # Our `log` effect — persist any matched event to the durable `resource :Event` (tenant-scoped).
    # This is what makes the Activity page a durable feed; a bare nexus wouldn't register it.
    Nexus.Effects.register("log", fn _args, ev, ctx ->
      Nexus.Store.create(
        Event,
        %{kind: to_string(ev[:kind] || ""), actor: to_string(ev[:actor] || ""),
          title: to_string(ev[:title] || ev[:kind] || ""), target: to_string(ev[:target] || ""),
          tags: Enum.join(List.wrap(ev[:tags]), ","), scope: to_string(ev[:scope] || "member"),
          at: ev[:at] || System.os_time(:second)},
        ctx[:tenant] || ev[:tenant] || Nexus.Store.default_tenant()
      )
      :ok
    end)

    # Scheduled agent runs — the effect a Schedule fires (via Nexus.Scheduler). Runs the named agent on
    # the brief and persists a Run, exactly like a manual run; the schedule's tenant flows through ctx.
    Nexus.Effects.register("scheduled_run", fn args, _event, ctx ->
      tenant = ctx[:tenant] || Nexus.Store.default_tenant()
      agent = to_string(args["agent"] || "")
      task = to_string(args["task"] || "")
      if agent != "" and task != "" and not is_nil(Nexus.Agent.get(agent)) do
        do_run(agent, task, tenant, "scheduler", fn _ -> :ok end)
      end
      :ok
    end)

    # Re-arm persisted schedules on boot (durable: the Schedule rows are the source of truth; the armed
    # timers live only in memory, so they must be rebuilt). v1 re-arms the default tenant (one nexus per
    # org); multi-tenant fan-out is a follow-up when tenant enumeration lands.
    for s <- current_schedules(Nexus.Store.default_tenant()) do
      arm_schedule(Nexus.Store.default_tenant(), s)
    end

    # Live agent runs — the Studio opens EventSource('/live/agent_run?agent=…&task=…&u=…') and the
    # loop's typed events (text/tools/final) stream straight through. do_run also persists the Run row.
    Nexus.Live.register("agent_run", fn params, emit ->
      agent = params["agent"] || ""
      task = params["task"] || ""
      # tenant/u are SERVER-INJECTED by the /ws + /live transports (Nexus.Auth), never the client's word.
      tenant = params["tenant"] || Nexus.Store.default_tenant()
      user = params["u"] || "anon"
      sel = if(is_list(params["capabilities"]), do: params["capabilities"], else: [])
      caps = if(agent != "" and Nexus.Agent.get(agent), do: Nexus.Agent.admitted(Nexus.Agent.get(agent), sel), else: [])

      cond do
        agent == "" or task == "" -> emit.(%{type: "error", error: "agent and task are required"})
        is_nil(Nexus.Agent.get(agent)) -> emit.(%{type: "error", error: "no such agent: #{agent}"})
        # The SSE/WS transport must enforce the SAME authz as the HTTP route (fix wb-swpm): a viewer
        # can't run agents, and a run targeting a workspace honors its write ACL. role is server-injected.
        not live_write_ok?(params) -> emit.(%{type: "error", error: "forbidden — insufficient role for this workspace"})
        # A general (tree-wide) agent requires admin on the WS/SSE path too — the same gate as the HTTP
        # route (wb-fgg8); without this the live transport is a bypass for running workhorse org-wide. (wb-16ht)
        Nexus.Auth.multi?() and Nexus.Agent.general?(Nexus.Agent.get(agent)) and
            not Nexus.Auth.role_at_least?(params["role"] || "viewer", "admin") ->
          emit.(%{type: "error", error: "forbidden — running a general agent requires admin"})
        true ->
          do_run(agent, task, tenant, user, emit,
            workspace: params["workspace"], model: params["model"],
            isolate: params["isolate"] == true, capabilities: caps)
      end

      :ok
    end)

    Nexus.Live.register("usage", fn params, emit ->
      # A representative running nexus on the current tier; Capacity derives the dials.
      nx = %{id: params["nx"] || "dogfood", plan: Nexus.Pricing.default_tier().id, state: "running"}
      emit.(Nexus.Capacity.report(nx))
    end)

    # The fleet: ONE nexus per org. We report THIS running nexus — its own identity + what it serves.
    Nexus.Live.register("fleet", fn _params, emit ->
      tier = Nexus.Pricing.default_tier()
      emit.(%{nexuses: [%{
        name: Application.get_env(:nexus, :nexus_name, "nexus"),
        friendly: Application.get_env(:nexus, :nexus_friendly, ""),
        state: "running",
        tier: tier.name,
        surfaces: length(Application.get_env(:nexus, :mounts, []))
      }]})
    end)

    # Storage: this nexus's managed object store — one bucket per mounted surface, sizes derived from
    # what's actually on the data volume (real, not a mock). Egress-free (R2 in cloud, local in dev).
    Nexus.Live.register("storage", fn params, emit ->
      # Read-side ACL on the SSE twin (fix wb-swpm) — only surfaces the caller may read, like /cloud/storage.
      req = %{role: params["role"] || "viewer", user: params["u"], tenant: params["tenant"] || Nexus.Store.default_tenant(), body: nil, query: %{}}

      buckets =
        for {name, root} <- readable_mounts(req), name != "" do
          bytes = dir_bytes(root)
          %{name: name, objects: count_files(root), size: human(bytes), bytes: bytes}
        end

      total = Enum.reduce(buckets, 0, &(&1.bytes + &2))
      emit.(%{total: human(total), buckets: Enum.sort_by(buckets, & &1.bytes, :desc)})
    end)

    # Inbox live-push — subscribe this SSE connection to the event bus; every bus #event pings the
    # browser so the Inbox refetches its (tenant+role-scoped) threads. The ping carries only the kind,
    # never data — the scoped /cloud/inbox fetch is the source of truth, so there's no cross-tenant leak.
    Nexus.Live.register("inbox", fn _params, emit ->
      Nexus.Events.subscribe(fn ev -> "event" in List.wrap(ev[:tags]) end)
      emit.(%{type: "ready"})
      inbox_live_loop(emit)
    end)
  end

  defp inbox_live_loop(emit) do
    receive do
      {:event, ev} ->
        emit.(%{type: "event", kind: to_string(ev[:kind] || "")})
        inbox_live_loop(emit)
    end
  end

  # Real storage for the Storage admin page — one bucket per mounted surface, sizes off the data volume
  # (the same computation as the `storage` Live dial). Shape matches the page: {totalSize, buckets:[…]}.
  def storage(req) do
    buckets =
      for {name, root} <- readable_mounts(req), name != "" do
        bytes = dir_bytes(root)
        %{name: name, nexus: name, objects: count_files(root), size: human(bytes), egress: "$0.00", bytes: bytes}
      end

    total = Enum.reduce(buckets, 0, &(&1.bytes + &2))
    %{totalSize: human(total), buckets: Enum.sort_by(buckets, & &1.bytes, :desc)}
  end

  # ── Data page handlers ───────────────────────────────────────────────────────────────────────────
  # Every resource ("table") for the current tenant, grouped-friendly (carries `workspace`). Tier
  # badges (durable/replicated) are GLOBAL facts of the backend, not per-resource (one Store adapter,
  # one Litestream replica) — surfaced honestly rather than faked into per-table tiers.
  def data_list(req) do
    tenant = req.tenant || Nexus.Store.default_tenant()
    durable = Nexus.Store.adapter() == Nexus.Store.Sqlite
    replicated = durable and litestream_on?()

    resources =
      Nexus.Resources.list(Nexus.Config.data_dir(), tenant)
      # Hide per-user `account` resources (Profile/DeviceKey) from the generic explorer — they hold one
      # person's private rows and have their own gated surfaces (fix wb-90sp).
      |> Nexus.Resources.explorable()
      |> Enum.map(fn r ->
        %{name: r.name, workspace: r.workspace, file: r.file, files: r.files,
          count: r.count, live: r.count > 0, durable: durable, replicated: replicated,
          description: r.description, tags: r.tags,
          fields: Enum.map(r.fields, &field_meta/1)}
      end)

    %{resources: resources, backend: backend_label(), durable: durable, replicated: replicated}
  end

  # A real page of a resource's rows. Query: name, offset, limit, sort (field), dir (asc|desc), q.
  # Returns {fields, rows, total, offset, limit} — total is the count AFTER any `q` filter, so the UI
  # paginates the full table (not a capped peek). Tenant-scoped via Nexus.Store.page.
  def data_rows(req) do
    tenant = req.tenant || Nexus.Store.default_tenant()
    name = req.query["name"] || ""

    case Nexus.Resources.fetch(name, Nexus.Config.data_dir(), tenant) do
      :error ->
        {404, %{error: "no such resource"}}

      # Per-user identity resources (Profile/DeviceKey) are NOT browsable here (fix wb-90sp) — exposing
      # their rows would leak every user's data across the org. Treat as not-found so the generic
      # explorer can neither read nor enumerate them; they have their own gated surfaces.
      {:ok, entry} ->
        if Nexus.Resources.account?(entry) do
          {404, %{error: "no such resource"}}
        else
          sort_field = String.trim(req.query["sort"] || "")
          sort = if sort_field == "", do: nil, else: {sort_field, req.query["dir"] || "asc"}
          # Clamp once (Store.Page applies the same bounds internally) so the echoed offset/limit match
          # what was actually served — the UI's "showing X of Y" math stays correct on extreme inputs.
          o = Nexus.Store.Page.opts(offset: to_int(req.query["offset"], 0), limit: to_int(req.query["limit"], 50))

          {rows, total} =
            Nexus.Store.page(entry.module, tenant,
              offset: o.offset, limit: o.limit, sort: sort, q: req.query["q"])

          %{name: entry.name, description: entry.description, tags: entry.tags,
            fields: Enum.map(entry.fields, &field_meta/1),
            rows: Enum.map(rows, &row_map/1), total: total, offset: o.offset, limit: o.limit}
        end
    end
  end

  # Storage health overview — the "is my data live / am I backed up" page. Real numbers: the durable DB
  # size on the volume, the configured backend, cold-replica (Litestream) status, and tenant totals.
  def data_health(req) do
    tenant = req.tenant || Nexus.Store.default_tenant()
    resources = Nexus.Resources.list(Nexus.Config.data_dir(), tenant)
    rows = Enum.reduce(resources, 0, &(&1.count + &2))
    db_bytes = db_size_bytes()
    durable = Nexus.Store.adapter() == Nexus.Store.Sqlite

    %{backend: backend_label(), durable: durable,
      db_size: human(db_bytes), db_bytes: db_bytes,
      resources: length(resources), rows: rows,
      cold: cold_status()}
  end

  # Asset repository — media files on the data volume across all workspaces, for the Drive-style grid.
  # Reuses the same mounts as the file tree; serve/preview via /cloud/raw. Capped (with `truncated`).
  @asset_cap 500
  def assets_list(req) do
    want = String.trim(req.query["type"] || "")

    all =
      for {mount, root} <- readable_mounts(req),
          file <- Path.wildcard(Path.join(root, "**/*")),
          File.regular?(file),
          kind = asset_kind(file),
          not is_nil(kind),
          want == "" or want == kind do
        rel = Path.relative_to(file, root)
        path = mount <> "/" <> rel
        %{name: Path.basename(file), path: path, workspace: mount, type: kind,
          size: file_size(file), url: "/cloud/raw?path=" <> URI.encode(path)}
      end

    %{assets: Enum.take(all, @asset_cap), truncated: length(all) > @asset_cap, total: length(all)}
  end

  # Upload an asset into a workspace. Body: %{path: "<mount>/<rel>", content: "<base64>"} (a data: URL
  # prefix is tolerated). Writes the bytes to the volume and commits into the workspace repo, exactly
  # like the file-mutation verbs (attributed, remounted, logged).
  def asset_upload(req) do
    path = is_map(req.body) && req.body["path"]
    raw = (is_map(req.body) && req.body["content"]) || ""

    with {:ok, abs, mount, root, rel} <- resolve_target(path),
         true <- rel != "" or {:error, 400, "path required"},
         {:ok, bytes} <- decode_b64(raw) do
      File.mkdir_p!(Path.dirname(abs))
      File.write!(abs, bytes)
      commit_tree_change(req, mount, root, "upload #{rel} via dashboard", "uploaded #{rel} to #{mount}")
    else
      {:error, status, msg} -> {status, %{error: msg}}
      {:error, msg} -> {400, %{error: msg}}
      false -> {400, %{error: "path required"}}
      _ -> {400, %{error: "upload failed"}}
    end
  end

  # ── Data helpers ─────────────────────────────────────────────────────────────────────────────────
  defp field_meta({name, type}), do: %{name: to_string(name), type: field_type_label(type)}

  defp field_type_label({:scalar, t}), do: to_string(t)
  defp field_type_label({:enum, vals}), do: Enum.map_join(vals, " | ", &to_string/1)
  defp field_type_label({:list, inner}), do: "[" <> field_type_label(inner) <> "]"
  defp field_type_label(other), do: inspect(other)

  # Resource struct → a JSON-safe row map (just its declared fields; Jason renders enum atoms as strings).
  defp row_map(%_{} = row), do: Map.from_struct(row)
  defp row_map(row) when is_map(row), do: row

  defp backend_label do
    case Nexus.Store.adapter() do
      Nexus.Store.Sqlite -> "SQLite (durable)"
      Nexus.Store.Ets -> "ETS (in-memory)"
      other -> inspect(other)
    end
  end

  defp litestream_on? do
    Nexus.Litestream.enabled?()
  rescue
    _ -> false
  end

  defp cold_status do
    if litestream_on?() do
      replica = (try do Nexus.Litestream.replica() rescue _ -> nil end)
      %{enabled: true, target: replica_label(replica)}
    else
      %{enabled: false, target: nil}
    end
  end

  defp replica_label(%{} = r), do: r[:url] || r["url"] || r[:bucket] || r["bucket"] || "object store"
  defp replica_label(_), do: "object store"

  defp db_size_bytes do
    case File.stat(Nexus.Paths.db_path()) do
      {:ok, %{size: s}} -> s || 0
      _ -> 0
    end
  rescue
    _ -> 0
  end

  # TOCTOU-safe size: a file that passes File.regular? but vanishes before stat shouldn't kill the grid.
  defp file_size(file) do
    case File.stat(file) do
      {:ok, %{size: s}} -> s || 0
      _ -> 0
    end
  end

  defp to_int(nil, d), do: d
  defp to_int(s, d) when is_binary(s), do: (case Integer.parse(s) do {i, _} -> i; _ -> d end)
  defp to_int(i, _) when is_integer(i), do: i
  defp to_int(_, d), do: d

  # Media classification by extension — what the asset grid groups + previews.
  @img ~w(.png .jpg .jpeg .gif .webp .svg .avif .bmp .ico)
  @vid ~w(.mp4 .mov .webm .mkv .avi .m4v)
  @aud ~w(.mp3 .wav .ogg .flac .m4a .aac)
  @doc_ext ~w(.pdf)
  @arch ~w(.zip .tar .gz .tgz .7z .rar)
  defp asset_kind(file) do
    ext = file |> Path.extname() |> String.downcase()

    cond do
      ext in @img -> "image"
      ext in @vid -> "video"
      ext in @aud -> "audio"
      ext in @doc_ext -> "pdf"
      ext in @arch -> "archive"
      true -> nil
    end
  end

  # Accept raw base64 or a data: URL; cap size defensively.
  @max_asset_bytes 33_554_432
  defp decode_b64(s) when is_binary(s) do
    payload = case String.split(s, "base64,", parts: 2) do [_, b] -> b; [b] -> b end

    case Base.decode64(String.trim(payload)) do
      {:ok, bytes} when byte_size(bytes) <= @max_asset_bytes -> {:ok, bytes}
      {:ok, _} -> {:error, "file too large"}
      :error -> {:error, "invalid base64 content"}
    end
  end

  defp decode_b64(_), do: {:error, "content required"}

  # The platform secrets this nexus reads via Nexus.Secrets — injected at deploy (Fly secrets / encrypted
  # control-plane env). We expose only the NAME + whether it's set, never the value, and only to an admin.
  # This is the read-only counterpart to the editable control-plane env store the page already shows.
  def injected_secrets(req) do
    if Nexus.Auth.role_at_least?(Map.get(req, :role, "viewer"), "admin") do
      items = Enum.map(platform_secret_catalog(), fn s -> Map.put(s, :present, secret_present?(s.name)) end)
      %{secrets: items}
    else
      {403, %{error: "admin only"}}
    end
  end

  defp secret_present?(name) do
    Nexus.Secrets.has?(name)
  rescue
    _ -> false
  catch
    _, _ -> false
  end

  # The recognized secret names the built-in integrations look for. Used two ways by the (single) env
  # list: any that are PRESENT-via-deploy (not in the editable store) round out the list, and ALL of
  # them are offered as name suggestions when adding one. Manageable keys only — bootstrap/identity env
  # (WB_ENV_MASTER_KEY, WB_DATA, NEXUS_TENANT, PORT) is deliberately excluded: it isn't user-editable.
  defp platform_secret_catalog do
    [
      %{name: "OPENROUTER_API_KEY", label: "OpenRouter", group: "Inference"},
      %{name: "CF_AIG_URL", label: "Cloudflare AI Gateway — compat URL (…/compat/chat/completions)", group: "Inference"},
      %{name: "CF_AIG_TOKEN", label: "Cloudflare AI Gateway — token", group: "Inference"},
      %{name: "CLOUDFLARE_API_TOKEN", label: "Cloudflare — API token (direct Workers AI fallback)", group: "Inference"},
      %{name: "CLOUDFLARE_ACCOUNT_ID", label: "Cloudflare — account id (direct Workers AI fallback)", group: "Inference"},
      %{name: "BRAVE_API_KEY", label: "Brave Search", group: "Inference"},
      %{name: "WB_DATABASE_URL", label: "Database URL", group: "Storage & data"},
      %{name: "WB_S3_ACCESS_KEY_ID", label: "Object store — access key", group: "Storage & data"},
      %{name: "WB_S3_SECRET_ACCESS_KEY", label: "Object store — secret key", group: "Storage & data"},
      %{name: "GITHUB_OAUTH_CLIENT_ID", label: "GitHub OAuth — client id", group: "Integrations"},
      %{name: "GITHUB_OAUTH_CLIENT_SECRET", label: "GitHub OAuth — client secret", group: "Integrations"},
      %{name: "GITHUB_WEBHOOK_SECRET", label: "GitHub webhook secret", group: "Integrations"},
      %{name: "GOOGLE_OAUTH_CLIENT_ID", label: "Google OAuth — client id", group: "Integrations"},
      %{name: "GOOGLE_OAUTH_CLIENT_SECRET", label: "Google OAuth — client secret", group: "Integrations"},
      %{name: "SLACK_OAUTH_CLIENT_ID", label: "Slack OAuth — client id", group: "Integrations"},
      %{name: "SLACK_OAUTH_CLIENT_SECRET", label: "Slack OAuth — client secret", group: "Integrations"}
    ]
  end

  # GET /cloud/apps — discover installed apps across the user's workspaces. An app = a folder
  # `<ws>/apps/<aid>/` (its prebuilt bundle, served by serve_static) + an `app.work` manifest. The bundle
  # is durable (committed to the workspace git repo) and off-image; this just lists them for the studio.
  def apps_list(req) do
    apps =
      for {ws, root} <- readable_mounts(req),
          ws != "",
          appsdir = Path.join(root, "apps"),
          File.dir?(appsdir),
          aid <- (case File.ls(appsdir) do {:ok, names} -> Enum.sort(names); _ -> [] end),
          appdir = Path.join(appsdir, aid),
          File.dir?(appdir) do
        meta = app_manifest(Path.join(appdir, "app.work"))
        entry = meta[:entry] || "index.html"
        %{
          id: ws <> "/apps/" <> aid, aid: aid, workspace: ws,
          name: meta[:name] || humanize(aid),
          entry: entry, lane: meta[:lane] || "static",
          license: meta[:license] || "", source: meta[:source] || "",
          url: "/" <> ws <> "/apps/" <> aid <> "/" <> entry,
          updated: mtime_unix(appdir)
        }
      end

    %{apps: apps}
  end

  # Parse an `app.work` manifest — a small `app do … end` block of string fields (name/entry/lane/
  # license/source). Line-anchored regex (no json, per canon); missing fields → nil.
  defp app_manifest(path) do
    case File.read(path) do
      {:ok, src} ->
        for field <- ~w(name entry lane license source), into: %{} do
          v = case Regex.run(~r/^\s*#{field}\s+"([^"]*)"/m, src) do
            [_, m] -> m
            _ -> nil
          end
          {String.to_atom(field), v}
        end

      _ ->
        %{}
    end
  end

  # Sum file sizes under a dir (bounded walk) — the surface's on-disk footprint.
  def dir_bytes(root) do
    Path.wildcard(Path.join(root, "**/*"))
    |> Enum.filter(&File.regular?/1)
    |> Enum.reduce(0, fn f, acc -> acc + (File.stat!(f).size || 0) end)
  rescue
    _ -> 0
  end

  def count_files(root), do: Path.wildcard(Path.join(root, "**/*")) |> Enum.count(&File.regular?/1)

  # ── Workspace file tree ────────────────────────────────────────────────────────────────────────
  # No `path` → the mounts as top-level folders. With `path` ("<mount>/<sub>…") → that directory's
  # entries. Each entry: %{name, dir, path, size}. Hidden dotfiles + the weave index are skipped.
  # Workspace folders = the real top-level dirs on the data volume (excludes the nexus's own .nexus/db
  # + cache + dotfiles). Read from the FILESYSTEM (not the boot-time mounts list) so a freshly
  # git-pushed workspace shows up in the tree immediately, without waiting for a re-mount.
  defp mounts do
    root = Nexus.Config.data_dir()

    case File.ls(root) do
      {:ok, names} ->
        for n <- Enum.sort(names),
            n not in ~w(.nexus cache),
            not String.starts_with?(n, "."),
            File.dir?(Path.join(root, n)),
            do: {n, Path.join(root, n)}

      _ ->
        []
    end
  end

  def tree(req) do
    case String.trim(req.query["path"] || "") do
      "" ->
        # Read-side ACL (wb-ate4): only list workspaces the caller may read.
        entries = for {name, root} <- readable_mounts(req), do: %{name: name, dir: true, path: name, size: dir_bytes(root)}
        %{path: "", entries: Enum.sort_by(entries, & &1.name)}

      path ->
        [mount | rest] = String.split(path, "/", trim: true)

        case List.keyfind(mounts(), mount, 0) do
          nil ->
            {404, %{error: "no such mount"}}

          {_, root} ->
            dir = Path.join([root | rest])
            safe = Path.expand(dir)

            cond do
              not may_read_workspace?(req, mount, root) -> forbidden()
              not within_mount?(safe, root) -> {403, %{error: "path escapes mount"}}
              not File.dir?(safe) -> {404, %{error: "not a directory"}}
              true -> %{path: path, entries: list_dir(safe, path)}
            end
        end
    end
  end

  def search(req) do
    q = String.downcase(String.trim(req.query["q"] || ""))

    results =
      if q == "" do
        []
      else
        for {name, root} <- readable_mounts(req),
            file <- Path.wildcard(Path.join(root, "**/*")),
            File.regular?(file),
            base = Path.basename(file),
            String.contains?(String.downcase(base), q) do
          rel = Path.relative_to(file, root)
          %{name: base, path: name <> "/" <> rel, workspace: name}
        end
        |> Enum.take(40)
      end

    %{query: q, results: results}
  end

  # Hosted apps = the served workbook surfaces on THIS nexus (the live mounts). Each tile launches the
  # app at its URL. A surface that matches a declared workspace inherits that workspace's name + emoji.
  def apps(req) do
    org = req.tenant || Nexus.Store.default_tenant()
    declared = Map.new(Nexus.Config.workspaces(), fn w -> {w.id, w} end)

    apps =
      # Only surfaces the caller may read (wb-hpnm) — don't leak private/draft surface names/URLs.
      for {name, root} <- readable_mounts(req), name != "" do
        w = declared[name]
        vis = visibility_of(org, name, root)
        # An app's workspace = the declared workspace its path sits under (first segment). Flat top-level
        # mounts group under themselves when they ARE a declared workspace, else nil (→ "Other" in the UI).
        ws = name |> String.split("/") |> List.first()
        %{name: name, label: (w && w.name) || humanize(name), icon: (w && w.icon) || "",
          url: "/" <> name <> "/", visibility: vis, gated: vis == "private",
          workspace: if(Map.has_key?(declared, ws), do: ws, else: nil),
          updated: mtime_unix(root)}
      end

    %{apps: Enum.sort_by(apps, & &1.label)}
  end

  # GET /cloud/items?ws=<id> — the kind-typed items inside a workspace, from real .work declarations.
  def items(req) do
    ws = String.trim(req.query["ws"] || "")

    case List.keyfind(mounts(), ws, 0) do
      nil -> {404, %{error: "no such workspace"}}
      {_, root} ->
        if not may_read_workspace?(req, ws, root) do
          forbidden()
        else
          %{items: collect_items(req, ws, root), workspace: ws}
        end
    end
  end

  # Sub-mounts under the workspace are app surfaces (kind from their index.work); standalone .work files
  # that declare a user-facing kind (agent/flow/chat/resource) are those kinds; pure-infra files skipped.
  # The expensive part of /cloud/items: glob + read+parse EVERY .work file (Nexus.Literate). Cached per
  # workspace root, keyed by a cheap signature of the files' {path, mtime} — so repeated loads (including
  # browser hard-refreshes, which DON'T clear this server-side cache) are instant, and any .work edit
  # (mtime change) invalidates it. Re-parsing on every call is what pinned /cloud/items at ~6.5s.
  defp classified_files(root) do
    work_files =
      Path.wildcard(Path.join(root, "**/*.work"))
      |> Enum.reject(&(Path.basename(&1) == "index.work"))
      |> Enum.sort()

    sig = :erlang.phash2(Enum.map(work_files, fn f -> {f, mtime_unix_file(f)} end))

    case :persistent_term.get({:cloud_items_cache, root}, nil) do
      {^sig, cached} ->
        cached

      _ ->
        classified =
          for f <- work_files do
            rel = Path.relative_to(f, root)
            info = file_info(f, rel) # ONE read+parse per file
            %{f: f, rel: rel, info: info, sk: surface_file_kind(info.kinds), client?: "client" in info.kinds, kinds: info.kinds}
          end

        :persistent_term.put({:cloud_items_cache, root}, {sig, classified})
        classified
    end
  end

  defp collect_items(req, ws, root) do
    submounts =
      for {name, mroot} <- readable_mounts(req), name != ws, String.starts_with?(name, ws <> "/") do
        leaf = name |> String.split("/") |> List.last()
        k = surface_kind(mroot)
        %{id: name, kind: k, icon: items_icon(k), name: humanize(leaf), path: name,
          workspace: ws, url: "/" <> name <> "/", updated: mtime_unix(mroot), children: [], source: "inferred"}
      end

    classified = classified_files(root)

    # `client`-only files are ISLANDS. 2+ of them = the sections of ONE composed page (e.g. the lander),
    # not separate apps — so they collapse into a single page item (their sections live in its drawer).
    # A LONE client file is a standalone single-page app and stays its own item.
    sections = Enum.filter(classified, &(is_nil(&1.sk) and &1.client?))

    files =
      for c <- classified, kind = item_kind(c.sk, c.client?, length(sections)), not is_nil(kind) do
        %{id: ws <> "/" <> c.rel, kind: kind, icon: items_icon(kind), name: c.info.title,
          path: ws <> "/" <> c.rel, workspace: ws, updated: mtime_unix_file(c.f),
          children: (for v <- c.info.volumes, do: %{kind: "volume", name: v.name, format: v.format}), source: "inferred"}
      end

    page =
      if length(sections) >= 2 do
        kids = for s <- sections, do: %{kind: "page", name: s.info.title, path: ws <> "/" <> s.rel}
        [%{id: ws <> "/__page", kind: "app", icon: items_icon("app"), name: humanize(ws),
           path: ws <> "/index.work", url: "/" <> ws <> "/", workspace: ws, updated: mtime_unix(root),
           children: kids, source: "inferred"}]
      else
        []
      end

    # every workspace gets a DEFAULT channel — always present, hideable via `hide "general"` in index.work
    channel = %{id: ws <> "/general", kind: "chat", icon: items_icon("chat"), name: "general",
                path: ws <> "/general", workspace: ws, updated: 0, children: [], source: "default"}

    inferred = ([channel] ++ submounts ++ files ++ page) |> Enum.uniq_by(& &1.id)

    # Phase 2: the workspace's own index.work `workspace do …` block curates order/grouping/visibility/refs
    # over the inferred discovery (declared wins, inference fills the rest).
    apply_manifest(inferred, workspace_manifest(Path.join(root, "index.work")), ws, root)
  end

  # resource/database blocks a file declares → recursive `volume` children for the contents drawer
  defp volume_children(kinds, f) do
    for v <- volumes_in(kinds, f), do: %{kind: "volume", name: v.name, format: v.format}
  end

  # Read a workspace's index.work `workspace do … end` block — the authored curation layer (nil if none).
  defp workspace_manifest(index_path) do
    with {:ok, src} <- File.read(index_path),
         block when is_map(block) <-
           Enum.find(Nexus.Literate.parse(src), &(Map.get(&1, :type) == :code and Map.get(&1, :kind) == "workspace")) do
      parse_manifest(Map.get(block, :body, ""))
    else
      _ -> nil
    end
  end

  # Line-based parse of the manifest body: group / item [do] / icon / contains / hide.
  defp parse_manifest(body) do
    init = %{order: [], group_of: %{}, hidden: MapSet.new(), contains: %{}, icon_of: %{}, cur_group: nil, cur_item: nil}

    body
    |> String.split("\n")
    |> Enum.reduce(init, fn line, a ->
      t = String.trim(line)
      has_do = Regex.match?(~r/\bdo\s*$/, t)
      grp = Regex.run(~r/^group\s+"([^"]+)"/, t)
      itm = Regex.run(~r/^item\s+"([^"]+)"/, t)
      hid = Regex.run(~r/^hide\s+"([^"]+)"/, t)
      con = Regex.run(~r/^contains\s+"([^"]+)"/, t)
      ico = Regex.run(~r/^icon\s+"([^"]+)"/, t)
      ends = Regex.match?(~r/^end\b/, t)

      cond do
        grp ->
          %{a | cur_group: Enum.at(grp, 1)}

        itm ->
          p = Enum.at(itm, 1)
          %{a | cur_item: if(has_do, do: p, else: nil), order: a.order ++ [p], group_of: Map.put(a.group_of, p, a.cur_group)}

        hid ->
          %{a | hidden: MapSet.put(a.hidden, Enum.at(hid, 1))}

        con && a.cur_item ->
          %{a | contains: Map.update(a.contains, a.cur_item, [Enum.at(con, 1)], &(&1 ++ [Enum.at(con, 1)]))}

        ico && a.cur_item ->
          %{a | icon_of: Map.put(a.icon_of, a.cur_item, Enum.at(ico, 1))}

        ends ->
          if a.cur_item, do: %{a | cur_item: nil}, else: %{a | cur_group: nil}

        true ->
          a
      end
    end)
    |> Map.take([:order, :group_of, :hidden, :contains, :icon_of])
  end

  # Merge the authored manifest over inferred discovery: declared items first (ordered/grouped/decorated
  # with ref children), hidden removed, everything else appended (source: inferred).
  defp apply_manifest(inferred, nil, _ws, _root), do: Enum.sort_by(inferred, & &1.name)

  defp apply_manifest(inferred, m, ws, _root) do
    rel = fn p -> String.replace_prefix(p, ws <> "/", "") end
    by_path = Map.new(inferred, &{rel.(&1.path), &1})
    contained = m.contains |> Map.values() |> List.flatten() |> MapSet.new()
    declared_set = MapSet.new(m.order)

    declared =
      for p <- m.order, item = Map.get(by_path, p), not is_nil(item), not MapSet.member?(m.hidden, p) do
        refs = ref_children(m, p, by_path, ws)

        item
        |> Map.put(:group, Map.get(m.group_of, p))
        |> Map.put(:icon, Map.get(m.icon_of, p, item.icon))
        |> Map.put(:source, "declared")
        |> Map.put(:children, (item.children || []) ++ refs)
      end

    # everything not explicitly placed: drop hidden + items nested under a parent (contained) + already-declared
    undeclared =
      inferred
      |> Enum.reject(fn it ->
        r = rel.(it.path)
        MapSet.member?(m.hidden, r) or MapSet.member?(contained, r) or MapSet.member?(declared_set, r)
      end)
      |> Enum.sort_by(& &1.name)

    declared ++ undeclared
  end

  # a `contains "<path>"` → a reference (symlink) child; resolved to the live target item when present
  defp ref_children(m, p, by_path, ws) do
    for cp <- Map.get(m.contains, p, []) do
      tgt = Map.get(by_path, cp)

      %{kind: (tgt && tgt.kind) || "app", name: (tgt && tgt.name) || humanize(Path.basename(cp, ".work")),
        icon: (tgt && tgt.icon) || items_icon("app"), ref: %{target: ws <> "/" <> cp}}
    end
  end

  # POST /cloud/items/reorder {ws, order:[rel paths]} — persist a drag-reorder into the index.work manifest.
  def items_reorder(req) do
    ws = String.trim((is_map(req.body) && req.body["ws"]) || "")
    order = (is_map(req.body) && req.body["order"]) || []

    case List.keyfind(mounts(), ws, 0) do
      nil ->
        {404, %{error: "no such workspace"}}

      {_, root} ->
        if not may_workspace?(req, ws, root, :write) do
          forbidden()
        else
          idx = Path.join(root, "index.work")
          m = workspace_manifest(idx) || %{order: [], group_of: %{}, hidden: MapSet.new(), contains: %{}, icon_of: %{}}
          write_manifest_block(idx, render_manifest(%{m | order: order}))
          %{ok: true, order: order}
        end
    end
  end

  # the authored manifest map → a `workspace do … end` block (custom order, preserving contains/hide/icon)
  defp render_manifest(m) do
    items =
      for p <- m.order do
        inner =
          (for c <- Map.get(m.contains, p, []), do: "    contains " <> inspect(c)) ++
            case Map.get(m.icon_of, p) do
              nil -> []
              ic -> ["    icon " <> inspect(ic)]
            end

        if inner == [], do: "  item " <> inspect(p), else: Enum.join(["  item " <> inspect(p) <> " do"] ++ inner ++ ["  end"], "\n")
      end

    hides = for h <- Enum.sort(MapSet.to_list(m.hidden)), do: "  hide " <> inspect(h)
    "workspace do\n" <> Enum.join(items ++ hides, "\n") <> "\nend"
  end

  # replace the existing `workspace do … end` block in index.work (or append one), then save to the volume.
  defp write_manifest_block(idx, block) do
    src = (case File.read(idx), do: ({:ok, s} -> s; _ -> ""))

    new =
      if Regex.match?(~r/(?ms)^workspace do.*?^end/, src) do
        Regex.replace(~r/(?ms)^workspace do.*?^end/, src, fn _ -> block end)
      else
        String.trim_trailing(src) <> "\n\n" <> block <> "\n"
      end

    File.write!(idx, new)
  end

  # a file's STANDALONE surface kind — nil if it's only a `client` island or pure infra
  defp surface_file_kind(kinds) do
    cond do
      "agent" in kinds -> "agent"
      "flow" in kinds or "worker" in kinds -> "workflow"
      "chat" in kinds -> "chat"
      "database" in kinds or "resource" in kinds -> "database"
      "app" in kinds -> "app"
      true -> nil
    end
  end

  defp item_kind(sk, _client?, _n) when not is_nil(sk), do: sk
  defp item_kind(_sk, true, n) when n < 2, do: "app"
  defp item_kind(_sk, _client?, _n), do: nil

  # data volumes a unit declares (resource/database block names) → the contents drawer's "data sources"
  defp volumes_in(kinds, f) do
    if "resource" in kinds or "database" in kinds do
      case File.read(f) do
        {:ok, src} ->
          Regex.scan(~r/^\s*(?:resource|database)\s+:?"?(\w+)"?/m, src)
          |> Enum.map(fn [_, n] -> %{name: n, format: "sheet"} end)
          |> Enum.uniq()

        _ ->
          []
      end
    else
      []
    end
  end

  # kind → a valid Iconoir name the studio sidebar renders (matches the studio's KIND_DEFAULT intent).
  defp items_icon(kind) do
    case to_string(kind || "") do
      "agent" -> "cpu"
      "app" -> "app-window"
      "client" -> "app-window"
      "workflow" -> "git-fork"
      "flow" -> "git-fork"
      "worker" -> "git-fork"
      "database" -> "database"
      "resource" -> "database"
      "chat" -> "chat-bubble"
      _ -> "box"
    end
  end

  defp file_kinds(f) do
    case File.read(f) do
      {:ok, c} -> Nexus.Literate.parse(c) |> Enum.filter(&(&1.type == :code)) |> Enum.map(& &1.kind)
      _ -> []
    end
  end

  # ONE read+parse → {kinds, title, volumes}. Replaces the old file_kinds+file_title+volumes_in trio that
  # each re-read+re-parsed the same file (3× the IO+parse per .work file — the /cloud/items slowness).
  defp file_info(f, rel) do
    fallback = humanize(Path.rootname(Path.basename(rel)))

    case File.read(f) do
      {:ok, c} ->
        blocks = Nexus.Literate.parse(c)
        kinds = blocks |> Enum.filter(&(&1.type == :code)) |> Enum.map(& &1.kind)

        title =
          case Enum.find(blocks, &(&1.type == :heading)) do
            %{text: t} -> t |> String.split(~r/[—\-#]/) |> List.first() |> String.trim()
            _ -> fallback
          end

        volumes =
          if "resource" in kinds or "database" in kinds do
            Regex.scan(~r/^\s*(?:resource|database)\s+:?"?(\w+)"?/m, c)
            |> Enum.map(fn [_, n] -> %{name: n, format: "sheet"} end)
            |> Enum.uniq()
          else
            []
          end

        %{kinds: kinds, title: title, volumes: volumes}

      _ ->
        %{kinds: [], title: fallback, volumes: []}
    end
  end

  defp surface_kind(mroot), do: user_facing_kind(file_kinds(Path.join(mroot, "index.work"))) || "app"

  # declared block kinds → a Studio item kind; nil when the file is pure infra (no user-facing surface)
  defp user_facing_kind(kinds) do
    cond do
      "agent" in kinds -> "agent"
      "flow" in kinds or "worker" in kinds -> "workflow"
      "chat" in kinds -> "chat"
      "database" in kinds or "resource" in kinds -> "database"
      "client" in kinds or "app" in kinds -> "app"
      true -> nil
    end
  end

  defp file_title(f, rel) do
    fallback = humanize(Path.rootname(Path.basename(rel)))

    case File.read(f) do
      {:ok, c} ->
        case Nexus.Literate.parse(c) |> Enum.find(&(&1.type == :heading)) do
          %{text: t} -> t |> String.split(~r/[—\-#]/) |> List.first() |> String.trim()
          _ -> fallback
        end

      _ ->
        fallback
    end
  end

  defp mtime_unix_file(f) do
    case File.stat(f, time: :posix) do
      {:ok, %{mtime: m}} -> m
      _ -> 0
    end
  end

  # GET /cloud/graph?ws=<id> — the workspace's .work knowledge graph as { nodes, edges }.
  def graph(req) do
    ws = String.trim(req.query["ws"] || "")

    case List.keyfind(mounts(), ws, 0) do
      nil ->
        {404, %{error: "no such workspace"}}

      {_, root} ->
        if not may_read_workspace?(req, ws, root) do
          forbidden()
        else
          g = Nexus.Graph.build_dir(root)
          titles = Map.get(g, :titles, %{})

          # Emit the Understand-Anything KnowledgeGraph shape from structural data (the LLM pipeline enriches
          # summary/domain/tours later, Phase 2). Node type ⇐ .work kind; edge type ⇐ graph.ex edge type.
          nodes =
            for {id, n} <- g.nodes do
              src = (get_in(n, [:facets, :source]) || %{})
              %{id: id, name: Map.get(titles, id, id), type: graph_node_type(Map.get(n, :kind)),
                kind: Map.get(n, :kind), lang: Map.get(n, :lang), filePath: Map.get(src, :file),
                tags: Enum.reject([Map.get(n, :kind), Map.get(n, :lang)], &is_nil/1),
                summary: "", domain: ws, complexity: "moderate"}
            end

          edges =
            for e <- g.edges do
              %{source: Map.get(e, :from), target: Map.get(e, :to),
                type: graph_edge_type(Map.get(e, :type)), layer: Map.get(e, :layer),
                direction: "forward", weight: 1.0}
            end

          %{nodes: nodes, edges: edges, workspace: ws, kind: "codebase"}
        end
    end
  end

  # .work kind → Understand-Anything NodeType (structural mapping; the LLM pipeline refines later).
  defp graph_node_type(kind) do
    case to_string(kind || "") do
      "agent" -> "service"
      "server" -> "service"
      "app" -> "module"
      "client" -> "module"
      "dep" -> "module"
      "flow" -> "pipeline"
      "worker" -> "pipeline"
      "resource" -> "table"
      "database" -> "table"
      "def" -> "function"
      "" -> "module"
      other -> other
    end
  end

  # graph.ex edge type (atom) → UA EdgeType string.
  defp graph_edge_type(t) do
    case to_string(t || "") do
      "calls" -> "calls"
      "imports" -> "imports"
      "fetch" -> "reads_from"
      "ref" -> "related"
      "dep" -> "depends_on"
      "" -> "depends_on"
      other -> other
    end
  end

  # POST /cloud/graph/build?ws= — LLM-enrich the structural graph (domains + summaries), persist the KG.
  def graph_build(req) do
    ws = String.trim((is_map(req.body) && req.body["ws"]) || req.query["ws"] || "")

    case List.keyfind(mounts(), ws, 0) do
      nil ->
        {404, %{error: "no such workspace"}}

      {_, root} ->
        if not may_workspace?(req, ws, root, :write) do
          forbidden()
        else
          g = Nexus.Graph.build_dir(root)
          units = for {id, n} <- g.nodes, do: %{id: id, kind: to_string(Map.get(n, :kind) || "")}
          # Phase B: read the actual source of each unit's file (capped) so summaries/domains are GROUNDED in
          # what the code does, not guessed from names.
          file_block = graph_file_snippets(g, root)

          prompt = """
          You map a software workspace into a knowledge graph (Understand-Anything style). For these units:
          (1) group them into 3–7 cohesive DOMAINS by purpose; (2) assign architectural LAYERS (e.g. UI,
          API, Domain, Data, Infra); (3) build 1–3 guided TOURS (an ordered path of nodeIds that explains
          the workspace); (4) give each unit a one-sentence SUMMARY; (5) add SEMANTIC RELATIONS — pairs of
          conceptually-related units NOT already linked by code (similar purpose / shared concern), each
          with a short reason. Respond with ONLY a JSON object, no prose:
          {"domains":[{"id":"kebab","name":"Name","nodeIds":["id"]}],
           "layers":[{"id":"kebab","name":"Layer","nodeIds":["id"]}],
           "tours":[{"id":"kebab","title":"Title","nodeIds":["id"]}],
           "relations":[{"from":"id","to":"id","why":"short reason"}],
           "summaries":{"id":"one sentence"}}
          Workspace: #{ws}

          SOURCE — the actual file contents; base every summary on what the code/prose really does:
          #{file_block}

          Units (#{length(units)}, {id, kind}): #{Jason.encode!(units)}
          """

          enrich = parse_json_obj(run_agent(prompt))
          kg = assemble_kg(ws, g, enrich)
          dir = Path.join(root, ".understand")
          File.mkdir_p!(dir)
          File.write!(Path.join(dir, "knowledge-graph.json"), Jason.encode!(kg))
          kg
        end
    end
  end

  # GET /cloud/graph/rich?ws= — the full literate structure every node already carries (graph.ex facets +
  # titles + typed edges + backlinks). This is the real content the runtime's graph_summary throws away.
  def graph_rich(req) do
    ws = String.trim(req.query["ws"] || "")

    case List.keyfind(mounts(), ws, 0) do
      nil ->
        {404, %{error: "no such workspace"}}

      {_, root} ->
        if not may_read_workspace?(req, ws, root) do
          forbidden()
        else
          # Phase C: join the runtime telemetry overlay so each node carries its OBSERVED traffic
          # (runs/tokens/latency/errors) — what actually ran, not just what's declared.
          g = Nexus.Graph.build_dir(root) |> Nexus.Graph.with_overlay(Nexus.Telemetry.overlay())
          titles = Map.get(g, :titles, %{})
          org = req.tenant || Nexus.Store.default_tenant()
          vis = visibility_of(org, ws, root)

          nodes =
            for {id, n} <- g.nodes do
              src = get_in(n, [:facets, :source]) || %{}
              f = Map.get(n, :file)
              %{id: id, name: Map.get(titles, id, id), type: graph_node_type(Map.get(n, :kind)),
                kind: Map.get(n, :kind), lang: Map.get(n, :lang), filePath: f,
                path: if(is_binary(f), do: ws <> "/" <> Path.relative_to(f, root), else: nil),
                exports: list_str(Map.get(src, :exports)), imports: list_str(Map.get(src, :imports)),
                types: list_str(Map.get(src, :types)), calls: list_str(Map.get(src, :calls)),
                members: block_members(f, Map.get(n, :kind), id),
                observed: observed_map(get_in(n, [:facets, :observed])),
                tags: Enum.reject([Map.get(n, :kind), Map.get(n, :lang)], &is_nil/1)}
            end

          edges =
            for e <- g.edges do
              %{source: Map.get(e, :from), target: Map.get(e, :to),
                type: graph_edge_type(Map.get(e, :type)), layer: to_string(Map.get(e, :layer))}
            end

          %{nodes: nodes, edges: edges, workspace: ws, kind: "codebase", rich: true, visibility: vis}
        end
    end
  end

  defp observed_map(o) when is_map(o),
    do: %{runs: Map.get(o, :runs), tokens: Map.get(o, :tokens), latency_ms: Map.get(o, :latency_ms), errors: Map.get(o, :errors)}

  defp observed_map(_), do: nil

  # GET /cloud/graph/changed?ws= — the workspace's dirty files (git status --porcelain), for diff-impact.
  def graph_changed(req) do
    ws = String.trim(req.query["ws"] || "")

    case List.keyfind(mounts(), ws, 0) do
      nil ->
        {404, %{error: "no such workspace"}}

      {_, root} ->
        if not may_read_workspace?(req, ws, root) do
          forbidden()
        else
          changed =
            case System.cmd("git", ["-C", root, "status", "--porcelain"], stderr_to_stdout: true) do
              {out, 0} ->
                out
                |> String.split("\n", trim: true)
                |> Enum.map(&String.trim(String.slice(&1, 2..-1//1)))
                |> Enum.map(&(ws <> "/" <> &1))

              _ ->
                []
            end

          %{changed: changed, workspace: ws}
        end
    end
  end

  # Phase A — parse a unit's block for its fine-grained MEMBERS: a server's routes/endpoints, a resource's
  # fields, an agent's tools/grants, a flow's steps. The real declarations inside the block, not just names.
  defp block_members(file, kind, name) when is_binary(file) do
    case File.read(file) do
      {:ok, src} -> extract_members(src, to_string(kind), to_string(name))
      _ -> []
    end
  end

  defp block_members(_, _, _), do: []

  defp extract_members(src, kind, name) do
    body = block_body(String.split(src, "\n"), kind, name)

    member_patterns(kind)
    |> Enum.flat_map(fn {re, type} ->
      Regex.scan(re, body) |> Enum.map(fn m -> %{label: String.trim(Enum.at(m, 1, "")), type: type} end)
    end)
    |> Enum.reject(&(&1.label == ""))
    |> Enum.uniq()
    |> Enum.take(14)
  end

  # best-effort: the lines from `<kind> :<name> … do` to the next column-0 `end`
  defp block_body(lines, kind, name) do
    start = Enum.find_index(lines, &Regex.match?(~r/^\s*#{kind}\s+:?"?#{Regex.escape(name)}"?\b.*\bdo\b/, &1))

    case start do
      nil -> Enum.join(lines, "\n")
      i -> lines |> Enum.drop(i + 1) |> Enum.take_while(&(not Regex.match?(~r/^end\s*$/, &1))) |> Enum.join("\n")
    end
  end

  # patterns are LINE-ANCHORED (^\s*…/m) so they match real directives, not mentions inside prompt prose.
  defp member_patterns("server"), do: [{~r/^\s*route\s+"([^"]+)"/m, "endpoint"}, {~r/^\s*defp?\s+(\w+)/m, "function"}]
  defp member_patterns("client"), do: [{~r/^\s*route\s+"([^"]+)"/m, "endpoint"}, {~r/^\s*(?:export\s+)?function\s+(\w+)/m, "function"}, {~r/^\s*(?:export\s+)?class\s+(\w+)/m, "class"}]
  defp member_patterns("resource"), do: [{~r/^\s*field\s+:?"?(\w+)"?/m, "field"}]
  defp member_patterns("database"), do: [{~r/^\s*field\s+:?"?(\w+)"?/m, "field"}]
  defp member_patterns("agent"), do: [{~r/^\s*tools\s+([^\n#]+)/m, "tool"}, {~r/^\s*grant\s+([^\n#]+)/m, "grant"}]
  defp member_patterns("flow"), do: [{~r/^\s*step\s+:?"?(\w+)"?/m, "step"}]
  defp member_patterns("worker"), do: [{~r/^\s*step\s+:?"?(\w+)"?/m, "step"}]
  # any other code unit (Elixir def / JS function / class) → its functions & classes
  defp member_patterns(_), do: [{~r/^\s*defp?\s+(\w+)/m, "function"}, {~r/^\s*(?:export\s+)?function\s+(\w+)/m, "function"}, {~r/^\s*(?:export\s+)?class\s+(\w+)/m, "class"}]

  defp list_str(nil), do: []
  defp list_str(l) when is_list(l), do: l |> Enum.map(&to_str_safe/1) |> Enum.reject(&(&1 == ""))
  defp list_str(x), do: [to_str_safe(x)]

  # to_string that never raises — the type registry / facets can hold tuples ({:catalog, []}) and other terms
  defp to_str_safe(x) when is_binary(x), do: x
  defp to_str_safe(x) when is_atom(x), do: to_string(x)
  defp to_str_safe(x) when is_integer(x) or is_float(x), do: to_string(x)
  defp to_str_safe({a, _}), do: to_str_safe(a)
  defp to_str_safe(x), do: inspect(x)

  # GET /cloud/graph/query?ws=&op=why|near|search&node= — graph queries for agents + the Graph view.
  def graph_query(req) do
    ws = String.trim(req.query["ws"] || "")
    op = req.query["op"] || "near"
    node = req.query["node"] || ""

    case List.keyfind(mounts(), ws, 0) do
      nil ->
        {404, %{error: "no such workspace"}}

      {_, root} ->
        if not may_read_workspace?(req, ws, root) do
          forbidden()
        else
          g = Nexus.Graph.build_dir(root)

          case op do
            "why" ->
              %{op: "why", node: node, result: Nexus.Graph.why(g, node)}

            "near" ->
              edges = Nexus.Graph.near(g, node) |> Enum.map(&%{from: Map.get(&1, :from), to: Map.get(&1, :to), type: to_string(Map.get(&1, :type))})
              %{op: "near", node: node, result: edges}

            "search" ->
              q = String.downcase(node)
              hits = for {id, n} <- g.nodes, q == "" or String.contains?(String.downcase(to_string(id)), q),
                       do: %{id: id, kind: Map.get(n, :kind), file: Map.get(n, :file)}
              %{op: "search", q: node, result: hits}

            _ ->
              {400, %{error: "unknown op — use why|near|search"}}
          end
        end
    end
  end

  # Pull the first {...} JSON object out of an LLM reply (tolerant of surrounding prose / code fences).
  defp parse_json_obj(text) do
    s = to_string(text)

    with {a, _} <- :binary.match(s, "{"),
         matches when matches != [] <- :binary.matches(s, "}"),
         {b, _} <- List.last(matches),
         {:ok, m} <- Jason.decode(binary_part(s, a, b - a + 1)) do
      m
    else
      _ -> %{}
    end
  end

  # Read each unique source file once (capped) → a labeled block for the enrichment prompt (Phase B).
  defp graph_file_snippets(g, root) do
    files = for {_id, n} <- g.nodes, f = Map.get(n, :file), is_binary(f), into: MapSet.new(), do: f

    files
    |> Enum.take(40)
    |> Enum.map(fn f ->
      rel = Path.relative_to(f, root)
      snip = case File.read(f) do
        {:ok, c} -> String.slice(c, 0, 1400)
        _ -> ""
      end
      "=== #{rel} ===\n#{snip}"
    end)
    |> Enum.join("\n\n")
  end

  # Merge the structural graph + the LLM enrichment into the Understand-Anything KnowledgeGraph shape.
  defp assemble_kg(ws, g, enrich) do
    domains = Map.get(enrich, "domains", [])
    layers = Map.get(enrich, "layers", [])
    tours = Map.get(enrich, "tours", [])
    summaries = Map.get(enrich, "summaries", %{})
    dom_of = for d <- domains, id <- Map.get(d, "nodeIds", []), into: %{}, do: {id, Map.get(d, "id")}
    lay_of = for l <- layers, id <- Map.get(l, "nodeIds", []), into: %{}, do: {id, Map.get(l, "id")}

    nodes =
      for {id, n} <- g.nodes do
        %{id: id, name: id, type: graph_node_type(Map.get(n, :kind)), kind: Map.get(n, :kind),
          lang: Map.get(n, :lang), filePath: Map.get(n, :file), summary: Map.get(summaries, id, ""),
          domain: Map.get(dom_of, id), layer: Map.get(lay_of, id),
          tags: Enum.reject([Map.get(n, :kind), Map.get(n, :lang)], &is_nil/1)}
      end

    structural =
      for e <- g.edges,
        do: %{source: Map.get(e, :from), target: Map.get(e, :to), type: graph_edge_type(Map.get(e, :type))}

    # semantic edges (Phase D) — LLM-derived conceptual links, flagged so the view renders them distinctly
    semantic =
      for r <- Map.get(enrich, "relations", []), Map.get(r, "from") && Map.get(r, "to"),
        do: %{source: Map.get(r, "from"), target: Map.get(r, "to"), type: "related",
              semantic: true, why: Map.get(r, "why")}

    edges = structural ++ semantic

    %{nodes: nodes, edges: edges, domains: domains, layers: layers, tours: tours,
      workspace: ws, kind: "codebase", enriched: true}
  end

  # Newest mtime of the app's folder (its index.work, else the dir) as a unix int — for "recently updated".
  defp mtime_unix(root) do
    path = Path.join(root, "index.work")
    path = if File.exists?(path), do: path, else: root

    case File.stat(path, time: :posix) do
      {:ok, %{mtime: m}} -> m
      _ -> 0
    end
  end

  # A surface's visibility: an explicit per-folder permission (control plane) wins; otherwise derive —
  # an `auth` block ⇒ private (lock), else public (globe). "draft" only ever comes from the CP record.
  defp visibility_of(org, name, root) do
    case Nexus.ControlPlane.get(org, :visibility, name) do
      {:ok, rec} -> rec[:state] || rec["state"] || derived_vis(root)
      _ -> derived_vis(root)
    end
  end

  defp derived_vis(root), do: if(mount_gated?(root), do: "private", else: "public")

  # The per-workspace ACL inputs (wb-afvq): {visibility, owner} for a surface. Owner is "" unless a CP
  # visibility record set it (drafts). The cloud write path gates on these via Nexus.Authz.may_access?.
  defp workspace_acl(org, name, root) do
    case Nexus.ControlPlane.get(org, :visibility, name) do
      {:ok, rec} -> {rec[:state] || rec["state"] || derived_vis(root), rec[:owner] || rec["owner"] || ""}
      _ -> {derived_vis(root), ""}
    end
  end

  # May this request take `action` (:read | :write) on workspace `mount`? Single-tenant/dev → yes;
  # multi-tenant enforces the workspace's visibility ACL (draft = owner/admin; private = member+; public
  # = read-any / write-member) via Nexus.Authz. The read + write paths share ONE decision (wb-ate4).
  defp may_workspace?(req, mount, root, action) do
    not Nexus.Auth.multi?() or
      (
        {vis, owner} = workspace_acl(req.tenant || Nexus.Store.default_tenant(), mount, root)
        Nexus.Authz.may_access?(%{role: Map.get(req, :role, "viewer"), user: user_key(req)}, vis, owner, action)
      )
  end

  defp may_write_workspace?(req, mount, root), do: may_workspace?(req, mount, root, :write)
  defp may_read_workspace?(req, mount, root), do: may_workspace?(req, mount, root, :read)

  # The ONE per-workspace write authorizer for an AGENT RUN (fix wb-913c) — used by the HTTP agent_run/
  # agent_chat handlers AND the SSE/WS live source, so all three honor the same draft/private ACL. A run
  # targeting a workspace must pass may_write_workspace? for it; an ephemeral/unknown mount has no ACL.
  defp workspace_write_ok?(req, ws) do
    case ws do
      w when is_binary(w) and w != "" ->
        case List.keyfind(mounts(), w, 0) do
          {_, root} -> may_write_workspace?(req, w, root)
          _ -> true
        end

      _ ->
        true
    end
  end

  # Authorize a write-capable Live/SSE/WS source (fix wb-swpm): the socket injects role server-side, so
  # apply the SAME :write role gate + per-workspace ACL the HTTP route enforces. params has role/u/tenant.
  defp live_write_ok?(params) do
    req = %{role: params["role"] || "viewer", user: params["u"], tenant: params["tenant"] || Nexus.Store.default_tenant(), body: nil, query: %{}}
    gate(req, :write) and workspace_write_ok?(req, params["workspace"])
  end

  # The mounts the caller may READ — the ONE place every list/enumerate route walks (wb-ate4/wb-59uk),
  # so a new route can't forget the read ACL and leak draft/private workspace metadata.
  defp readable_mounts(req), do: Enum.filter(mounts(), fn {name, root} -> may_read_workspace?(req, name, root) end)

  # Create a draft = a real nexus folder scaffolded with an index.work, committed so it's a live
  # surface, and flagged `draft` in the control plane. Promote later via /cloud/visibility.
  def draft_create(req) do
    org = req.tenant || Nexus.Store.default_tenant()
    name = String.trim((is_map(req.body) && req.body["name"]) || "") |> then(&if(&1 == "", do: "Untitled draft", else: &1))
    slug = draft_slug(name)
    root = Path.join(Nexus.Config.data_dir(), slug)
    File.mkdir_p!(root)
    idx = Path.join(root, "index.work")
    unless File.exists?(idx), do: File.write!(idx, draft_scaffold(name))

    bare = Nexus.Git.bare_path(Nexus.GitHttp.repos_root(), slug)
    Nexus.Git.provision_remote(bare, root)
    Nexus.Git.commit_file(bare, root, "index.work", "create draft #{name}")
    # Record the draft's OWNER (wb-afvq) — a draft is writable only by its owner (or admin+).
    Nexus.ControlPlane.put(org, :visibility, slug, %{id: slug, state: "draft", name: name, owner: user_key(req)})
    spawn(fn -> if function_exported?(Nexus.Server, :remount, 0), do: Nexus.Server.remount() end)

    %{ok: true, id: slug, name: name, url: "/" <> slug <> "/"}
  end

  # Set a surface's visibility (draft → private/public, the "promote", or back).
  def set_visibility(req) do
    org = req.tenant || Nexus.Store.default_tenant()
    id = is_map(req.body) && req.body["id"]
    state = is_map(req.body) && req.body["state"]

    owner = case Nexus.ControlPlane.get(org, :visibility, id) do
      {:ok, rec} -> rec[:owner] || rec["owner"] || ""
      _ -> ""
    end

    cond do
      id in [nil, ""] -> {400, %{error: "id required"}}
      state not in ["draft", "private", "public"] -> {400, %{error: "state must be draft|private|public"}}
      # Only the workspace OWNER or an admin may change its visibility (wb-5voh) — not any member. An
      # ownerless surface is admin-only. Multi-tenant only; dev trusted.
      not vis_manage_ok?(req, owner) -> forbidden()
      true ->
        # Preserve the existing owner (wb-afvq) so promoting a draft doesn't drop its ACL anchor.
        Nexus.ControlPlane.put(org, :visibility, id, %{id: id, state: state, owner: owner})
        %{ok: true, id: id, state: state}
    end
  end

  # May this request change a surface's visibility? Owner-or-admin (dev trusted). Owner match is
  # case-insensitive on the uid; an ownerless surface ("") is admin-only.
  defp vis_manage_ok?(req, owner) do
    not Nexus.Auth.multi?() or
      Nexus.Auth.role_at_least?(Map.get(req, :role, "viewer"), "admin") or
      (owner != "" and String.downcase(owner) == String.downcase(to_string(user_key(req))))
  end

  # Unique-ish slug for a new draft folder (no traversal/separators; suffix if the folder already exists).
  defp draft_slug(name) do
    base = name |> String.downcase() |> String.replace(~r{[^a-z0-9]+}, "-") |> String.trim("-")
    base = if base == "", do: "draft", else: base
    root = Nexus.Config.data_dir()
    if File.dir?(Path.join(root, base)), do: base <> "-" <> Integer.to_string(System.os_time(:second), 36), else: base
  end

  defp draft_scaffold(name) do
    """
    # #{name}

    A new draft app — build it with the agent on the left; this preview updates as it takes shape.

    client :app do
      <div style="min-height:100vh;display:grid;place-items:center;font:16px system-ui;color:#555">
        <div style="text-align:center">
          <div style="font-size:40px">✦</div>
          <p>#{name} — your draft starts here.</p>
        </div>
      </div>
    end
    """
  end

  defp humanize(name), do: name |> String.split(~r{[-/_]}, trim: true) |> Enum.map_join(" ", &String.capitalize/1)

  # Agents from the live registry. Each: %{name, file}. Studio lists them in the Agents tab.
  # The Studio agent roster — our curated, toolkit-bound catalog. Each agent is named after its
  # MODALITY and is PROVIDED BY a toolkit: disable the toolkit and the agent disappears from the composer
  # (the client filters against /cloud/toolkits). Workhorse (everyday) + Autopilot have no toolkit — always on.
  # The pastel theme/icon is resolved client-side (WB.AGENT_THEME) so it matches the Toolkits page. THE
  # LINE: the agent BLOCKS are standard `.work`; this roster + its toolkit bindings are our cloud product.
  def agent_catalog do
    [
      %{name: "workhorse", label: "Workhorse", toolkit: nil,
        blurb: "The everyday generalist — plans, dispatches, gets things done."},
      %{name: "deck", label: "Deck Builder", toolkit: "presentation",
        blurb: "Turns a brief into a real, rendering reveal.js deck."},
      %{name: "video", label: "Video Editor", toolkit: "video",
        blurb: "Authors HyperFrames scenes the nexus renders to a clip."},
      %{name: "research", label: "Deep Researcher", toolkit: "research",
        blurb: "Fans out searches and synthesizes organized, cited findings."},
      %{name: "autopilot", label: "Autopilot", toolkit: nil,
        blurb: "Runs your work on a schedule and keeps it moving on its own."}
    ]
  end

  def agents_list(_req) do
    defined = Nexus.Agent.all() |> Enum.map(&to_string(Map.get(&1, :name))) |> MapSet.new()

    agents =
      agent_catalog()
      |> Enum.map(fn a ->
        a
        |> Map.put(:defined, MapSet.member?(defined, a.name))
        |> Map.put(:capabilities, admission_of(a.name))
      end)

    %{agents: agents}
  end

  # An agent's capability admission policy, serialized for the composer: "all" | "none" | [ids].
  defp admission_of(name) do
    case Nexus.Agent.get(name) do
      nil -> "all"
      node -> case Nexus.Agent.capabilities(node) do
                :all -> "all"
                :none -> "none"
                list when is_list(list) -> list
              end
    end
  end

  # ── Agent overrides (model + prompt) — the agent editor. The shipped agent block is the default; an
  # override layers on top per org (stored in the control plane), applied at run time.
  defp agent_override(tenant, name) do
    case Nexus.ControlPlane.get(tenant, :agent_override, name) do
      {:ok, o} when is_map(o) -> o
      _ -> %{}
    end
  end

  # The shipped agent's default prompt (from the live registry), so the editor shows what it's overriding.
  defp agent_default_prompt(name) do
    try do
      case Nexus.Agent.get(name) do
        %{} = a -> to_string(Map.get(a, :prompt) || "")
        _ -> ""
      end
    rescue
      _ -> ""
    end
  end

  def agent_config_get(req) do
    name = req.query["name"] || ""
    base = Enum.find(agent_catalog(), &(&1.name == name)) || %{name: name, label: name, toolkit: nil}
    ov = agent_override(req.tenant, name)

    %{name: name, label: Map.get(base, :label) || name, toolkit: Map.get(base, :toolkit),
      default_prompt: agent_default_prompt(name),
      prompt: Map.get(ov, :prompt), model: Map.get(ov, :model)}
  end

  def agent_config_save(req) do
    b = (is_map(req.body) && req.body) || %{}
    name = b["name"] || ""

    if name == "" do
      {400, %{error: "name required"}}
    else
      upd =
        agent_override(req.tenant, name)
        |> maybe_put(:prompt, b["prompt"])
        |> maybe_put(:model, b["model"])

      Nexus.ControlPlane.put(req.tenant, :agent_override, name, upd)
      {200, %{ok: true, name: name, model: upd[:model], prompt: upd[:prompt]}}
    end
  end

  # ── Workbooks Inference — our default LLM provider over the Cloudflare AI Gateway. Branded "Workbooks
  # Inference"; the gateway account/pricing/token are OUR product, not the open standard.
  @inference_default_model "anthropic/claude-opus-4.8"
  # Cloudflare publishes the full catalog (no JSON /models endpoint on the gateway) as a PUBLIC markdown
  # page; the routable id lives in each entry's link URL (e.g. `anthropic/claude-opus-4.8`,
  # `@cf/openai/gpt-oss-120b`). We fetch + parse it server-side (no token needed — it's public docs) and
  # serve it to every nexus. Clients only ever see /cloud/inference/models — never Cloudflare directly.
  @cf_models_url "https://developers.cloudflare.com/ai/models/index.md"

  # The effective model list — LIVE from Cloudflare's catalog, cached (1h), with the curated set as the
  # fallback when the fetch fails (offline / parse yields too few). The base carries task + derived
  # modalities + role (agent vs generator); a background crawl of each model's page enriches it with
  # vision/function-calling/context/unit-pricing (CF only exposes those on per-model pages), cached 24h.
  def inference_model_list do
    base = cached_inference_models()
    ensure_cf_enrichment(base)
    merge_enrichment(base)
  end

  # Per-model facts (from models.dev, with a CF page-crawl fallback) merged onto the base by id. The
  # overlay's precise input/output modalities win when present; the CF-task-derived modalities stand in
  # otherwise (e.g. generators models.dev doesn't list). Cost/context/tool/reasoning come along too.
  defp merge_enrichment(base) do
    ex = enrichment_cache()

    Enum.map(base, fn m ->
      case Map.get(ex, m.id) do
        nil ->
          m

        meta ->
          # models.dev meta carries explicit modalities; the CF-crawl fallback carries only a `vision`
          # flag (image input) — fold that into the task-derived base.
          modal_in =
            cond do
              meta[:modal_in] -> meta[:modal_in]
              Map.get(meta, :vision) and "text" in (m[:modal_out] || []) -> Enum.uniq((m[:modal_in] || []) ++ ["image"])
              true -> m[:modal_in]
            end

          modal_out = meta[:modal_out] || m[:modal_out]

          m
          |> Map.merge(Map.drop(meta, [:modal_in, :modal_out, :vision]))
          |> Map.put(:modal_in, modal_in)
          |> Map.put(:modal_out, modal_out)
      end
    end)
  end

  defp enrichment_cache do
    case :persistent_term.get({:cf_enrich_cache}, nil) do
      {ts, map, ttl} -> if System.os_time(:second) - ts < ttl, do: map, else: %{}
      _ -> %{}
    end
  end

  # Kick off a single bounded enrichment pass when the cache is cold and none is in flight. Primary source
  # is models.dev (one structured JSON — a genuine data payload at a network boundary, the allowed JSON
  # exception); matched by normalized model id (CF writes "claude-opus-4.8", models.dev "claude-opus-4-8",
  # plus -preview/date suffixes). The handful models.dev lacks (legacy @cf Workers-AI) fall back to a crawl
  # of that model's CF page. Progressive: task-derived modalities serve immediately, the rest land in ~secs.
  defp ensure_cf_enrichment(base) do
    fresh? =
      case :persistent_term.get({:cf_enrich_cache}, nil) do
        {ts, _m, ttl} -> System.os_time(:second) - ts < ttl
        _ -> false
      end

    if not fresh? and not :persistent_term.get({:cf_enrich_running}, false) do
      :persistent_term.put({:cf_enrich_running}, true)
      ids = Enum.map(base, & &1.id)

      spawn(fn ->
        try do
          md = fetch_models_dev()

          map =
            ids
            |> Task.async_stream(fn id -> {id, resolve_model_meta(id, md)} end,
              max_concurrency: 10, timeout: 15_000, on_timeout: :kill_task)
            |> Enum.flat_map(fn
              {:ok, {id, meta}} when is_map(meta) -> [{id, meta}]
              _ -> []
            end)
            |> Map.new()

          if map_size(map) > 0,
            do: :persistent_term.put({:cf_enrich_cache}, {System.os_time(:second), map, 86_400})
        after
          :persistent_term.put({:cf_enrich_running}, false)
        end
      end)
    end

    :ok
  end

  # models.dev first; only the legacy @cf Workers-AI models it lacks fall back to a CF page crawl.
  defp resolve_model_meta(id, md_index) do
    case md_lookup(md_index, id) do
      meta when is_map(meta) -> meta
      _ -> if String.contains?(id, "@cf/"), do: crawl_cf_model(id), else: nil
    end
  end

  # Fetch the whole models.dev catalog and flatten it to a normalized-tail → meta index across every
  # provider (modalities, $/M cost, context, function-calling, reasoning). One request, cached implicitly
  # by the enrichment cache TTL. Returns %{} on any failure (callers degrade to the CF crawl / task data).
  defp fetch_models_dev do
    url = "https://models.dev/api.json"
    headers = [{~c"user-agent", ~c"workbooks-nexus"}, {~c"accept", ~c"application/json"}]

    with {:ok, {{_, code, _}, _h, body}} when code in 200..299 <-
           :httpc.request(:get, {to_charlist(url), headers},
             [timeout: 30_000, autoredirect: true, ssl: [verify: :verify_none]], body_format: :binary),
         {:ok, json} <- Jason.decode(body) do
      for {_prov, p} <- json, is_map(p), {mid, m} <- (p["models"] || %{}), is_map(m), into: %{} do
        {norm_id(mid), models_dev_meta(m)}
      end
    else
      _ -> %{}
    end
  rescue
    _ -> %{}
  catch
    _, _ -> %{}
  end

  defp models_dev_meta(m) do
    mod = m["modalities"] || %{}

    %{
      modal_in: (mod["input"] || ["text"]) |> Enum.map(&to_string/1),
      modal_out: (mod["output"] || ["text"]) |> Enum.map(&to_string/1),
      price_in: get_in(m, ["cost", "input"]),
      price_out: get_in(m, ["cost", "output"]),
      context: get_in(m, ["limit", "context"]),
      tools: m["tool_call"] == true,
      reasoning: m["reasoning"] == true
    }
  end

  # Match a routable id against the models.dev index by its model tail, ignoring provider + . - _ casing,
  # then by prefix (handles models.dev's -preview / -<date> suffixes vs CF's bare id).
  defp md_lookup(index, _id) when map_size(index) == 0, do: nil

  defp md_lookup(index, id) do
    tail = id |> String.split("/") |> List.last()
    nt = norm_id(tail)

    case Map.get(index, nt) do
      m when is_map(m) ->
        m

      _ ->
        case Enum.find(index, fn {k, _} -> String.starts_with?(k, nt) or String.starts_with?(nt, k) end) do
          {_, m} -> m
          _ -> nil
        end
    end
  end

  defp norm_id(s), do: s |> to_string() |> String.downcase() |> String.replace(~r/[.\-_ ]/, "")

  # Fetch one model's public page (markdown) and pull its Model Info table: context window, function
  # calling, vision, and unit pricing ($/M input & output tokens). Returns a meta map or nil.
  defp crawl_cf_model(id) do
    url = "https://developers.cloudflare.com/ai/models/#{id}/index.md"
    headers = [{~c"accept", ~c"text/markdown"}, {~c"user-agent", ~c"workbooks-nexus"}]

    case :httpc.request(:get, {to_charlist(url), headers},
           [timeout: 12_000, autoredirect: true, ssl: [verify: :verify_none]], body_format: :binary) do
      {:ok, {{_, code, _}, _h, body}} when code in 200..299 -> parse_cf_model_info(body)
      _ -> nil
    end
  rescue
    _ -> nil
  catch
    _, _ -> nil
  end

  defp parse_cf_model_info(body) do
    md = String.replace(body, ~r/<[^>]*>/, " ")

    meta = %{
      context: cf_int(md, ~r/Context Window[^\n]*?\|\s*([\d,]+)\s*tokens/i),
      tools: cf_row_yes?(md, "Function calling"),
      vision: cf_row_yes?(md, "Vision"),
      price_in: cf_price(md, "input"),
      price_out: cf_price(md, "output")
    }

    # Only return when we actually learned something — keeps junk pages out of the cache.
    if meta.context || meta.price_in || meta.tools || meta.vision, do: meta, else: nil
  end

  defp cf_row_yes?(md, label), do: Regex.match?(~r/#{Regex.escape(label)}[^\n|]*\|\s*Yes/i, md)

  defp cf_int(md, re) do
    case Regex.run(re, md) do
      [_, n] ->
        case n |> String.replace(",", "") |> Integer.parse() do
          {i, _} -> i
          _ -> nil
        end

      _ ->
        nil
    end
  end

  defp cf_price(md, dir) do
    case Regex.run(~r/\$\s*([\d.]+)\s*per\s*M\s*#{dir}/i, md) do
      [_, n] ->
        case Float.parse(n) do
          {f, _} -> f
          _ -> nil
        end

      _ ->
        nil
    end
  end

  defp cached_inference_models do
    now = System.os_time(:second)

    case :persistent_term.get({:cf_models_cache}, nil) do
      {ts, list, ttl} when now - ts < ttl ->
        list

      _ ->
        case fetch_cf_models() do
          live when is_list(live) and live != [] ->
            :persistent_term.put({:cf_models_cache}, {now, live, 3600})
            live

          _ ->
            # Unreachable / parse too small → curated fallback, cached briefly so we retry soon.
            :persistent_term.put({:cf_models_cache}, {now, model_catalog(), 300})
            model_catalog()
        end
    end
  end

  # GET Cloudflare's public models markdown and parse it. Returns our model shape (text-generation only)
  # or nil on any failure so the caller falls back to the curated catalog.
  defp fetch_cf_models do
    :inets.start()
    :ssl.start()
    headers = [{~c"accept", ~c"text/markdown"}, {~c"user-agent", ~c"workbooks-nexus"}]

    case :httpc.request(:get, {to_charlist(@cf_models_url), headers},
           [timeout: 12_000, autoredirect: true, ssl: [verify: :verify_none]], body_format: :binary) do
      {:ok, {{_, code, _}, _h, body}} when code in 200..299 -> parse_cf_models(body)
      _ -> nil
    end
  rescue
    _ -> nil
  catch
    _, _ -> nil
  end

  # Each entry is a markdown link `[<logo><name><Task> • <Provider>…](<…/ai/models/{id}/>)`; the routable
  # id is the URL path and the Task sits inside the bracket text. We keep EVERY model (text + generators),
  # deriving each entry's task + modalities + role from that text; the label is the id's last segment.
  @cf_entry_re ~r/\[\s*(?:📌)?\s*(?:!\[[^\]]*\]\([^)]*\))?([^\[\]]+?)\]\((https:\/\/developers\.cloudflare\.com\/ai\/models\/[^)\s]+?)\/?\)/u

  # CF task vocabulary (used both to recognise a real model entry and to derive modalities).
  @cf_tasks [
    "Text Generation", "Text-to-Image", "Image-to-Image", "Text-to-Video", "Image-to-Video",
    "Text-to-Speech", "Automatic Speech Recognition", "Text Embeddings", "Text Classification",
    "Image Classification", "Object Detection", "Image-to-Text", "Translation", "Summarization"
  ]

  defp parse_cf_models(md) do
    models =
      for [_, text, url] <- Regex.scan(@cf_entry_re, md), task = cf_task(text), task != nil do
        id = String.replace_prefix(url, "https://developers.cloudflare.com/ai/models/", "")
        {modal_in, modal_out, role} = cf_modality(task)

        %{
          id: id, label: id |> String.split("/") |> List.last(),
          provider: cf_provider(id), tier: cf_tier(id),
          task: task, modal_in: modal_in, modal_out: modal_out, role: role
        }
      end
      |> Enum.uniq_by(& &1.id)

    if length(models) >= 10, do: models, else: nil
  end

  # The first known task name contained in the entry text (case-insensitive), or nil for a non-model link.
  defp cf_task(text) do
    t = String.downcase(text)
    Enum.find(@cf_tasks, fn task -> String.contains?(t, String.downcase(task)) end)
  end

  # Map a task to {input modalities, output modalities, role}. role "agent" = text-out brain candidate;
  # "generator" = a tool/toolkit backend (image/video/audio/embedding/classification output).
  defp cf_modality(task) do
    case task do
      "Text Generation" -> {["text"], ["text"], "agent"}
      "Summarization" -> {["text"], ["text"], "generator"}
      "Translation" -> {["text"], ["text"], "generator"}
      "Text Embeddings" -> {["text"], ["embedding"], "generator"}
      "Text Classification" -> {["text"], ["label"], "generator"}
      "Text-to-Image" -> {["text"], ["image"], "generator"}
      "Image-to-Image" -> {["image"], ["image"], "generator"}
      "Text-to-Video" -> {["text"], ["video"], "generator"}
      "Image-to-Video" -> {["image"], ["video"], "generator"}
      "Text-to-Speech" -> {["text"], ["audio"], "generator"}
      "Automatic Speech Recognition" -> {["audio"], ["text"], "generator"}
      "Image-to-Text" -> {["image"], ["text"], "generator"}
      "Image Classification" -> {["image"], ["label"], "generator"}
      "Object Detection" -> {["image"], ["label"], "generator"}
      _ -> {["text"], ["text"], "generator"}
    end
  end

  # Provider slug for grouping/icons — strip the `@cf/` (Workers-AI) prefix, take the author segment.
  defp cf_provider(id), do: id |> String.replace_prefix("@cf/", "") |> String.split("/") |> List.first()

  defp cf_tier(id) do
    s = String.downcase(id)

    cond do
      String.contains?(s, ["o1", "o3", "o4", "reason", "-r1", "thinking"]) -> "reasoning"
      String.contains?(s, ["mini", "flash", "haiku", "small", "lite", "8b", "-fast"]) -> "fast"
      String.contains?(s, ["llama", "mistral", "qwen", "gemma", "deepseek-chat", "workers-ai"]) -> "open"
      true -> "frontier"
    end
  end

  # Curated catalog of routable `provider/model` ids over the Cloudflare AI Gateway — the FALLBACK when the
  # live gateway list isn't available (no token yet / unreachable). tier: frontier | fast | reasoning | open.
  # All curated entries are chat brains, so they carry text→text modalities + the "agent" role.
  def model_catalog do
    Enum.map(curated_models(), fn m ->
      Map.merge(%{task: "Text Generation", modal_in: ["text"], modal_out: ["text"], role: "agent"}, m)
    end)
  end

  defp curated_models do
    [
      # OpenAI
      %{id: "openai/gpt-5.2", label: "GPT-5.2", provider: "openai", tier: "frontier"},
      %{id: "openai/gpt-5.2-mini", label: "GPT-5.2 Mini", provider: "openai", tier: "fast"},
      %{id: "openai/gpt-5.1", label: "GPT-5.1", provider: "openai", tier: "frontier"},
      %{id: "openai/gpt-4.1", label: "GPT-4.1", provider: "openai", tier: "frontier"},
      %{id: "openai/gpt-4.1-mini", label: "GPT-4.1 Mini", provider: "openai", tier: "fast"},
      %{id: "openai/gpt-4o", label: "GPT-4o", provider: "openai", tier: "frontier"},
      %{id: "openai/gpt-4o-mini", label: "GPT-4o Mini", provider: "openai", tier: "fast"},
      %{id: "openai/o4", label: "o4", provider: "openai", tier: "reasoning"},
      %{id: "openai/o4-mini", label: "o4-mini", provider: "openai", tier: "reasoning"},
      # Anthropic
      %{id: "anthropic/claude-opus-4-5", label: "Claude Opus 4.5", provider: "anthropic", tier: "frontier"},
      %{id: "anthropic/claude-4-5-sonnet", label: "Claude 4.5 Sonnet", provider: "anthropic", tier: "frontier"},
      %{id: "anthropic/claude-4-5-haiku", label: "Claude 4.5 Haiku", provider: "anthropic", tier: "fast"},
      %{id: "anthropic/claude-3-7-sonnet", label: "Claude 3.7 Sonnet", provider: "anthropic", tier: "frontier"},
      %{id: "anthropic/claude-3-5-haiku", label: "Claude 3.5 Haiku", provider: "anthropic", tier: "fast"},
      # Google
      %{id: "google/gemini-2.5-pro", label: "Gemini 2.5 Pro", provider: "google", tier: "frontier"},
      %{id: "google/gemini-2.5-flash", label: "Gemini 2.5 Flash", provider: "google", tier: "fast"},
      %{id: "google/gemini-2.5-flash-lite", label: "Gemini 2.5 Flash-Lite", provider: "google", tier: "fast"},
      %{id: "google/gemini-2.0-flash", label: "Gemini 2.0 Flash", provider: "google", tier: "fast"},
      # xAI
      %{id: "grok/grok-4", label: "Grok 4", provider: "grok", tier: "frontier"},
      %{id: "grok/grok-4-mini", label: "Grok 4 Mini", provider: "grok", tier: "fast"},
      %{id: "grok/grok-3", label: "Grok 3", provider: "grok", tier: "frontier"},
      # Mistral
      %{id: "mistral/mistral-large-latest", label: "Mistral Large", provider: "mistral", tier: "frontier"},
      %{id: "mistral/mistral-small-latest", label: "Mistral Small", provider: "mistral", tier: "fast"},
      %{id: "mistral/codestral-latest", label: "Codestral", provider: "mistral", tier: "fast"},
      # DeepSeek
      %{id: "deepseek/deepseek-chat", label: "DeepSeek V3", provider: "deepseek", tier: "frontier"},
      %{id: "deepseek/deepseek-reasoner", label: "DeepSeek R1", provider: "deepseek", tier: "reasoning"},
      # Meta / Workers AI (no per-token billing — Workers AI pricing)
      %{id: "workers-ai/@cf/meta/llama-4-scout-17b-16e-instruct", label: "Llama 4 Scout", provider: "workers-ai", tier: "open"},
      %{id: "workers-ai/@cf/meta/llama-3.3-70b-instruct-fp8-fast", label: "Llama 3.3 70B", provider: "workers-ai", tier: "open"},
      %{id: "workers-ai/@cf/meta/llama-3.1-8b-instruct-fast", label: "Llama 3.1 8B", provider: "workers-ai", tier: "open"}
    ]
  end

  def inference_models(_req), do: %{models: inference_model_list(), provider: "Workbooks Inference", default_model: @inference_default_model}

  # The generator-model roster behind the image/video/speech toolkits — every catalog model whose OUTPUT is
  # a non-text modality, grouped by that modality (image | video | audio | …). The generator toolkits are
  # ROUTERS over this LIVE set: the .work manifest/skill carries the routing context, the model list is
  # never hardcoded, so new gateway generators surface automatically. Map toolkit → modality keeps the two
  # in sync (image-generation→image, video-generation→video, speech→audio).
  @generator_toolkits %{"image" => "image-generation", "video" => "video-generation", "audio" => "speech"}

  def generators(_req) do
    grouped =
      inference_model_list()
      |> Enum.filter(&(&1[:role] == "generator"))
      |> Enum.group_by(fn m -> List.first(m[:modal_out] || ["text"]) end)

    %{generators: grouped, toolkits: @generator_toolkits}
  end

  defp inference_config(tenant) do
    case Nexus.ControlPlane.get(tenant, :inference, "config") do
      {:ok, c} when is_map(c) -> ensure_enforced(tenant, c)
      _ -> ensure_enforced(tenant, %{})
    end
  end

  # Every control-plane org is gated: the money-boundary admission (Nexus.Inference.Admission) only
  # enforces when the config carries `enforce: true`, so we establish that (and a zero starting balance)
  # the first time an org's inference config is read. A tenant runtime / dev box (control plane off) is
  # left ungated — the open-standard runtime never pays. Self-healing: no migration needed.
  defp ensure_enforced(tenant, cfg) do
    if is_binary(tenant) and Nexus.ControlPlane.enabled?() and Map.get(cfg, :enforce) != true do
      seeded = cfg |> Map.put(:enforce, true) |> Map.put_new(:balance, 0.0)
      Nexus.ControlPlane.put(tenant, :inference, "config", seeded)
      seeded
    else
      cfg
    end
  end

  def inference_status(req) do
    cfg = inference_config(req.tenant)
    reg = inference_registry_cfg(req.tenant)

    %{
      provider: "Workbooks Inference",
      balance: Map.get(cfg, :balance) || 0.0,
      spent_mtd: Map.get(cfg, :spent_mtd) || 0.0,
      default_model: Map.get(cfg, :default_model) || @inference_default_model,
      monthly_cap: Map.get(cfg, :monthly_cap),
      per_run_cap: Map.get(cfg, :per_run_cap),
      enforce: Map.get(cfg, :enforce) == true,
      # Active model-access policy (for the admin surface): how many models the active group admits and
      # which capabilities are switched off org-wide.
      registry: %{
        active_group: Map.get(reg, :active_group),
        group_count: length(Map.get(reg, :groups) || []),
        allow_count: length(Map.get(cfg, :allow_ids) || []),
        caps: Map.get(reg, :caps) || %{}
      },
      models: inference_model_list(),
      # Transparent pricing: Cloudflare passes provider rates through (no per-token markup); the 5% is on
      # top-ups. Workbooks adds 0.5%. Shown to the customer as an itemized footnote.
      pricing: %{cloudflare_pct: 5.0, workbooks_pct: 0.5,
        note: "Inference is billed at provider rates with no per-token markup. Top-ups carry a 5% Cloudflare fee + a 0.5% Workbooks fee."}
    }
  end

  def inference_config_save(req) do
    b = (is_map(req.body) && req.body) || %{}

    upd =
      inference_config(req.tenant)
      |> maybe_put(:default_model, b["default_model"])
      |> maybe_put(:monthly_cap, inf_num(b["monthly_cap"]))
      |> maybe_put(:per_run_cap, inf_num(b["per_run_cap"]))

    Nexus.ControlPlane.put(req.tenant, :inference, "config", upd)
    {200, %{ok: true, config: upd}}
  end

  # ── Model-access registry — the highest-level AI/LLM management surface. Admins define model GROUPS
  # (a preset rule over the live catalog + hand pin/exclude overrides), choose which group is ACTIVE for
  # the whole org, and flip per-modality capability switches (no image / no video / …). The active group
  # resolves to a concrete allow-list; that list + the caps are mirrored into the inference config so the
  # money-boundary gate enforces them on EVERY inference path. THE LINE: what "frontier"/"cheap" means is
  # our opinion, expressed as data — core only enforces the resolved list.
  @inf_presets %{
    "frontier" => %{tiers: ["frontier", "reasoning"], text_only: true},
    "cheap" => %{tiers: ["fast", "open"], text_only: true},
    "text_only" => %{text_only: true},
    "no_image" => %{exclude_modalities: ["image"]},
    "all" => %{}
  }

  defp inference_registry_cfg(tenant) do
    case Nexus.ControlPlane.get(tenant, :inference, "registry") do
      {:ok, r} when is_map(r) -> r
      _ -> %{groups: [], active_group: nil, caps: %{}}
    end
  end

  def inference_registry(req) do
    reg = inference_registry_cfg(req.tenant)

    %{
      groups: Map.get(reg, :groups) || [],
      active_group: Map.get(reg, :active_group),
      caps: Map.get(reg, :caps) || %{},
      presets: Map.keys(@inf_presets),
      models: inference_model_list()
    }
  end

  # Save the registry, then PROJECT it into the enforced config: resolve the active group → allow_ids,
  # normalize caps. Admin-only (route auth). Empty/`nil` active group ⇒ no allow_ids ⇒ every model allowed.
  def inference_registry_save(req) do
    b = (is_map(req.body) && req.body) || %{}
    groups = Enum.map(b["groups"] || [], &normalize_group/1)
    active = b["active_group"]
    caps = normalize_caps(b["caps"])

    reg = %{groups: groups, active_group: active, caps: caps}
    Nexus.ControlPlane.put(req.tenant, :inference, "registry", reg)

    allow_ids = resolve_allow_ids(groups, active)

    inference_config(req.tenant)
    |> Map.put(:enforce, true)
    |> Map.put(:allow_ids, allow_ids)
    |> Map.put(:caps, caps)
    |> then(&Nexus.ControlPlane.put(req.tenant, :inference, "config", &1))

    {200, %{ok: true, active_group: active, allow_count: length(allow_ids), caps: caps}}
  end

  defp normalize_group(g) when is_map(g) do
    rule = g["rule"] || %{}

    %{
      id: to_string(g["id"] || gen_id()),
      name: to_string(g["name"] || "Group"),
      preset: g["preset"],
      rule: %{
        tiers: g["preset"] && @inf_presets[g["preset"]][:tiers] || rule["tiers"] || [],
        max_price_out: inf_num(rule["max_price_out"]),
        text_only: rule["text_only"] == true or (g["preset"] && @inf_presets[g["preset"]][:text_only]) == true,
        exclude_modalities: rule["exclude_modalities"] || (g["preset"] && @inf_presets[g["preset"]][:exclude_modalities]) || []
      },
      pin: g["pin"] || [],
      exclude: g["exclude"] || []
    }
  end

  defp normalize_group(_), do: nil

  defp normalize_caps(caps) when is_map(caps) do
    for k <- ["image", "video", "audio"], into: %{}, do: {String.to_atom(k), Map.get(caps, k, true) != false}
  end

  defp normalize_caps(_), do: %{image: true, video: true, audio: true}

  # The active group resolves to a concrete id set: every catalog model matching the group's rule, plus
  # hand-pinned ids, minus hand-excluded ids. No active group ⇒ [] ⇒ unrestricted (admission default).
  defp resolve_allow_ids(_groups, active) when active in [nil, ""], do: []

  defp resolve_allow_ids(groups, active) do
    case Enum.find(groups, &(&1[:id] == active)) do
      nil ->
        []

      g ->
        models = inference_model_list()
        matched = models |> Enum.filter(&group_match?(g[:rule], &1)) |> Enum.map(& &1.id)
        ((matched ++ (g[:pin] || [])) -- (g[:exclude] || [])) |> Enum.uniq()
    end
  end

  defp group_match?(rule, m) do
    tiers = rule[:tiers] || []
    out = m[:modal_out] || ["text"]
    excl = rule[:exclude_modalities] || []

    (tiers == [] or to_string(m[:tier]) in tiers) and
      (is_nil(rule[:max_price_out]) or (is_number(m[:price_out]) and m[:price_out] <= rule[:max_price_out])) and
      (rule[:text_only] != true or out == ["text"]) and
      not Enum.any?(excl, &(&1 in out))
  end

  # Inference credit top-off → a real Polar checkout for a one-time custom-amount product. The checkout is
  # bound to the org via `external_customer_id` so Polar reuses the CARD ON FILE from the customer's first
  # purchase (the onboarding subscription) — top-ups are one click. Settlement happens on the Polar webhook
  # (`order.paid`), which credits the org ledger via `credit_inference/2`. The 5% CF + 0.5% WB fee rides on
  # top, so the customer pays `amount * 1.055` and receives `amount` of credit. When Polar isn't configured
  # we record the intent and return pending — never a fake success.
  def inference_topup(req) do
    b = (is_map(req.body) && req.body) || %{}
    amount = inf_num(b["amount"])
    tenant = req.tenant || Nexus.Store.default_tenant()

    cond do
      is_nil(amount) or amount <= 0 ->
        {400, %{error: "amount must be a positive number"}}

      true ->
        total = Float.round(amount * 1.055, 2)
        product = Nexus.Config.polar_credit_product()

        cond do
          not Nexus.Polar.configured?() or is_nil(product) ->
            {200, %{pending: true, amount: amount, total: total,
              message: "Top-up of $#{usd(amount)} (≈ $#{usd(total)} with fees) is noted — billing is not configured on this nexus yet."}}

          true ->
            opts = [
              products: [product],
              external_customer_id: tenant,
              customer_email: b["email"],
              success_url: b["success_url"],
              # amount in cents; the credit the customer receives is `amount` (metadata), fee rides on top.
              amount: round(total * 100),
              metadata: %{tenant: tenant, purpose: "inference_credit", credit: amount}
            ]

            case Nexus.Polar.create_checkout(opts) do
              {:ok, %{url: url, id: id}} ->
                {200, %{url: url, checkout_id: id, amount: amount, total: total}}

              {:error, reason} ->
                {502, %{error: "could not start checkout", detail: inspect(reason)}}
            end
        end
    end
  end

  # Onboarding (and upgrade) subscription checkout — tier → Polar subscription product. Binds the checkout
  # to the org via `external_customer_id` so the card is stored for later inference top-ups. The onboarding
  # `profile` (account type, name, usecases) rides as metadata so the webhook can finish provisioning.
  def billing_checkout(req) do
    b = (is_map(req.body) && req.body) || %{}
    tier = to_string(b["tier"] || b["plan"] || "")
    tenant = req.tenant || Nexus.Store.default_tenant()
    product = tier != "" && Nexus.Config.polar_product(tier)

    cond do
      tier == "" ->
        {400, %{error: "tier is required"}}

      not Nexus.Polar.configured?() or is_nil(product) or product == false ->
        {200, %{pending: true, tier: tier,
          message: "Checkout for the #{tier} plan is not configured on this nexus yet."}}

      true ->
        opts = [
          products: [product],
          external_customer_id: tenant,
          customer_email: b["email"],
          customer_name: b["name"],
          success_url: b["success_url"],
          metadata: %{tenant: tenant, purpose: "subscription", tier: tier,
            profile: (is_binary(b["profile"]) && String.slice(b["profile"], 0, 500)) || ""}
        ]

        case Nexus.Polar.create_checkout(opts) do
          {:ok, %{url: url, id: id}} -> {200, %{url: url, checkout_id: id, tier: tier}}
          {:error, reason} -> {502, %{error: "could not start checkout", detail: inspect(reason)}}
        end
    end
  end

  # Billing status for the dashboard — whether Polar is live + the org's current subscription (tier set by
  # the webhook on `subscription.active`). Balance lives on the inference config (see `inference_status`).
  def billing_status(req) do
    tenant = req.tenant || Nexus.Store.default_tenant()
    sub =
      case Nexus.ControlPlane.get(tenant, :billing, "subscription") do
        {:ok, s} when is_map(s) -> s
        _ -> nil
      end

    %{configured: Nexus.Polar.configured?(), server: Nexus.Config.polar_server(), subscription: sub}
  end

  # Polar webhook — Standard-Webhooks HMAC-verified, then SETTLES the purchase. Credit top-ups
  # (`purpose: "inference_credit"`) add to the org ledger; subscriptions set the org's active tier. Surfaces
  # a `billing.<type>` #event on the bus for the Activity feed. Fail closed on a bad signature.
  def polar_webhook(req) do
    raw = req[:raw_body] || ""
    headers = req[:headers] || %{}

    if Nexus.Polar.verify_webhook(raw, headers) do
      payload = (is_map(req.body) && req.body) || %{}
      type = payload["type"] || "unknown"
      data = payload["data"] || %{}
      meta = data["metadata"] || %{}
      # Tenant from the Polar-VERIFIED customer binding (external_customer_id set at checkout), NOT the
      # buyer-controlled metadata — otherwise a crafted event could settle credit/tier onto another org
      # (red-team wb-8l5s). Falls back to meta/req only when the verified field is absent.
      tenant =
        data["external_customer_id"] || get_in(data, ["customer", "external_id"]) ||
          meta["tenant"] || req.tenant || Nexus.Store.default_tenant()

      # Idempotency (red-team wb-c0tu): Polar RETRIES deliveries and order.paid + order.updated both fire
      # for one purchase — without dedup, credit applies N times. Skip a webhook-id we've already settled.
      wid = headers["webhook-id"]

      cond do
        is_binary(wid) and webhook_seen?(tenant, wid) ->
          %{ok: true, deduped: true}

        true ->
          settle_polar(type, tenant, meta, data)
          if is_binary(wid), do: mark_webhook_seen(tenant, wid)

          Nexus.Events.emit(
            %{kind: "billing.#{type}", actor: "polar", title: "Polar #{type}",
              target: tenant, tags: ["event", "billing"], scope: "owner"},
            tenant: tenant
          )

          %{ok: true}
      end
    else
      {401, %{error: "invalid signature"}}
    end
  end

  # webhook-id idempotency markers in the control-plane store (wb-c0tu).
  defp webhook_seen?(tenant, wid) do
    match?({:ok, _}, Nexus.ControlPlane.get(tenant, :polar_webhook, wid))
  end

  defp mark_webhook_seen(tenant, wid) do
    Nexus.ControlPlane.put(tenant, :polar_webhook, wid, %{at: System.system_time(:second)})
  end

  # Apply a verified Polar event. `order.paid` (one-time) → credit the inference ledger by the metadata
  # `credit` amount. Subscription lifecycle → record/clear the org's active tier. Other events are noted
  # via the #event only.
  defp settle_polar(type, tenant, meta, data) do
    cond do
      type in ["order.paid", "order.updated"] and meta["purpose"] == "inference_credit" ->
        credit = inf_num(meta["credit"]) || 0.0
        if credit > 0, do: credit_inference(tenant, credit)

      type in ["subscription.active", "subscription.created", "subscription.updated"] ->
        Nexus.ControlPlane.put(tenant, :billing, "subscription",
          %{tier: meta["tier"], status: "active", polar_id: data["id"]})

      type in ["subscription.canceled", "subscription.revoked"] ->
        Nexus.ControlPlane.put(tenant, :billing, "subscription",
          %{tier: meta["tier"], status: "canceled", polar_id: data["id"]})

      true ->
        :ok
    end
  end

  # Add `amount` USD of inference credit to the org ledger (the balance read by `inference_status`).
  defp credit_inference(tenant, amount) do
    cfg = inference_config(tenant)
    bal = (Map.get(cfg, :balance) || 0.0) + amount
    Nexus.ControlPlane.put(tenant, :inference, "config", Map.put(cfg, :balance, Float.round(bal / 1, 2)))
  end

  defp usd(n), do: :erlang.float_to_binary(n / 1, decimals: 2)

  # Best-effort run cost: a single total-token count × the model's blended $/Mtok rate (avg of input +
  # output prices from the catalog enrichment). The exact in/out split isn't carried per-run, so this is
  # a settlement estimate — admission already hard-gated on balance > 0; this debits the ledger after.
  defp run_cost(model, tokens) do
    m = Enum.find(inference_model_list(), &(&1.id == model)) || %{}
    pin = (is_number(m[:price_in]) && m[:price_in]) || 0.0
    pout = (is_number(m[:price_out]) && m[:price_out]) || 0.0
    rate = (pin + pout) / 2
    Float.round(tokens / 1_000_000 * rate, 6)
  end

  defp inf_num(nil), do: nil
  defp inf_num(n) when is_number(n), do: n / 1
  defp inf_num(s) when is_binary(s) do
    case Float.parse(String.trim(s)) do
      {f, _} -> f
      _ -> nil
    end
  end
  defp inf_num(_), do: nil

  # An app is GATED (lock) when its workbook declares an `auth` block — our auth guardian
  # (Nexus.Auth.Guard) protects it. No auth block ⇒ public (globe), an open hosted surface. Only the
  # mount's root-level .work is checked (where index/auth live), so it stays cheap.
  defp mount_gated?(root) do
    Path.wildcard(Path.join(root, "*.work"))
    |> Enum.any?(fn f ->
      try do
        File.read!(f) |> Nexus.Literate.parse() |> Enum.any?(&(&1.type == :code and &1.kind == "auth"))
      rescue
        _ -> false
      end
    end)
  end

  # Resolve a `<mount>/<rel>` request path to a real absolute file under data_dir, with the same
  # mount + traversal guard as :tree. Returns {:ok, abs} | {:error, status, msg}.
  defp resolve_file(path) do
    case String.split(String.trim(path || ""), "/", trim: true) do
      [] ->
        {:error, 400, "path required"}

      [mount | rest] ->
        case List.keyfind(mounts(), mount, 0) do
          nil ->
            {:error, 404, "no such mount"}

          {_, root} ->
            abs = Path.expand(Path.join([root | rest]))

            cond do
              not within_mount?(abs, root) -> {:error, 403, "path escapes mount"}
              not File.regular?(abs) -> {:error, 404, "not a file"}
              true -> {:ok, abs}
            end
        end
    end
  end

  @max_text_bytes 2_097_152

  # Text content for code/.work/markdown viewers. Binary files (by MIME) get `binary: true` so the
  # client fetches bytes from /cloud/raw instead.
  def file_read(req) do
    case resolve_file(req.query["path"]) do
      {:error, status, msg} ->
        {status, %{error: msg}}

      {:ok, abs} ->
        [mount | _] = String.split(String.trim(req.query["path"]), "/", trim: true)
        {_, root} = List.keyfind(mounts(), mount, 0)

        # Read-side per-workspace ACL (wb-ate4): a draft/private workspace is only readable by its
        # owner/members — not every authenticated user. Multi-tenant only; dev is trusted.
        if not may_read_workspace?(req, mount, root) do
          forbidden()
        else
          ct = MIME.from_path(abs)
          size = (File.stat!(abs).size || 0)
          is_text = String.starts_with?(ct, "text/") or ct in ~w(application/json application/javascript application/xml image/svg+xml) or text_ext?(abs)

          cond do
            not is_text -> %{path: req.query["path"], binary: true, content_type: ct, size: size}
            size > @max_text_bytes -> %{path: req.query["path"], binary: false, truncated: true, size: size, content: binary_part(File.read!(abs), 0, @max_text_bytes)}
            true -> %{path: req.query["path"], binary: false, size: size, content: File.read!(abs)}
          end
        end
    end
  end

  # Save an edited file: write to the volume, commit into the workspace repo (provisioning it if needed),
  # then recompile. Body: %{path: "<ws>/<rel>", content: "…"}.
  def file_save(req) do
    path = (is_map(req.body) && req.body["path"]) || req.query["path"]
    content = (is_map(req.body) && req.body["content"]) || ""

    case resolve_file(path) do
      {:error, status, msg} ->
        {status, %{error: msg}}

      {:ok, abs} ->
        [mount | rest] = String.split(String.trim(path), "/", trim: true)
        {_, root} = List.keyfind(mounts(), mount, 0)
        rel = Enum.join(rest, "/")

        # Per-workspace ACL (wb-afvq): a draft is writable only by its owner/admin; private/public by
        # a member+. Multi-tenant only; dev is trusted. Pairs with the authorship gate below.
        if not may_write_workspace?(req, mount, root) do
          forbidden()
        else
        File.write!(abs, content)

        bare = Nexus.Git.bare_path(Nexus.GitHttp.repos_root(), mount)
        Nexus.Git.provision_remote(bare, root)

        # Attribute the commit to the signed-in user (jj/git author) — the basis for the attributed
        # change-log and multi-user/tenant scoping. The authorship gate verifies any device-key proof
        # and (under the :hard policy) rejects an unsigned edit; the returned author is who to credit.
        case gate_or_reject(req, path, content, user_key(req)) do
          {:reject, resp} -> resp
          {:ok, who} ->
            result = Nexus.Git.commit_file(bare, root, rel, "edit #{rel} via dashboard", author: "#{who} <#{who}>")
            spawn(fn -> if function_exported?(Nexus.Server, :remount, 0), do: Nexus.Server.remount() end)

            case result do
              {:ok, sha} ->
                # Record the change in the durable, attributed log (the Activity feed): a #event → the
                # `log` effect persists it to resource Event — who changed what, where, with the sha.
                Nexus.Events.emit(
                  %{kind: "workspace.change", actor: who, title: "edited #{rel} in #{mount}",
                    target: sha, tags: ["event", "change"], scope: "member"},
                  tenant: req.tenant
                )
                %{ok: true, sha: sha}

              :nochange -> %{ok: true, nochange: true}
              {:error, out} -> {500, %{error: out}}
            end
        end
        end
    end
  end

  # The cloud-commit chokepoint (fix wb-i2c8): run a contribution through Nexus.Authorship.gate_contribution
  # BEFORE it is committed. The client may carry a device-key proof in `body["author"]` (%{did, sig});
  # the signed uid is FORCED to the authenticated user (never the client's claim). Returns the author
  # string to attribute the commit to, or `{:reject, resp}` (403 under the :hard policy when unsigned).
  defp gate_or_reject(req, target, bytes, who) do
    ca = (is_map(req.body) && req.body["author"]) || %{}
    proof = %{
      author: %{uid: String.downcase(to_string(who)), did: ca["did"], sig: ca["sig"]},
      device_keys: device_keys(req.tenant || Nexus.Store.default_tenant(), String.downcase(to_string(who)))
    }

    case Nexus.Authorship.gate_contribution(proof, target, bytes) do
      {:reject, _} -> {:reject, {403, %{error: "unsigned contribution rejected (authorship policy is 'hard')"}}}
      {:accept, did} -> {:ok, did}
      {:accept_unverified, _} -> {:ok, to_string(who)}
    end
  end

  # Resolve a `<mount>/<rel>` to {abs, mount, root, rel} WITHOUT requiring it to exist (create/rename
  # destinations don't yet). Mount + traversal guarded exactly like resolve_file.
  defp resolve_target(path) do
    case String.split(String.trim(path || ""), "/", trim: true) do
      [] -> {:error, 400, "path required"}
      [mount | rest] ->
        case List.keyfind(mounts(), mount, 0) do
          nil -> {:error, 404, "no such mount"}
          {_, root} ->
            abs = Path.expand(Path.join([root | rest]))
            if within_mount?(abs, root),
              do: {:ok, abs, mount, root, Enum.join(rest, "/")},
              else: {:error, 403, "path escapes mount"}
        end
    end
  end

  # A resolved absolute path is inside a mount iff it IS the root or sits strictly below it. A raw
  # prefix test (no trailing separator) would let a sibling like `studioSECRET` pass for mount
  # `studio` — a `..` escape into a prefix-sharing sibling. Require the separator to close that hole.
  defp within_mount?(abs, root) do
    r = Path.expand(root)
    (abs == r or String.starts_with?(abs, r <> "/")) and not symlink_component?(abs, r)
  end

  # Path.expand collapses `..`/`.` LEXICALLY but does NOT follow symlinks — so a member who plants a
  # symlink inside their workspace (`pwn -> ../../other-ws`) could read/write THROUGH it to outside the
  # mount, defeating the prefix check above (red-team wb-3t3c). A managed workspace tree has no
  # legitimate symlinks, so we reject any path that traverses one: walk each existing component from the
  # mount root down and fail if it's a symlink.
  defp symlink_component?(abs, root) do
    abs
    |> Path.relative_to(root)
    |> Path.split()
    |> Enum.reduce_while(root, fn seg, cur ->
      p = Path.join(cur, seg)

      case File.lstat(p, []) do
        {:ok, %{type: :symlink}} -> {:halt, :symlink}
        _ -> {:cont, p}
      end
    end)
    |> Kernel.==(:symlink)
  end

  # Commit a tree change (delete/rename/new) into the workspace's bare repo, attributed to the user,
  # then remount + log an Activity event. Shared tail for the file-mutation verbs below.
  defp commit_tree_change(req, mount, root, msg, event_title) do
    bare = Nexus.Git.bare_path(Nexus.GitHttp.repos_root(), mount)
    Nexus.Git.provision_remote(bare, root)

    # Per-workspace ACL (wb-afvq) then the authorship chokepoint — a tree change is signed over its
    # message (no single file body); under :hard an unsigned change is rejected.
    with true <- may_write_workspace?(req, mount, root),
         {:ok, who} <- gate_or_reject(req, mount, msg, user_key(req)) do
    result = Nexus.Git.commit_paths(bare, root, msg, author: "#{who} <#{who}>")
    spawn(fn -> if function_exported?(Nexus.Server, :remount, 0), do: Nexus.Server.remount() end)

    case result do
      {:ok, sha} ->
        Nexus.Events.emit(
          %{kind: "workspace.change", actor: who, title: event_title, target: sha,
            tags: ["event", "change"], scope: "member"}, tenant: req.tenant)
        %{ok: true, sha: sha}

      :nochange -> %{ok: true, nochange: true}
      {:error, out} -> {500, %{error: out}}
    end
    else
      false -> forbidden()
      {:reject, resp} -> resp
    end
  end

  # Create a new (empty) file. Body: %{path: "<mount>/<rel>"}. 409 if it already exists.
  def file_new(req) do
    case resolve_target(is_map(req.body) && req.body["path"]) do
      {:error, status, msg} -> {status, %{error: msg}}
      {:ok, abs, mount, root, rel} ->
        cond do
          not may_write_workspace?(req, mount, root) -> forbidden()  # gate BEFORE disk (wb-66do)
          rel == "" -> {400, %{error: "path required"}}
          File.exists?(abs) -> {409, %{error: "already exists"}}
          true ->
            File.mkdir_p!(Path.dirname(abs)); File.write!(abs, "")
            commit_tree_change(req, mount, root, "create #{rel} via dashboard", "created #{rel} in #{mount}")
        end
    end
  end

  # Create a new folder (with a .gitkeep so the empty dir survives the git round-trip). Body: %{path}.
  def file_mkdir(req) do
    case resolve_target(is_map(req.body) && req.body["path"]) do
      {:error, status, msg} -> {status, %{error: msg}}
      {:ok, abs, mount, root, rel} ->
        cond do
          not may_write_workspace?(req, mount, root) -> forbidden()  # gate BEFORE disk (wb-66do)
          rel == "" -> {400, %{error: "path required"}}
          File.exists?(abs) -> {409, %{error: "already exists"}}
          true ->
            File.mkdir_p!(abs); File.write!(Path.join(abs, ".gitkeep"), "")
            commit_tree_change(req, mount, root, "mkdir #{rel} via dashboard", "created folder #{rel} in #{mount}")
        end
    end
  end

  # Rename/move a file or folder. Body: %{from: "<mount>/<rel>", to: "<mount>/<rel>"} (same mount).
  def file_rename(req) do
    from = is_map(req.body) && req.body["from"]
    to = is_map(req.body) && req.body["to"]
    with {:ok, fabs, fmount, root, frel} <- resolve_target(from),
         {:ok, tabs, tmount, _r, trel} <- resolve_target(to) do
      cond do
        not may_write_workspace?(req, fmount, root) -> forbidden()  # gate BEFORE disk (wb-66do)
        frel == "" or trel == "" -> {400, %{error: "from and to required"}}
        fmount != tmount -> {400, %{error: "cross-workspace move not supported"}}
        not File.exists?(fabs) -> {404, %{error: "source not found"}}
        File.exists?(tabs) -> {409, %{error: "destination exists"}}
        true ->
          File.mkdir_p!(Path.dirname(tabs)); File.rename!(fabs, tabs)
          commit_tree_change(req, fmount, root, "rename #{frel} → #{trel} via dashboard", "renamed #{frel} to #{trel} in #{fmount}")
      end
    else
      {:error, status, msg} -> {status, %{error: msg}}
    end
  end

  # Delete a file or folder (recursive). Body: %{path: "<mount>/<rel>"}.
  def file_delete(req) do
    case resolve_target(is_map(req.body) && req.body["path"]) do
      {:error, status, msg} -> {status, %{error: msg}}
      {:ok, abs, mount, root, rel} ->
        cond do
          not may_write_workspace?(req, mount, root) -> forbidden()  # gate BEFORE disk (wb-66do)
          rel == "" -> {400, %{error: "refusing to delete a workspace root"}}
          not File.exists?(abs) -> {404, %{error: "not found"}}
          true ->
            File.rm_rf!(abs)
            commit_tree_change(req, mount, root, "delete #{rel} via dashboard", "deleted #{rel} in #{mount}")
        end
    end
  end

  # Raw bytes with the right Content-Type — for <img> and pdf.js.
  def file_raw(req) do
    case resolve_file(req.query["path"]) do
      {:error, status, msg} -> {status, %{error: msg}}
      {:ok, abs} ->
        [mount | _] = String.split(String.trim(req.query["path"]), "/", trim: true)
        {_, root} = List.keyfind(mounts(), mount, 0)
        # Read-side per-workspace ACL (wb-ate4) — same gate as file_read.
        if may_read_workspace?(req, mount, root),
          do: {200, raw_ct(abs), File.read!(abs)},
          else: forbidden()
    end
  end

  # MIME.from_path returns application/octet-stream for unknown; treat known dev-text extensions as text.
  defp text_ext?(abs) do
    ext = abs |> Path.extname() |> String.downcase()
    ext in ~w(.work .ex .exs .md .txt .js .ts .jsx .tsx .css .html .htm .json .yaml .yml .toml .sh .zig .rs .go .py .rb .sql .org .csv .gitignore .env .lock .heex .eex)
  end

  defp raw_ct(abs) do
    case MIME.from_path(abs) do
      "application/octet-stream" -> "application/octet-stream"
      ct -> ct
    end
  end

  # ── Git remote per workspace ─────────────────────────────────────────────────────────────────────
  # The push URL for a workspace's bare repo + its current GitHub mirror (if any). Base is derived from
  # the request host/scheme when available; otherwise the client prepends location.origin to the
  # relative `/git/<ws>.git`. `ws` is sanitized (no slashes / traversal) before it touches the disk.
  def workspace_git(req) do
    ws = git_ws(req.query["ws"])

    if ws == "" do
      {400, %{error: "ws required"}}
    else
      base =
        case {req[:scheme], req[:host]} do
          {s, h} when is_binary(s) and is_binary(h) and h != "" -> "#{s}://#{h}"
          _ -> ""
        end

      remote = base <> "/git/" <> ws <> ".git"
      mirror = current_mirror(ws)
      %{remote: remote, push: "git push " <> remote <> " main", mirror: mirror}
    end
  end

  # GET /cloud/workspace/branches?ws= — real git branches, current, and dirty count for a workspace.
  def workspace_branches(req) do
    ws = String.trim(req.query["ws"] || "")

    case List.keyfind(mounts(), ws, 0) do
      nil ->
        {404, %{error: "no such workspace"}}

      {_, root} ->
        if not may_read_workspace?(req, ws, root) do
          forbidden()
        else
          branches =
            case System.cmd("git", ["-C", root, "branch", "--format=%(refname:short)"], stderr_to_stdout: true) do
              {out, 0} -> out |> String.split("\n", trim: true) |> Enum.map(&String.trim/1) |> Enum.reject(&(&1 == ""))
              _ -> []
            end

          current = git_line(root, ["rev-parse", "--abbrev-ref", "HEAD"])
          dirty = case git_out(root, ["status", "--porcelain"]) do
            nil -> 0
            out -> out |> String.split("\n", trim: true) |> length()
          end

          %{branches: branches, current: current, dirty: dirty}
        end
    end
  end

  # POST /cloud/workspace/checkout {ws, branch} — switch the workspace to a branch (swaps its content).
  def workspace_checkout(req) do
    ws = String.trim((is_map(req.body) && req.body["ws"]) || "")
    branch = String.trim((is_map(req.body) && req.body["branch"]) || "")
    git_switch(req, ws, ["checkout", branch], branch)
  end

  # POST /cloud/workspace/branch {ws, name} — create a new branch off HEAD and switch to it.
  def workspace_branch(req) do
    ws = String.trim((is_map(req.body) && req.body["ws"]) || "")
    name = String.trim((is_map(req.body) && req.body["name"]) || "")
    git_switch(req, ws, ["checkout", "-b", name], name)
  end

  defp git_switch(req, ws, args, branch) do
    case List.keyfind(mounts(), ws, 0) do
      nil ->
        {404, %{error: "no such workspace"}}

      {_, root} ->
        cond do
          branch == "" -> {400, %{error: "branch required"}}
          not may_workspace?(req, ws, root, :write) -> forbidden()
          true ->
            case System.cmd("git", ["-C", root | args], stderr_to_stdout: true) do
              {_, 0} -> %{ok: true, branch: branch}
              {out, _} -> {400, %{error: String.trim(out)}}
            end
        end
    end
  end

  defp git_out(root, args) do
    case System.cmd("git", ["-C", root | args], stderr_to_stdout: true) do
      {out, 0} -> out
      _ -> nil
    end
  end

  defp git_line(root, args), do: (case git_out(root, args), do: (nil -> nil; s -> String.trim(s)))

  # Bind (or clear, with an empty url) the GitHub mirror remote for a workspace's bare repo. Any token
  # embedded in the URL is STRIPPED before storage (wb-7a2s) — only the credential-free remote lands in
  # git config; the github.com push credential is minted fresh (scoped 1h App token) at push time.
  def workspace_mirror(req) do
    ws = git_ws(is_map(req.body) && req.body["ws"])
    url = (is_map(req.body) && req.body["url"]) || ""

    if ws == "" do
      {400, %{error: "ws required"}}
    else
      bare = Nexus.Git.bare_path(Nexus.GitHttp.repos_root(), ws)
      {:ok, _} = Nexus.Git.provision_remote(bare, Nexus.GitHttp.work_dir(ws))
      :ok = Nexus.Git.set_mirror(bare, url)
      %{ok: true, mirror: (if String.trim(to_string(url)) == "", do: nil, else: url)}
    end
  end

  # The mirror url currently configured on the bare repo (nil if none / not provisioned).
  defp current_mirror(ws) do
    bare = Nexus.Git.bare_path(Nexus.GitHttp.repos_root(), ws)

    if Nexus.Git.bare?(bare) do
      case System.cmd("git", ["--git-dir=#{bare}", "config", "--get", "workbooks.mirror"], stderr_to_stdout: true) do
        {out, 0} -> (t = String.trim(out)) != "" && t || nil
        _ -> nil
      end
    end
  end

  # Sanitize a workspace name for use as a repo path component — no traversal, no separators.
  defp git_ws(name) do
    n = name |> to_string() |> String.trim()
    if n == "" or String.contains?(n, "..") or String.contains?(n, "/"), do: "", else: n
  end

  defp list_dir(abs, rel) do
    File.ls!(abs)
    |> Enum.reject(&String.starts_with?(&1, "."))
    |> Enum.map(fn name ->
      full = Path.join(abs, name)
      isdir = File.dir?(full)
      %{name: name, dir: isdir, path: rel <> "/" <> name, size: (if isdir, do: 0, else: (File.stat!(full).size || 0))}
    end)
    |> Enum.sort_by(&{!&1.dir, &1.name})
  end

  def human(b) when b >= 1_048_576, do: "#{Float.round(b / 1_048_576, 1)} MB"
  def human(b) when b >= 1024, do: "#{div(b, 1024)} KB"
  def human(b), do: "#{b} B"

  # ── Autopoet management (ADMIN ONLY) ─────────────────────────────────────────
  # The autopoet is managed only by admin. These wrap Nexus.Autopoet.Worker into JSON-safe snapshots
  # (the runtime carries the mechanism; this is our cloud dashboard reading it).
  def autopoet_status(req) do
    if autopoet_admin?(req) do
      hb = Nexus.Autopoet.Worker.status()

      %{
        heartbeat: %{armed: hb.armed, every: spec_every(hb.spec), next_ms: hb.next_ms, last: autopoet_report(hb.last)},
        access: autopoet_access(),
        log: Nexus.Autopoet.Knowledge.recall("autopoet") |> Enum.reverse() |> Enum.take(50)
      }
    else
      {403, %{error: "admin only"}}
    end
  end

  def autopoet_heartbeat(req) do
    if autopoet_admin?(req) do
      on = is_map(req.body) and req.body["on"] == true
      every = (is_map(req.body) && req.body["every"]) || "15m"
      if on, do: Nexus.Autopoet.Worker.arm(every), else: Nexus.Autopoet.Worker.disarm()
      hb = Nexus.Autopoet.Worker.status()
      %{armed: hb.armed, every: spec_every(hb.spec), next_ms: hb.next_ms}
    else
      {403, %{error: "admin only"}}
    end
  end

  def autopoet_run(req) do
    if autopoet_admin?(req), do: autopoet_report(Nexus.Autopoet.Worker.run_once()), else: {403, %{error: "admin only"}}
  end

  # SERVER-DERIVED authority — gated on the authenticated session role (req.role, set by the runtime
  # from the session), NEVER the client's claimed role. Admin or owner only.
  defp autopoet_admin?(req), do: Nexus.Auth.role_at_least?(Map.get(req, :role, "viewer"), "admin")

  defp spec_every(%{every: e}), do: e
  defp spec_every(_), do: nil

  defp autopoet_report(nil), do: nil

  defp autopoet_report(r) do
    %{
      sensed: r.sensed,
      at: Map.get(r, :at),
      results:
        Enum.map(r.results || [], fn x ->
          %{target: x.target, kind: to_string(x.kind), action: to_string(x.action), reasons: Enum.map(x.reasons || [], &inspect/1)}
        end)
    }
  end

  defp autopoet_access do
    a = Nexus.Autopoet.Worker.access()

    %{
      managed: a.managed,
      proposed: a.proposed,
      frozen: a.frozen,
      agents: Enum.map(a.agents, fn ag -> %{name: ag.name, management: ag.management, ceiling: ceiling_str(ag.ceiling)} end),
      leases: a.leases,
      impure_indexes: a.impure_indexes
    }
  end

  defp ceiling_str(:unbounded), do: "unbounded"
  defp ceiling_str(list) when is_list(list), do: Enum.join(list, ", ")
  defp ceiling_str(_), do: "unbounded"
end

# The durable event log — a normal resource (tenant-scoped SQLite). The `log` effect writes rows here;
# the Activity page reads them. This is OUR cloud store, not part of the open standard.
