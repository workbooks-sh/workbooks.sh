# Cloud — our control-plane dashboard, as a workbook

Our cloud dashboard (`web/cloud-dashboard`, a SvelteKit app) migrated to a **`.work` workbook**: one
`client` island that IS the dashboard SPA — a sidebar and a panel, five views: **Upgrade** (renders the
personalized upsell from our marketing workbook's `upsell` source), **Usage** (RAM/storage dials off
`Nexus.Capacity`), **Nexuses** (this running nexus, self-reported), **Domains** and **Account**. No
SvelteKit, no build step — the dashboard is a workbook.

**Auth seam.** The island authenticates to the control plane (`/api/platform`) with a Bearer token — a
`wbk_` PAT (minted by the `work` CLI or the Account view) or a WorkOS session JWT — read from `?token=`
or `localStorage`. No token ⇒ **demo mode**, where the views fall back to this nexus's own server-block
sources. Live control-plane data is one paste away (the *Connect* pill), and nothing about auth is
baked into the runtime — it's the same `Nexus.Auth` Bearer path any deployment uses.

## The data — dogfooded straight off the platform

Rather than hand-roll a backend, the dashboard reads the platform's own primitives. This `server`
block exposes a `usage` live source backed by `Nexus.Capacity` — the same capacity engine the hosted
control plane uses — so the Usage view shows real dials on whatever nexus serves it. (The production
multi-tenant dashboard reads `/api/platform/usage`; our own dogfood reads the primitive directly.)

server :cloud do
  # Native-auth adoption (wb-ajvy): real CLI tokens minted by Nexus.Auth.Token (hashed-at-rest,
  # tenant-scoped, audited) — not a demo. Exposed with the routing primitive; the Account view calls
  # them. The token carries scopes, so it's subject to the same per-route guards as a session.
  route "POST /cloud/token", :mint_token
  route "GET /cloud/tokens", :list_tokens

  def mint_token(req) do
    name = (is_map(req.body) && req.body["name"]) || "cli"
    {201, Nexus.Auth.Token.mint(req.tenant, name: name, scopes: ["api"])}
  end

  def list_tokens(req), do: %{tokens: Nexus.Auth.Token.list(req.tenant)}

  def register do
    Nexus.Live.register("usage", fn params, emit ->
      # A representative running nexus on the current tier; Capacity derives the dials.
      nx = %{id: params["nx"] || "dogfood", plan: Nexus.Pricing.default_tier().id, state: "running"}
      emit.(Nexus.Capacity.report(nx))
    end)

    # The fleet: ONE nexus per org. We report THIS running nexus — its own identity + what it serves.
    Nexus.Live.register("fleet", fn _params, emit ->
      tier = Nexus.Pricing.default_tier()
      emit.(%{nexuses: [%{
        name: Application.get_env(:nexus, :nexus_name, "nexus"),
        friendly: Application.get_env(:nexus, :nexus_friendly, ""),
        state: "running",
        tier: tier.name,
        surfaces: length(Application.get_env(:nexus, :mounts, []))
      }]})
    end)

    # Storage: this nexus's managed object store — one bucket per mounted surface, sizes derived from
    # what's actually on the data volume (real, not a mock). Egress-free (R2 in cloud, local in dev).
    Nexus.Live.register("storage", fn _params, emit ->
      mounts = Application.get_env(:nexus, :mounts, [])

      buckets =
        for {name, root} <- mounts, name != "" do
          bytes = dir_bytes(root)
          %{name: name, objects: count_files(root), size: human(bytes), bytes: bytes}
        end

      total = Enum.reduce(buckets, 0, &(&1.bytes + &2))
      emit.(%{total: human(total), buckets: Enum.sort_by(buckets, & &1.bytes, :desc)})
    end)
  end

  # Sum file sizes under a dir (bounded walk) — the surface's on-disk footprint.
  def dir_bytes(root) do
    Path.wildcard(Path.join(root, "**/*"))
    |> Enum.filter(&File.regular?/1)
    |> Enum.reduce(0, fn f, acc -> acc + (File.stat!(f).size || 0) end)
  rescue
    _ -> 0
  end

  def count_files(root), do: Path.wildcard(Path.join(root, "**/*")) |> Enum.count(&File.regular?/1)

  def human(b) when b >= 1_048_576, do: "#{Float.round(b / 1_048_576, 1)} MB"
  def human(b) when b >= 1024, do: "#{div(b, 1024)} KB"
  def human(b), do: "#{b} B"
end

client :app do
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@500;600&display=swap" rel="stylesheet">

  <style>
    *{box-sizing:border-box}
    :root{--paper:#16171a;--card:#1f2125;--ink:#ecebe5;--dim:#8c9189;--line:#2d2f34;--mint:#aee5c2;--sky:#a8d4f0;
      --sans:'Geist',system-ui,sans-serif;--mono:'Geist Mono',monospace}
    body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.55 var(--sans);display:flex;min-height:100vh}
    .side{width:230px;flex:none;border-right:1px solid var(--line);display:flex;flex-direction:column;position:sticky;top:0;height:100vh;overflow:hidden}
    .dna{height:8px;flex:none;background:repeating-linear-gradient(90deg,#f3c5a3 0 20px,#aee5c2 20px 36px,#a8d4f0 36px 49px,#f2ddb0 49px 65px,#9fc4e8 65px 74px);background-size:74px 8px;animation:dna 52s linear infinite}
    @keyframes dna{to{background-position:74px 0}}
    .sb{padding:16px 14px;display:flex;flex-direction:column;gap:2px;overflow-y:auto}
    .brand{display:flex;align-items:center;gap:9px;font-weight:650;font-size:16px;padding:6px 8px 14px}
    .brand svg{width:24px;height:auto;color:var(--ink)}
    .nav{display:block;width:100%;text-align:left;border:0;background:none;color:var(--dim);font:500 14.5px var(--sans);
      padding:8px 10px;border-radius:8px;cursor:pointer;display:flex;align-items:center;gap:9px}
    .nav:hover{background:rgba(255,255,255,.05);color:var(--ink)}
    .nav.on{background:rgba(255,255,255,.06);color:var(--ink);font-weight:600;box-shadow:inset 3px 0 0 var(--mint)}
    .nav .tag{margin-left:auto;font:600 9px var(--mono);text-transform:uppercase;letter-spacing:.06em;color:#6c7080;border:1px solid var(--line);border-radius:5px;padding:1px 5px}
    .main{flex:1;min-width:0;padding:40px 48px 100px;max-width:840px}
    .view{display:none} .view.on{display:block}
    h1{font-size:27px;letter-spacing:-.02em;margin:0 0 6px} .lead{color:var(--dim);margin:0 0 26px}
    .org{display:flex;gap:8px;align-items:center;margin:0 0 22px}
    .org input{background:var(--card);border:1px solid var(--line);border-radius:9px;color:var(--ink);font:14px var(--sans);padding:8px 11px;width:220px}
    .org button{background:var(--ink);color:var(--paper);border:0;border-radius:9px;font:600 14px var(--sans);padding:9px 16px;cursor:pointer}

    /* upsell blocks */
    .hero{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:26px 28px;margin-bottom:14px}
    .hero h2{font-size:24px;letter-spacing:-.02em;margin:0 0 8px} .hero p{color:var(--dim);margin:0;font-size:16px}
    .blk{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px 24px;margin-bottom:14px}
    .blk h3{font-size:13px;text-transform:uppercase;letter-spacing:.05em;color:var(--dim);margin:0 0 12px;font-family:var(--mono)}
    .blk ul{margin:0;padding-left:20px} .blk li{margin:5px 0}
    .cta{display:flex;align-items:center;justify-content:space-between;gap:12px}
    .cta a{background:var(--mint);color:#11231a;text-decoration:none;padding:11px 20px;border-radius:10px;font-weight:650}
    .cta .sub{color:var(--dim);font-size:14px}
    .soon{border:1px dashed var(--line);border-radius:14px;padding:40px;text-align:center;color:var(--dim)}
    .soon b{color:var(--ink)}
    /* usage dials */
    .dials{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    @media(max-width:640px){.dials{grid-template-columns:1fr}}
    .dial{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px 22px}
    .dial .t{font:600 12px var(--mono);text-transform:uppercase;letter-spacing:.05em;color:var(--dim);margin-bottom:10px}
    .dial .n{font-size:24px;font-weight:700;letter-spacing:-.01em}
    .dial .n small{font-size:14px;font-weight:500;color:var(--dim)}
    .bar{height:8px;border-radius:5px;background:var(--line);overflow:hidden;margin:12px 0 8px}
    .bar i{display:block;height:100%;background:var(--mint);transition:width .4s}
    .dial.near .bar i{background:var(--peach)} .dial.over .bar i{background:#f0a0a0}
    .dial .s{font:600 11px var(--mono);text-transform:uppercase;letter-spacing:.05em}
    .dial .s.ok{color:var(--mint)} .dial .s.near{color:var(--peach)} .dial .s.over{color:#f0a0a0}
    .tierline{display:flex;gap:10px;align-items:baseline;margin:0 0 18px;color:var(--dim)}
    .tierline b{color:var(--ink);font-size:17px}
    /* fleet */
    .nx{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px 24px}
    .nx .top{display:flex;align-items:center;gap:11px;margin-bottom:14px}
    .nx .name{font:600 18px var(--mono);letter-spacing:-.01em}
    .nx .friendly{color:var(--dim);font-size:14px}
    .nx .st{margin-left:auto;display:inline-flex;align-items:center;gap:6px;font:600 11px var(--mono);text-transform:uppercase;letter-spacing:.05em;color:var(--mint)}
    .nx .st .d{width:7px;height:7px;border-radius:50%;background:var(--mint)}
    .nx .meta{display:flex;gap:26px;color:var(--dim);font-size:14px;margin-bottom:18px}
    .nx .meta b{color:var(--ink)}
    .nx .acts{display:flex;gap:8px}
    .nx .acts button{border:1px solid var(--line);background:none;color:var(--ink);font:600 13px var(--sans);padding:8px 15px;border-radius:9px;cursor:pointer}
    .nx .acts button:hover{background:rgba(255,255,255,.05)}
    /* lists (domains / account) */
    .list{display:flex;flex-direction:column;gap:8px}
    .empty{border:1px dashed var(--line);border-radius:12px;padding:26px;text-align:center;color:var(--dim)}
    .row2{display:flex;align-items:center;gap:11px;background:var(--card);border:1px solid var(--line);border-radius:11px;padding:13px 16px}
    .row2 .ic{color:var(--sky)} .row2 .muted{color:var(--dim);margin-left:auto;font-size:13px}
    .row2 code{font:13px var(--mono);color:var(--mint)}
    .acc-sec{margin-bottom:30px} .acc-h{display:flex;align-items:center;justify-content:space-between;margin:0 0 12px}
    .acc-h h3{font-size:16px;margin:0}
    .mini{border:1px solid var(--line);background:none;color:var(--ink);font:600 13px var(--sans);padding:7px 13px;border-radius:8px;cursor:pointer}
    .mini:hover{background:rgba(255,255,255,.05)}
    /* connect pill */
    .spacer{flex:1;min-height:14px}
    .conn{display:flex;align-items:center;gap:8px;border:1px solid var(--line);background:var(--card);color:var(--dim);
      font:600 12px var(--mono);padding:9px 11px;border-radius:9px;cursor:pointer;margin-top:8px}
    .conn:hover{color:var(--ink)} .conn .cdot{width:8px;height:8px;border-radius:50%;background:#6c7080;flex:none}
    .conn.live{color:var(--mint)} .conn.live .cdot{background:var(--mint)}
  </style>

  <aside class="side">
    <div class="dna"></div>
    <div class="sb">
      <div class="brand">
        <svg viewBox="0 0 113.444 65.6002" fill="none"><path fill="currentColor" d="M48.271 0.137C54.035-0.042 59.486-0.1 65.239 0.308 65.53 10.08 65.175 19.962 65.462 29.738 65.487 30.568 65.871 31.142 66.391 31.743 72.108 33.464 84.752 13.845 90.921 11.74 93.907 12.344 100.087 19.999 102.273 22.457 98.731 28.417 83.273 40.691 81.382 45.003 81.4 46.287 81.45 46.326 82.157 47.442 83.708 48.637 108.252 47.988 113.133 48.464 113.57 53.985 113.431 59.865 113.391 65.428 101.67 65.449 86.679 66.781 76.472 61.69 68.049 57.527 61.65 50.16 58.704 41.238 57.939 38.586 57.387 36.15 56.78 33.468 55.6 38.7 54.677 42.988 51.921 47.705 39.805 68.442 20.228 65.456 0.065 65.389-0.058 59.646-0.006 53.901 0.222 48.161 5.512 48.136 28.425 48.742 31.699 47.27 31.862 46.897 31.905 46.848 31.987 46.404 32.672 42.681 14.558 27.349 11.618 22.838L11.373 22.456C13.177 19.907 19.347 13.073 22.063 11.774 25.791 11.211 40.002 29.83 44.456 31.689 45.845 32.268 46.068 32.231 47.291 31.751 48.666 29.798 48.206 22.821 48.217 20.153L48.271 0.137Z"/></svg>
        <span>Workbooks</span>
      </div>
      <button class="nav on" data-view="upgrade">Upgrade</button>
      <button class="nav" data-view="usage">Usage</button>
      <button class="nav" data-view="nexuses">Nexuses</button>
      <button class="nav" data-view="domains">Domains</button>
      <button class="nav" data-view="storage">Storage</button>
      <button class="nav" data-view="account">Account</button>
      <button class="nav" data-view="settings">Settings</button>
      <div class="spacer"></div>
      <button class="conn" id="conn" type="button"><span class="cdot"></span><span id="cl">Demo mode</span></button>
    </div>
  </aside>

  <main class="main">
    <section class="view on" data-view="upgrade">
      <h1>Upgrade</h1>
      <p class="lead">A personalized scale-up plan — assembled live by our marketing workbook's upsell agent. Prices are pinned; the model only writes the prose.</p>
      <div class="org">
        <input id="org" type="text" placeholder="your org name" value="Acme" />
        <button id="load" type="button">Refresh</button>
      </div>
      <div id="page"></div>
    </section>

    <section class="view" data-view="usage">
      <h1>Usage</h1>
      <p class="lead">Live RAM + storage against your tier ceiling — straight from <code>Nexus.Capacity</code>, the same engine the hosted control plane runs. Auto-scale lives within the ceiling; crossing it is a scale-up.</p>
      <div id="usage"><div class="soon">Reading capacity…</div></div>
    </section>
    <section class="view" data-view="nexuses">
      <h1>Nexuses</h1>
      <p class="lead">One nexus per org — the nexus <em>is</em> the org. You scale this one; more separation is a new org, never a second nexus. This is the live nexus serving the dashboard you're reading.</p>
      <div id="fleet"><div class="soon">Reading fleet…</div></div>
    </section>
    <section class="view" data-view="domains">
      <h1>Domains</h1>
      <p class="lead">Share from <em>your</em> domain, not ours. Add a host, drop the TXT challenge we give you, verify — and your nexus answers on it (paid tier). <code>POST /api/platform/domains</code>.</p>
      <div class="org" style="max-width:480px">
        <input id="dhost" type="text" placeholder="apps.your-company.com" style="width:100%" />
        <button id="dadd" type="button">Add</button>
      </div>
      <div id="domains" class="list"><div class="empty">No domains yet — add one above.</div></div>
    </section>

    <section class="view" data-view="account">
      <h1>Account</h1>
      <p class="lead">Your org, your keys. CLI access tokens for the <code>work</code> CLI, and workspaces to divide the org.</p>
      <div class="acc-sec">
        <div class="acc-h"><h3>CLI tokens</h3><button id="mint" type="button" class="mini">Mint token</button></div>
        <div id="tokens" class="list"><div class="empty">No tokens — mint one to authenticate the <code>work</code> CLI.</div></div>
      </div>
      <div class="acc-sec">
        <div class="acc-h"><h3>Workspaces</h3><button id="wsadd" type="button" class="mini">New workspace</button></div>
        <div id="workspaces" class="list"><div class="row2"><span class="ic">▣</span><b>Default</b><span class="muted">the org's primary workspace</span></div></div>
      </div>
    </section>

    <section class="view" data-view="storage">
      <h1>Storage</h1>
      <p class="lead">Your nexus's managed object store — one bucket per surface, egress-free (R2 in cloud, local on disk in dev). Real on-disk footprint, derived live from the data volume.</p>
      <div id="storage"><div class="soon">Reading storage…</div></div>
    </section>

    <section class="view" data-view="settings">
      <h1>Settings</h1>
      <p class="lead">Team secrets + per-deployment config. Env vars are encrypted at rest, org+workspace-scoped; injected into the nexus at deploy, never in source.</p>
      <div class="acc-sec">
        <div class="acc-h"><h3>Environment variables</h3><button id="envadd" type="button" class="mini">Add var</button></div>
        <div id="env" class="list"><div class="empty">No vars — add a key (e.g. <code>OPENROUTER_API_KEY</code>). Values are write-only, never shown.</div></div>
      </div>
      <div class="acc-sec">
        <div class="acc-h"><h3>Config</h3></div>
        <div id="cfg" class="list"></div>
      </div>
    </section>
  </main>

  <script>
  (function(){
    var $=function(s){return document.querySelector(s)};
    function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]})}

    // ── auth seam ──────────────────────────────────────────────────────────────────────────────
    // The dashboard is a workbook island; it authenticates to the control plane (/api/platform) with a
    // Bearer token — a `wbk_` PAT (minted by the work CLI / the Account view) or a WorkOS session JWT.
    // The token is read from ?token= (one-time, then stored) or localStorage; no token ⇒ demo mode
    // (the views fall back to this nexus's own server-block sources). This is the whole seam: live
    // control-plane data is one paste away, and nothing about auth is baked into the runtime.
    var TOK=(function(){
      try{ var u=new URL(location.href); var t=u.searchParams.get('token');
        if(t){ localStorage.setItem('wb_token',t); u.searchParams.delete('token'); history.replaceState({},'',u); }
        return localStorage.getItem('wb_token')||''; }catch(_){ return ''; }
    })();
    function connected(){ return !!TOK; }
    function plat(path, opts){
      opts=opts||{}; opts.headers=Object.assign({'content-type':'application/json'}, opts.headers||{}, TOK?{Authorization:'Bearer '+TOK}:{});
      return fetch('/api/platform'+path, opts);
    }
    function setConn(){
      var c=$('#conn'); if(!c)return;
      c.classList.toggle('live',connected());
      $('#cl').textContent=connected()?'Connected':'Demo mode';
    }
    $('#conn') && $('#conn').addEventListener('click',function(){
      if(connected()){ if(confirm('Disconnect this dashboard?')){ localStorage.removeItem('wb_token'); TOK=''; setConn(); } return; }
      var t=prompt('Paste a wbk_ access token (mint one in Account, or `work auth token`):');
      if(t){ TOK=t.trim(); localStorage.setItem('wb_token',TOK); setConn(); }
    });
    setConn();

    // view routing
    var loaded={};
    [].forEach.call(document.querySelectorAll('.nav'),function(n){
      n.addEventListener('click',function(){
        var v=n.dataset.view;
        [].forEach.call(document.querySelectorAll('.nav'),function(x){x.classList.toggle('on',x===n)});
        [].forEach.call(document.querySelectorAll('.view'),function(x){x.classList.toggle('on',x.dataset.view===v)});
        if(v==='usage'&&!loaded.usage){loaded.usage=true;loadUsage();}
        if(v==='nexuses'&&!loaded.nexuses){loaded.nexuses=true;loadFleet();}
        if(v==='account'&&!loaded.account){loaded.account=true;loadTokens();}
        if(v==='storage'&&!loaded.storage){loaded.storage=true;loadStorage();}
        if(v==='settings'&&!loaded.settings){loaded.settings=true;loadSettings();}
      });
    });

    // nexuses view — the live fleet (one nexus per org) from the cloud server block's `fleet` source
    function loadFleet(){
      var box=$('#fleet'); box.innerHTML='<div class="soon">Reading fleet…</div>';
      var es=new EventSource('live/fleet');
      es.onmessage=function(e){ var r; try{r=JSON.parse(e.data)}catch(_){return}
        if(r.type==='end'){es.close();return}
        if(r.nexuses){ es.close();
          box.innerHTML=r.nexuses.map(function(n){
            return '<div class="nx"><div class="top"><span class="name">'+esc(n.name)+'</span>'+
              (n.friendly?'<span class="friendly">'+esc(n.friendly)+'</span>':'')+
              '<span class="st"><span class="d"></span>'+esc(n.state)+'</span></div>'+
              '<div class="meta"><span>tier <b>'+esc(n.tier)+'</b></span><span>surfaces <b>'+esc(n.surfaces)+'</b></span></div>'+
              '<div class="acts"><button data-act="sleep">Sleep</button><button data-act="scale">Scale up</button></div></div>';
          }).join('');
          [].forEach.call(document.querySelectorAll('#fleet [data-act]'),function(b){
            b.addEventListener('click',function(){
              if(b.dataset.act==='scale'){ document.querySelector('.nav[data-view="upgrade"]').click(); }
              else { b.textContent='Sleeping…'; }
            });
          });
        }};
      es.onerror=function(){ es.close(); box.innerHTML='<div class="soon">Could not read fleet.</div>'; };
    }

    // usage view — RAM + storage dials from the cloud server block's `usage` source (Nexus.Capacity)
    function dial(d){
      var cls=d.status||'ok';
      var ceiling=d.limit>0?(d.limit+' '+d.unit):'no ceiling';
      var pct=d.limit>0?d.pct:0;
      return '<div class="dial '+cls+'"><div class="t">'+(d.unit==='MB'?'Memory':'Storage')+'</div>'+
        '<div class="n">'+d.used+' <small>/ '+esc(ceiling)+'</small></div>'+
        '<div class="bar"><i style="width:'+pct+'%"></i></div>'+
        '<div class="s '+cls+'">'+cls+(d.limit>0?' · '+pct+'%':'')+'</div></div>';
    }
    function loadUsage(){
      var box=$('#usage'); box.innerHTML='<div class="soon">Reading capacity…</div>';
      var es=new EventSource('live/usage');
      es.onmessage=function(e){ var r; try{r=JSON.parse(e.data)}catch(_){return}
        if(r.type==='end'){es.close();return}
        if(r.ram){
          var t=r.tier||{}, n=r.next;
          box.innerHTML='<div class="tierline"><b>'+esc(t.name||'—')+'</b><span>'+(n?('next: '+esc(n.name)+' · '+esc(n.price||'')):'top tier')+'</span></div>'+
            '<div class="dials">'+dial(r.ram)+dial(r.storage)+'</div>';
          es.close();
        }};
      es.onerror=function(){ es.close(); box.innerHTML='<div class="soon">Could not read capacity.</div>'; };
    }

    // upgrade view — render the upsell blocks from the marketing workbook's live source
    var R={
      hero:function(b){return '<div class="hero"><h2>'+esc(b.copy.headline)+'</h2><p>'+esc(b.copy.subhead||'')+'</p></div>'},
      unlocks:function(b){return '<div class="blk"><h3>'+esc(b.copy.intro||'Unlocks')+'</h3><ul>'+(b.items||[]).map(function(i){return '<li>'+esc(i)+'</li>'}).join('')+'</ul></div>'},
      compare:function(b){return '<div class="blk"><h3>'+esc(b.copy.intro||'Compare')+'</h3><p>'+esc((b.current&&b.current.name)||'')+' → '+esc((b.next&&b.next.name)||'')+'</p></div>'},
      headroom:function(b){return '<div class="blk"><h3>'+esc(b.copy.intro||'Where you stand')+'</h3></div>'},
      cta:function(b){return '<div class="blk"><div class="cta"><a href="'+esc(b.href||'#')+'">'+esc(b.copy.label||'Upgrade')+'</a><span class="sub">'+esc(b.copy.sub||'')+'</span></div></div>'}
    };
    function render(page){ $('#page').innerHTML=(page.blocks||[]).map(function(b){return R[b.type]?R[b.type](b):''}).join(''); }
    function load(){
      var org=encodeURIComponent($('#org').value.trim()||'your team');
      $('#page').innerHTML='<div class="soon">Assembling…</div>';
      var es=new EventSource('live/upsell?org='+org);
      es.onmessage=function(e){ var d; try{d=JSON.parse(e.data)}catch(_){return}
        if(d.type==='end'){es.close();return} if(d.blocks){ render(d); es.close(); } };
      es.onerror=function(){ es.close(); $('#page').innerHTML='<div class="soon">Could not reach the upsell source.</div>'; };
    }
    $('#load').addEventListener('click',load);
    $('#org').addEventListener('keydown',function(e){if(e.key==='Enter')load()});
    load();

    // domains + account — UI shells; these POST to /api/platform/* once the auth seam (wb-rlyr) lands.
    // Until then they show the local pending state so the surface is real and demonstrable.
    function addDomainRow(h,note){ var box=$('#domains'); if(box.querySelector('.empty'))box.innerHTML='';
      box.insertAdjacentHTML('beforeend','<div class="row2"><span class="ic">◷</span><b>'+esc(h)+'</b><span class="muted">'+esc(note)+'</span></div>'); }
    $('#dadd') && $('#dadd').addEventListener('click',function(){
      var h=$('#dhost').value.trim(); if(!h)return; $('#dhost').value='';
      if(connected()){
        plat('/domains',{method:'POST',body:JSON.stringify({host:h})}).then(function(r){return r.json()}).then(function(d){
          addDomainRow(h, d.error?('error: '+d.error):'add TXT '+(d.challenge||'_workbooks-challenge')+' → verify');
        }).catch(function(){ addDomainRow(h,'request failed'); });
      } else addDomainRow(h,'demo — connect to bind for real');
    });
    function addTokRow(tok,note){ var box=$('#tokens'); if(box.querySelector('.empty'))box.innerHTML='';
      box.insertAdjacentHTML('beforeend','<div class="row2"><span class="ic">⚿</span><b>cli</b><code>'+esc(tok)+'</code><span class="muted">'+esc(note)+'</span></div>'); }
    // Mint a REAL token via our cloud server block → Nexus.Auth.Token (hashed-at-rest, audited).
    $('#mint') && $('#mint').addEventListener('click',function(){
      fetch('/cloud/token',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({name:'cli'})})
        .then(function(r){return r.json()}).then(function(d){
          addTokRow(d.token||'(minted)', 'copy now — shown once · '+(d.id||''));
        }).catch(function(){ addTokRow('—','mint failed'); });
    });
    function loadTokens(){
      fetch('/cloud/tokens').then(function(r){return r.json()}).then(function(d){
        var box=$('#tokens'); var ts=(d&&d.tokens)||[];
        if(!ts.length)return;
        box.innerHTML=ts.map(function(t){return '<div class="row2"><span class="ic">⚿</span><b>'+esc(t.name||'cli')+'</b><code>'+esc(t.id||'')+'</code><span class="muted">created '+esc(t.created_at||'')+'</span></div>'}).join('');
      }).catch(function(){});
    }
    $('#wsadd') && $('#wsadd').addEventListener('click',function(){
      var box=$('#workspaces');
      box.insertAdjacentHTML('beforeend','<div class="row2"><span class="ic">▣</span><b>New workspace</b><span class="muted">rename in settings</span></div>');
    });

    // Storage — real on-disk footprint from the cloud server block's `storage` source (per-surface buckets)
    function loadStorage(){
      var box=$('#storage'); box.innerHTML='<div class="soon">Reading storage…</div>';
      var es=new EventSource('live/storage');
      es.onmessage=function(e){ var r; try{r=JSON.parse(e.data)}catch(_){return}
        if(r.type==='end'){es.close();return}
        if(r.buckets){ es.close();
          box.innerHTML='<div class="tierline"><b>'+esc(r.total)+'</b><span>across '+r.buckets.length+' surface bucket(s)</span></div>'+
            '<div class="list">'+r.buckets.map(function(b){return '<div class="row2"><span class="ic">▤</span><b>'+esc(b.name)+'</b><code>'+esc(b.objects)+' objects</code><span class="muted">'+esc(b.size)+'</span></div>'}).join('')+'</div>';
        }};
      es.onerror=function(){ es.close(); box.innerHTML='<div class="soon">Could not read storage.</div>'; };
    }

    // Settings — env vars (write-only) + config. Live when connected (/api/platform/env), demo otherwise.
    function loadSettings(){
      $('#cfg').innerHTML=['tiers','reserved-hosts','runtime-image','search'].map(function(k){
        return '<div class="row2"><span class="ic">⚙</span><b>'+k+'</b><span class="muted">from deployment.work · Nexus.Config</span></div>';
      }).join('');
      if(connected()){
        plat('/env').then(function(r){return r.json()}).then(function(d){
          var box=$('#env'); var vs=(d&&d.vars)||[];
          if(vs.length) box.innerHTML=vs.map(function(v){return '<div class="row2"><span class="ic">🔑</span><b>'+esc(v.key||v.name)+'</b><span class="muted">'+esc(v.workspace||'org')+' · write-only</span></div>'}).join('');
        }).catch(function(){});
      }
    }
    $('#envadd') && $('#envadd').addEventListener('click',function(){
      var k=prompt('Env var key (the value is set at deploy, never shown here):'); if(!k)return;
      var box=$('#env'); if(box.querySelector('.empty'))box.innerHTML='';
      box.insertAdjacentHTML('beforeend','<div class="row2"><span class="ic">🔑</span><b>'+esc(k)+'</b><span class="muted">pending · set value at deploy</span></div>');
    });
  })();
  </script>
end
