# Cloud — our control-plane dashboard, as a workbook

Our cloud dashboard (formerly `web/cloud-dashboard`, a SvelteKit app) migrated to a **`.work`
workbook**: one `client` island that IS the dashboard SPA. The Svelte components were ported
**verbatim** — every `<style>` copied byte-for-byte (the theme is exact) and every component's DOM
reproduced exactly — into a vanilla island the nexus renders (no SvelteKit, no build step). The shell
is the sidebar + topbar; the views (Nexus overview, Usage, Storage, Database, Team, Secrets, Settings,
Upgrade, Sharing, Workspace, nexus detail, plus the bare Welcome/Authorize/Denied) are reproduced
one-for-one.

**Auth seam.** The island authenticates to the control plane (`/api/platform`) with our OWN native
session cookie (`Nexus.Auth.Session`, set by `/auth/login`). No session ⇒ the platform API answers
401 and the island bounces to `/login/`. The `work` CLI uses a `wbk_` PAT on the same `/api/platform`
— one auth path for browser and CLI; nothing about auth is baked into the runtime.

## The data — dogfooded straight off the platform

The dashboard reads the platform's own primitives via `/api/platform/*` (the hosted control plane,
`Nexus.Platform`). This `server` block additionally exposes `usage`/`fleet`/`storage` live sources
backed by `Nexus.Capacity` for the dogfood nexus serving it, and mints real CLI tokens.

server :cloud do
  # Native-auth adoption (wb-ajvy): real CLI tokens minted by Nexus.Auth.Token (hashed-at-rest,
  # tenant-scoped, audited) — not a demo. Exposed with the routing primitive; the Account view calls
  # them. The token carries scopes, so it's subject to the same per-route guards as a session.
  route "POST /cloud/token", :mint_token
  route "GET /cloud/tokens", :list_tokens

  # Agent chat + session history. Sessions are scoped to {tenant (org), user} — the user key comes from
  # the client's /me identity for now (req carries only tenant; threading server-derived identity into
  # req is a follow-up, after which `u` is ignored). Store is in-process (beachhead); move to a durable
  # resource for cross-restart history.
  route "GET /cloud/agent/sessions", :agent_sessions
  route "GET /cloud/agent/session", :agent_session
  route "POST /cloud/agent/chat", :agent_chat

  # Workspace file tree — REAL files on the data volume. The mounts (deployed surfaces) are the
  # top-level folders; `path` walks within one. Path-traversal guarded (resolved must stay under root).
  route "GET /cloud/tree", :tree

  # File search across all workspaces (mounts) — filename substring match over the real data volume.
  route "GET /cloud/search", :search

  @agent_store {:cloud_agent_sessions}

  def mint_token(req) do
    name = (is_map(req.body) && req.body["name"]) || "cli"
    {201, Nexus.Auth.Token.mint(req.tenant, name: name, scopes: ["api"])}
  end

  def list_tokens(req), do: %{tokens: Nexus.Auth.Token.list(req.tenant)}

  def agent_sessions(req) do
    sessions = sessions_for(req.tenant, user_key(req)) |> Enum.map(fn s -> %{id: s.id, title: s.title, updated: s.updated} end)
    %{sessions: sessions}
  end

  def agent_session(req) do
    case Enum.find(sessions_for(req.tenant, user_key(req)), &(&1.id == (req.query["id"] || ""))) do
      nil -> {404, %{error: "not found"}}
      s -> %{id: s.id, title: s.title, messages: s.messages}
    end
  end

  def agent_chat(req) do
    user = user_key(req)
    msg = (is_map(req.body) && req.body["message"]) || ""
    id = is_map(req.body) && req.body["id"]
    reply = run_agent(msg)
    sessions = sessions_for(req.tenant, user)
    {match, rest} = Enum.split_with(sessions, &(&1.id == id))

    session =
      case match do
        [s] -> s
        _ -> %{id: gen_id(), title: title_from(msg), messages: [], updated: 0}
      end

    turns = session.messages ++ [%{role: "user", text: msg}, %{role: "assistant", text: reply}]
    session = %{session | messages: turns, updated: System.os_time(:second)}
    save_sessions(req.tenant, user, [session | rest])
    %{id: session.id, title: session.title, reply: reply}
  end

  defp user_key(req), do: (is_map(req.body) && req.body["u"]) || req.query["u"] || "anon"
  defp sessions_for(tenant, user), do: Map.get(:persistent_term.get(@agent_store, %{}), {tenant, user}, [])

  defp save_sessions(tenant, user, list) do
    all = :persistent_term.get(@agent_store, %{})
    :persistent_term.put(@agent_store, Map.put(all, {tenant, user}, Enum.sort_by(list, & &1.updated, :desc)))
  end

  defp gen_id, do: Base.url_encode64(:crypto.strong_rand_bytes(9), padding: false)
  defp title_from(msg), do: msg |> String.trim() |> String.slice(0, 48) |> then(&if(&1 == "", do: "New chat", else: &1))

  defp run_agent(msg) do
    try do
      case Nexus.Agent.run(task: msg, timeout_ms: 60_000) do
        {:ok, %{answer: a}} when is_binary(a) -> a
        {:ok, a} when is_binary(a) -> a
        {:error, _} -> "I couldn't reach the agent runtime just now — try again in a moment."
        _ -> "(no answer)"
      end
    rescue
      _ -> "The agent isn't available on this nexus yet (no model key configured)."
    catch
      _, _ -> "The agent run failed unexpectedly."
    end
  end

  def register do
    Nexus.Live.register("usage", fn params, emit ->
      # A representative running nexus on the current tier; Capacity derives the dials.
      nx = %{id: params["nx"] || "dogfood", plan: Nexus.Pricing.default_tier().id, state: "running"}
      emit.(Nexus.Capacity.report(nx))
    end)

    # The fleet: ONE nexus per org. We report THIS running nexus — its own identity + what it serves.
    Nexus.Live.register("fleet", fn _params, emit ->
      tier = Nexus.Pricing.default_tier()
      emit.(%{nexuses: [%{
        name: Application.get_env(:nexus, :nexus_name, "nexus"),
        friendly: Application.get_env(:nexus, :nexus_friendly, ""),
        state: "running",
        tier: tier.name,
        surfaces: length(Application.get_env(:nexus, :mounts, []))
      }]})
    end)

    # Storage: this nexus's managed object store — one bucket per mounted surface, sizes derived from
    # what's actually on the data volume (real, not a mock). Egress-free (R2 in cloud, local in dev).
    Nexus.Live.register("storage", fn _params, emit ->
      mounts = Application.get_env(:nexus, :mounts, [])

      buckets =
        for {name, root} <- mounts, name != "" do
          bytes = dir_bytes(root)
          %{name: name, objects: count_files(root), size: human(bytes), bytes: bytes}
        end

      total = Enum.reduce(buckets, 0, &(&1.bytes + &2))
      emit.(%{total: human(total), buckets: Enum.sort_by(buckets, & &1.bytes, :desc)})
    end)
  end

  # Sum file sizes under a dir (bounded walk) — the surface's on-disk footprint.
  def dir_bytes(root) do
    Path.wildcard(Path.join(root, "**/*"))
    |> Enum.filter(&File.regular?/1)
    |> Enum.reduce(0, fn f, acc -> acc + (File.stat!(f).size || 0) end)
  rescue
    _ -> 0
  end

  def count_files(root), do: Path.wildcard(Path.join(root, "**/*")) |> Enum.count(&File.regular?/1)

  # ── Workspace file tree ────────────────────────────────────────────────────────────────────────
  # No `path` → the mounts as top-level folders. With `path` ("<mount>/<sub>…") → that directory's
  # entries. Each entry: %{name, dir, path, size}. Hidden dotfiles + the weave index are skipped.
  defp mounts, do: for({name, root} <- Application.get_env(:nexus, :mounts, []), name != "", do: {name, root})

  def tree(req) do
    case String.trim(req.query["path"] || "") do
      "" ->
        entries = for {name, root} <- mounts(), do: %{name: name, dir: true, path: name, size: dir_bytes(root)}
        %{path: "", entries: Enum.sort_by(entries, & &1.name)}

      path ->
        [mount | rest] = String.split(path, "/", trim: true)

        case List.keyfind(mounts(), mount, 0) do
          nil ->
            {404, %{error: "no such mount"}}

          {_, root} ->
            dir = Path.join([root | rest])
            safe = Path.expand(dir)

            cond do
              not String.starts_with?(safe, Path.expand(root)) -> {403, %{error: "path escapes mount"}}
              not File.dir?(safe) -> {404, %{error: "not a directory"}}
              true -> %{path: path, entries: list_dir(safe, path)}
            end
        end
    end
  end

  def search(req) do
    q = String.downcase(String.trim(req.query["q"] || ""))

    results =
      if q == "" do
        []
      else
        for {name, root} <- mounts(),
            file <- Path.wildcard(Path.join(root, "**/*")),
            File.regular?(file),
            base = Path.basename(file),
            String.contains?(String.downcase(base), q) do
          rel = Path.relative_to(file, root)
          %{name: base, path: name <> "/" <> rel, workspace: name}
        end
        |> Enum.take(40)
      end

    %{query: q, results: results}
  end

  defp list_dir(abs, rel) do
    File.ls!(abs)
    |> Enum.reject(&String.starts_with?(&1, "."))
    |> Enum.map(fn name ->
      full = Path.join(abs, name)
      isdir = File.dir?(full)
      %{name: name, dir: isdir, path: rel <> "/" <> name, size: (if isdir, do: 0, else: (File.stat!(full).size || 0))}
    end)
    |> Enum.sort_by(&{!&1.dir, &1.name})
  end

  def human(b) when b >= 1_048_576, do: "#{Float.round(b / 1_048_576, 1)} MB"
  def human(b) when b >= 1024, do: "#{div(b, 1024)} KB"
  def human(b), do: "#{b} B"
end

design :theme do
/* ── app.css — VERBATIM from web/cloud-dashboard/src/app.css (Franie → /cloud/fonts) ── */
@import url("https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap");

@font-face{ font-family:"Franie"; font-style:normal; font-weight:300; font-display:swap;
  src:url("/cloud/fonts/Franie-Light.woff2") format("woff2"); }
@font-face{ font-family:"Franie"; font-style:normal; font-weight:600; font-display:swap;
  src:url("/cloud/fonts/Franie-SemiBold.woff2") format("woff2"); }
@font-face{ font-family:"Franie"; font-style:italic; font-weight:600; font-display:swap;
  src:url("/cloud/fonts/Franie-SemiBoldItalic.woff2") format("woff2"); }
@font-face{ font-family:"Franie"; font-style:normal; font-weight:700; font-display:swap;
  src:url("/cloud/fonts/Franie-Bold.woff2") format("woff2"); }
@font-face{ font-family:"Franie"; font-style:italic; font-weight:700; font-display:swap;
  src:url("/cloud/fonts/Franie-BoldItalic.woff2") format("woff2"); }
@font-face{ font-family:"Franie"; font-style:normal; font-weight:900; font-display:swap;
  src:url("/cloud/fonts/Franie-Black.woff2") format("woff2"); }

:root{
  --paper:#f7f6f1; --card:#fff; --ink:#1a1b1e; --bloom:#13d943; --bloomd:#149157; --dim:#6a6f68;
  --line:#e7e5db; --pc:#a8d4f0; --pcd:#2f6fa8; --stroke:var(--ink); --shadow:var(--ink);
  --prose:#34372f;
  --prose-strong:#26282b;
  --li-ink:#3a3e38;
  --well:#fff;
  --hover:rgba(18,19,22,.05);
  --hover-soft:rgba(18,19,22,.03);
  --kbd-line:rgba(18,19,22,.22);
  --scrim-q:rgba(10,10,12,.5);
  --on-bloom:#10120f;

  --mint:#aee5c2; --sky:#a8d4f0; --sage:#c8e0b0; --cream:#f2ddb0; --peach:#f3c5a3; --blue:#9fc4e8; --violet:#d9c5f0;
  --run:var(--bloomd); --amber:#c2861f; --pause:#7c63cf; --bad:#d9534f; --bad-fill:rgba(217,83,79,.13);
  --live:var(--run);

  --display:"Franie",system-ui,sans-serif;
  --mono:"Geist Mono",ui-monospace,"SF Mono",Menlo,monospace;
  --read:"Geist",system-ui,sans-serif;
  --sans:"Geist",system-ui,sans-serif;
  --r:12px;
  --soft-1:none;
  --soft-2:none;
  --section:var(--mint);
  color-scheme:light;
}

[data-theme="dark"]{
  --paper:#16171a; --card:#1f2125; --ink:#ecebe5; --dim:#8c9189;
  --bloom:#3fe081; --bloomd:#37c873; --line:#2d2f34; --stroke:#31343a; --shadow:#000;
  --prose:#c9ccc2; --prose-strong:#d4d7cd; --li-ink:#c4c8bf;
  --well:#0f1012; --hover:rgba(255,255,255,.05); --hover-soft:rgba(255,255,255,.04);
  --kbd-line:#3a3d42; --scrim-q:rgba(0,0,0,.6);
  --bad:#e8736f; --bad-fill:rgba(232,115,111,.16); --on-bloom:#10120f;
  --run:var(--bloomd); --amber:#e0b34a; --pause:#b48cff;
  --soft-1:none;
  --soft-2:none;
  color-scheme:dark;
}

* { box-sizing:border-box; margin:0; padding:0; }
html,body { height:100%; }
body{ background:var(--paper); color:var(--ink); font-family:var(--read);
  -webkit-font-smoothing:antialiased; font-size:15px; line-height:1.5; }
a{ color:inherit; text-decoration:none; }
button{ font-family:inherit; cursor:pointer; border:0; background:none; color:inherit; }
.mono{ font-family:var(--mono); }
.dim{ color:var(--dim); } .faint{ color:var(--dim); }
.muted{ color:var(--dim); font:500 12px var(--mono); }

.btn{ display:inline-flex; align-items:center; gap:8px; height:38px; padding:0 16px;
  font:700 12px var(--mono); letter-spacing:.05em; text-transform:uppercase; color:var(--ink);
  background:var(--card); border:1px solid var(--line); border-radius:11px;
  box-shadow:var(--soft-1); transition:transform .08s, box-shadow .08s, background .12s; }
.btn:hover{ transform:translateY(-1px); box-shadow:var(--soft-2); }
.btn:active{ transform:translateY(0); box-shadow:var(--soft-1); }
.btn.primary{ background:var(--ink); color:var(--paper); }
.btn.primary:hover{ background:var(--ink); }
.btn.sm{ height:32px; padding:0 12px; font-size:11px; border-radius:9px; box-shadow:var(--soft-1); }
.btn.sm:hover{ box-shadow:var(--soft-1); }
.btn.danger{ color:var(--bad); border-color:var(--bad); background:var(--card); }
.btn.danger:hover{ background:var(--bad-fill); }
.ico{ width:15px; height:15px; display:block; flex:none; }

.dot{ width:9px; height:9px; border-radius:50%; flex:none; }
.dot.run{ background:var(--bloom); box-shadow:0 0 0 3px var(--mint); animation:pulse 2.4s ease-in-out infinite; }
.dot.sleep{ background:var(--dim); box-shadow:0 0 0 3px var(--well); }
.dot.build{ background:var(--amber); box-shadow:0 0 0 3px var(--cream); animation:pulse 1.2s ease-in-out infinite; }
.dot.pause{ background:var(--pause); box-shadow:0 0 0 3px var(--violet); }
@keyframes pulse{ 0%,100%{ opacity:1; } 50%{ opacity:.5; } }
@media (prefers-reduced-motion:reduce){ .dot.run,.dot.build{ animation:none; } }

#app{ display:grid; grid-template-columns:248px 1fr; height:100vh; }

.side{ border-right:1px solid var(--line); background:var(--paper); display:flex; flex-direction:column;
  padding:22px 14px 24px; overflow-y:auto; z-index:30; }
.topdna{ margin:-22px -14px 16px; height:8px; overflow:hidden; flex:0 0 auto; }
.brand{ display:flex; align-items:center; gap:9px; padding:4px 8px 16px; }
.brand svg{ width:24px; height:auto; color:var(--ink); flex:0 0 auto; }
.brand b{ font-family:var(--display); font-weight:600; font-size:21px; line-height:1; letter-spacing:.005em;
  color:var(--ink); text-transform:none; }
.brand .cl{ font:700 10px var(--mono); letter-spacing:.12em; text-transform:uppercase; color:var(--dim);
  border:1px solid var(--line); border-radius:7px; padding:2px 6px; }

.themebtn{ margin-left:auto; flex:0 0 auto; width:34px; height:34px; display:flex; align-items:center; justify-content:center;
  border:1px solid var(--line); border-radius:9px; background:var(--card); color:var(--ink);
  box-shadow:var(--soft-1); transition:transform .08s, box-shadow .08s; }
.themebtn:hover{ transform:translateY(-1px); box-shadow:var(--soft-1); }
.themebtn:active{ transform:translateY(0); box-shadow:var(--soft-1); }
.themebtn svg{ width:16px; height:16px; display:block; }

.org{ display:flex; align-items:center; gap:8px; padding:9px; border:1px solid var(--line); border-radius:10px;
  margin-bottom:14px; cursor:pointer; background:var(--card); box-shadow:var(--soft-1);
  transition:transform .08s, box-shadow .08s; }
.org:hover{ transform:translateY(-1px); box-shadow:var(--soft-1); }
.org .av{ width:24px; height:24px; border-radius:7px; background:linear-gradient(135deg,var(--mint),var(--sky));
  flex:none; display:grid; place-items:center; font:700 11px var(--mono); color:var(--on-bloom); border:1px solid var(--line); }
.org .nm{ font:600 13px var(--read); flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.org .ch{ color:var(--dim); }

.nav{ display:flex; flex-direction:column; gap:2px; flex:1; }
.nav .lbl{ font:700 10px var(--mono); letter-spacing:.16em; text-transform:uppercase; color:var(--dim); padding:14px 8px 6px; }
.nav a{ display:flex; align-items:center; gap:10px; padding:9px 8px; border-radius:8px; color:var(--li-ink);
  font:600 13.5px var(--read); transition:.12s; cursor:pointer; }
.nav a:hover{ background:var(--hover); color:var(--ink); }
.nav a.on{ background:var(--ink); color:var(--paper); }
.nav a.on .ico{ color:var(--paper); }

.acct{ display:flex; align-items:center; gap:9px; padding:10px 8px; border-top:1px solid var(--line); margin-top:8px;
  cursor:pointer; border-radius:8px; }
.acct:hover{ background:var(--hover); }
.acct .av{ width:28px; height:28px; border-radius:50%; background:linear-gradient(135deg,var(--peach),var(--blue));
  flex:none; display:grid; place-items:center; font:700 11px var(--mono); color:var(--on-bloom); border:1px solid var(--line); }
.acct .nm{ font:600 13px var(--read); line-height:1.2; }
.acct .em{ font:500 11px var(--mono); color:var(--dim); line-height:1.3; }

.main{ overflow-y:auto; position:relative; }
#view.fullbleed{ position:absolute; inset:0; overflow:hidden; }
.topbar{ display:flex; align-items:center; gap:12px; padding:16px 28px; border-bottom:1px solid var(--line);
  position:sticky; top:0; background:var(--paper); z-index:5; }
.crumb{ font:700 12px var(--mono); letter-spacing:.1em; text-transform:uppercase; color:var(--ink); flex:1; }
.crumb span{ color:var(--dim); }
.search{ display:flex; align-items:center; gap:8px; height:36px; padding:0 12px; border:1px solid var(--line);
  border-radius:10px; color:var(--dim); width:210px; background:var(--card); box-shadow:var(--soft-1); }
.search svg{ color:var(--dim); }
.search input{ background:none; border:0; outline:none; color:var(--ink); font:500 13px var(--mono); width:100%; }
.search input::placeholder{ color:var(--dim); }
.wrap{ padding:22px 36px 52px; max-width:1560px; margin:0 auto; width:100%; }

.row{ display:flex; align-items:center; gap:14px; padding:16px 18px; border:1px solid var(--line); border-radius:var(--r);
  margin-bottom:12px; background:var(--card); cursor:pointer; box-shadow:var(--soft-1);
  transition:transform .08s, box-shadow .08s; }
.row:hover{ transform:translateY(-1px); box-shadow:var(--soft-2); }
.row .nx{ flex:1; min-width:0; }
.row .nx b{ font:600 15px var(--read); display:flex; align-items:center; gap:9px; }
.row .nx .url{ font:500 11.5px var(--mono); color:var(--dim); margin-top:3px; }
.row .meta{ text-align:right; font:500 12px var(--mono); color:var(--dim); min-width:96px; }
.row .meta .st{ font-weight:700; display:flex; align-items:center; gap:7px; justify-content:flex-end; color:var(--ink); }
.row .meta .sub{ font-size:11px; color:var(--dim); margin-top:4px; }
.spark{ width:84px; height:30px; flex:none; }
.tag{ font:700 11px var(--mono); padding:3px 8px; border-radius:6px; border:1px solid var(--line); color:var(--dim); }

.sechead{ display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
.sechead h2{ font-family:var(--display); font-weight:600; font-size:24px; line-height:1.1;
  display:inline-flex; align-items:center; gap:11px; }
.sechead h2::before{ content:""; width:11px; height:18px; border-radius:5px; background:var(--section);
  flex:none; box-shadow:var(--soft-1); }
.sechead p{ font:400 14px var(--read); color:var(--prose); margin-top:4px; }

.stats{ display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:24px; }
.stat{ border:1px solid var(--line); border-radius:var(--r); padding:16px; background:var(--card);
  box-shadow:var(--soft-1); }
.stat .k{ font:700 10px var(--mono); color:var(--dim); text-transform:uppercase; letter-spacing:.12em; }
.stat .v{ font-family:var(--display); font-weight:600; font-size:26px; margin-top:9px; line-height:1; }
.stat .v small{ font:400 13px var(--read); color:var(--dim); }
.stat .d{ font:500 11px var(--mono); margin-top:6px; }
.up{ color:var(--bloomd); } .down{ color:var(--amber); }

.card{ border:1px solid var(--line); border-radius:var(--r); background:var(--card); padding:20px; margin-bottom:18px;
  box-shadow:var(--soft-1); }
.card h3{ font-family:var(--display); font-weight:600; font-size:17px; margin-bottom:14px; display:flex; align-items:center; gap:8px; }
.kv{ display:flex; justify-content:space-between; padding:10px 0; border-bottom:1px solid var(--line); font:400 14px var(--read); }
.kv:last-child{ border:0; }
.kv .k{ color:var(--dim); } .kv .v{ font:500 12.5px var(--mono); color:var(--ink); }

.logs{ background:var(--well); border:1px solid var(--line); border-radius:var(--r); padding:16px;
  font:400 12px/1.7 var(--mono); height:230px; overflow-y:auto; color:var(--dim); }
.logs .ln{ white-space:pre-wrap; color:var(--dim); }
.logs .ln .t{ color:var(--dim); opacity:.7; } .logs .ln .g{ color:var(--bloom); } .logs .ln .a{ color:var(--amber); }

table{ width:100%; border-collapse:collapse; font:400 14px var(--read); }
th{ text-align:left; font:700 10px var(--mono); text-transform:uppercase; letter-spacing:.12em; color:var(--dim);
  padding:11px 12px; border-bottom:1px solid var(--line); }
td{ padding:13px 12px; border-bottom:1px solid var(--line); }
td.num{ font:500 13px var(--mono); text-align:right; }
tr:last-child td{ border:0; }

.bar{ height:8px; border-radius:999px; background:var(--well); border:1px solid var(--line); overflow:hidden; margin:12px 0; }
.bar i{ display:block; height:100%; border-radius:999px;
  background:linear-gradient(90deg, color-mix(in srgb, var(--section) 78%, #fff), var(--section)); }

.danger-zone{ border-color:color-mix(in srgb, var(--bad) 50%, var(--line)); box-shadow:var(--soft-1); }
.danger-zone h3{ color:var(--bad); }

.grid-2{ display:grid; grid-template-columns:1fr 1fr; gap:18px; }

.modal{ position:fixed; inset:0; background:var(--scrim-q); display:grid; place-items:center; z-index:40; }
.sheet{ width:560px; max-width:94vw; max-height:90vh; overflow-y:auto; background:var(--card);
  border:1px solid var(--line); border-radius:16px; padding:26px; box-shadow:var(--soft-2); }
.sheet h2{ font-family:var(--display); font-weight:600; font-size:22px; margin-bottom:6px; }
.sheet .sub{ color:var(--prose); font:400 14px var(--read); margin-bottom:22px; }
.lab{ font:700 10px var(--mono); letter-spacing:.12em; text-transform:uppercase; color:var(--dim); margin:18px 0 9px; }
.field{ margin-bottom:11px; }
.field input{ width:100%; height:42px; padding:0 13px; border-radius:9px; background:var(--card); border:1px solid var(--line);
  color:var(--ink); font:500 14px var(--mono); outline:none; transition:.12s; box-shadow:var(--soft-1); }
.field input:focus{ transform:translateY(-1px); box-shadow:var(--soft-1); }
.plans{ display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
.plan{ border:1px solid var(--line); border-radius:11px; padding:14px; cursor:pointer; background:var(--card);
  box-shadow:var(--soft-1); transition:transform .08s, box-shadow .08s; }
.plan:hover{ transform:translateY(-1px); box-shadow:var(--soft-1); }
.plan.sel{ background:var(--mint); color:var(--on-bloom); }
.plan .nm{ font:600 13px var(--read); }
.plan .pr{ font-family:var(--display); font-weight:600; font-size:19px; margin:8px 0 3px; }
.plan .pr small{ font:400 11px var(--mono); color:var(--dim); }
.plan.sel .pr small{ color:var(--on-bloom); }
.plan .ds{ font:400 11.5px var(--read); color:var(--dim); line-height:1.4; }
.plan.sel .ds{ color:var(--on-bloom); }
.regions{ display:flex; gap:9px; flex-wrap:wrap; }
.reg{ border:1px solid var(--line); border-radius:9px; padding:9px 13px; font:600 12.5px var(--read); cursor:pointer;
  display:flex; align-items:center; gap:7px; background:var(--card); box-shadow:var(--soft-1); transition:transform .08s, box-shadow .08s; }
.reg:hover{ transform:translateY(-1px); box-shadow:var(--soft-1); }
.reg.sel{ background:var(--sky); color:var(--on-bloom); }
.addon{ display:flex; align-items:center; gap:12px; padding:13px; border:1px solid var(--line); border-radius:10px;
  margin-bottom:9px; background:var(--card); }
.addon .info{ flex:1; }
.addon .info b{ font:600 13px var(--read); }
.addon .info p{ font:400 11.5px var(--read); color:var(--dim); margin-top:2px; }
.addon .pr{ font:700 12px var(--mono); color:var(--dim); }
.tog{ width:40px; height:23px; border-radius:12px; background:var(--well); border:1px solid var(--line);
  position:relative; flex:none; cursor:pointer; transition:.15s; }
.tog i{ position:absolute; top:1.5px; left:2px; width:15px; height:15px; border-radius:50%; background:var(--dim); transition:.18s; }
.tog.on{ background:var(--mint); border-color:var(--bloomd); }
.tog.on i{ left:19px; background:var(--bloomd); }
.sheet .foot{ display:flex; align-items:center; justify-content:space-between; margin-top:24px; padding-top:18px; border-top:1px solid var(--line); }
.sheet .est{ font:400 14px var(--read); color:var(--prose); } .sheet .est b{ color:var(--ink); font-family:var(--mono); font-weight:700; }
.note{ font:400 12.5px var(--read); color:var(--prose); background:var(--well); border:1px solid var(--line); border-radius:9px;
  padding:11px 13px; margin-top:14px; line-height:1.5; }

/* ── +layout.svelte <style> — VERBATIM (sidebar switchers / nav / workspaces) ── */
.swrap { position: relative; margin: 0 0 4px; }
.swlabel { font: 700 9.5px var(--read); letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--dim); padding: 0 4px 4px; margin-top: 10px; }
.sw { display: flex; align-items: center; gap: 8px; padding: 7px 8px; border-radius: 9px;
  cursor: pointer; color: var(--ink); transition: background 0.1s; }
.sw:hover { background: var(--line); }
.swname { flex: 1; min-width: 0; font: 600 13.5px var(--read); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sw .ico.ch { width: 15px; height: 15px; color: var(--dim); flex: none; }
.sw .av.sm { width: 22px; height: 22px; border-radius: 6px; flex: none; display: grid; place-items: center;
  background: var(--line); color: var(--ink); font: 700 10px var(--read); }
.navspacer { flex: 1; }
.swmenu, .orgmenu { position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 35;
  background: var(--card); border: 1px solid var(--line); border-radius: 11px; padding: 6px; animation: org-in 0.12s ease; }
.orgwrap { position: relative; }
.orgmenu { position: absolute; top: calc(100% + 6px); left: 0; right: 0; z-index: 35;
  background: var(--card); border: 1px solid var(--line); border-radius: 11px; padding: 6px; animation: org-in 0.12s ease; }
@keyframes org-in { from { transform: translateY(-4px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.omcur { display: flex; align-items: center; gap: 8px; padding: 8px 9px; font: 600 13px var(--read); color: var(--ink); }
.omcur .av.sm { width: 20px; height: 20px; border-radius: 6px; background: var(--line); display: grid; place-items: center;
  font: 700 9px var(--read); color: var(--ink); flex: none; }
.omcur span:nth-child(2) { flex: 1; }
.omtick { color: var(--run); }
.omdiv { height: 1px; background: var(--line); margin: 5px 4px; }
.omitem { display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left;
  padding: 8px 9px; border: none; background: none; border-radius: 8px; color: var(--ink);
  font: 500 13px var(--read); cursor: pointer; text-decoration: none; }
.omitem:hover { background: var(--line); }
.omitem[disabled] { color: var(--dim); cursor: default; }
.omitem[disabled]:hover { background: none; }
.omitem small { color: var(--dim); font-size: 10px; }
.org .nm { display: flex; flex-direction: column; gap: 1px; flex: 1; min-width: 0; }
.wsname { font: 600 13px var(--read); color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.wsorg { font: 500 10.5px var(--read); color: var(--dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.omhead { font: 700 9.5px var(--read); letter-spacing: 0.06em; text-transform: uppercase; color: var(--dim); padding: 6px 9px 4px; }
.omitem { gap: 8px; }
.omname { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.omitem .av.sm { width: 20px; height: 20px; border-radius: 6px; flex: none; background: var(--line);
  display: grid; place-items: center; font: 700 9px var(--read); color: var(--ink); }
.av.sm.plus { background: var(--line); color: var(--ink); font-size: 13px; }
.av.sm.plus svg { display: block; }
.omempty { padding: 8px 9px; font: 500 12px var(--read); color: var(--dim); }
.omedit { flex: 1; min-width: 0; background: var(--bg); border: 1px solid var(--line); border-radius: 6px;
  padding: 4px 7px; font: 500 13px var(--read); color: var(--ink); outline: none; }
.omedit:focus { border-color: var(--mint); }
.omtick.btn { background: none; border: 0; cursor: pointer; color: var(--run); font-size: 14px; padding: 0 4px; }
.nxnav { display: flex; flex-direction: column; gap: 1px; margin: 4px 0 14px; }
.nxlink { display: flex; align-items: center; gap: 9px; padding: 6px 10px 6px 11px; border-radius: 7px; text-decoration: none;
  font: 500 13px var(--read); color: var(--dim); }
.nxlink svg { flex: none; opacity: 0.85; }
.nxlink:hover { background: var(--line); color: var(--ink); }
.nxlink.on { background: var(--line); color: var(--ink); font-weight: 600; }
/* Nexus dropdown in a subtle container at the very top (replaces the brand/logo) */
.swrap.nxtop { margin: 2px 0 12px; padding: 4px; border: 1px solid var(--line); border-radius: 12px; background: var(--card); }
.swrap.nxtop .sw { padding: 7px 8px; }
.nxnav.nxprimary { margin: 0 0 6px; }
/* Admin — bottom-anchored OVERLAY drawer (above the avatar). Opens UPWARD, floating over the
   workspaces list so a long sidebar still scrolls behind it. State persists (wb-admin-drawer). */
.adminsec { position: relative; margin: 0 0 2px; }
.adminbtn { display: flex; align-items: center; gap: 9px; width: 100%; box-sizing: border-box; padding: 7px 10px 7px 11px;
  border: none; background: none; cursor: pointer; border-radius: 8px; font: 500 13px var(--read); color: var(--dim); }
.adminbtn svg { flex: none; opacity: 0.85; }
.adminbtn:hover { background: var(--line); color: var(--ink); }
.adminsec.open .adminbtn { background: var(--line); color: var(--ink); font-weight: 600; }
.adminchev { margin-left: auto; display: grid; place-items: center; color: var(--dim); transition: transform .18s ease; }
.adminsec.open .adminchev { transform: rotate(-90deg); }
.admindrawer { position: absolute; left: 0; right: 0; bottom: calc(100% + 4px); z-index: 25;
  background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 5px; box-shadow: 0 -8px 26px rgba(0,0,0,.20);
  opacity: 0; transform: translateY(6px); pointer-events: none; transition: opacity .15s ease, transform .15s ease; }
.adminsec.open .admindrawer { opacity: 1; transform: translateY(0); pointer-events: auto; }
.admindrawer .nxnav { margin: 0; }
/* Workspace = folder: disclosure caret + lazy file tree (desktop-app style) */
.wstoggle { flex: none; width: 20px; height: 28px; border: none; background: none; color: var(--dim); cursor: pointer; display: grid; place-items: center; padding: 0; }
.wstoggle svg { width: 13px; height: 13px; transition: transform .15s ease; }
.wsrow.wsopen .wstoggle svg { transform: rotate(90deg); }
.wstree { display: flex; flex-direction: column; }
.trow { display: flex; align-items: center; gap: 6px; min-height: 26px; border-radius: 7px; cursor: pointer; color: var(--dim); font: 500 12.5px var(--read); }
.trow:hover { background: var(--line); color: var(--ink); }
.trow .tchev { flex: none; display: grid; place-items: center; color: var(--dim); }
.trow .tchev svg { width: 12px; height: 12px; transition: transform .15s ease; }
.trow.dir.open .tchev svg { transform: rotate(90deg); }
.trow .tname { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.trow.file .tname { color: var(--dim); }
.tbm { flex: none; opacity: 0; border: none; background: none; color: var(--dim); cursor: pointer; font-size: 12px; padding: 2px 5px; border-radius: 5px; }
.trow:hover .tbm, .sfrow:hover .tbm { opacity: .7; }
.tbm:hover { opacity: 1 !important; color: var(--ink); }
.tbm.on { opacity: 1; color: var(--peach, #f3c5a3); }
.treemsg { color: var(--dim); font: 500 12px var(--read); padding: 5px 0; opacity: .7; }
/* Bookmarks */
.bmsec { margin-top: 6px; }
.swlabel { font: 700 9.5px var(--read); letter-spacing: 0.08em; text-transform: uppercase; color: var(--dim); padding: 0 4px 4px; }
.bmlist { display: flex; flex-direction: column; gap: 1px; }
.bmrow { display: flex; align-items: center; gap: 7px; min-height: 28px; padding: 0 6px; border-radius: 7px; cursor: pointer; color: var(--ink); font: 500 13px var(--read); }
.bmrow:hover { background: var(--line); }
.bmstar { flex: none; color: var(--peach, #f3c5a3); font-size: 12px; }
.bmrow .tname { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bmx { flex: none; opacity: 0; border: none; background: none; color: var(--dim); cursor: pointer; font-size: 15px; line-height: 1; padding: 2px 5px; border-radius: 5px; }
.bmrow:hover .bmx { opacity: .6; }
.bmx:hover { opacity: 1; color: var(--ink); }
/* File search */
.srchsec { margin-top: 6px; }
.srchinput { width: 100%; box-sizing: border-box; border: 1px solid var(--line); background: var(--card); color: var(--ink); border-radius: 8px; padding: 7px 10px; font: 500 13px var(--read); }
.srchinput:focus { outline: none; border-color: var(--stroke); }
.srchinput::placeholder { color: var(--dim); }
.srchresults { display: flex; flex-direction: column; gap: 1px; margin-top: 4px; max-height: 30vh; overflow-y: auto; }
.sfrow { display: flex; align-items: center; gap: 7px; min-height: 28px; padding: 0 6px; border-radius: 7px; cursor: pointer; color: var(--ink); font: 500 12.5px var(--read); }
.sfrow:hover { background: var(--line); }
.sfrow .tname { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sfrow .ssub { flex: none; color: var(--dim); font: 500 10.5px var(--mono); margin-left: auto; }
.sfrow .tbm { margin-left: 4px; }
/* group label (e.g. "Admin") above a nav group */
.navgrp { font: 700 9.5px var(--read); letter-spacing: 0.08em; text-transform: uppercase; color: var(--dim); padding: 0 10px; margin: 8px 0 4px; }
.wssec { margin-top: 6px; }
.wshdr { display: flex; align-items: center; justify-content: space-between; }
.wsadd { background: none; border: 0; cursor: pointer; color: var(--dim); font-size: 16px; line-height: 1;
  padding: 0 4px; border-radius: 5px; }
.wsadd:hover { background: var(--line); color: var(--ink); }
.wslist { display: flex; flex-direction: column; gap: 1px; max-height: 42vh; overflow-y: auto; }
.wsrow { display: flex; align-items: center; border-radius: 8px; position: relative; }
.wsrow:hover { background: var(--line); }
.wsrow.on { background: var(--line); }
.wsrow.on::before { content: ''; position: absolute; left: 0; top: 6px; bottom: 6px; width: 2.5px; border-radius: 2px; background: var(--ink); }
.wsrow.on .wsmain { font-weight: 600; }
.wsmain { display: flex; align-items: center; gap: 8px; flex: 1; min-width: 0; padding: 8px 9px; border: none; background: none;
  color: var(--ink); font: 500 13px var(--read); cursor: pointer; text-align: left; }
.wsmain .av.sm { font-size: 12px; }
.wsedit-btn { flex: none; width: 26px; height: 26px; margin-right: 5px; border: none; border-radius: 6px;
  background: none; color: var(--dim); cursor: pointer; opacity: 0; font-size: 12px; }
.wsrow:hover .wsedit-btn { opacity: 1; }
.wsedit-btn:hover { background: var(--card); color: var(--ink); }
.wsedit { padding: 8px 7px; display: flex; flex-direction: column; gap: 8px; }
.wsiconrow { display: flex; align-items: center; gap: 7px; }
.wstile { flex: none; width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--stroke);
  border-radius: 9px; background: var(--card); color: var(--ink); cursor: pointer; font: 600 14px var(--read); }
.wstile:hover, .wstile.on { border-color: var(--ink); }
.wspicker { display: flex; flex-direction: column; gap: 5px; }
.wsinitials { align-self: flex-start; border: none; background: none; color: var(--dim);
  font: 500 11.5px var(--read); cursor: pointer; padding: 2px 0; }
.wsinitials:hover { color: var(--ink); }
.wsinput { flex: 1; min-width: 0; font: 500 13px var(--read); padding: 8px 10px; border: 1px solid var(--stroke);
  border-radius: 8px; background: var(--card); color: var(--ink); outline: none; }
.wsinput:focus { border-color: var(--ink); }
.wsactions { display: flex; align-items: center; gap: 6px; }
.wsactions button { border: none; border-radius: 7px; padding: 6px 11px; font: 600 12px var(--read); cursor: pointer; }
.wsdel { background: none; color: var(--bad, #d4604a); }
.wsdel:hover { background: color-mix(in srgb, var(--bad, #d4604a) 14%, transparent); }
.wscancel { background: var(--line); color: var(--ink); }
.wssave { background: var(--ink); color: var(--paper); }

/* ── Toast.svelte <style> — VERBATIM ── */
.toasts { position: fixed; bottom: 20px; right: 20px; z-index: 60; display: flex; flex-direction: column; gap: 10px; align-items: flex-end; }
.toast { display: flex; align-items: center; gap: 9px; padding: 11px 15px; background: var(--card); border: 2px solid var(--stroke);
  border-radius: 11px; box-shadow: 4px 4px 0 var(--shadow); color: var(--ink); font: 500 13px var(--read); cursor: pointer;
  max-width: 340px; animation: toast-in 0.16s ease; }
.toast.bad { border-color: var(--bad); }
@keyframes toast-in { from { transform: translateY(8px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

/* ── DnaStrip.svelte <style> — VERBATIM ── */
.dna { height: var(--h); border-radius: 4px; overflow: hidden; }
.track { display: flex; height: 100%; width: 200%; animation: drift 52s linear infinite; }
.track i { display: block; height: 100%; }
@keyframes drift { to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) { .track { animation: none; } }

/* ── EmojiPicker.svelte <style> — VERBATIM (:global unwrapped) ── */
.picker-host emoji-picker {
  --background: var(--card); --border-color: var(--stroke); --button-active-background: var(--line);
  --button-hover-background: var(--line); --category-emoji-padding: 0.35rem; --indicator-color: var(--ink);
  --input-border-color: var(--stroke); --input-background: var(--card); --input-font-color: var(--ink);
  --input-placeholder-color: var(--dim); --num-columns: 8; --outline-color: var(--ink); --emoji-size: 1.2rem;
  width: 100%; max-width: 100%; height: 320px; border: none; border-radius: 8px; }
.picker-host .loading { color: var(--dim); font-size: 12px; padding: 1rem; text-align: center; }
end

client :app do
  <script>/* no-flash theme: set the attribute before first paint (default dark) */
  (function(){try{var t=localStorage.getItem('wb-theme')||'dark';
  document.documentElement.setAttribute('data-theme',t);}catch(e){document.documentElement.setAttribute('data-theme','dark');}})();</script>

  <div id="root"></div>
  <div class="toasts" id="toasts"></div>

  <script>
  // ═══════════════════════ WB runtime — ports api.js + the stores + helpers ═══════════════════════
  (function () {
    var WB = (window.WB = window.WB || {});
    WB._views = {};
    WB._params = {};
    WB.view = function (route, def) { WB._views[route] = def; };
    WB.styles = function (css) { var s = document.createElement('style'); s.textContent = css; document.head.appendChild(s); };
    // Svelte scopes each component's <style>; our ports inject globally, so a view that redefines a
    // shared class (.card/.row/.bar/.tag/.sub/.body) would bleed into every view. scopeCss restores
    // that scoping: every selector is prefixed with the view's mount scope. @keyframes/@font-face stay
    // global (names are global anyway); @media/@supports recurse. Modals use the GLOBAL design-block
    // classes (.modal/.sheet) so they're unaffected.
    function scopeCss(css, sel) {
      css = css.replace(/\/\*[\s\S]*?\*\//g, '');
      var out = '', i = 0, n = css.length;
      while (i < n) {
        var b = css.indexOf('{', i);
        if (b === -1) { out += css.slice(i); break; }
        var header = css.slice(i, b).trim();
        var depth = 1, j = b + 1;
        while (j < n && depth > 0) { var ch = css[j]; if (ch === '{') depth++; else if (ch === '}') depth--; j++; }
        var body = css.slice(b + 1, j - 1);
        if (/^@(keyframes|font-face|import|page|charset)/.test(header)) {
          out += header + '{' + body + '}\n';
        } else if (/^@(media|supports|container|layer)/.test(header)) {
          out += header + '{' + scopeCss(body, sel) + '}\n';
        } else {
          out += header.split(',').map(function (s) { s = s.trim(); return s ? sel + ' ' + s : s; }).filter(Boolean).join(', ') + '{' + body + '}\n';
        }
        i = j;
      }
      return out;
    }
    WB.scopedStyles = function (scope, css) { WB.styles(scopeCss(css, '[data-view="' + scope + '"]')); };
    function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
    WB.esc = esc;

    // ── api.js port ───────────────────────────────────────────────────────────────────────────
    var RUNTIME = '';                       // collab calls (history/drafts/shared) are mock until wired
    function live(){ return RUNTIME !== ''; }
    async function plat(path, opts){ opts = opts || {};
      var res = await fetch('/api/platform' + path, {
        method: opts.method || 'GET',
        headers: opts.body ? { 'content-type': 'application/json' } : {},
        body: opts.body && JSON.stringify(opts.body),
        credentials: 'same-origin'
      });
      if (res.status === 401) { location.assign('/login/'); throw new Error('unauthorized'); }
      if (!res.ok) throw new Error((opts.method||'GET') + ' /api/platform' + path + ' → ' + res.status);
      return res.status === 204 ? null : res.json();
    }
    async function rt(path, opts){ opts = opts || {};
      var res = await fetch(path, { method: opts.method || 'GET',
        headers: { 'content-type': 'application/json' }, body: opts.body && JSON.stringify(opts.body), credentials: 'same-origin' });
      if (!res.ok) throw new Error((opts.method||'GET') + ' ' + path + ' → ' + res.status);
      return res.status === 204 ? null : res.json();
    }
    var STATE_LABEL = { run: 'Active', sleep: 'Idle', build: 'Starting', pause: 'Paused' };
    var SUB_FOR = { run: 'active', sleep: 'sleeping', build: 'building · weaving…', pause: 'paused' };
    var withSub = function (n) { return Object.assign({}, n, { sub: n.sub || SUB_FOR[n.state] || '' }); };

    var api = WB.api = {
      live: live, STATE_LABEL: STATE_LABEL,
      async listNexuses(){ try { return (await plat('/nexuses')).nexuses.map(withSub); } catch (e) { return []; } },
      async getNexus(id){ try {
        var nexus = withSub(await plat('/nexuses/' + id)); var row;
        try { row = (await plat('/usage')).rows.find(function(r){ return r.name === id; }); } catch (e) {}
        var config = { region: nexus.region, plan: nexus.plan,
          status: nexus.state === 'run' ? 'Active' : nexus.state === 'sleep' ? 'Idle' : 'Starting',
          storage: (row && row.storage) || '—', database: (row && row.database) || 'none', created: '—' };
        var month = { activeCompute: row ? (row.activeHrs + ' hrs') : '0.0 hrs', sleeping: '—',
          storage: (row && row.storage) || '—', egress: '$0.00', subtotal: (row && row.cost) || '$0.00' };
        var metrics = { cpu: 0, memMb: 0, memCapGb: 1, reqMin: 0, costMonth: ((row && row.cost) || '$0').replace(/[$,]/g, '') };
