  end
  # <<< GENERATED

  # Built-in toolkits are default-added; a tenant can disable one (stored as a :toolkit record with
  # enabled:false). `enabled?/2` resolves the effective state.
  defp toolkit_enabled?(tenant, id) do
    case CP.get(tenant, :toolkit, id) do
      {:ok, rec} -> rec[:enabled] != false
      _ -> true
    end
  end

  @doc "Toggle a built-in toolkit on/off for this tenant. `{200, %{id, enabled}}`."
  def toggle_toolkit(req) do
    id = req.params["id"]

    if Enum.any?(standalone_catalog(), &(&1.id == id)) do
      now = !toolkit_enabled?(req.tenant, id)
      CP.put(req.tenant, :toolkit, id, %{enabled: now})
      {200, %{id: id, enabled: now}}
    else
      {404, %{error: "no such toolkit"}}
    end
  end

  # ── unified toolkit library — the one feed behind the dashboard's Toolkits page. A toolkit comes in
  # two KINDS: a PROVIDER toolkit wraps an external service (the integrations above — connect an account),
  # a STANDALONE toolkit needs none. `status` is "ready" | "soon" so the UI can mark unfinished work.
  def toolkits(req) do
    conns = CP.list(req.tenant, :integration)

    providers =
      for p <- catalog() do
        accounts =
          conns
          |> Enum.filter(&(&1[:provider] == p.id))
          |> Enum.map(&%{id: &1[:id], label: &1[:label], status: &1[:status] || "connected"})

        ready = configured?(p) and not Map.get(p, :soon, false)

        p
        |> Map.take([:id, :name, :group, :blurb, :detail, :field, :hint])
        |> Map.merge(%{
          kind: "provider",
          mode: Atom.to_string(p.mode),
          configured: configured?(p),
          status: if(ready, do: "ready", else: "soon"),
          accounts: accounts
        })
      end

    standalone =
      Enum.map(standalone_catalog(), fn t ->
        t |> Map.put(:kind, "standalone") |> Map.put(:enabled, toolkit_enabled?(req.tenant, t.id))
      end)

    %{toolkits: providers ++ standalone}
  end

  # ── list — the marketplace state: every provider + the accounts wired up under it ──────────────
  def list_integrations(req) do
    conns = CP.list(req.tenant, :integration)

    providers =
      for p <- catalog() do
        accounts =
          conns
          |> Enum.filter(&(&1[:provider] == p.id))
          |> Enum.map(&%{id: &1[:id], label: &1[:label], status: &1[:status] || "connected"})

        p
        |> Map.take([:id, :name, :group, :blurb, :field, :hint])
        |> Map.put(:mode, Atom.to_string(p.mode))
        |> Map.put(:configured, configured?(p))
        |> Map.put(:accounts, accounts)
      end

    %{providers: providers}
  end

  # API-key providers are always ready (you paste). OAuth providers need this nexus's app credentials.
  defp configured?(%{mode: :api_key}), do: true
  # Google connects via domain-wide delegation (a service account), NOT a 3-legged OAuth client — so its
  # readiness is the DWD seam, not GOOGLE_OAUTH_CLIENT_ID.
  defp configured?(%{id: "google"}), do: Nexus.Google.configured?()
  defp configured?(%{mode: :oauth2, id: id}), do: Nexus.Secrets.has?(client_id_secret(id))

  # ── API-key connect — seal the pasted token, store the connection ──────────────────────────────
  def connect_api_key(req) do
    b = req.body || %{}
    provider = b["provider"]
    label = String.trim(to_string(b["label"] || ""))
    credential = to_string(b["credential"] || "")
    s = spec(provider)

    cond do
      is_nil(s) or s.mode != :api_key -> {400, %{error: "not an API-key provider"}}
      label == "" -> {400, %{error: "name this account"}}
      credential == "" -> {400, %{error: "a credential is required"}}
      true ->
        id = new_id()

        case seal(req.tenant, id, "TOKEN", credential) do
          {:ok, sid} ->
            store_connection(req.tenant, id, provider, label, %{token_secret_id: sid})
            {201, %{id: id, provider: provider, label: label, status: "connected"}}

          {:error, reason} ->
            {seal_status(reason), %{error: to_string(reason)}}
        end
    end
  end

  # ── OAuth: step 1 — mint state, hand back the provider authorize URL for the popup ─────────────
  def authorize(req) do
    provider = req.query["provider"]
    label = String.trim(to_string(req.query["label"] || ""))
    origin = to_string(req.query["origin"] || "")
    s = spec(provider)

    cond do
      is_nil(s) or s.mode != :oauth2 -> {400, %{error: "not an OAuth provider"}}
      not configured?(s) -> {400, %{error: "#{s.name} OAuth app not configured (set #{client_id_secret(provider)} / #{client_secret_secret(provider)})"}}
      origin == "" -> {400, %{error: "origin required"}}
      true ->
        state = new_state()
        redirect_uri = origin <> "/cloud/oauth/callback"
        # Park the handshake so the callback can resolve tenant + the exact redirect_uri used.
        CP.put(@oauth_org, :oauth_state, state, %{
          tenant: req.tenant, provider: provider, label: label, redirect_uri: redirect_uri
        })

        params =
          Map.merge(s.auth_params, %{
            "client_id" => Nexus.Secrets.get(client_id_secret(provider)),
            "redirect_uri" => redirect_uri,
            "response_type" => "code",
            "scope" => s.scopes,
            "state" => state
          })

        {200, %{url: s.authorize_url <> "?" <> URI.encode_query(params)}}
    end
  end

  # ── OAuth: step 2 — provider redirects here; exchange the code server-side, seal the tokens ─────
  def callback(req) do
    code = req.query["code"]
    state = req.query["state"]

    with {:ok, pend} <- CP.get(@oauth_org, :oauth_state, state),
         true <- is_binary(code) and code != "",
         s when not is_nil(s) <- spec(pend.provider),
         {:ok, tokens} <- exchange_code(s, code, pend.redirect_uri) do
      CP.delete(@oauth_org, :oauth_state, state)
      persist_oauth(pend.tenant, pend.provider, pend.label, tokens)
      popup_done("Connected — you can close this window.")
    else
      _ ->
        if state, do: CP.delete(@oauth_org, :oauth_state, state)
        popup_done("Connection failed. Close this window and try again.")
    end
  end

  # Seal access + refresh as TWO separate encrypted secrets; expiry (not sensitive) on the record.
  defp persist_oauth(tenant, provider, label, tokens) do
    id = new_id()
    {:ok, asid} = seal(tenant, id, "ACCESS", tokens.access)
    refresh_id = if tokens.refresh, do: with({:ok, rid} <- seal(tenant, id, "REFRESH", tokens.refresh), do: rid)

    store_connection(tenant, id, provider, account_label(provider, label, tokens.access), %{
      access_secret_id: asid,
      refresh_secret_id: refresh_id,
      expires_at: tokens.expires_at
    })
  end

  # The connection's display name. If the popup supplied one, keep it; otherwise derive it from the
  # authorized identity (GitHub login, Google email) so connecting is just Connect → OAuth, no naming.
  defp account_label(provider, label, access) do
    case String.trim(to_string(label)) do
      "" -> derive_label(provider, access) || String.capitalize(provider)
      l -> l
    end
  end

  defp derive_label("github", token),
    do: identity_field("https://api.github.com/user", token, "login")

  defp derive_label("gmail", token),
    do: identity_field("https://www.googleapis.com/oauth2/v2/userinfo", token, "email")

  defp derive_label(_provider, _token), do: nil

  # GET a provider identity endpoint with the fresh access token and pull one field for the label.
  defp identity_field(url, token, key) do
    :inets.start()
    :ssl.start()

    headers = [
      {~c"authorization", ~c"Bearer " ++ to_charlist(token)},
      {~c"accept", ~c"application/json"},
      {~c"user-agent", ~c"workbooks-nexus"}
    ]

    case :httpc.request(:get, {to_charlist(url), headers}, [timeout: 10_000, ssl: [verify: :verify_none]], body_format: :binary) do
      {:ok, {{_, code, _}, _h, body}} when code in 200..299 ->
        case Jason.decode(body) do
          {:ok, m} when is_map(m) -> m[key]
          _ -> nil
        end

      _ ->
        nil
    end
  rescue
    _ -> nil
  end

  # ── refresh — the seam toolkits call. Returns a live access token, refreshing if expired. ───────
  # `{:ok, token} | {:error, reason}`. Server-side only; never exposed as a plaintext-returning route.
  def fresh_token(tenant, id) do
    with {:ok, rec} <- CP.get(tenant, :integration, id) do
      cond do
        rec[:token_secret_id] -> Env.reveal(tenant, rec.token_secret_id)
        expired?(rec) and rec[:refresh_secret_id] -> refresh(tenant, rec)
        rec[:access_secret_id] -> Env.reveal(tenant, rec.access_secret_id)
        true -> {:error, :no_token}
      end
    end
  end

  defp expired?(%{expires_at: at}) when is_integer(at), do: System.os_time(:second) >= at - 60
  defp expired?(_), do: false

  defp refresh(tenant, rec) do
    s = spec(rec.provider)

    with {:ok, refresh_tok} <- Env.reveal(tenant, rec.refresh_secret_id),
         {:ok, tokens} <- refresh_code(s, refresh_tok) do
      Env.update(tenant, rec.access_secret_id, %{value: tokens.access})
      new_refresh_id = rec.refresh_secret_id

      if tokens.refresh,
        do: Env.update(tenant, rec.refresh_secret_id, %{value: tokens.refresh})

      CP.update(tenant, :integration, rec.id, %{expires_at: tokens.expires_at, refresh_secret_id: new_refresh_id})
      {:ok, tokens.access}
    end
  end

  # ── disconnect — drop the sealed secrets, then the record ──────────────────────────────────────
  def remove_integration(req) do
    id = req.params["id"]

    case CP.get(req.tenant, :integration, id) do
      {:ok, rec} ->
        for k <- [:token_secret_id, :access_secret_id, :refresh_secret_id],
            sid = rec[k],
            is_binary(sid),
            do: Env.delete(req.tenant, sid)

        CP.delete(req.tenant, :integration, id)
        %{ok: true, id: id}

      {:error, :not_found} ->
        {404, %{error: "no such connection"}}
    end
  end

  # ── token endpoints (HTTP) ─────────────────────────────────────────────────────────────────────
  defp exchange_code(s, code, redirect_uri) do
    form = %{
      "grant_type" => "authorization_code",
      "code" => code,
      "redirect_uri" => redirect_uri,
      "client_id" => Nexus.Secrets.get(client_id_secret(s.id)),
      "client_secret" => Nexus.Secrets.get(client_secret_secret(s.id))
    }

    post_token(s.token_url, form)
  end

  defp refresh_code(s, refresh_tok) do
    form = %{
      "grant_type" => "refresh_token",
      "refresh_token" => refresh_tok,
      "client_id" => Nexus.Secrets.get(client_id_secret(s.id)),
      "client_secret" => Nexus.Secrets.get(client_secret_secret(s.id))
    }

    post_token(s.token_url, form)
  end

  # POST the form to the provider's token endpoint and normalise the bundle. `Accept: application/json`
  # makes GitHub answer JSON (it defaults to form-encoded); everyone else already does.
  defp post_token(url, form) do
    :inets.start()
    :ssl.start()
    body = URI.encode_query(form)

    headers = [
      {~c"accept", ~c"application/json"},
      {~c"user-agent", ~c"workbooks-nexus"}
    ]

    req = {to_charlist(url), headers, ~c"application/x-www-form-urlencoded", body}

    case :httpc.request(:post, req, [timeout: 15_000, ssl: [verify: :verify_none]], body_format: :binary) do
      {:ok, {{_, code, _}, _h, resp}} when code in 200..299 ->
        case Jason.decode(resp) do
          {:ok, %{"access_token" => access} = m} ->
            exp = m["expires_in"]
            {:ok, %{
              access: access,
              refresh: m["refresh_token"],
              expires_at: if(is_integer(exp), do: System.os_time(:second) + exp, else: nil)
            }}

          _ ->
            {:error, :bad_token_response}
        end

      {:ok, {{_, code, _}, _h, _resp}} ->
        {:error, {:token_http, code}}

      {:error, e} ->
        {:error, inspect(e)}
    end
  end

  # ── Google Workspace via domain-wide delegation ────────────────────────────────────────────────
  # The cheapest/fastest broad-access path: ONE service account (ours), the customer's super-admin
  # authorizes its client id + these scopes once in their Admin console, and the agent then impersonates
  # any user in the domain (create mailboxes, manage aliases, drive Admin SDK/Gmail). No per-user OAuth,
  # no Marketplace listing required. Tokens are minted on demand by `Nexus.Google` — nothing to seal.
  # Scope minimisation (cheapest = no CASA): drive.file not full drive, gmail.modify/settings not
  # mail.google.com/. admin.directory.* + cloud-platform are "sensitive" (verification, no CASA).
  @dwd_scopes [
    "openid",
    "email",
    "https://www.googleapis.com/auth/admin.directory.user",
    "https://www.googleapis.com/auth/admin.directory.user.alias",
    "https://www.googleapis.com/auth/admin.directory.domain",
    "https://www.googleapis.com/auth/admin.directory.group",
    "https://www.googleapis.com/auth/gmail.settings.basic",
    "https://www.googleapis.com/auth/gmail.settings.sharing",
    "https://www.googleapis.com/auth/gmail.modify",
    "https://www.googleapis.com/auth/drive.file",
    "https://www.googleapis.com/auth/cloud-platform"
  ]

  @doc "What the dashboard shows so a customer's admin can wire delegation: the SA client id + scopes."
  def google_delegation(_req) do
    %{
      configured: Nexus.Google.configured?(),
      client_id: Nexus.Google.client_id(),
      scopes: @dwd_scopes,
      scopes_csv: Enum.join(@dwd_scopes, ","),
      admin_console_url: "https://admin.google.com/ac/owl/domainwidedelegation"
    }
  end

  # Record a delegation connection: the only per-tenant facts are the domain + the admin user we
  # impersonate for Admin SDK calls. No tokens stored — `google_token/3` mints them on demand.
  def connect_google_dwd(req) do
    b = req.body || %{}
    domain = String.trim(to_string(b["domain"] || "")) |> String.downcase()
    admin = String.trim(to_string(b["admin_email"] || "")) |> String.downcase()

    cond do
      not Nexus.Google.configured?() -> {503, %{error: "delegation service account not configured on this nexus"}}
      domain == "" -> {400, %{error: "your Workspace domain is required"}}
      not String.contains?(admin, "@") -> {400, %{error: "a super-admin email to impersonate is required"}}
      true ->
        id = new_id()
        store_connection(req.tenant, id, "google", domain, %{mode: "dwd", admin_email: admin})
        {201, %{id: id, provider: "google", label: domain, status: "connected", mode: "dwd"}}
    end
  end

  # Create a dedicated agent mailbox on the connected domain. Impersonates the stored super-admin for the
  # Admin SDK call. WARNS the caller this consumes a paid Workspace seat (billed to the customer).
  def google_create_mailbox(req) do
    b = req.body || %{}
    email = String.trim(to_string(b["email"] || ""))

    cond do
      email == "" -> {400, %{error: "an email for the mailbox is required"}}
      true ->
        with {:ok, token} <- google_token(req.tenant, req.params["id"], "https://www.googleapis.com/auth/admin.directory.user") do
          attrs = %{primary_email: email, given_name: b["given_name"] || "Workbooks", family_name: b["family_name"] || "Agent"}

          case Nexus.Google.Admin.create_user(token, attrs) do
            {:ok, user} -> {201, %{ok: true, user: user, note: "this mailbox consumes a paid Workspace seat"}}
            {:error, reason} -> {502, %{error: inspect(reason)}}
          end
        else
          {:error, reason} -> {502, %{error: inspect(reason)}}
        end
    end
  end

  # Add a free proxy alias to an existing user on the connected domain.
  def google_add_alias(req) do
    b = req.body || %{}
    user = String.trim(to_string(b["user"] || ""))
    alias_email = String.trim(to_string(b["alias"] || ""))

    cond do
      user == "" or alias_email == "" -> {400, %{error: "user + alias are required"}}
      true ->
        with {:ok, token} <- google_token(req.tenant, req.params["id"], "https://www.googleapis.com/auth/admin.directory.user.alias") do
          case Nexus.Google.Admin.add_alias(token, user, alias_email) do
            {:ok, _} -> {201, %{ok: true, user: user, alias: alias_email}}
            {:error, reason} -> {502, %{error: inspect(reason)}}
          end
        else
          {:error, reason} -> {502, %{error: inspect(reason)}}
        end
    end
  end

  # Grant a mailbox the ability to send as another address (impersonates that mailbox, not the admin).
  def google_add_sendas(req) do
    b = req.body || %{}
    user = String.trim(to_string(b["user"] || ""))
    send_as = String.trim(to_string(b["send_as"] || ""))

    cond do
      user == "" or send_as == "" -> {400, %{error: "user + send_as are required"}}
      true ->
        with {:ok, token} <- google_token(req.tenant, req.params["id"], "https://www.googleapis.com/auth/gmail.settings.sharing", user) do
          case Nexus.Google.Admin.add_send_as(token, user, send_as) do
            {:ok, _} -> {201, %{ok: true, user: user, send_as: send_as}}
            {:error, reason} -> {502, %{error: inspect(reason)}}
          end
        else
          {:error, reason} -> {502, %{error: inspect(reason)}}
        end
    end
  end

  @doc """
  Server-side seam toolkits call to act on a Google connection. Mints an impersonated access token for
  `scopes`, acting as `sub` (defaults to the stored admin for domain ops). `{:ok, token} | {:error, _}`.
  """
  def google_token(tenant, conn_id, scopes, sub \\ nil) do
    with {:ok, rec} <- CP.get(tenant, :integration, conn_id),
         "dwd" <- rec[:mode] || "dwd",
         impersonate when is_binary(impersonate) <- sub || rec[:admin_email] do
      case Nexus.Google.access_token(impersonate, scopes) do
        {:ok, %{access: token}} -> {:ok, token}
        {:skip, reason} -> {:error, reason}
        err -> err
      end
    else
      {:error, _} = err -> err
      _ -> {:error, :not_a_delegation_connection}
    end
  end

  # ── shared helpers ─────────────────────────────────────────────────────────────────────────────
  defp store_connection(tenant, id, provider, label, extra) do
    attrs = Map.merge(%{provider: provider, label: label, status: "connected"}, extra)
    {:ok, rec} = CP.put(tenant, :integration, id, attrs)
    rec
  end

  # Seal one value into the encrypted Env store under a per-connection name; returns its secret id.
  defp seal(tenant, conn_id, suffix, value) do
    name = "#{String.upcase(conn_id)}__#{suffix}" |> String.replace(~r/[^A-Z0-9_]/, "_")

    case Env.create(tenant, %{name: name, value: value, scope: "user"}) do
      {:ok, env} -> {:ok, env[:id]}
      err -> err
    end
  end

  defp seal_status(:no_master_key), do: 503
  defp seal_status(_), do: 400

  # The deploy-injected secret name holding this provider's OAuth client id / secret. We prefer the
  # dedicated `<PROVIDER>_OAUTH_*` name, but fall back to any provider-specific alias so an operator who
  # already injected credentials for a sibling feature need not register a second app. GitHub is the
  # case in point: a GitHub *App* (for repo mirroring) already ships `GITHUB_APP_CLIENT_ID/_SECRET`, and
  # its user-to-server OAuth uses the very same authorize/token endpoints — so the marketplace "Connect"
  # button reuses those creds with no extra registration. (App OAuth ignores the `scope` param and grants
  # the App's installed permissions instead, which is exactly what we want here.)
  # "gmail" is the personal (3-legged) Google connect — it shares the GOOGLE_OAUTH_* web-client creds.
  @oauth_id_aliases %{
    "github" => ["GITHUB_OAUTH_CLIENT_ID", "GITHUB_APP_CLIENT_ID"],
    "gmail" => ["GOOGLE_OAUTH_CLIENT_ID"]
  }
  @oauth_secret_aliases %{
    "github" => ["GITHUB_OAUTH_CLIENT_SECRET", "GITHUB_APP_CLIENT_SECRET"],
    "gmail" => ["GOOGLE_OAUTH_CLIENT_SECRET"]
  }

  defp client_id_secret(provider),
    do: resolve_secret_name(provider, @oauth_id_aliases, "#{String.upcase(provider)}_OAUTH_CLIENT_ID")

  defp client_secret_secret(provider),
    do: resolve_secret_name(provider, @oauth_secret_aliases, "#{String.upcase(provider)}_OAUTH_CLIENT_SECRET")

  # First candidate name that's actually present wins; otherwise the canonical name (so error messages and
  # `configured?/1` report the name an operator is expected to set).
  defp resolve_secret_name(provider, aliases, default) do
    case aliases[provider] do
      names when is_list(names) -> Enum.find(names, default, &Nexus.Secrets.has?/1)
      _ -> default
    end
  end

  defp new_id, do: "intg_" <> rand()
  defp new_state, do: "st_" <> rand()
  defp rand, do: :crypto.strong_rand_bytes(16) |> Base.url_encode64(padding: false)

  defp popup_done(msg) do
    html = """
    <!doctype html><meta charset="utf-8"><title>Workbooks</title>
    <body style="font:15px system-ui;background:#16171a;color:#ecebe5;display:grid;place-items:center;height:100vh;margin:0">
    <p>#{msg}</p>
    <script>try{window.opener&&window.opener.postMessage('wb-integration-connected','*')}catch(e){}; setTimeout(function(){window.close()},800);</script>
    </body>
    """

    {200, "text/html; charset=utf-8", html}
  end
end
