  (function(){
    var $=function(s){return document.querySelector(s)};
    function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(m){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]})}
    var cats=['All'].concat(Array.from(new Set(CATALOG.map(function(t){return t.category}))).sort());
    var active='All';
    function card(t){
      return '<div class="tk" data-slug="'+esc(t.slug)+'"><div class="top"><span class="lg" style="background:'+esc(t.tint||'#2a2d34')+'">'+
        (t.logo?'<img src="'+esc(t.logo)+'" onerror="this.style.display=\'none\'">':'')+'</span><span class="t">'+esc(t.title)+'</span></div>'+
        '<div class="tag">'+esc(t.tagline||'')+'</div>'+
        '<div class="meta"><span class="badge">'+esc(t.category)+'</span><span class="badge">'+esc(t.kind)+'</span><span class="badge st">'+esc(t.status)+'</span></div></div>';
    }
    function renderGrid(){
      var list=active==='All'?CATALOG:CATALOG.filter(function(t){return t.category===active});
      $('#grid').innerHTML=list.map(card).join('');
      [].forEach.call(document.querySelectorAll('.tk'),function(el){el.addEventListener('click',function(){detail(el.dataset.slug)})});
    }
    function renderFilters(){
      $('#filters').innerHTML=cats.map(function(c){return '<button class="pill'+(c===active?' on':'')+'" data-c="'+esc(c)+'">'+esc(c)+'</button>'}).join('');
      [].forEach.call(document.querySelectorAll('.pill'),function(p){p.addEventListener('click',function(){active=p.dataset.c;renderFilters();renderGrid()})});
    }
    function kv(k,v){return v?'<div class="kv"><b>'+k+'</b><span>'+esc(Array.isArray(v)?v.join(', '):v)+'</span></div>':''}
    function detail(slug){
      var t=CATALOG.filter(function(x){return x.slug===slug})[0]; if(!t)return;
      $('#dcard').innerHTML='<button class="dclose" data-x>×</button><h2>'+esc(t.title)+'</h2><p class="dtag">'+esc(t.tagline||'')+'</p>'+
        (t.description?'<p class="desc">'+esc(t.description)+'</p>':'')+
        kv('Kind',t.kind)+kv('Category',t.category)+kv('Status',t.status)+kv('Version',t.version)+
        kv('Integration',t.integration)+kv('Capabilities',t.caps)+kv('Env keys',t.env_keys)+kv('Updated',t.updated);
      $('#detail').classList.add('on');
      $('#dcard [data-x]').addEventListener('click',function(){$('#detail').classList.remove('on')});
    }
    $('#detail').addEventListener('click',function(e){if(e.target===$('#detail'))$('#detail').classList.remove('on')});
    renderFilters(); renderGrid();
  })();
  </script>
end
