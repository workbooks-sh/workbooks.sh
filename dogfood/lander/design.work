# Design — the lander brand sheet

The marketing lander's whole visual system — the trial font slots, the "lattice" brand
(hard type, breathing cells, flat color), every section's styles. Migrated verbatim from
`web/index.html`'s head; tangled into a stylesheet by the weaver. Fonts resolve from this
workbook's own `fonts/` (served as static assets).

design :lander do
  nav.wb-nav { display: none !important; }
  section.file { display: block; margin: 0; padding: 0; max-width: none; border: 0; }
  
    /* ── BRAND V · "lattice" ─ hard type, breathing cells, flat color events ──
       No gradients. No opacity fades. No blur. Everything that moves is
       geometry: cells trade area, identicon pixels are born and die. */
  /* ── headline font slots — switch pairs by editing --display / --accent in :root.
     All trialed faces stay registered below; pairs log: fonts/README.md ── */
  @font-face { font-family: "Inkognito"; src: url("fonts/Inkognito.woff2") format("woff2"), url("fonts/Inkognito.woff") format("woff"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "Florens"; src: url("fonts/CSFlorensPixel-Regular.woff2") format("woff2"), url("fonts/CSFlorensPixel-Regular.woff") format("woff"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "Golem"; src: url("fonts/CSGolem-Regular.woff2") format("woff2"), url("fonts/CSGolem-Regular.woff") format("woff"); font-weight: 400; font-display: swap; }
  /* Braked: the Bold cut is registered at weight 400 on purpose — every display
     spot says 400, and the display face should land heavy like Anton did. */
  @font-face { font-family: "Braked"; src: url("fonts/BRAKED-Bold.woff") format("woff"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "Braked"; src: url("fonts/BRAKED-Semibold.woff") format("woff"); font-weight: 600; font-display: swap; }
  @font-face { font-family: "Warlock"; src: url("fonts/UMWarlock.woff") format("woff"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "Groothan"; src: url("fonts/GroothanMixed-Regular.woff2") format("woff2"), url("fonts/GroothanMixed-Regular.woff") format("woff"); font-weight: 400; font-display: block; }
  @font-face { font-family: "Groothan"; src: url("fonts/GroothanMixed-Italic.woff2") format("woff2"); font-weight: 400; font-style: italic; font-display: swap; }
  @font-face { font-family: "Muzzaro"; src: url("fonts/Muzzaro.woff2") format("woff2"), url("fonts/Muzzaro.woff") format("woff"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "Franie"; src: url("fonts/Franie-Light.woff2") format("woff2"); font-weight: 300; font-display: block; }
  @font-face { font-family: "Franie"; src: url("fonts/Franie-Medium.ttf") format("truetype"); font-weight: 500; font-display: swap; }
  @font-face { font-family: "Franie"; src: url("fonts/Franie-SemiBold.woff2") format("woff2"); font-weight: 600; font-display: block; }
  @font-face { font-family: "Franie"; src: url("fonts/Franie-SemiBoldItalic.woff2") format("woff2"); font-weight: 600; font-style: italic; font-display: block; }
  @font-face { font-family: "Franie"; src: url("fonts/Franie-Bold.woff2") format("woff2"); font-weight: 700; font-display: block; }
  @font-face { font-family: "Franie"; src: url("fonts/Franie-BoldItalic.woff2") format("woff2"); font-weight: 700; font-style: italic; font-display: swap; }
  @font-face { font-family: "Franie"; src: url("fonts/Franie-Black.woff2") format("woff2"); font-weight: 900; font-display: block; }
  
    :root {
      color-scheme: light;
      --paper: #f7f6f1;
      --ink: #121316;
      --bloom: #13d943;  /* neon green — the one accent */
      --display: "Franie", sans-serif;
      --accent: "Franie", sans-serif;
      --mono: "JetBrains Mono", monospace;
    }
    * { box-sizing: border-box; margin: 0; }
    html, body { height: 100%; }
    /* SSR's default page chrome is a 46rem reading column — a full-bleed lander overrides it. */
    body { background: var(--paper); color: var(--ink); font-family: var(--mono); overflow-x: hidden;
           max-width: none; margin: 0; padding: 0; }
  
    /* ── the house scrollbar — dotted track, solid 2px thumb, neutral ink.
       Standard across the whole site; the s3 terminal keeps its piece-accent
       version of the same idea. ── */
    html { scrollbar-width: thin; scrollbar-color: #565b54 transparent; }
    ::-webkit-scrollbar { width: 9px; }
    ::-webkit-scrollbar-track {
      background-image: repeating-linear-gradient(180deg, rgba(86,91,84,.4) 0 4px, transparent 4px 9px);
      background-size: 2px 100%; background-position: center; background-repeat: no-repeat;
    }
    ::-webkit-scrollbar-thumb {
      background-color: #565b54; background-clip: padding-box;
      border-left: 3.5px solid transparent; border-right: 3.5px solid transparent;
    }
  
    #lattice { position: absolute; inset: 0; display: block; }
    #s1 { position: relative; height: 100vh; overflow: hidden; }
  
    /* ── hero ──────────────────────────────────────────────────────────────── */
    .hero {
      position: relative; z-index: 2; height: 100vh;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center; padding: 0 24px;
    }
    .inner { display: flex; flex-direction: column; align-items: center; }
  
    .brandlock { display: flex; align-items: center; gap: 14px; margin-bottom: 30px; }
    .brandlock svg { width: 46px; height: auto; display: block; color: var(--ink); }
    .brandlock span {
      font-family: var(--display); font-weight: 500; font-size: 31px; letter-spacing: .01em;
      text-transform: uppercase; color: var(--ink); line-height: 1;
    }
  
    .lockup { width: fit-content; max-width: 96vw; margin-inline: auto; --hero: clamp(48px, 8.25vw, 112px); }
    .lockup .jl {
      display: block; font-family: var(--display); font-weight: 900; text-transform: uppercase;
      font-size: var(--hero); line-height: .85;
      white-space: nowrap; color: var(--ink); text-align: center;
    }
    .lockup .jl:nth-child(1) { font-weight: 300; font-size: calc(var(--hero) * 1.25); }  /* living  — light */
    .lockup .jl:nth-child(2) { font-weight: 600; font-style: italic; }  /* breathing — semibold */
    .lockup .jl:nth-child(3) { font-size: calc(var(--hero) * 0.875); }  /* software — one size down */
    /* software (nth-child 3) stays 900 black */
    /* the counterpoint line: PIXELS against Anton's block — same ink,
       lowercase, the machine voice between two human shouts */
    /* the pixel voice, canonicalized: 900 so its strokes read the same ink
       density as Anton, a smidge of tracking, sized to Anton's cap height */
    /* the counterpoint line, duo system: Groothan's bubble glyphs in white
       with a thick ink outline, overlapping the grotesque lines around it */
    /* the counterpoint line (2026-06-12): solid white fill + a thick ink ring,
       rendered as a real SVG outline by nav.js (paint-order:stroke) — fixed scale,
       identical on Safari/iOS where -webkit-text-stroke broke. */
    @media (prefers-reduced-motion: reduce) {
      .lockup .jl:nth-child(2) { animation: none; }
    }
  
    .caption {
      margin-top: 30px; width: min(680px, 90vw); font-size: 12.5px; line-height: 1.8;
      color: #565b54; letter-spacing: .01em;
    }
    .caption b { color: var(--ink); font-weight: 700; }
  
    /* CTAs — unchanged */
    .ctas { display: flex; gap: 14px; margin-top: 38px; align-items: center; flex-wrap: wrap; justify-content: center; }
    .btn {
      display: inline-flex; align-items: center; gap: 10px; text-decoration: none;
      font-family: var(--mono); font-weight: 500; font-size: 13px; letter-spacing: .02em;
      padding: 14px 24px; border-radius: 12px; transition: transform .18s ease, box-shadow .25s ease;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn svg { height: 15px; width: auto; display: block; }
    .btn-copy {
      color: var(--ink); background: rgba(255,255,255,.55);
      border: 1px solid rgba(18,19,22,.16); cursor: pointer;
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      padding-left: 20px; padding-right: 30px;
    }
    .btn-copy .vd { width: 1px; height: 17px; background: rgba(18,19,22,.22); margin: 0 5px; }
    .btn-copy:hover { border-color: rgba(18,19,22,.4); }
    .btn-copy .cpy { height: 13px; opacity: .55; }
    .btn-copy.copied .lbl { color: var(--bloom); }
    /* primary CTA → cloud "Start building": ink fill + the brand lip */
    .btn-primary { background: var(--ink); color: var(--paper); box-shadow: 3px 3px 0 var(--ink); }
    .btn-primary:hover { transform: translate(1px,1px); box-shadow: 2px 2px 0 var(--ink); }
    .btn-primary svg { height: 14px; }
    /* download → SECONDARY white (matches the copy buttons, no drop shadow) */
    .btn-dl { color: var(--ink); background: rgba(255,255,255,.55); border: 1px solid rgba(18,19,22,.16);
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
    .btn-dl:hover { border-color: rgba(18,19,22,.4); }
    /* ── download → "notify me" modal ────────────────────────────────────── */
    .dl-modal { position: fixed; inset: 0; z-index: 80; display: none; align-items: center;
      justify-content: center; padding: 24px; background: rgba(18,19,22,.42);
      backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); }
    .dl-modal.on { display: flex; }
    .dl-card { width: min(440px, 100%); background: var(--paper); border-radius: 18px;
      border: 1px solid rgba(18,19,22,.1); box-shadow: 0 30px 80px rgba(18,19,22,.32);
      padding: 28px 28px 26px; position: relative; animation: dlpop .22s cubic-bezier(.2,.8,.2,1); }
    @keyframes dlpop { from { opacity: 0; transform: translateY(10px) scale(.98); } to { opacity: 1; transform: none; } }
    .dl-x { position: absolute; top: 14px; right: 14px; width: 30px; height: 30px; border: 0;
      border-radius: 8px; background: transparent; color: #6a6f68; cursor: pointer; font-size: 20px; line-height: 1; }
    .dl-x:hover { background: rgba(18,19,22,.06); color: var(--ink); }
    .dl-kicker { font-size: 11px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; color: #8b9088; }
    .dl-card h3 { font-family: var(--display, inherit); font-size: 24px; line-height: 1.1; margin: 8px 0 6px; color: var(--ink); letter-spacing: -.01em; }
    .dl-card p.sub { margin: 0 0 18px; color: #5d625b; font-size: 14px; line-height: 1.5; }
    .dl-field { display: block; margin-bottom: 16px; }
    .dl-label { display: block; font-size: 12.5px; font-weight: 600; color: var(--ink); margin-bottom: 8px; }
    .dl-input { width: 100%; padding: 12px 14px; border: 1px solid rgba(18,19,22,.18); border-radius: 11px;
      font: inherit; font-size: 15px; background: #fff; color: var(--ink); }
    .dl-input:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px rgba(18,19,22,.08); }
    .dl-chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .dl-chips input { position: absolute; opacity: 0; pointer-events: none; }
    .dl-chips label { cursor: pointer; font-size: 13px; padding: 8px 13px; border-radius: 999px;
      border: 1px solid rgba(18,19,22,.18); color: #4a4f48; transition: .12s; }
    .dl-chips label:hover { border-color: rgba(18,19,22,.4); }
    .dl-chips input:checked + label { background: var(--ink); color: var(--paper); border-color: var(--ink); }
    .dl-submit { width: 100%; margin-top: 20px; padding: 13px; border: 0; border-radius: 12px;
      background: var(--ink); color: var(--paper); font: inherit; font-size: 15px; font-weight: 600; cursor: pointer;
      box-shadow: 0 12px 30px rgba(18,19,22,.24); transition: .12s; }
    .dl-submit:hover { box-shadow: 0 16px 38px rgba(18,19,22,.34); }
    .dl-submit:disabled { opacity: .6; cursor: default; box-shadow: none; }
    .dl-err { display: none; margin: 12px 0 0; color: #c0392b; font-size: 13px; }
    .dl-thanks { display: none; text-align: center; padding: 8px 0 4px; }
    .dl-thanks .tick { width: 52px; height: 52px; margin: 0 auto 14px; border-radius: 50%;
      background: #aee5c2; display: grid; place-items: center; color: #0a2413; }
    .dl-thanks h3 { margin: 0 0 6px; }
    /* desktop build not published yet — present but resting */
    .btn-dl.soon { pointer-events: none; background: #b5b8b2; box-shadow: none; }
    .btn-dl.soon .tag {
      font-size: 9px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
      background: var(--paper); color: #6a6f68; border-radius: 4px; padding: 2px 6px; margin-left: 2px;
    }
    .btn-agent {
      color: var(--ink); background: rgba(255,255,255,.55);
      border: 1px solid rgba(18,19,22,.16);
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    }
    .btn-agent:hover { border-color: rgba(18,19,22,.4); }
  
    /* open-source badge row — flat two-cell shields in the house style */
    .badges { display: flex; gap: 12px; margin-top: 22px; justify-content: center; flex-wrap: wrap; }
    .badge {
      display: inline-flex; align-items: stretch; text-decoration: none;
      font-family: var(--mono); font-size: 10.5px; font-weight: 700; letter-spacing: .03em;
      border: 1.5px solid var(--ink); border-radius: 5px; overflow: hidden;
    }
    .badge .k { display: inline-flex; align-items: center; gap: 6px; background: var(--ink); color: var(--paper); padding: 5px 9px; }
    .badge .k svg { height: 12px; width: auto; display: block; }
    .badge .v { display: inline-flex; align-items: center; color: var(--ink); padding: 5px 9px; }
    .badge:hover .v { background: var(--bloom) !important; }
  
    /* ── section 2 · the grove ───────────────────────────────────────────────
       Neon green world. Arrival is a RADIAL bloom from the bottom of the
       screen (scroll-scrubbed veil). Inside: an ASCII tree of very small
       glyphs grows bottom-up and blossoms; node-graph roots hang beneath it
       on verlet physics. */
    /* ── the seam: a DNA sequence line — flat color blocks of varying width
       drifting past, occasionally mutating. Same pastels as the lattice. ── */
    #dna { position: absolute; bottom: 0; left: 0; right: 0; height: 18px; z-index: 3; }
    #dna canvas { display: block; }
  
    /* ── platforms section: desktop (soon) · cloud (live) ─────────────────────── */
    #platforms { position: relative; z-index: 4; background: var(--paper); padding: calc(17vh + 96px) 24px 104px; }
    .plat-head { max-width: 760px; margin: 0 auto 46px; text-align: center; }
    .plat-kicker { font: 700 11px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: #565b54; margin: 0 0 16px; }
    .plat-kicker b { color: var(--bloom); }
    .plat-h { font-family: var(--display, inherit); font-weight: 600; font-size: clamp(30px, 4vw, 48px); line-height: 1.05; letter-spacing: -.018em; color: var(--ink); margin: 0 0 14px; }
    .plat-sub { font-size: clamp(15px, 1.5vw, 17px); line-height: 1.55; color: #4a4f48; max-width: 600px; margin: 0 auto; }
    .plat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; max-width: 1140px; margin: 0 auto; }
    .plat-card { background: #fff; border: 1px solid rgba(18,19,22,.1); border-radius: 20px; padding: 30px 30px 28px; box-shadow: 0 18px 50px rgba(18,19,22,.07); display: flex; flex-direction: column; }
    .plat-card.live { box-shadow: 0 22px 60px rgba(18,19,22,.12); border-color: rgba(18,19,22,.16); }
    .plat-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .plat-ic { width: 46px; height: 46px; border-radius: 13px; display: grid; place-items: center; }
    .plat-ic svg { width: 23px; height: 23px; }
    .plat-tag { font: 700 10.5px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: #6a6f68; background: #f1efe8; border-radius: 999px; padding: 6px 11px; }
    .plat-tag.on { color: #0a2413; background: #aee5c2; display: inline-flex; align-items: center; gap: 6px; }
    .plat-tag.on .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--bloom); box-shadow: 0 0 0 0 rgba(19,217,67,.5); animation: platpulse 1.8s infinite; }
    @keyframes platpulse { 0% { box-shadow: 0 0 0 0 rgba(19,217,67,.5) } 70% { box-shadow: 0 0 0 6px rgba(19,217,67,0) } 100% { box-shadow: 0 0 0 0 rgba(19,217,67,0) } }
    .plat-card h3 { font-size: 22px; font-weight: 650; letter-spacing: -.01em; color: var(--ink); margin: 0 0 10px; }
    .plat-card p { font-size: 14.5px; line-height: 1.6; color: #4a4f48; margin: 0 0 22px; flex: 1; }
    .plat-btn { display: inline-flex; align-items: center; gap: 7px; align-self: flex-start; font: 600 14px/1 var(--sans, inherit); text-decoration: none; cursor: pointer; padding: 12px 18px; border-radius: 12px; transition: transform .08s, box-shadow .12s, background .12s; }
    .plat-btn.primary { background: var(--ink); color: var(--paper); border: 0; box-shadow: 0 12px 30px rgba(18,19,22,.24); }
    .plat-btn.primary:hover { box-shadow: 0 16px 40px rgba(18,19,22,.34); transform: translateY(-1px); }
    .plat-btn.ghost { background: transparent; color: var(--ink); border: 1px solid rgba(18,19,22,.22); }
    .plat-btn.ghost:hover { border-color: var(--ink); }
    .plat-btn.copy { background: transparent; color: var(--ink); border: 1px solid rgba(18,19,22,.22); font-family: var(--mono); font-size: 12.5px; }
    .plat-btn.copy:hover { border-color: var(--ink); }
    .plat-btn.copy svg { width: 14px; height: 14px; opacity: .6; }
    .plat-btn.copy.copied .lbl { color: var(--bloom); }
    @media (max-width: 920px) { .plat-grid { grid-template-columns: 1fr; max-width: 460px; } }
    @media (max-width: 760px) { #platforms { padding: calc(8vh + 64px) 20px 72px; } }
  
    /* ── cloud pricing: one dark comparison table — per-seat stack (10/50/100) vs. our flat $20 ─── */
    #cloud-pricing { position: relative; z-index: 4; background: #0c0d10; color: #e9e7e1; padding: 80px 24px 88px; }
    .cp-inner { max-width: 720px; margin: 0 auto; text-align: center; }
    .cp-kicker { font: 700 11px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: #8a8f86; display: inline-flex; align-items: center; gap: 9px; margin: 0 0 16px; }
    .cp-kicker .dot { width: 7px; height: 7px; border-radius: 50%; background: #aee5c2; box-shadow: 0 0 12px rgba(174,229,194,.6); }
    .cp-h { font-size: clamp(26px, 4vw, 40px); line-height: 1.08; letter-spacing: -.025em; font-weight: 680; margin: 0 0 14px; color: #fff; }
    .cp-sub { font-size: 15px; line-height: 1.55; color: #a8aca3; max-width: 500px; margin: 0 auto 34px; }

    /* the one table */
    .cp-table { width: 100%; border-collapse: collapse; font-size: 15px; text-align: left; }
    .cp-table th { font: 700 10px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: #8a8f86; padding: 0 0 13px; border-bottom: 1px solid rgba(255,255,255,.12); }
    .cp-table th.tool { text-align: left; }
    .cp-table td { padding: 13px 0; border-bottom: 1px solid rgba(255,255,255,.06); color: #cdd0c8; }
    .cp-table .num { text-align: right; font-variant-numeric: tabular-nums; color: #cdd0c8; white-space: nowrap; padding-left: 22px; }
    .cp-table th.num { color: #8a8f86; }
    .cp-table .bc { display: flex; align-items: center; gap: 10px; color: #e9e7e1; font-weight: 500; white-space: nowrap; }
    .cp-table .g { width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; flex: none; }
    .cp-table .g svg, .cp-table img.g { width: 20px; height: 20px; display: block; }
    .cp-table .seat { font: 600 11px var(--mono); color: #6a6f68; margin-left: 2px; }

    /* the whole-stack subtotal — the number that hurts */
    .cp-compare .total td { color: #fff; font-weight: 700; border-bottom: 0; }
    .cp-compare .total .bc { color: #fff; font-weight: 700; }
    .cp-compare .total .num { color: #e0856b; }

    /* the row that breaks the pattern */
    .cp-compare .wbrow td { border-bottom: 0; padding: 18px 0 4px; border-top: 1px solid rgba(255,255,255,.16); }
    .cp-compare .wbrow .bc { color: #fff; font-weight: 700; }
    .cp-compare .wbrow .wbmark { color: #aee5c2; }
    .cp-compare .wbrow .seat { color: #aee5c2; }
    .cp-compare .wbrow .num b { font-size: 22px; font-weight: 700; color: #aee5c2; }

    .cp-foot { font-size: 14px; line-height: 1.6; color: #8a8f86; margin: 28px 0 0; }
    .cp-foot b { color: #cdd0c8; font-weight: 600; }
    .cp-foot a { color: #fff; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,.3); white-space: nowrap; }
    @media (max-width: 620px) {
      #cloud-pricing { padding: 60px 16px 68px; }
      .cp-table { font-size: 13.5px; }
      .cp-table .seat { display: none; }
      .cp-table .num { padding-left: 12px; }
    }

    /* ── cloud tiers: the offer — four pastel-accented machine tiers (no free) ─────── */
    #cloud-tiers { position: relative; z-index: 4; background: #0c0d10; color: #e9e7e1; padding: 8px 24px 96px; }
    .ct-inner { max-width: 1080px; margin: 0 auto; text-align: center; }
    .ct-kicker { font: 700 11px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: #8a8f86; margin: 0 0 14px; }
    .ct-h { font-size: clamp(24px, 3.4vw, 36px); line-height: 1.1; letter-spacing: -.025em; font-weight: 680; margin: 0 0 12px; color: #fff; }
    .ct-sub { font-size: 15px; line-height: 1.55; color: #a8aca3; max-width: 520px; margin: 0 auto 40px; }
    .ct-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; text-align: left; }
    .ct-card { position: relative; background: #15171c; border: 1px solid rgba(255,255,255,.09); border-radius: 16px; padding: 22px 20px 24px; display: flex; flex-direction: column; }
    .ct-card.pop { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 12px 40px -16px var(--accent); }
    .ct-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
    .ct-name { display: inline-flex; align-items: center; gap: 8px; font: 700 13px var(--mono); letter-spacing: .04em; text-transform: uppercase; color: #fff; }
    .ct-name::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: var(--accent); flex: none; }
    .ct-tag { font: 700 9px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: #11231a; background: var(--accent); padding: 4px 7px; border-radius: 20px; }
    .ct-price { display: flex; align-items: baseline; gap: 3px; margin-bottom: 4px; }
    .ct-price b { font-size: 30px; font-weight: 700; color: #fff; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
    .ct-price span { font: 600 13px var(--mono); color: #7e837a; }
    .ct-spec { font: 600 12px var(--mono); color: #8a8f86; padding-bottom: 16px; margin-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,.08); }
    .ct-spec .ct-mem { color: var(--accent); }
    .ct-feat { list-style: none; margin: 0 0 20px; padding: 0; display: flex; flex-direction: column; gap: 9px; flex: 1; }
    .ct-feat li { position: relative; padding-left: 20px; font-size: 13px; line-height: 1.4; color: #cdd0c8; }
    .ct-feat li::before { content: ""; position: absolute; left: 0; top: 5px; width: 11px; height: 6px; border-left: 2px solid var(--accent); border-bottom: 2px solid var(--accent); transform: rotate(-45deg); }
    .ct-btn { display: block; text-align: center; font: 700 12px/1 var(--mono); letter-spacing: .05em; color: #11231a; background: var(--accent); padding: 12px; border-radius: 10px; text-decoration: none; transition: filter .12s, transform .12s; }
    .ct-btn:hover { filter: brightness(1.08); transform: translateY(-1px); }
    .ct-note { font-size: 12px; line-height: 1.45; color: #6a6f68; margin: 14px 0 0; }
    /* enterprise — full-width banner beneath the four cards */
    .ct-ent { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 16px;
      background: #15171c; border: 1px solid rgba(255,255,255,.09); border-left: 3px solid var(--accent); border-radius: 16px; padding: 20px 24px; text-align: left; }
    .ct-ent-l { min-width: 0; }
    .ct-ent .ct-name::before { background: var(--accent); }
    .ct-ent-sub { font-size: 13px; line-height: 1.5; color: #8a8f86; margin: 8px 0 0; }
    .ct-ent-btn { flex: none; width: auto; padding: 12px 22px; }
    .ct-foot { font-size: 13.5px; line-height: 1.6; color: #8a8f86; max-width: 560px; margin: 36px auto 0; }
    @media (max-width: 920px) { .ct-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 520px) { #cloud-tiers { padding: 0 16px 72px; } .ct-grid { grid-template-columns: 1fr; } .ct-ent { flex-direction: column; align-items: flex-start; } }
  
    #s2 { position: relative; height: 100vh; background: var(--paper); overflow: hidden; }
    .sky-pin { position: relative; height: 100vh; overflow: hidden; }
    #tree { position: absolute; inset: 0; display: block; }
    .sky-content {
      position: absolute; inset: 0; z-index: 3;
      display: flex; flex-direction: column; align-items: center; justify-content: space-between;
      padding: 11vh 7vw 5vh; text-align: center; pointer-events: none;
    }
    .sky-head { max-width: 820px; margin-inline: auto; }
    .sky-kicker {
      font-size: 11px; font-weight: 700; letter-spacing: .34em; text-transform: uppercase;
      color: var(--ink); margin-bottom: 18px;
    }
    .sky-kicker b { color: var(--bloom); }
    .sky-h {
      font-family: var(--display); font-weight: 600; font-size: clamp(32px, 3.7vw, 60px); line-height: .98;
      color: var(--ink);
    }
    .sky-h em {
      font-style: italic; font-weight: inherit;
      color: var(--ink);
    }
    .sky-points {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 34px;
      max-width: 1060px; margin: 0; padding: 0;
    }
    .sky-points li {
      list-style: none; font-size: 12px; line-height: 1.7; color: #3c423a;
      text-align: left; padding-left: 20px; position: relative;
    }
    .sky-points li b { display: block; color: var(--ink); }
    .sky-points li::before { content: "■"; position: absolute; left: 0; top: 3px; font-size: 9px; color: var(--bloom); }
    .sky-more {
      display: inline-block; margin-top: 22px; font-size: 12px; font-weight: 700;
      letter-spacing: .06em; text-transform: uppercase; color: var(--ink); text-decoration: none;
      border-bottom: 2px solid var(--bloom); padding-bottom: 3px; pointer-events: auto;
    }
    .sky-more:hover { color: var(--bloom); }
  
    /* ── section 3 · the ecosystem — DARK. Pastel DNA-family color system:
       each piece owns a pastel and a small spectrum; ink icons on pastel
       tiles; soft borders; quiet buttons. ── */
    #s3 { background: var(--ink); padding: 13vh 7vw 14vh; }
    #s3 .sky-kicker { color: #8b9085; }
    .s3-grid { display: grid; grid-template-columns: 340px 1fr; gap: 76px; max-width: 1480px; margin: 0 auto; align-items: start; }
    .s3-left h2 {
      font-family: var(--display); font-weight: 600; font-size: clamp(34px, 3.4vw, 52px); line-height: 1;
      color: var(--paper); margin-bottom: 18px;
    }
    .s3-left h2 em { font-style: italic; font-weight: inherit; }
    .s3-left .lede { font-size: 12.5px; line-height: 1.8; color: #9ba095; max-width: 42ch; margin-bottom: 30px; }
  
    .s3-sel { border-top: 1px solid rgba(247,246,241,.2); display: flex; flex-direction: column; }
    .s3-sel button {
      display: flex; align-items: center; gap: 14px; padding: 17px 6px; cursor: pointer;
      background: none; border: none; border-bottom: 1px solid rgba(247,246,241,.2); text-align: left;
      font: 700 13.5px var(--mono); letter-spacing: .06em; text-transform: uppercase; color: #8b9085;
    }
    .s3-sel button { justify-content: flex-start; }
    .s3-sel button .mini { width: 33px; height: 33px; border-radius: 8px; display: inline-flex;
                           align-items: center; justify-content: center; flex: 0 0 auto; }
    .s3-sel button .mini img { height: 19px; filter: invert(.92); }
    .s3-sel button .go { margin-left: auto; visibility: hidden; font-size: 15px; }
    .s3-sel button:has(+ .active) { border-bottom-color: transparent; }
    .s3-sel:has(> button.active:first-child) { border-top-color: transparent; }
    .s3-sel button.active {
      color: var(--paper); background: #1b1d20;
      margin-right: -76px; padding-right: 80px; padding-left: 14px;
      border-radius: 12px 0 0 12px; border-bottom-color: transparent;
    }
    .s3-sel button.active .go, .s3-sel button:hover .go { visibility: visible; }
    .s3-sel button:hover { color: var(--paper); }
  
    .s3-stage {
      display: grid; grid-template-columns: 1.05fr 1fr; gap: 0;
      background: #1b1d20; border-radius: 14px; overflow: hidden; align-items: stretch;
    }
    .s3-stage .leaf { padding: 36px 40px; }
    .s3-headrow { display: flex; align-items: center; gap: 20px; margin-bottom: 22px; }
    /* ONE capsule: the app icon with its language bar inset at the bottom */
    .s3-stage .bigicon { width: 72px; flex: 0 0 auto; border-radius: 15px; overflow: hidden; display: flex; flex-direction: column; }
    .s3-stage .bigicon .face { height: 62px; display: flex; align-items: center; justify-content: center; }
    .s3-stage .bigicon .face img { height: 38px; filter: invert(.92); }
    .s3-stage .bigicon .dnaMini { display: flex; height: 9px; }
    .s3-stage .bigicon .dnaMini i { display: block; height: 100%; }
    /* the terminal — softly contained: one shade above the section, no border.
       The scrollbar is a brand moment: a faint dotted stroke that turns SOLID
       where the thumb is. Success lines use the piece's vibrant accent. */
    .s3-termwrap {
      position: relative; background: #15171a; border-left: 1px solid rgba(247,246,241,.07);
      padding: 30px 34px 30px 28px; height: 100%;
    }
    .s3-term {
      font: 400 12.5px var(--mono); line-height: 2.05; color: #9ba095;
      max-height: 460px; overflow-y: auto; padding-right: 12px;
      scrollbar-width: none;
    }
    .s3-term::-webkit-scrollbar { display: none; }
    .s3-term .ln { white-space: pre-wrap; word-break: break-word; }
    .s3-term .ps { color: var(--pc); font-weight: 700; }
    .s3-term .cmd { color: var(--paper); font-weight: 700; }
    .s3-term .ok { color: var(--ac); }
    .s3-term .dim { color: #6a7064; }
    .s3-term .hi { color: var(--paper); }
    .s3-term .q { color: var(--pc); }
    .s3-term .caret { display: inline-block; width: 7px; height: 13px; background: var(--paper);
                      vertical-align: -2px; animation: blink 1s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    .s3-scroll {
      position: absolute; top: 30px; bottom: 30px; right: 14px; width: 2px;
      background-image: repeating-linear-gradient(180deg, rgba(247,246,241,.22) 0 4px, transparent 4px 9px);
    }
    .s3-scroll .thumb { position: absolute; left: 0; width: 2px; background: var(--ac); }
    .s3-stage .role { font: 700 10px var(--mono); letter-spacing: .3em; text-transform: uppercase; margin-bottom: 6px; }
    .s3-stage h3 { font-family: var(--display); font-weight: 600; font-size: 38px; line-height: 1; color: var(--paper); }
    .s3-stage p { font-size: 12.5px; line-height: 1.8; margin-bottom: 12px; max-width: 58ch; color: #9ba095; }
    .s3-feats { list-style: none; padding: 0; margin: 6px 0 16px; display: flex; flex-direction: column; gap: 9px; }
    .s3-feats li { font: 400 12px var(--mono); line-height: 1.6; color: #9ba095; padding-left: 20px; position: relative; }
    .s3-feats li::before { content: "■"; position: absolute; left: 0; top: 2px; font-size: 9px; color: var(--pc); }
    .s3-feats li b { color: var(--paper); font-weight: 700; }
    .s3-stage .why { border-left: 3px solid; padding-left: 14px; color: #9ba095; }
    .s3-stage .why b { color: var(--paper); }
    .s3-stage .more {
      display: inline-flex; gap: 8px; margin-top: 10px; align-self: flex-start;
      color: var(--ink); text-decoration: none;
      font: 700 11.5px var(--mono); letter-spacing: .04em; text-transform: uppercase;
      border: none; border-radius: 8px; padding: 11px 16px;
      transition: transform .15s ease;
    }
    .s3-stage .more:hover { transform: translateY(-2px); }
  
    /* ── mobile ─────────────────────────────────────────────────────────── */
    @media (max-width: 820px) {
      .sky-h, .s3-left h2 { white-space: normal; }
      .sky-points { grid-template-columns: 1fr; gap: 18px; max-width: 92vw; }
      #s2 { height: auto; min-height: 0; }
      .sky-pin { height: auto; }
      #tree { display: none; }
      .sky-content { position: static; padding: 12vh 7vw 8vh; gap: 34px; }
      .s3-grid { grid-template-columns: 1fr; gap: 40px; }
      .s3-sel button.active { margin-right: 0; padding-right: 14px; border-radius: 12px; }
      .s3-stage { grid-template-columns: 1fr; }
      .s3-termwrap { border-left: none; border-top: 1px solid rgba(247,246,241,.07); }
      .ctas { gap: 10px; }
      .btn { padding: 12px 16px; }
      .lockup { width: 84vw; }
      .lockup .jl { font-size: clamp(42px, 13.5vw, 56px); line-height: 1; }
    }
  
  
  /* ── hero v2 — sentence headline + above/below desktop-demo overlap ── */
  .hero { height: auto; min-height: 0; justify-content: flex-start; padding: 15vh 24px 0; }
  .brandlock span { font-size: 24px; font-weight: 600; letter-spacing: 0; }
  .hero-h { font-family: var(--display); font-weight: 600; font-size: clamp(34px, 4.6vw, 70px); line-height: 1.05; letter-spacing: -.012em; color: var(--ink); max-width: 17ch; margin: 4px auto 0; text-transform: none; }
  .hero-h em { font-style: italic; font-weight: 600; }
  .herodemo { width: min(1200px, 94vw); margin: 5vh auto -15vh; position: relative; z-index: 6; }
  .appwin { border: 2px solid var(--ink); border-radius: 16px; overflow: hidden; background: var(--card); box-shadow: 0 40px 90px -28px rgba(18,19,22,.5); }
  .appbar { display: flex; align-items: center; gap: 7px; padding: 11px 15px; border-bottom: 2px solid var(--ink); background: var(--paper); }
  .appbar i { width: 11px; height: 11px; border-radius: 50%; background: var(--ink); opacity: .22; }
  .appbar .apptitle { margin-left: 11px; font: 600 12px var(--mono); color: var(--dim); letter-spacing: .04em; }
  .appscreen { position: relative; aspect-ratio: 16/10; background: #0b1020; overflow: hidden; }
  .appscreen > video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cursor3d { position: absolute; width: 28px; height: 28px; left: 22%; top: 30%; pointer-events: none; z-index: 3; filter: drop-shadow(0 5px 7px rgba(0,0,0,.45)); animation: cursorpath 11s ease-in-out infinite; }
  .cursor3d svg { width: 100%; height: 100%; display: block; }
  @keyframes cursorpath { 0%,100%{left:22%;top:30%} 22%{left:58%;top:36%} 45%{left:60%;top:64%} 68%{left:36%;top:56%} 85%{left:72%;top:44%} }
  #s2 { padding-top: 18vh; }
  @media (max-width:820px){ .herodemo{ margin-bottom:-8vh } #s2{ padding-top:6vh } .hero{ padding-top:13vh } }
  
  
  /* hero v2 fixes: stop #s1 clipping the demo overlap; desktop-app frame (stoplight only) */
  #s1 { height: auto; overflow: visible; }
  .herodemo { width: min(1060px, 90vw); margin: 4vh auto -13vh; }
  .appwin { border-radius: 14px; }
  .appscreen { aspect-ratio: 16/10; }
  .stoplight { position: absolute; top: 15px; left: 16px; display: flex; gap: 8px; z-index: 4; }
  .stoplight i { width: 12px; height: 12px; border-radius: 50%; display: block; box-shadow: 0 0 0 .5px rgba(0,0,0,.12) inset; }
  .stoplight i:nth-child(1){ background:#ff5f57 } .stoplight i:nth-child(2){ background:#febc2e } .stoplight i:nth-child(3){ background:#28c840 }
  #s2 { padding-top: 16vh; }
  
  
  /* demo straddles the section boundary, overlapping PAST the DNA strip into #s2 */
  #dna { position: static; width: 100%; height: 18px; margin: 0; z-index: 1; }
  .herodemo { margin: 4vh auto -17vh; }
  /* #platforms now absorbs the demo overlap; #s2 sits below it, so normal spacing. */
  #s2 { padding-top: 8vh; }
  /* stoplight: scale with the desktop window (container units), and smaller */
  .appscreen { container-type: inline-size; }
  .stoplight { top: 1.25cqw; left: 1.5cqw; gap: 0.62cqw; }
  .stoplight i { width: 0.78cqw; height: 0.78cqw; box-shadow: 0 0 0 .4px rgba(0,0,0,.1) inset; }
  
  
  /* DNA strip pinned to the section boundary (#s2 top); demo overlaps DOWN past it */
  #dna { position: absolute; top: 0; left: 0; right: 0; bottom: auto; height: 18px; z-index: 1; }
  
  
  /* softer shadow (~75% less), drop the heavy black stroke, scale the hero up */
  .appwin { box-shadow: 0 14px 34px -18px rgba(18,19,22,.20); border: 1px solid rgba(18,19,22,.08); }
  .hero-h { font-size: clamp(40px, 5.4vw, 84px); }
  
  
  /* DNA strip = tight divider right after the hero content; demo overlaps down from it into #s2 */
  #dna { position: static; width: 100%; height: 18px; margin: 0; left: auto; right: auto; top: auto; bottom: auto; z-index: 1; }
  .herodemo { margin: 0 auto -17vh; }
  #s2 { padding-top: 0; }
  
  
  /* ════ CLEAN SECTION MODEL — flow-based, sizes to content (like #s3). ════
     Overlap between hero demo and the workbooks section = ONE var (--overlap).
     No fixed 100vh + absolute-centered content; sections can't clip each other. */
  :root { --demo-w: min(1060px, 90vw); --overlap: 14vh; }
  #s1 { height: auto; min-height: 0; overflow: visible; }
  .hero { height: auto; min-height: 0; justify-content: flex-start; padding: 13vh 24px 0; }
  .herodemo { position: relative; z-index: 6; width: var(--demo-w); margin: 5vh auto calc(-1 * var(--overlap)); }
  #s2 { position: relative; height: auto; min-height: 0; overflow: visible; background: var(--paper); padding: 0; }
  .sky-pin { position: relative; height: auto; min-height: 0; overflow: visible; }
  .sky-content { position: static; inset: auto; min-height: 122vh; padding: calc(var(--overlap) + 9vh) 7vw 6vh; }
  #dna { position: absolute; top: 0; left: 0; right: 0; height: 18px; z-index: 1; }
  
end
