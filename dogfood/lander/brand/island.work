client :brandbook do
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@500;600&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box}
    :root{--ink:#16161a;--paper:#faf9f4;--dim:#6a6f68;--line:#e7e5db;--card:#fff;
      --sans:'Geist',system-ui,sans-serif;--mono:'Geist Mono',monospace}
    body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.6 var(--sans)}
    .wrap{max-width:880px;margin:0 auto;padding:64px 28px 120px}
    h1{font-size:34px;font-weight:800;letter-spacing:-.03em;margin:0 0 4px}
    .lead{color:var(--dim);margin:0 0 48px;max-width:56ch}
    section{margin:0 0 56px}
    .lbl{font:600 11px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:#a4a097;margin:0 0 16px}
    .mark-row{display:flex;align-items:flex-end;gap:34px;flex-wrap:wrap}
    .mark{color:var(--ink)} .mark.k{color:var(--ink)} .mark svg{display:block}
    .on-dark{background:var(--ink);border-radius:14px;padding:26px 30px;display:inline-flex;gap:30px;align-items:flex-end}
    .on-dark .mark{color:#fff}
    /* lockup — petal glyph + flex bar (keeps the 113.444:65.6 ratio) */
    .lockup{--h:52px;--gw:calc(var(--h)*113.444/65.6002);display:flex;align-items:stretch;width:100%;max-width:560px}
    .lockup .g{flex:0 0 auto;width:var(--gw);height:var(--h);color:var(--ink)} .lockup .g svg{display:block;width:100%;height:100%}
    .lockup .bar{flex:1 1 0;height:var(--h);background:var(--ink);min-width:0}
    /* dna strip */
    .dna{height:14px;border-radius:7px;overflow:hidden;background:repeating-linear-gradient(90deg,#f3c5a3 0 28px,#aee5c2 28px 50px,#a8d4f0 50px 68px,#f2ddb0 68px 90px,#9fc4e8 90px 103px);background-size:103px 14px;animation:drift 52s linear infinite}
    @keyframes drift{to{background-position:103px 0}}
    .pal{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px}
    .sw{border:1px solid var(--line);border-radius:11px;overflow:hidden;background:var(--card)}
    .sw .chip{height:64px} .sw .meta{padding:8px 10px;font:600 11px var(--mono)} .sw .meta small{display:block;color:var(--dim);font-weight:500}
    .type .row{border-top:1px solid var(--line);padding:18px 0;display:flex;align-items:baseline;gap:18px}
    .type .row:first-child{border-top:0}
    .type .k{font:600 11px var(--mono);color:#a4a097;width:120px;flex:none;text-transform:uppercase;letter-spacing:.06em}
    .disp{font-weight:800;font-size:40px;letter-spacing:-.03em}
    .body{font-size:19px} .ms{font-family:var(--mono);font-size:16px}
  </style>

  <div class="wrap">
    <h1>Workbooks brand</h1>
    <p class="lead">The marks, the lockup, the palette, the type — the canonical reference, always current. Built with the brand it documents.</p>

    <section>
      <p class="lbl">The mark · the petal</p>
      <div class="mark-row">
        <span class="mark"><svg width="84" viewBox="0 0 113.444 65.6002" fill="none"><path fill="currentColor" d="M48.271 0.137C54.035-0.042 59.486-0.1 65.239 0.308 65.53 10.08 65.175 19.962 65.462 29.738 65.487 30.568 65.871 31.142 66.391 31.743 72.108 33.464 84.752 13.845 90.921 11.74 93.907 12.344 100.087 19.999 102.273 22.457 98.731 28.417 83.273 40.691 81.382 45.003 81.4 46.287 81.45 46.326 82.157 47.442 83.708 48.637 108.252 47.988 113.133 48.464 113.57 53.985 113.431 59.865 113.391 65.428 101.67 65.449 86.679 66.781 76.472 61.69 68.049 57.527 61.65 50.16 58.704 41.238 57.939 38.586 57.387 36.15 56.78 33.468 55.6 38.7 54.677 42.988 51.921 47.705 39.805 68.442 20.228 65.456 0.065 65.389-0.058 59.646-0.006 53.901 0.222 48.161 5.512 48.136 28.425 48.742 31.699 47.27 31.862 46.897 31.905 46.848 31.987 46.404 32.672 42.681 14.558 27.349 11.618 22.838L11.373 22.456C13.177 19.907 19.347 13.073 22.063 11.774 25.791 11.211 40.002 29.83 44.456 31.689 45.845 32.268 46.068 32.231 47.291 31.751 48.666 29.798 48.206 22.821 48.217 20.153L48.271 0.137Z"/></svg></span>
        <span class="mark"><svg width="48" viewBox="0 0 113.444 65.6002" fill="none"><path fill="currentColor" d="M48.271 0.137C54.035-0.042 59.486-0.1 65.239 0.308 65.53 10.08 65.175 19.962 65.462 29.738 65.487 30.568 65.871 31.142 66.391 31.743 72.108 33.464 84.752 13.845 90.921 11.74 93.907 12.344 100.087 19.999 102.273 22.457 98.731 28.417 83.273 40.691 81.382 45.003 81.4 46.287 81.45 46.326 82.157 47.442 83.708 48.637 108.252 47.988 113.133 48.464 113.57 53.985 113.431 59.865 113.391 65.428 101.67 65.449 86.679 66.781 76.472 61.69 68.049 57.527 61.65 50.16 58.704 41.238 57.939 38.586 57.387 36.15 56.78 33.468 55.6 38.7 54.677 42.988 51.921 47.705 39.805 68.442 20.228 65.456 0.065 65.389-0.058 59.646-0.006 53.901 0.222 48.161 5.512 48.136 28.425 48.742 31.699 47.27 31.862 46.897 31.905 46.848 31.987 46.404 32.672 42.681 14.558 27.349 11.618 22.838L11.373 22.456C13.177 19.907 19.347 13.073 22.063 11.774 25.791 11.211 40.002 29.83 44.456 31.689 45.845 32.268 46.068 32.231 47.291 31.751 48.666 29.798 48.206 22.821 48.217 20.153L48.271 0.137Z"/></svg></span>
        <span class="on-dark"><span class="mark"><svg width="48" viewBox="0 0 113.444 65.6002" fill="none"><path fill="currentColor" d="M48.271 0.137C54.035-0.042 59.486-0.1 65.239 0.308 65.53 10.08 65.175 19.962 65.462 29.738 65.487 30.568 65.871 31.142 66.391 31.743 72.108 33.464 84.752 13.845 90.921 11.74 93.907 12.344 100.087 19.999 102.273 22.457 98.731 28.417 83.273 40.691 81.382 45.003 81.4 46.287 81.45 46.326 82.157 47.442 83.708 48.637 108.252 47.988 113.133 48.464 113.57 53.985 113.431 59.865 113.391 65.428 101.67 65.449 86.679 66.781 76.472 61.69 68.049 57.527 61.65 50.16 58.704 41.238 57.939 38.586 57.387 36.15 56.78 33.468 55.6 38.7 54.677 42.988 51.921 47.705 39.805 68.442 20.228 65.456 0.065 65.389-0.058 59.646-0.006 53.901 0.222 48.161 5.512 48.136 28.425 48.742 31.699 47.27 31.862 46.897 31.905 46.848 31.987 46.404 32.672 42.681 14.558 27.349 11.618 22.838L11.373 22.456C13.177 19.907 19.347 13.073 22.063 11.774 25.791 11.211 40.002 29.83 44.456 31.689 45.845 32.268 46.068 32.231 47.291 31.751 48.666 29.798 48.206 22.821 48.217 20.153L48.271 0.137Z"/></svg></span></span>
      </div>
    </section>

    <section>
      <p class="lbl">The lockup · glyph + flex bar</p>
      <div class="lockup"><span class="g"><svg viewBox="0 0 113.444 65.6002" fill="none"><path fill="currentColor" d="M48.271 0.137C54.035-0.042 59.486-0.1 65.239 0.308 65.53 10.08 65.175 19.962 65.462 29.738 65.487 30.568 65.871 31.142 66.391 31.743 72.108 33.464 84.752 13.845 90.921 11.74 93.907 12.344 100.087 19.999 102.273 22.457 98.731 28.417 83.273 40.691 81.382 45.003 81.4 46.287 81.45 46.326 82.157 47.442 83.708 48.637 108.252 47.988 113.133 48.464 113.57 53.985 113.431 59.865 113.391 65.428 101.67 65.449 86.679 66.781 76.472 61.69 68.049 57.527 61.65 50.16 58.704 41.238 57.939 38.586 57.387 36.15 56.78 33.468 55.6 38.7 54.677 42.988 51.921 47.705 39.805 68.442 20.228 65.456 0.065 65.389-0.058 59.646-0.006 53.901 0.222 48.161 5.512 48.136 28.425 48.742 31.699 47.27 31.862 46.897 31.905 46.848 31.987 46.404 32.672 42.681 14.558 27.349 11.618 22.838L11.373 22.456C13.177 19.907 19.347 13.073 22.063 11.774 25.791 11.211 40.002 29.83 44.456 31.689 45.845 32.268 46.068 32.231 47.291 31.751 48.666 29.798 48.206 22.821 48.217 20.153L48.271 0.137Z"/></svg></span><span class="bar"></span></div>
    </section>

    <section>
      <p class="lbl">The DNA strip · the pastel family</p>
      <div class="dna"></div>
    </section>

    <section>
      <p class="lbl">Palette</p>
      <div class="pal" id="pal"></div>
    </section>

    <section class="type">
      <p class="lbl">Type</p>
      <div class="row"><span class="k">Display</span><span class="disp">software that's living.</span></div>
      <div class="row"><span class="k">Body · Geist</span><span class="body">The objective language of design — clean, neutral, legible at any size.</span></div>
      <div class="row"><span class="k">Mono · Geist Mono</span><span class="ms">work weave . → workbook.html</span></div>
    </section>
  </div>

  <script>
  (function(){
    var COLORS=[
      ["Ink","#16161a"],["Paper","#faf9f4"],["Line","#e7e5db"],["Dim","#6a6f68"],
      ["Peach","#f3c5a3"],["Mint","#aee5c2"],["Sky","#a8d4f0"],["Sand","#f2ddb0"],
      ["Blue","#9fc4e8"],["Moss","#c8e0b0"],["Lilac","#d9c5f0"]];
    document.getElementById('pal').innerHTML=COLORS.map(function(c){
      return '<div class="sw"><div class="chip" style="background:'+c[1]+'"></div><div class="meta">'+c[0]+'<small>'+c[1]+'</small></div></div>';
    }).join('');
  })();
  </script>
end
