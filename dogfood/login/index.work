# Sign in — our own auth, dogfooded

The native email/password sign-in for the cloud platform — **our own auth** (`Nexus.Auth`), no
external IdP. A centered card on the brand's pastel aurora, matching the onboarding/authorize design.
Posts to the nexus's `/auth/{login,signup,forgot}` endpoints; a verified credential issues a
`Nexus.Auth.Session` cookie and lands on the dashboard. This is a `.work` workbook served by the same
nexus as everything else — the login lives in the dogfood pile too.

design :login do
  *{box-sizing:border-box}
  :root{--ink:#16161a;--paper:#f7f6f1;--card:#fff;--line:#e7e5db;--dim:#6a6f68;
    --mint:#aee5c2;--sky:#a8d4f0;--peach:#f3c5a3;--cream:#f2ddb0;--violet:#d9c5f0;
    --sans:'Geist',system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
  body{margin:0;min-height:100vh;background:var(--paper);color:var(--ink);font-family:var(--sans);
    display:grid;place-items:center;overflow:hidden}
  /* soft drifting pastel blobs (the onboarding aurora) */
  .blobs{position:fixed;inset:0;z-index:0;filter:blur(64px);opacity:.55;pointer-events:none}
  .blobs span{position:absolute;width:46vmax;height:46vmax;border-radius:50%;background:var(--c);
    animation:drift 26s ease-in-out infinite alternate}
  @keyframes drift{to{transform:translate(4vmax,-3vmax) scale(1.12)}}
  .card{position:relative;z-index:1;width:380px;max-width:92vw;background:var(--card);
    border:1px solid var(--line);border-radius:20px;padding:34px 30px 30px;
    box-shadow:0 24px 60px -28px rgba(20,20,26,.35)}
  .mark{width:42px;height:auto;color:var(--ink);display:block;margin:0 0 18px}
  .mark svg{display:block;width:100%;height:auto}
  h1{font-size:21px;font-weight:700;letter-spacing:-.02em;margin:0 0 4px}
  .sub{font-size:13.5px;line-height:1.5;color:var(--dim);margin:0 0 22px}
  label{display:block;font:600 11px var(--sans);letter-spacing:.04em;text-transform:uppercase;
    color:var(--dim);margin:0 0 5px}
  .field{margin:0 0 14px}
  input{width:100%;padding:11px 13px;border:1px solid var(--line);border-radius:11px;
    font:500 14px var(--sans);color:var(--ink);background:var(--paper);outline:none}
  input:focus{border-color:var(--sky);background:#fff}
  .btn{width:100%;padding:12px;border:0;border-radius:11px;background:var(--ink);color:#fff;
    font:700 14px var(--sans);cursor:pointer;transition:transform .1s,filter .1s}
  .btn:hover{filter:brightness(1.12)}
  .btn:active{transform:translateY(1px)}
  .btn[disabled]{opacity:.6;cursor:default}
  .row{display:flex;justify-content:space-between;align-items:center;margin:0 0 18px}
  .lk{background:none;border:0;color:var(--dim);font:600 12.5px var(--sans);cursor:pointer;padding:0}
  .lk:hover{color:var(--ink)}
  .toggle{text-align:center;font-size:13px;color:var(--dim);margin:18px 0 0}
  .toggle button{background:none;border:0;color:var(--ink);font-weight:700;cursor:pointer;padding:0}
  .msg{font-size:13px;border-radius:10px;padding:9px 12px;margin:0 0 16px;display:none}
  .msg.err{display:block;background:#fdeceb;color:#b3261e}
  .msg.ok{display:block;background:#eaf7ef;color:#1b7a43}
end

client :login do
  <div class="blobs" aria-hidden="true">
    <span style="--c:var(--mint);  top:-14%; left:-8%"></span>
    <span style="--c:var(--sky);   top:6%;   right:-12%"></span>
    <span style="--c:var(--peach); bottom:-16%; left:12%"></span>
    <span style="--c:var(--cream); bottom:4%; right:8%"></span>
    <span style="--c:var(--violet);top:40%; left:44%"></span>
  </div>

  <form class="card" id="auth" autocomplete="on">
    <span class="mark"><svg viewBox="0 0 113.444 65.6002" fill="none" aria-label="Workbooks"><path fill="currentColor" d="M48.271 0.137C54.035-0.042 59.486-0.1 65.239 0.308 65.53 10.08 65.175 19.962 65.462 29.738 65.487 30.568 65.871 31.142 66.391 31.743 72.108 33.464 84.752 13.845 90.921 11.74 93.907 12.344 100.087 19.999 102.273 22.457 98.731 28.417 83.273 40.691 81.382 45.003 81.4 46.287 81.45 46.326 82.157 47.442 83.708 48.637 108.252 47.988 113.133 48.464 113.57 53.985 113.431 59.865 113.391 65.428 101.67 65.449 86.679 66.781 76.472 61.69 68.049 57.527 61.65 50.16 58.704 41.238 57.939 38.586 57.387 36.15 56.78 33.468 55.6 38.7 54.677 42.988 51.921 47.705 39.805 68.442 20.228 65.456 0.065 65.389-0.058 59.646-0.006 53.901 0.222 48.161 5.512 48.136 28.425 48.742 31.699 47.27 31.862 46.897 31.905 46.848 31.987 46.404 32.672 42.681 14.558 27.349 11.618 22.838L11.373 22.456C13.177 19.907 19.347 13.073 22.063 11.774 25.791 11.211 40.002 29.83 44.456 31.689 45.845 32.268 46.068 32.231 47.291 31.751 48.666 29.798 48.206 22.821 48.217 20.153L48.271 0.137Z"/></svg></span>

    <h1 id="title">Welcome back</h1>
    <p class="sub" id="lede">Sign in to your nexus.</p>

    <div class="msg" id="msg"></div>

    <div class="field" id="namef" style="display:none">
      <label for="name">Name</label>
      <input id="name" type="text" autocomplete="name" placeholder="Your name">
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" type="email" autocomplete="email" required placeholder="you@company.com">
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input id="password" type="password" autocomplete="current-password" required placeholder="••••••••">
    </div>

    <div class="row">
      <span></span>
      <button type="button" class="lk" id="forgot">Forgot password?</button>
    </div>

    <button class="btn" id="submit" type="submit">Sign in</button>

    <p class="toggle" id="toggle">New here? <button type="button" id="toggleBtn">Create an account</button></p>
  </form>

  <script>
  (function () {
    var mode = 'login'; // 'login' | 'signup'
    var $ = function (id) { return document.getElementById(id); };
    var msg = $('msg');
    function show(kind, text) { msg.className = 'msg ' + kind; msg.textContent = text; }
    function clearMsg() { msg.className = 'msg'; msg.textContent = ''; }

    function setMode(m) {
      mode = m;
      var signup = m === 'signup';
      $('title').textContent = signup ? 'Create your account' : 'Welcome back';
      $('lede').textContent = signup ? 'Spin up your own nexus in seconds.' : 'Sign in to your nexus.';
      $('submit').textContent = signup ? 'Create account' : 'Sign in';
      $('namef').style.display = signup ? 'block' : 'none';
      $('password').setAttribute('autocomplete', signup ? 'new-password' : 'current-password');
      $('toggle').innerHTML = signup
        ? 'Already have an account? <button type="button" id="toggleBtn">Sign in</button>'
        : 'New here? <button type="button" id="toggleBtn">Create an account</button>';
      document.getElementById('toggleBtn').addEventListener('click', function () { setMode(signup ? 'login' : 'signup'); });
      clearMsg();
    }
    document.getElementById('toggleBtn').addEventListener('click', function () { setMode('signup'); });

    async function post(path, payload) {
      var r = await fetch(path, {
        method: 'POST', headers: { 'content-type': 'application/json' },
        credentials: 'same-origin', body: JSON.stringify(payload)
      });
      var data = {}; try { data = await r.json(); } catch (e) {}
      return { ok: r.ok, status: r.status, data: data };
    }

    $('auth').addEventListener('submit', async function (e) {
      e.preventDefault();
      clearMsg();
      var btn = $('submit'); btn.disabled = true;
      var email = $('email').value.trim(), password = $('password').value;
      var res = mode === 'signup'
        ? await post('/auth/signup', { email: email, password: password, name: $('name').value.trim() })
        : await post('/auth/login', { email: email, password: password });
      if (res.ok) { window.location.assign('/cloud/'); return; }
      btn.disabled = false;
      show('err', (res.data && res.data.error) || 'Something went wrong. Try again.');
    });

    $('forgot').addEventListener('click', async function () {
      var email = $('email').value.trim();
      if (!email) { show('err', 'Enter your email first, then tap “Forgot password?”'); return; }
      await post('/auth/forgot', { email: email });
      show('ok', 'If that email has an account, a reset link is on its way.');
    });
  })();
  </script>
end
