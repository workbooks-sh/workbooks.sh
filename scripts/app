#!/usr/bin/env bash
# Workbooks local-PRODUCTION orchestrator (wb-g8c).
#
# Develop against the real production build — NO `tauri dev`, NO `iex`. Builds the
# four artifacts the shipped app is made of, each behind a BUILD-LOCK so a
# verified-good artifact is frozen and never rebuilt until you `unlock` it or its
# source actually changes. This is the "least-finicky, production-faithful" loop.
#
#   ./scripts/app status            # what's built / stale / locked / missing
#   ./scripts/app build [comp...]   # build stale/missing comps (skips locked + unchanged)
#   ./scripts/app run               # build (respecting locks) then launch the .app
#   ./scripts/app lock   <comp|all> # freeze: never rebuild (it works — leave it)
#   ./scripts/app unlock <comp|all> # thaw: allow rebuilds again
#   ./scripts/app rebuild <comp...> # force rebuild even if unchanged (ignores lock)
#
# Components:  kernel  escript  image  app
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOCK="$ROOT/scripts/.build-lock.tsv"
COMPONENTS=(kernel escript image app)

# The runtime image ref the local container boots (override with WB_IMAGE).
IMAGE_REF="${WB_IMAGE:-ghcr.io/workbooks-sh/runtime:latest}"
# The freshly-built escript the app shell + deploy-kit shell out to.
export WB_BIN="$ROOT/runtime/wb"

c_red=$'\e[31m'; c_grn=$'\e[32m'; c_ylw=$'\e[33m'; c_dim=$'\e[2m'; c_cyn=$'\e[36m'; c_rst=$'\e[0m'
say()  { printf '%s\n' "$*" >&2; }
hdr()  { printf '%s==>%s %s\n' "$c_cyn" "$c_rst" "$*" >&2; }
die()  { printf '%sERROR:%s %s\n' "$c_red" "$c_rst" "$*" >&2; exit 1; }

# ---- source globs: what feeds each artifact (a change here => stale) ----------
src_paths() {
  case "$1" in
    kernel)  echo "runtime/kernel/src runtime/kernel/wit runtime/kernel/Cargo.toml runtime/kernel/Cargo.lock" ;;
    escript) echo "runtime/host runtime/mix.exs runtime/mix.lock" ;;
    image)   echo "runtime/host runtime/Dockerfile runtime/deploy runtime/mix.exs runtime/mix.lock" ;;
    app)     echo "desktop/src desktop/src-tauri/src desktop/src-tauri/Cargo.toml desktop/src-tauri/Cargo.lock desktop/src-tauri/tauri.conf.json desktop/package.json desktop/src-tauri/oql.wasm" ;;
  esac
}

# Content hash of a component's sources (order-stable, ignores mtime + build dirs).
src_hash() {
  local paths abs=() p
  paths="$(src_paths "$1")"
  for p in $paths; do [ -e "$ROOT/$p" ] && abs+=("$ROOT/$p"); done
  [ ${#abs[@]} -eq 0 ] && { echo "none"; return; }
  find "${abs[@]}" -type f \
       -not -path '*/target/*' -not -path '*/node_modules/*' -not -path '*/.svelte-kit/*' \
       -print0 2>/dev/null | LC_ALL=C sort -z | xargs -0 shasum -a 256 2>/dev/null \
       | shasum -a 256 | cut -d' ' -f1
}

# Artifact path (file or dir) + an identity string for the built output.
art_path() {
  case "$1" in
    kernel)  echo "$ROOT/desktop/src-tauri/oql.wasm" ;;
    escript) echo "$ROOT/runtime/wb" ;;
    image)   echo "" ;;  # docker image, not a file — handled specially
    app)     ls -d "$ROOT"/desktop/src-tauri/target/release/bundle/macos/*.app 2>/dev/null | head -1 ;;
  esac
}
art_present() {
  case "$1" in
    image) docker image inspect "$IMAGE_REF" >/dev/null 2>&1 ;;
    *)     local p; p="$(art_path "$1")"; [ -n "$p" ] && [ -e "$p" ] ;;
  esac
}
art_id() {
  case "$1" in
    image) docker image inspect "$IMAGE_REF" -f '{{.Id}}' 2>/dev/null || echo "absent" ;;
    app)   local p; p="$(art_path "$1")"; [ -n "$p" ] && echo "$p:$(stat -f %m "$p" 2>/dev/null)" || echo "absent" ;;
    *)     local p; p="$(art_path "$1")"; [ -e "$p" ] && shasum -a 256 "$p" | cut -d' ' -f1 || echo "absent" ;;
  esac
}

# ---- lockfile (TSV: component<TAB>src_sha<TAB>art_id<TAB>locked<TAB>built_at) --
lock_init() { [ -f "$LOCK" ] || printf '# component\tsrc_sha\tart_id\tlocked\tbuilt_at\n' > "$LOCK"; }
lock_get()  { lock_init; awk -F'\t' -v c="$1" -v f="$2" '$1==c{print $f}' "$LOCK"; }
lock_set()  { # component src_sha art_id locked built_at
  lock_init
  local tmp; tmp="$(mktemp)"
  awk -F'\t' -v c="$1" '$1!=c' "$LOCK" > "$tmp"
  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" >> "$tmp"
  mv "$tmp" "$LOCK"
}
is_locked() { [ "$(lock_get "$1" 4)" = "1" ]; }
set_locked() { # component 0|1
  lock_init
  local s a b; s="$(lock_get "$1" 2)"; a="$(lock_get "$1" 3)"; b="$(lock_get "$1" 5)"
  lock_set "$1" "${s:-}" "${a:-}" "$2" "${b:-}"
}

# ---- per-component builders ---------------------------------------------------
build_kernel() {
  hdr "kernel: cargo component build --release"
  ( cd "$ROOT/runtime/kernel" && cargo component build --release )
  local out
  out="$(ls -t "$ROOT"/runtime/kernel/target/wasm32-*/release/oql.wasm 2>/dev/null | head -1)"
  [ -n "$out" ] || die "kernel build produced no oql.wasm"
  cp "$out" "$ROOT/runtime/build/oql.wasm"
  cp "$out" "$ROOT/desktop/src-tauri/oql.wasm"
  say "    oql.wasm -> runtime/build/ + desktop/src-tauri/ ($(wc -c <"$out" | tr -d ' ') bytes)"
}
build_escript() {
  hdr "escript: mix escript.build (wb)"
  ( cd "$ROOT/runtime" && mix escript.build >/dev/null )
  [ -x "$ROOT/runtime/wb" ] || die "escript build produced no runtime/wb"
}
build_image() {
  hdr "image: wb deploy build (OCI runtime -> krunvm store)"
  [ -x "$WB_BIN" ] || die "image needs the escript first (build escript)"
  "$WB_BIN" deploy build --into-krunvm 2>&1 | sed 's/^/    /' >&2 \
    || die "image build failed (need docker running + skopeo for krunvm staging)"
}
build_app() {
  # Local-prod produces only the .app — NOT the .dmg. DMG packaging shells to
  # Finder/AppleScript (bundle_dmg.sh), which fails in a headless/background
  # session; the .app is all we need to launch. Distribution DMGs are a separate
  # signed/notarized pipeline (tauri.conf keeps targets "all" for that).
  # Also disable updater-artifact creation: it signs the .app.tar.gz with the
  # release private key (TAURI_SIGNING_PRIVATE_KEY), which we don't have locally.
  # tauri.conf keeps createUpdaterArtifacts:true for the real distribution build.
  hdr "app: tauri build --bundles app (production .app bundle, no updater/dmg)"
  ( cd "$ROOT/desktop" && bun run tauri build --bundles app --config '{"bundle":{"createUpdaterArtifacts":false}}' )
  art_present app || die "tauri build produced no .app bundle"
}

build_one() {
  local c="$1" force="${2:-}"
  if [ "$force" != "force" ] && is_locked "$c"; then
    say "  ${c_dim}skip ${c} (🔒 locked)${c_rst}"; return 0
  fi
  local cur; cur="$(src_hash "$c")"
  if [ "$force" != "force" ] && art_present "$c" && [ "$(lock_get "$c" 2)" = "$cur" ]; then
    say "  ${c_dim}skip ${c} (✓ up-to-date)${c_rst}"; return 0
  fi
  "build_${c}"
  lock_set "$c" "$cur" "$(art_id "$c")" "$(lock_get "$c" 4 || echo 0)" "$(date -u +%FT%TZ)"
  say "  ${c_grn}built ${c}${c_rst}"
}

# ---- commands -----------------------------------------------------------------
cmd_status() {
  lock_init
  printf '%-9s %-22s %-8s %s\n' COMPONENT STATE LOCK "SOURCE" >&2
  printf '%-9s %-22s %-8s %s\n' --------- ---------------------- -------- ------ >&2
  local c cur locked state
  for c in "${COMPONENTS[@]}"; do
    cur="$(src_hash "$c")"
    locked=$([ "$(lock_get "$c" 4)" = "1" ] && echo "🔒" || echo "·")
    if ! art_present "$c"; then state="${c_red}✗ missing${c_rst}"
    elif [ "$(lock_get "$c" 2)" = "$cur" ]; then state="${c_grn}✓ built${c_rst}"
    else state="${c_ylw}● stale (src changed)${c_rst}"; fi
    printf '%-9s %-31b %-8s %s\n' "$c" "$state" "$locked" "${cur:0:12}" >&2
  done
  say ""
  say "${c_dim}image ref: $IMAGE_REF${c_rst}"
}
cmd_build()   { local cs=("$@"); [ ${#cs[@]} -eq 0 ] && cs=("${COMPONENTS[@]}"); for c in "${cs[@]}"; do build_one "$c"; done; }
cmd_rebuild() { [ $# -ge 1 ] || die "rebuild needs a component"; for c in "$@"; do build_one "$c" force; done; }
cmd_run() {
  hdr "ensuring production build (locks respected)"
  cmd_build
  local appdir; appdir="$(art_path app)"
  [ -n "$appdir" ] || die "no .app bundle — run ./scripts/app build app"
  hdr "launching $appdir"
  open "$appdir"
  say "${c_grn}launched.${c_rst} The app owns the tray + boots the runtime container. Sign in via WorkOS in-app."
}
cmd_lock()   { local t="${1:-}"; [ -n "$t" ] || die "lock <comp|all>"; [ "$t" = all ] && { for c in "${COMPONENTS[@]}"; do set_locked "$c" 1; done; } || set_locked "$t" 1; say "${c_grn}locked $t${c_rst}"; cmd_status; }
cmd_unlock() { local t="${1:-}"; [ -n "$t" ] || die "unlock <comp|all>"; [ "$t" = all ] && { for c in "${COMPONENTS[@]}"; do set_locked "$c" 0; done; } || set_locked "$t" 0; say "${c_grn}unlocked $t${c_rst}"; cmd_status; }

case "${1:-status}" in
  status)  cmd_status ;;
  build)   shift; cmd_build "$@" ;;
  rebuild) shift; cmd_rebuild "$@" ;;
  run)     cmd_run ;;
  lock)    shift; cmd_lock "${1:-}" ;;
  unlock)  shift; cmd_unlock "${1:-}" ;;
  *)       die "unknown command '$1' — try: status build run lock unlock rebuild" ;;
esac
