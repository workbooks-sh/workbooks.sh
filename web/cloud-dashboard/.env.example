# WorkOS — platform auth + widgets. Real values live in .env (gitignored).
WORKOS_API_KEY=sk_...
WORKOS_CLIENT_ID=client_...
WORKOS_REDIRECT_URI=https://auth.workbooks.sh/v1/auth/callback
# Dev session: until the auth-service callback wires a real session, the widget
# token is minted for this org/user. In prod these come from the signed-in session.
WORKOS_DEMO_ORG=org_...
WORKOS_DEMO_USER=user_...
