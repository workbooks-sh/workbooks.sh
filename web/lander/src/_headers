# Cloudflare Pages response headers.

# /sw.js — service-worker kill switch.
# No-cache so existing browsers with a stale SW registration pick
# up the new (self-unregistering) version on the very next visit
# rather than waiting up to 24h for the spec-default SW refresh.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

# /install.sh — the `curl -fsSL https://workbooks.sh/install.sh | sh` installer.
# Serve as plain text and never cache, so a fresh installer is always fetched
# (release URLs change every desktop version).
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
