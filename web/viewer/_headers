# wb-u2o0.7.10 — security headers for apps/viewer.
#
# Cloudflare Pages does not ship a default CSP and the SvelteKit
# Cloudflare adapter only emits cache headers. Without these the
# viewer runs with no CSP, no clickjacking protection, no HSTS — any
# XSS regression goes straight to full origin compromise.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://auth.workbooks.sh https://network.workbooks.sh wss://auth.workbooks.sh; frame-src blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
