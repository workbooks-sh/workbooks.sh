# Workbooks — product showcase

# A tour of the desktop app that LETS EACH BEAT BREATHE: real distinct apps (held
# ~6s each), sharing with your team, a toolkit marketplace, hot-swapping the
# layout + theme live (yours to extend), and an agent that reasons, builds an app,
# and opens it in a split beside the conversation.
#
# Opens with a PRE-LOAD pass (f30–f120) that warms every app so the narrated tour
# switches INSTANTLY. The pre-load + SPA boot frame are TRIMMED off the front.

demo :product-showcase do
  target: web
  url: http://localhost:5178/
  fps: 30
  viewport: 1440x900
  verify_frames: 16
end

# ── pre-load (TRIMMED) — warm every app's iframe ─────────────────────────────
cue "f0", :navigate do
  url: http://localhost:5178/
  wait_until: networkidle
end
cue "f30", :click do
  selector: text="Swarm"
end
cue "f48", :click do
  selector: text="Canvas"
end
cue "f66", :click do
  selector: text="Ledger"
end
cue "f84", :click do
  selector: text="Pulse"
end
cue "f102", :click do
  selector: text="Kanban"
end
cue "f120", :click do
  selector: button[aria-label="New tab"]
end

# ── TRIM POINT ≈ f140 (4.7s) — narrated tour begins on the home composer ──────
cue "f146", :wait do
  Real software — built in workbooks.
  ms: 1600
end

# ── real apps, held long enough to actually read ─────────────────────────────
cue "00:06", :click do
  Ask anything — a swarm of agents researches it live.
  selector: text="Swarm"
end

cue "00:12", :click do
  Work together in real time — live cursors, drawings, presence.
  selector: text="Canvas"
end

cue "00:18", :click do
  A finance dashboard.
  selector: text="Ledger"
end

cue "00:24", :click do
  Product analytics.
  selector: text="Pulse"
end

cue "00:30", :click do
  A board that moves with your team.
  selector: text="Kanban"
end

# ── share it with people ─────────────────────────────────────────────────────
cue "00:35", :eval_js do
  Share any app with your whole team —
  code: (()=>{window.__wbShare&&window.__wbShare.requestShare('package:ws_personal/Kanban','Kanban');})()
end

cue "00:37", :click do
  pick who gets access.
  selector: text="Amara Okafor"
end

cue "00:39", :click do
  selector: text="Ravi Patel"
end

cue "00:41", :wait do
  ms: 1400
end

cue "00:43", :click do
  selector: text="Cancel"
end

# ── a marketplace of toolkits ────────────────────────────────────────────────
cue "00:45", :click do
  Add capabilities from a real toolkit marketplace —
  selector: button[aria-label="Toolkits"]
end

cue "00:48", :wait do
  install once to your org, then plug into any workspace.
  ms: 1800
end

cue "00:50", :click do
  selector: button:text-is("Add")
end

cue "00:52", :wait do
  ms: 1800
end

cue "00:54", :eval_js do
  code: (()=>{window.__wbChrome&&window.__wbChrome.closeLeft();})()
end

# ── it's yours to extend — hot-swap the layout + theme, live ─────────────────
cue "00:56", :eval_js do
  And it's yours to reshape — swap the whole layout,
  code: (()=>{window.__wbNav&&window.__wbNav.setLayout('hub');})()
end

cue "00:58", :eval_js do
  and re-theme the entire app on the fly.
  code: (()=>{const s=document.documentElement.style;const p={'--color-page':'#f6f5f0','--color-surface':'#ffffff','--color-surface-soft':'#efede6','--color-chrome':'#eceae2','--color-border':'#e2e0d7','--color-border-strong':'#c9c6ba','--color-fg':'#16171a','--color-fg-muted':'#5d6066','--color-fg-subtle':'#8a8d93','--color-accent':'#16171a','--color-grid-line':'#e2e0d7'};for(const k in p)s.setProperty(k,p[k]);})()
end

cue "01:00", :eval_js do
  code: (()=>{const s=document.documentElement.style;const p={'--color-page':'#17120a','--color-surface':'#221a0e','--color-surface-soft':'#2a2113','--color-chrome':'#120e07','--color-border':'#3a2c16','--color-fg':'#f3e9d8','--color-fg-muted':'#a99878','--color-brand':'#f5a524','--color-accent':'#f5a524','--color-grid-line':'#2a2113'};for(const k in p)s.setProperty(k,p[k]);})()
end

cue "01:02", :eval_js do
  Make it yours.
  code: (()=>{const s=document.documentElement.style;['--color-page','--color-surface','--color-surface-soft','--color-chrome','--color-border','--color-border-strong','--color-fg','--color-fg-muted','--color-fg-subtle','--color-brand','--color-accent','--color-grid-line'].forEach(k=>s.removeProperty(k));window.__wbNav&&window.__wbNav.setLayout('shelf');window.__wbChrome&&window.__wbChrome.closeLeft();})()
end

cue "01:03", :wait do
  ms: 900
end

# ── talk to an agent — it reasons, builds, and opens beside the chat ──────────
cue "01:05", :click do
  Or just describe what you want.
  selector: button[aria-label="New tab"]
end

cue "01:07", :type do
  selector: [placeholder="What would you like to do?"]
  text: Build a habit tracker with a weekly grid
  per_key_ms: 34
end

cue "01:11", :click do
  Waldo reasons, calls real tools, and builds it.
  selector: button[type=submit]
end

cue "01:15", :wait do
  And opens it in a split, right beside the conversation.
  ms: 5200
  checkpoint: a two-pane split — the Waldo chat on the LEFT, the built habit-tracker app on the RIGHT
end

cue "01:21", :wait do
  Workbooks — every app, every agent, one window. Yours to extend.
  ms: 1800
end
