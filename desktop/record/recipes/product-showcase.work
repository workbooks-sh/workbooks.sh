# Workbooks — product showcase

# A fast, hard-cut tour of the desktop app: real distinct apps (research swarm,
# live collaborative canvas, dashboards, an animated board), then an agent that
# reasons, builds an app, and opens it in a split pane beside the conversation.
# Moves quick — short dwells, no dead air.

demo :product-showcase do
  target: web
  url: http://localhost:5178/
  fps: 30
  viewport: 1440x900
  verify_frames: 16
end

# ── real apps, fast cuts ─────────────────────────────────────────────────────
cue "00:00", :navigate do
  Real software — built in workbooks.
  url: http://localhost:5178/
  wait_until: networkidle
end

cue "00:02", :click do
  Ask anything — a swarm of agents researches it live.
  selector: text="Swarm"
  checkpoint: a dark multi-agent research console is open, agents working
end

cue "00:06", :click do
  Work together in real time — live cursors, drawings, presence.
  selector: text="Canvas"
  checkpoint: a collaborative whiteboard with sticky notes and named multiplayer cursors is open
end

cue "00:11", :click do
  A finance dashboard.
  selector: text="Ledger"
  checkpoint: a light finance dashboard with a balance and cashflow chart is open
end

cue "00:14", :click do
  Product analytics.
  selector: text="Pulse"
  checkpoint: a colorful analytics dashboard with charts is open
end

cue "00:17", :click do
  A board that moves with your team.
  selector: text="Kanban"
  checkpoint: a kanban board with four columns and rich cards is open
end

cue "00:20", :wait do
  Every app, one window.
  ms: 1400
end

# ── talk to an agent — it reasons, builds, and opens beside the chat ──────────
cue "00:23", :navigate do
  Or just describe what you want.
  url: http://localhost:5178/
  wait_until: networkidle
end

cue "00:25", :type do
  selector: [placeholder="What would you like to do?"]
  text: Build a habit tracker with a weekly grid
  per_key_ms: 34
end

cue "00:29", :click do
  Waldo reasons, calls real tools, and builds it.
  selector: button[type=submit]
end

cue "00:33", :wait do
  And opens it in a split, right beside the conversation.
  ms: 5000
  checkpoint: a two-pane split — the Waldo chat (reasoning + tool cards + response) on the LEFT, the built habit-tracker app on the RIGHT
end

# ── everything one keystroke away ────────────────────────────────────────────
cue "00:39", :click do
  Everything you've made — one keystroke away.
  selector: button[aria-label="Search"]
  checkpoint: a search drawer is open showing a feed of file cards
end

cue "00:42", :wait do
  Workbooks — every app, every agent, one window.
  ms: 2200
end
