{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workbooks",
  "version": "0.1.0",
  "identifier": "sh.workbooks.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Workbooks",
        "width": 1280,
        "height": 832,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": ["dmg"]
  }
}
