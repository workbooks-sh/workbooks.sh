{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workbooks",
  "version": "0.1.0",
  "identifier": "sh.workbooks.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5178",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Workbooks",
        "width": 1280,
        "height": 832,
        "minWidth": 880,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/workbooks-sh/workbooks.sh/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1MDRCNjE2NzI4NjNDMkIKUldRclBJWnlGcllFWlg4SG5UMDNZQk9iUWJqSmJhL1FEQzlkcWY0STByb20yVWYxdnF4UHp1WDMK"
    }
  }
}