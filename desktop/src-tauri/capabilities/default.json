{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions for the Workbooks desktop shell \u2014 window show/hide, tray, and the daemon-bridge commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:tray:default",
    "core:menu:default",
    "core:event:default",
    "dialog:default",
    "updater:default",
    "process:default",
    "clipboard-manager:allow-write-text",
    "store:default"
  ]
}