# Templates — learn by example

A small explorer that presents each example workbook by **what it teaches**, in plain language, and
lets you read the actual `.work` source behind it in an editor. The lessons + the code viewer are a
`client` island; the source is read live from each workbook's `/<name>/source` endpoint, so you're
always looking at the real thing running on this nexus.

client :app do
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/javascript/javascript.min.js"></script>

  <style>
    *{box-sizing:border-box}
    body{max-width:none!important;margin:0!important;padding:0!important;background:var(--bg)!important;
      color:var(--ink)!important;font:16px/1.6 var(--sans)!important}
    nav.wb-nav, section.file > h1, section.file > h2, section.file > h3, section.file > h4,
    section.file > p, section.file > ul, section.file > pre, section.file > .decl, section.file > figure{display:none!important}
    section.file{display:block;margin:0;padding:0;max-width:none;border:0}
    #x{max-width:1040px;margin:0 auto;padding:46px 24px 100px}

    .head{margin-bottom:34px}
    .head .kick{font-size:13px;text-transform:uppercase;letter-spacing:.1em;color:var(--accent);font-weight:600}
    .head h1{font-size:34px;font-weight:700;letter-spacing:-.02em;margin:6px 0 8px}
    .head p{color:var(--soft);font-size:17px;max-width:620px;margin:0}

    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
    .card{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:22px;cursor:pointer;
      transition:.16s;display:flex;flex-direction:column;gap:12px}
    .card:hover{border-color:#d8d5ca;box-shadow:0 10px 30px rgba(18,19,22,.06);transform:translateY(-2px)}
    .card .ic{width:46px;height:46px;border-radius:13px;display:grid;place-items:center;font-size:22px}
    .card h3{font-size:18px;font-weight:650;margin:0;letter-spacing:-.01em}
    .card .sub{color:var(--soft);font-size:14px;flex:1}
    .tags{display:flex;flex-wrap:wrap;gap:6px}
    .tag{font-size:11.5px;font-weight:500;color:#54545a;background:var(--bg);border:1px solid var(--line);border-radius:20px;padding:3px 9px}
    .more{font-size:13px;font-weight:600;color:var(--ink);display:inline-flex;gap:6px;align-items:center}

    #detail{display:none}
    #detail.on{display:block}
    .back{border:0;background:transparent;color:var(--soft);font:500 14px var(--sans);cursor:pointer;padding:0;margin-bottom:18px;display:inline-flex;gap:6px;align-items:center}
    .back:hover{color:var(--ink)}
    .lhead{display:flex;gap:18px;align-items:flex-start;margin-bottom:22px;flex-wrap:wrap}
    .lhead .ic{width:58px;height:58px;border-radius:15px;display:grid;place-items:center;font-size:28px;flex:none}
    .lhead h2{font-size:26px;font-weight:700;letter-spacing:-.02em;margin:0 0 4px}
    .lhead .sub{color:var(--soft);font-size:16px}
    .lhead .grow{flex:1}
    .open{border:1px solid var(--ink);background:var(--ink);color:#fff;border-radius:11px;padding:10px 16px;font:600 14px var(--sans);
      text-decoration:none;display:inline-flex;gap:7px;align-items:center;white-space:nowrap}
    .learn{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:22px 24px;margin-bottom:22px}
    .learn h4{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--soft);margin:0 0 14px}
    .learn ul{margin:0;padding:0;list-style:none;display:grid;gap:11px}
    .learn li{display:flex;gap:11px;align-items:flex-start;font-size:15px}
    .learn li b{color:var(--accent);flex:none;font-weight:700}

    .code{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
    .tabs{display:flex;gap:2px;background:var(--bg);border-bottom:1px solid var(--line);padding:8px 8px 0;overflow-x:auto}
    .tab{border:0;background:transparent;font:500 13px var(--mono);color:var(--soft);padding:8px 13px;border-radius:9px 9px 0 0;cursor:pointer;white-space:nowrap}
    .tab.on{background:var(--paper);color:var(--ink);border:1px solid var(--line);border-bottom-color:var(--paper);margin-bottom:-1px}
    .CodeMirror{height:auto;min-height:340px;max-height:62vh;font:13px/1.6 var(--mono);background:var(--paper)}
    .CodeMirror-gutters{background:var(--paper);border-right:1px solid var(--line)}
  </style>

  <div id="x">
    <div id="home">
      <div class="head">
        <div class="kick">Workbooks · examples</div>
        <h1>Learn by example</h1>
        <p>Each of these is a complete little app built as a workbook. Pick one to see what it teaches — and read the real <code>.work</code> source behind it.</p>
      </div>
      <div class="grid" id="grid"></div>
    </div>

    <div id="detail">
      <button class="back" id="back" type="button">← All examples</button>
      <div class="lhead">
        <div class="ic" id="dic"></div>
        <div><h2 id="dteach"></h2><div class="sub" id="dsub"></div></div>
        <div class="grow"></div>
        <a class="open" id="dopen" target="_blank">Open the live app →</a>
      </div>
      <div class="learn"><h4>What you'll learn</h4><ul id="dlearn"></ul></div>
      <div class="code"><div class="tabs" id="dtabs"></div><div id="deditor"></div></div>
    </div>
  </div>

  <script>
  (function(){
    var $=function(s){return document.querySelector(s)};
    var TINT=['var(--mint)','var(--sky)','var(--peach)','var(--cream)','var(--sage)'];
    function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]})}

    // Lessons — titled by WHAT THEY TEACH, in plain language, not by brand.
    var LESSONS=[
      { id:'search-swarm', icon:'🐝', teach:'Put an AI agent swarm to work',
        sub:'Dozens of AI agents search the live web at the same time, then write you one clear, cited report.',
        learn:[
          'How a workbook uses our own browser to fetch and read real web pages',
          'How the agent framework runs many agents at once and gathers their findings',
          'How progress streams onto the page live as the work happens',
          'Speech-to-text (dictation) that runs entirely in your browser — nothing sent to a server'
        ],
        tags:['AI agents','web research','live updates','in-browser AI'] },
      { id:'brandnana', icon:'🍌', teach:'Turn any website into something new',
        sub:'Point it at a brand and it builds a brand book — logo, colours, type, imagery, and a voice — from the live site.',
        learn:[
          'Pulling a logo and real imagery straight off a live website with our own browser',
          'Reading a page’s actual colours and fonts to rebuild its identity',
          'Writing copy with an AI model — and needing no paid third-party services',
          'A complete single-page app, from a blank box to a finished document'
        ],
        tags:['web scraping','media','single-page app','no microservices'] },
      { id:'deck', icon:'🖼️', teach:'Use any web library inside a workbook',
        sub:'Type a topic; it writes a slide deck and presents it — built with the real reveal.js library.',
        learn:[
          'Adding a real outside dependency (reveal.js) and using it in your app',
          'Building your own components with it inside a workbook',
          'Generating the actual content with an AI model',
          'Presenting it live, right there in the page'
        ],
        tags:['dependencies','reveal.js','components','generation'] }
    ];

    var grid=$('#grid');
    LESSONS.forEach(function(l,i){
      var c=document.createElement('div'); c.className='card';
      c.innerHTML='<div class="ic" style="background:'+TINT[i%5]+'">'+l.icon+'</div>'+
        '<h3>'+esc(l.teach)+'</h3><div class="sub">'+esc(l.sub)+'</div>'+
        '<div class="tags">'+l.tags.map(function(t){return '<span class="tag">'+esc(t)+'</span>'}).join('')+'</div>'+
        '<div class="more">Explore the code →</div>';
      c.addEventListener('click',function(){open(l,i)});
      grid.appendChild(c);
    });

    var cm=null, files=[];
    $('#back').addEventListener('click',function(){ $('#detail').classList.remove('on'); $('#home').style.display='block'; window.scrollTo(0,0); });

    function open(l,i){
      $('#home').style.display='none'; $('#detail').classList.add('on'); window.scrollTo(0,0);
      $('#dic').textContent=l.icon; $('#dic').style.background=TINT[i%5];
      $('#dteach').textContent=l.teach; $('#dsub').textContent=l.sub;
      $('#dopen').href='/'+l.id+'/';
      $('#dlearn').innerHTML=l.learn.map(function(x){return '<li><b>→</b><span>'+esc(x)+'</span></li>'}).join('');
      loadCode(l.id);
    }

    function loadCode(id){
      $('#dtabs').innerHTML=''; if(!cm){ cm=CodeMirror($('#deditor'),{value:'Loading…',mode:'javascript',lineNumbers:true,readOnly:true,lineWrapping:true}); }
      cm.setValue('Loading source…');
      fetch('/'+id+'/source').then(function(r){return r.json()}).then(function(fs){
        files=fs||[];
        $('#dtabs').innerHTML=files.map(function(f,i){return '<button class="tab'+(i===0?' on':'')+'" data-i="'+i+'">'+esc(f.name)+'</button>'}).join('');
        [].forEach.call(document.querySelectorAll('#dtabs .tab'),function(t){t.addEventListener('click',function(){
          [].forEach.call(document.querySelectorAll('#dtabs .tab'),function(x){x.classList.remove('on')});
          t.classList.add('on'); show(+t.dataset.i);
        });});
        show(0);
      }).catch(function(){ cm.setValue('(could not load source)'); });
    }
    function show(i){ if(files[i]) cm.setValue(files[i].content||''); setTimeout(function(){cm.refresh()},10); }
  })();
  </script>
end
