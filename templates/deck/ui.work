# The interface

A `client` block that pulls in **reveal.js** (CDN) and builds the deck. Enter a topic; it opens an
`EventSource` on the `deck` source, appends a `<section>` per slide as they stream in, then
initialises reveal.js so you can present (arrow keys · `f` for fullscreen).

client :app do
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/dist/reveal.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/dist/theme/white.css">
  <script src="https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/dist/reveal.js"></script>

  <style>
    :root{ --paper:#fff; --bg:#f7f6f3; --ink:#37352f; --soft:#787066; --line:#ece9e3; --accent:#ffd643; }
    *{box-sizing:border-box}
    body{max-width:none!important;margin:0!important;padding:0!important;background:var(--bg)!important;
      color:var(--ink)!important;font:16px/1.6 'Inter',system-ui,sans-serif!important}
    nav.wb-nav, section.file > h1, section.file > h2, section.file > h3, section.file > h4,
    section.file > p, section.file > ul, section.file > pre, section.file > .decl, section.file > figure{display:none!important}
    section.file{display:block;margin:0;padding:0;max-width:none;border:0}
    .paper{position:fixed;inset:0;pointer-events:none;z-index:0;
      background-image:linear-gradient(rgba(55,53,47,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(55,53,47,.05) 1px,transparent 1px);
      background-size:26px 26px;-webkit-mask-image:radial-gradient(78% 78% at 100% 100%,#000,transparent 44%),radial-gradient(62% 62% at 0% 0%,#000,transparent 44%);
      mask-image:radial-gradient(78% 78% at 100% 100%,#000,transparent 44%),radial-gradient(62% 62% at 0% 0%,#000,transparent 44%)}
    #ss{position:relative;z-index:1;max-width:1000px;margin:0 auto;padding:38px 22px 80px}

    #intro{min-height:calc(100vh - 76px);display:flex;flex-direction:column;justify-content:center}
    #intro .top{text-align:center;margin:0 0 26px}
    #intro .mark{font-size:34px;font-weight:700;letter-spacing:-.02em;display:inline-flex;gap:10px;align-items:center}
    #intro .tag{color:var(--soft);margin-top:10px;font-size:16px}
    .composer{background:var(--paper);border:1px solid var(--line);border-radius:18px;box-shadow:0 14px 44px rgba(55,53,47,.08);
      padding:16px 18px;margin:28px auto 14px;width:100%;max-width:640px;display:flex;gap:12px;align-items:center}
    .composer input{flex:1;border:0;outline:0;font:17px 'Inter';color:var(--ink);background:transparent}
    .composer input::placeholder{color:#b6afa4}
    .go{border:0;background:var(--ink);color:#fff;font:600 15px 'Inter';padding:11px 20px;border-radius:11px;cursor:pointer}
    .chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;max-width:640px;margin:0 auto}
    .chip{background:var(--paper);border:1px solid var(--line);border-radius:20px;padding:7px 14px;font-size:14px;color:var(--soft);cursor:pointer}
    .chip:hover{color:var(--ink)}

    #results{display:none}
    .rbar{display:flex;align-items:center;gap:12px;padding:6px 0 18px;border-bottom:1px solid var(--line);margin-bottom:22px}
    .rbar .home{font-size:18px;font-weight:700;cursor:pointer;display:flex;gap:7px;align-items:center}
    .rbar .grow{flex:1}
    .rbar button{border:1px solid var(--line);background:var(--paper);border-radius:10px;padding:8px 14px;font:500 14px 'Inter';cursor:pointer}
    .rbar .present{background:var(--ink);color:#fff;border-color:var(--ink)}
    .prog{display:flex;gap:10px;align-items:center;color:var(--soft);font-size:14px;margin-bottom:16px}
    .prog .dot{width:7px;height:7px;border-radius:50%;background:var(--accent);animation:pulse 1.1s infinite}
    @keyframes pulse{0%,100%{opacity:.35;transform:scale(.85)}50%{opacity:1;transform:scale(1.15)}}

    .stage{max-width:980px;margin:0 auto;border:1px solid var(--line);border-radius:14px;overflow:hidden;
      box-shadow:0 14px 44px rgba(55,53,47,.08);background:#fff}
    .reveal{width:100%;aspect-ratio:16/9}
    .reveal h1{font-size:2.1em} .reveal h2{font-size:1.5em;color:#37352f}
    .reveal .sub{color:#787066} .reveal ul{display:block}
  </style>

  <div class="paper"></div>
  <div id="ss">
    <div id="intro">
      <div class="top">
        <div class="mark">🖼️ <span>Deck</span></div>
        <div class="tag">Type a topic — get a presentation, built and rendered with reveal.js.</div>
      </div>
      <div class="composer">
        <input id="q" type="text" placeholder="The history of the typewriter" autocomplete="off" />
        <button class="go" id="go" type="button">Generate</button>
      </div>
      <div class="chips" id="chips">
        <span class="chip">How the BEAM scheduler works</span>
        <span class="chip">A primer on the WASM component model</span>
        <span class="chip">The case for local-first software</span>
      </div>
    </div>

    <div id="results">
      <div class="rbar">
        <div class="home" id="home">🖼️ <span id="rtitle">Deck</span></div>
        <div class="grow"></div>
        <button class="present" id="present" type="button">▶ Present</button>
        <button id="ns" type="button">+ New deck</button>
      </div>
      <div class="prog" id="prog"><span class="dot"></span><span id="ptxt">Starting…</span></div>
      <div class="stage"><div class="reveal"><div class="slides" id="slides"></div></div></div>
    </div>
  </div>

  <script>
  (function(){
    var $=function(s){return document.querySelector(s)};
    var es=null, deck=null, n=0;
    function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]})}

    $('#go').addEventListener('click',start);
    $('#q').addEventListener('keydown',function(e){if(e.key==='Enter')start();});
    $('#ns').addEventListener('click',home); $('#home').addEventListener('click',home);
    $('#present').addEventListener('click',function(){ var r=$('.reveal'); if(r.requestFullscreen)r.requestFullscreen(); });
    [].forEach.call(document.querySelectorAll('#chips .chip'),function(c){c.addEventListener('click',function(){$('#q').value=c.textContent;start();});});

    function home(){ if(es)es.close(); $('#results').style.display='none'; $('#intro').style.display='flex'; $('#q').value=''; }

    function start(){
      var q=$('#q').value.trim(); if(!q)return;
      if(es)es.close();
      if(deck){ try{deck.destroy();}catch(e){} deck=null; }
      $('#slides').innerHTML=''; n=0;
      $('#intro').style.display='none'; $('#results').style.display='block';
      $('#rtitle').textContent=q; $('#prog').style.display='flex'; $('#ptxt').textContent='Outlining…';
      es=new EventSource('/live/deck?q='+encodeURIComponent(q));
      es.onmessage=function(e){var d;try{d=JSON.parse(e.data)}catch(_){return} on(d);};
    }

    function on(d){
      if(d.type==='step'){ $('#ptxt').textContent=d.label; }
      else if(d.type==='slide'){ addSlide(d.slide); }
      else if(d.type==='done'||d.type==='end'){ $('#ptxt').textContent='Ready — arrow keys to present'; $('#prog').style.display='none'; present(); if(es)es.close(); }
    }

    function addSlide(s){
      n++;
      var sec=document.createElement('section');
      var bullets=(s.bullets||[]).map(function(b){return '<li>'+esc(b)+'</li>'}).join('');
      if(n===1){
        sec.innerHTML='<h1>'+esc(s.title||'')+'</h1>'+(bullets?'<p class="sub">'+(s.bullets||[]).map(esc).join(' · ')+'</p>':'');
      } else {
        sec.innerHTML='<h2>'+esc(s.title||'')+'</h2>'+(bullets?'<ul>'+bullets+'</ul>':'')+(s.notes?'<aside class="notes">'+esc(s.notes)+'</aside>':'');
      }
      $('#slides').appendChild(sec);
    }

    // initialise reveal.js once the deck is built (its own embedded instance, scoped to .reveal)
    function present(){
      if(!window.Reveal){ return; }
      deck=new Reveal($('.reveal'), { embedded:true, controls:true, progress:true, hash:false, transition:'slide', width:960, height:540, margin:0.08 });
      deck.initialize();
    }
  })();
  </script>
end
