# The interface

The interface is a `client` block — the browser island. It has two pages: the **intro**
(the composer + recent runs) and the **results** page (the live task list + report). Opening
a run swaps to the results page; "New search" returns to the intro. Each agent is a task
card; when the run finishes, the activity collapses to one foldable and the report renders
as a clean document — with hand-drawn figures (roughjs) where the data warrants one.

client :app do
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/rough-notation/lib/rough-notation.iife.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/roughjs@4.6.6/bundled/rough.js"></script>

  <style>
    :root{ --paper:#ffffff; --bg:#f7f6f3; --ink:#37352f; --soft:#787066; --line:#ece9e3;
      --accent:#ffd643; --mint:#cdeede; --sky:#d6e9fb; --peach:#fbe0cd; --lilac:#e9dcfb; --radius:14px; }
    *{box-sizing:border-box}
    body{max-width:none!important;margin:0!important;padding:0!important;background:var(--bg)!important;
      color:var(--ink)!important;font:16px/1.6 'Inter',system-ui,sans-serif!important}
    nav.wb-nav, section.file > h1, section.file > h2, section.file > h3,
    section.file > h4, section.file > p, section.file > ul, section.file > pre,
    section.file > .decl, section.file > figure{display:none!important}
    section.file{display:block;margin:0;padding:0;max-width:none;border:0}

    /* subtle graph-paper, fading in from the corners */
    .paper{position:fixed;inset:0;pointer-events:none;z-index:0;
      background-image:linear-gradient(rgba(55,53,47,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(55,53,47,.05) 1px,transparent 1px);
      background-size:26px 26px;
      -webkit-mask-image:radial-gradient(78% 78% at 100% 100%,#000,transparent 44%),radial-gradient(62% 62% at 0% 0%,#000,transparent 44%);
      mask-image:radial-gradient(78% 78% at 100% 100%,#000,transparent 44%),radial-gradient(62% 62% at 0% 0%,#000,transparent 44%)}
    #ss{position:relative;z-index:1;max-width:980px;margin:0 auto;padding:38px 22px 120px}

    /* ── intro page ── */
    #intro{min-height:calc(100vh - 76px);display:flex;flex-direction:column;justify-content:center}
    #intro .top{text-align:center;margin:0 0 30px}
    #intro .mark{font-size:34px;font-weight:700;letter-spacing:-.02em;display:inline-flex;gap:10px;align-items:center}
    #intro .tag{color:var(--soft);margin-top:10px;font-size:16px}
    /* Composer: a wide box — text area + bottom depth toolbar, with a full-height send button beside it. */
    .composer{background:var(--paper);border:1px solid var(--line);border-radius:20px;
      box-shadow:0 14px 44px rgba(55,53,47,.08);padding:18px;margin:30px auto 18px;width:100%;max-width:820px;
      display:flex;gap:14px;align-items:stretch}
    .cbody{flex:1;min-width:0;display:flex;flex-direction:column}
    .composer textarea{width:100%;border:0;outline:0;resize:none;font:16px/1.6 'Inter',sans-serif;
      color:var(--ink);background:transparent;min-height:96px}
    .composer textarea::placeholder{color:#b6afa4}
    .crow{display:flex;align-items:center;margin-top:12px}
    .depth{display:inline-flex;gap:4px;background:var(--bg);border-radius:11px;padding:4px}
    .dep{border:0;background:transparent;font:500 14px 'Inter';color:var(--soft);padding:6px 13px;
      border-radius:8px;cursor:pointer;transition:.15s}
    .dep.active{background:var(--paper);color:var(--ink);box-shadow:0 1px 4px rgba(55,53,47,.1)}
    /* a physical keyboard key — white keycap with beveled edges + depth */
    .go{align-self:stretch;width:60px;border-radius:13px;cursor:pointer;display:flex;align-items:center;justify-content:center;
      font-size:22px;line-height:1;color:var(--ink);
      background:linear-gradient(180deg,#ffffff 0%,#f1efe8 100%);
      border:1px solid #e3dfd5;
      box-shadow:0 4px 0 #d9d3c6, inset 0 1px 0 #ffffff, 0 6px 12px rgba(55,53,47,.08);
      transition:transform .08s ease, box-shadow .08s ease}
    .go:hover{transform:translateY(-1px);box-shadow:0 5px 0 #d9d3c6, inset 0 1px 0 #ffffff, 0 9px 16px rgba(55,53,47,.1)}
    .go:active{transform:translateY(3px);box-shadow:0 1px 0 #d9d3c6, inset 0 1px 0 #ffffff, 0 2px 5px rgba(55,53,47,.08)}
    /* in-browser dictation (Moonshine, client-side) */
    .mic{margin-left:auto;width:38px;height:38px;border:1px solid var(--line);background:var(--paper);
      border-radius:11px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--soft);transition:.15s}
    .mic:hover{color:var(--ink);border-color:#d8d3ca}
    .mic svg{width:18px;height:18px}
    .mic.rec{color:#e5484d;border-color:#f3b0b2;background:#fff1f1;animation:micpulse 1s infinite}
    .mic.load{opacity:.55;cursor:default}
    @keyframes micpulse{0%,100%{box-shadow:0 0 0 0 rgba(229,72,77,.32)}70%{box-shadow:0 0 0 7px rgba(229,72,77,0)}}
    /* live dictation: text streams into the box; a small badge shows it's listening */
    .cbody{position:relative}
    .cstatus{display:none;position:absolute;top:0;right:0;align-items:center;gap:7px;z-index:2;
      font:12px/1 'Inter';color:#e5484d;background:#fff1f1;border:1px solid #f3b0b2;border-radius:20px;padding:5px 11px 5px 9px}
    .cbody.active .cstatus{display:inline-flex}
    .eq{display:inline-flex;gap:2px;align-items:center;height:13px}
    .eq i{width:2.5px;height:4px;background:currentColor;border-radius:2px;animation:eq .85s ease-in-out infinite}
    .eq i:nth-child(2){animation-delay:.1s}.eq i:nth-child(3){animation-delay:.2s}
    .eq i:nth-child(4){animation-delay:.3s}.eq i:nth-child(5){animation-delay:.4s}
    @keyframes eq{0%,100%{height:4px}50%{height:13px}}
    .chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:8px auto 4px;max-width:820px}
    .chip{background:var(--paper);border:1px solid var(--line);border-radius:20px;padding:7px 14px;
      font-size:14px;color:var(--soft);cursor:pointer;transition:.15s}
    .chip:hover{color:var(--ink);border-color:#d8d3ca}
    .recent{max-width:720px;margin:26px auto 0}
    .recent h4{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:#b6afa4;margin:0 0 8px}
    .rrow{display:flex;gap:10px;align-items:center;padding:10px 12px;border-radius:10px;cursor:pointer;
      color:var(--ink);transition:.12s;border:1px solid transparent}
    .rrow:hover{background:var(--paper);border-color:var(--line)}
    .rrow .q{flex:1;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .rrow .m{font-size:12px;color:var(--soft)}

    /* ── results page ── */
    #results{display:none}
    .rbar{display:flex;align-items:center;gap:14px;padding:6px 0 18px;border-bottom:1px solid var(--line);margin-bottom:20px}
    .rbar .home{font-size:18px;font-weight:700;cursor:pointer;display:flex;gap:7px;align-items:center;white-space:nowrap}
    .rbar .grow{flex:1}
    .rbar .ns{border:1px solid var(--line);background:var(--paper);border-radius:10px;padding:8px 14px;
      font:500 14px 'Inter';color:var(--ink);cursor:pointer}
    .rbar .ns:hover{border-color:#d8d3ca}
    .qtitle{font-size:26px;font-weight:700;letter-spacing:-.02em;margin:2px 0 6px}
    .meta{display:flex;gap:14px;align-items:center;color:var(--soft);font-size:14px;margin-bottom:18px;flex-wrap:wrap}
    .meta .dot{width:7px;height:7px;border-radius:50%;background:var(--accent);animation:pulse 1.1s infinite}
    @keyframes pulse{0%,100%{opacity:.35;transform:scale(.85)}50%{opacity:1;transform:scale(1.15)}}

    .summary{display:none;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);
      margin-bottom:20px;align-items:stretch;overflow:hidden}
    .summary.on{display:flex}
    .summary .s{display:flex;flex-direction:column;gap:3px;padding:15px 22px;border-left:1px solid var(--line);flex:1}
    .summary .s:first-child{border-left:0}
    .summary .s b{font-size:20px;font-weight:700;letter-spacing:-.01em}
    .summary .s span{font-size:10.5px;color:var(--soft);text-transform:uppercase;letter-spacing:.07em;font-weight:500}

    details.activity{background:transparent;margin-bottom:14px}
    details.activity > summary{list-style:none;cursor:pointer;font-size:12px;text-transform:uppercase;
      letter-spacing:.08em;color:#b6afa4;padding:6px 0;display:flex;gap:7px;align-items:center}
    details.activity > summary::-webkit-details-marker{display:none}
    details.activity > summary:before{content:'▾';transition:.2s;font-size:11px}
    details.activity:not([open]) > summary:before{transform:rotate(-90deg)}
    .digest{background:#fffaf0;border:1px solid #f3e6c8;border-radius:var(--radius);padding:10px 14px;
      font-size:13px;color:#7a6a3f;margin:8px 0;display:flex;gap:9px;align-items:flex-start}
    .tasks{display:grid;grid-template-columns:repeat(auto-fill,minmax(248px,1fr));gap:11px;margin:10px 0 4px}
    .task{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:14px;
      display:flex;flex-direction:column;gap:9px;cursor:pointer;transition:.15s;animation:pop .3s ease;min-height:126px}
    @keyframes pop{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
    .task:hover{border-color:#d8d3ca;box-shadow:0 4px 16px rgba(55,53,47,.05)}
    .task.sel{border-color:var(--ink);box-shadow:0 0 0 1px var(--ink)}
    .thead{display:flex;align-items:center;justify-content:space-between}
    .ava{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;font-size:19px;flex:none}
    .task .t{font-weight:600;font-size:14px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .task .s{font-size:12.5px;color:var(--soft);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:auto}
    .tfoot{display:flex;justify-content:flex-end}
    .badge{display:inline-flex;gap:5px;align-items:center;background:var(--bg);border-radius:18px;
      padding:5px 11px;font-size:13px;font-weight:600;color:var(--ink);flex:none}
    .stp{font-size:12px;font-weight:600;padding:4px 10px;border-radius:16px;flex:none}
    .stp.searching{background:var(--sky)} .stp.reading{background:var(--peach)}
    .stp.thinking{background:var(--lilac)} .stp.done{background:var(--mint)}

    .report{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:42px 52px;margin-top:8px}
    .report > *{max-width:720px}
    .report > .fig,.report > .figwrap,.report table{max-width:none}
    .report h1{font-size:27px;font-weight:700;letter-spacing:-.02em;margin:0 0 8px;line-height:1.2}
    .report h2{font-size:19px;font-weight:600;margin:30px 0 10px;padding-bottom:7px;border-bottom:1px solid var(--line)}
    .report h3{font-size:15.5px;font-weight:600;margin:18px 0 8px}
    .report p{margin:0 0 13px;color:#2c2a26} .report ul,.report ol{margin:0 0 13px;padding-left:22px}
    .report li{margin:5px 0} .report a{color:#2f6fed;text-decoration:none} .report a:hover{text-decoration:underline}
    .report strong{font-weight:600;color:var(--ink)}
    .report code{background:var(--bg);padding:1px 6px;border-radius:5px;font-size:.88em}
    .report table{border-collapse:collapse;width:100%;margin:18px 0;font-size:13.5px}
    .report th,.report td{border:1px solid var(--line);padding:9px 13px;text-align:left;vertical-align:top}
    .report thead th{background:var(--bg);font-weight:600}
    .fig{margin:22px 0;padding:20px 22px 16px;background:var(--paper);border:1px solid var(--line);border-radius:14px}
    .fig .figt{font-size:12px;font-weight:600;color:var(--soft);text-transform:uppercase;letter-spacing:.06em;margin-bottom:14px}
    .fig .leg{display:flex;gap:16px;justify-content:center;margin-top:12px;font-size:12px;color:var(--soft)}
    .fig .leg i{display:inline-block;width:11px;height:11px;border-radius:3px;margin-right:5px;vertical-align:-1px}

    #detail{position:fixed;top:0;right:0;width:430px;max-width:92vw;height:100vh;background:var(--paper);
      border-left:1px solid var(--line);box-shadow:-12px 0 40px rgba(55,53,47,.1);padding:26px 24px;
      overflow-y:auto;transform:translateX(110%);transition:.28s cubic-bezier(.2,.8,.2,1);z-index:50}
    #detail.on{transform:none}
    #detail .x{position:absolute;top:18px;right:18px;border:0;background:var(--bg);width:30px;height:30px;
      border-radius:9px;cursor:pointer;font-size:15px;color:var(--soft)}
    #detail h3{font-size:18px;margin:0 32px 4px 0;display:flex;gap:9px;align-items:flex-start}
    #detail .dsub{color:var(--soft);font-size:13px;margin-bottom:16px}
    #detail .src{display:flex;gap:10px;align-items:flex-start;padding:10px;border-radius:10px;margin-bottom:7px;background:var(--bg)}
    #detail .src img{width:18px;height:18px;border-radius:4px;flex:none;margin-top:2px}
    #detail .src .sd{flex:1;min-width:0}
    #detail .src .sd b{font-size:13px;font-weight:600;display:block}
    #detail .src .sd p{font-size:12px;color:var(--soft);margin:3px 0 0;line-height:1.4}
    #detail .read{font-size:11px;color:#3a9d63;font-weight:600} #detail .pend{font-size:11px;color:#b6afa4}
    #detail .finding{background:var(--mint);border-radius:11px;padding:13px 15px;font-size:14px;margin-top:8px}
  </style>

  <div class="paper"></div>
  <div id="ss">
    <div id="intro">
      <div class="top">
        <div class="mark">🐝 <span id="wordmark">Search Swarm</span></div>
        <div class="tag">Ask anything — a swarm of agents researches the live web for you.</div>
      </div>
      <div class="composer">
        <div class="cbody">
          <div class="cstatus" id="cstatus"><span class="eq"><i></i><i></i><i></i><i></i><i></i></span><span class="dots" id="cstatustext">Listening</span></div>
          <textarea id="q" rows="1" placeholder="What do you want to understand?"></textarea>
          <div class="crow">
            <div class="depth">
              <button class="dep active" data-depth="turbo" type="button">⚡ Turbo</button>
              <button class="dep" data-depth="ludicrous" type="button">🚀 Ludicrous</button>
            </div>
            <button class="mic" id="mic" type="button" aria-label="Dictate" title="Dictate — Moonshine, runs in your browser">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2.5" width="6" height="11.5" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0"/><line x1="12" y1="17.5" x2="12" y2="21"/></svg>
            </button>
          </div>
        </div>
        <button class="go" id="go" type="button" aria-label="Send" title="Send">→</button>
      </div>
      <div class="chips" id="chips">
        <span class="chip">How does the BEAM scheduler work?</span>
        <span class="chip">Best practices for WASM component model</span>
        <span class="chip">State of small open-weight LLMs in 2026</span>
      </div>
      <div class="recent" id="recent"></div>
    </div>

    <div id="results">
      <div class="rbar">
        <div class="home" id="home">🐝 <span>Search Swarm</span></div>
        <div class="grow"></div>
        <button class="ns" id="ns" type="button">+ New search</button>
      </div>
      <div class="qtitle" id="qt"></div>
      <div class="meta" id="meta"><span class="dot"></span><span id="ptxt">Planning…</span></div>
      <div class="summary" id="summary"></div>
      <details class="activity" id="activity" open>
        <summary id="actsum">Agents &amp; activity</summary>
        <div id="digests"></div>
        <div class="tasks" id="tasks"></div>
      </details>
      <div class="report" id="report" style="display:none"></div>
    </div>
  </div>

  <aside id="detail">
    <button class="x" id="dx" type="button">✕</button>
    <div id="dbody"></div>
  </aside>

  <script>
  (function(){
    var AVA=['🐝','🔍','📚','🧭','🔬','📰','🗂️','🛰️','🧪','🪐','📡','🧠'];
    var fav=function(u){try{return 'https://www.google.com/s2/favicons?sz=64&domain='+new URL(u).hostname}catch(e){return ''}};
    var dom=function(u){try{return new URL(u).hostname.replace('www.','')}catch(e){return u}};
    var $=function(s){return document.querySelector(s)};
    var es=null, curDepth='turbo', tk={}, order=[], t0=0, openId=null;
    var usd=0, tin=0, tout=0;

    [].forEach.call(document.querySelectorAll('.dep'),function(d){d.addEventListener('click',function(){
      [].forEach.call(document.querySelectorAll('.dep'),function(x){x.classList.remove('active')});
      d.classList.add('active');curDepth=d.dataset.depth;});});

    if(window.RoughNotation){var an=RoughNotation.annotate($('#wordmark'),{type:'underline',color:'#ffd643',strokeWidth:3,padding:2});setTimeout(function(){an.show()},500);}

    $('#q').addEventListener('input',function(){this.style.height='auto';this.style.height=this.scrollHeight+'px';});
    $('#q').addEventListener('keydown',function(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();start();}});
    $('#go').addEventListener('click',start);
    $('#ns').addEventListener('click',home);
    $('#home').addEventListener('click',home);
    [].forEach.call(document.querySelectorAll('#chips .chip'),function(c){c.addEventListener('click',function(){$('#q').value=c.textContent;start();});});
    $('#dx').addEventListener('click',function(){detail.classList.remove('on');if(openId&&tk[openId])tk[openId].el.classList.remove('sel');openId=null;});
    var detail=$('#detail');

    function home(){ if(es)es.close(); detail.classList.remove('on');
      $('#results').style.display='none'; $('#intro').style.display='block';
      $('#q').value=''; $('#q').style.height='auto'; loadRecent(); window.scrollTo(0,0); }

    loadRecent();
    function loadRecent(){
      if(!window.nexus||!nexus.data)return;
      nexus.data.all('Session').then(function(rows){
        rows=(rows||[]).slice(-7).reverse();
        if(!rows.length){$('#recent').innerHTML='';return;}
        var h='<h4>Recent research</h4>';
        rows.forEach(function(r,i){h+='<div class="rrow" data-i="'+i+'"><span>🕘</span><span class="q">'+esc(r.prompt)+'</span><span class="m">'+(r.agents||0)+' agents · '+(r.depth||'')+'</span></div>';});
        $('#recent').innerHTML=h;
        [].forEach.call(document.querySelectorAll('.rrow'),function(x){x.addEventListener('click',function(){showStored(rows[+x.dataset.i]);});});
      }).catch(function(){});
    }

    // Revisit a saved run — render its stored report without re-running.
    function showStored(r){
      $('#intro').style.display='none';$('#results').style.display='block';
      $('#qt').textContent=r.prompt;$('#meta').style.display='none';
      $('#activity').style.display='none';$('#digests').innerHTML='';$('#tasks').innerHTML='';
      var s=$('#summary');s.className='summary on';
      s.innerHTML=stat(r.agents||0,'agents')+stat(r.depth||'—','depth')+'<div style="flex:1"></div>'+
        '<div class="s"><b style="font-size:13px;color:var(--soft)">saved run</b></div>';
      renderReport(r.report||'');window.scrollTo(0,0);
    }

    function start(){
      var query=$('#q').value.trim(); if(!query)return;
      if(es)es.close(); tk={};order=[];openId=null;t0=Date.now();usd=0;tin=0;tout=0;
      $('#intro').style.display='none';$('#results').style.display='block';
      $('#qt').textContent=query;$('#tasks').innerHTML='';$('#digests').innerHTML='';
      $('#report').style.display='none';$('#report').innerHTML='';
      $('#summary').className='summary';$('#summary').innerHTML='';
      $('#activity').style.display='block';$('#activity').open=true;$('#actsum').textContent='Agents & activity';
      $('#meta').style.display='flex';$('#ptxt').textContent='Planning…';window.scrollTo(0,0);
      es=new EventSource('/live/swarm?q='+encodeURIComponent(query)+'&depth='+curDepth);
      es.onmessage=function(e){var d;try{d=JSON.parse(e.data)}catch(_){return} on(d);};
      es.onerror=function(){};
    }

    function card(id){
      if(tk[id])return tk[id];
      // Agent ids are sequential (a1, a2, …) in dispatch order — but spawn events arrive
      // concurrently. Place each card by its id so the grid always reads first-to-last.
      var n=parseInt(String(id).replace(/\D/g,''),10)||(order.length+1), idx=n-1;
      var el=document.createElement('div');el.className='task';el.dataset.n=n;
      el.innerHTML='<div class="thead"><div class="ava"></div><span class="stp searching">searching</span></div>'+
        '<div class="t"></div><div class="s"></div>'+
        '<div class="tfoot"><span class="badge" style="display:none">📄 <i>0</i></span></div>';
      el.querySelector('.ava').textContent=AVA[idx%AVA.length];
      var tints=['var(--mint)','var(--sky)','var(--peach)','var(--lilac)']; el.querySelector('.ava').style.background=tints[idx%4];
      var host=$('#tasks'),ref=null;
      [].forEach.call(host.children,function(ch){if(ref===null&&(+ch.dataset.n)>n)ref=ch;});
      host.insertBefore(el,ref);
      var o={el:el,sources:[],pages:{},finding:'',srcN:0,read:0,query:''};
      el.addEventListener('click',function(){openDetail(id);});
      tk[id]=o;order.push(id);return o;
    }

    function on(d){
      if(d.type==='fleet'){$('#ptxt').textContent='Dispatching the swarm…';}
      else if(d.type==='usage'){usd+=(+d.usd||0);tin+=(+d.in||0);tout+=(+d.out||0);}
      else if(d.type==='spawn'){var c=card(d.id);c.query=d.query;c.el.querySelector('.t').textContent=d.query;}
      else if(d.type==='state'){var c=card(d.id);var st=c.el.querySelector('.stp');st.className='stp '+d.status;
        st.textContent=d.status; c.el.querySelector('.s').textContent=labelFor(d);}
      else if(d.type==='source'){var c=card(d.id);c.sources.push(d.url);c.srcN++;updBadge(c);}
      else if(d.type==='page'){var c=card(d.id);c.pages[d.url]=d.preview||'';c.read++;updBadge(c);if(openId===d.id)renderDetail(d.id);}
      else if(d.type==='done'){var c=card(d.id);c.finding=d.finding||'';var st=c.el.querySelector('.stp');st.className='stp done';st.textContent='done';
        c.el.querySelector('.s').textContent=c.read+' pages read · '+c.srcN+' sources';if(openId===d.id)renderDetail(d.id);}
      else if(d.type==='digest'){var n=document.createElement('div');n.className='digest';
        n.innerHTML='<span>'+(d.continue?'🔁':'✅')+'</span><span>'+esc((d.note||'').slice(0,200))+'</span>';$('#digests').appendChild(n);}
      else if(d.type==='synth'){$('#ptxt').textContent='Compiling the final report…';}
      else if(d.type==='report'){renderReport(d.content);}
      else if(d.type==='fleet_done'){finish();}
      else if(d.type==='end'){finish();if(es)es.close();loadRecent();}
    }

    function labelFor(d){
      if(d.status==='searching')return '🔍 searching the web';
      if(d.status==='reading')return '📄 reading '+(d.action||'');
      if(d.status==='thinking')return '🧠 '+(d.action||'writing finding');
      return d.action||'';
    }
    function updBadge(c){var b=c.el.querySelector('.badge');b.style.display='inline-flex';b.querySelector('i').textContent=c.read+'/'+c.srcN;}

    function openDetail(id){
      if(openId&&tk[openId])tk[openId].el.classList.remove('sel');
      openId=id;tk[id].el.classList.add('sel');renderDetail(id);detail.classList.add('on');
    }
    function renderDetail(id){
      var c=tk[id];var h='<h3><span>'+c.el.querySelector('.ava').textContent+'</span><span>'+esc(c.query)+'</span></h3>';
      h+='<div class="dsub">'+c.read+' of '+c.srcN+' sources read</div>';
      c.sources.forEach(function(u){var read=c.pages.hasOwnProperty(u);
        h+='<div class="src"><img src="'+fav(u)+'" onerror="this.style.visibility=\'hidden\'"><div class="sd">'+
          '<b>'+esc(dom(u))+'</b>'+(read?'<p>'+esc(c.pages[u]||'')+'</p>':'')+
          '</div><span class="'+(read?'read':'pend')+'">'+(read?'✓ read':'·')+'</span></div>';});
      if(c.finding)h+='<div class="finding">🧩 '+esc(c.finding)+'</div>';
      $('#dbody').innerHTML=h;
    }

    function renderReport(md){
      var r=$('#report');r.style.display='block';
      r.innerHTML=window.marked?marked.parse(md||''):('<pre>'+esc(md||'')+'</pre>');
      renderFigures(r);
    }

    // Turn ```figure JSON blocks into hand-drawn (roughjs) charts.
    var DRAW={bar:drawBar,line:drawLine,flow:drawFlow,compare:drawCompare,donut:drawDonut,pie:drawDonut};
    function renderFigures(root){
      if(!window.rough)return;
      [].forEach.call(root.querySelectorAll('code.language-figure'),function(code){
        var spec;try{spec=JSON.parse(code.textContent)}catch(e){return}
        var box=document.createElement('div');box.className='fig';
        if(spec.title){var t=document.createElement('div');t.className='figt';t.textContent=spec.title;box.appendChild(t);}
        var svg=(DRAW[spec.type]||drawBar)(spec);
        if(svg)box.appendChild(svg);
        if(spec.legend&&spec.legend.length&&spec.type!=='donut'&&spec.type!=='pie')box.appendChild(legendEl(spec.legend));
        var pre=code.closest('pre');if(pre)pre.replaceWith(box);else code.replaceWith(box);
      });
    }
    function legendEl(names){var l=document.createElement('div');l.className='leg';
      names.slice(0,5).forEach(function(n,i){var s=document.createElement('span');
        s.innerHTML='<i style="background:'+TINTS[i%5]+'"></i>'+esc(n);l.appendChild(s);});return l;}
    function svgEl(w,h){var s=document.createElementNS('http://www.w3.org/2000/svg','svg');s.setAttribute('width','100%');s.setAttribute('viewBox','0 0 '+w+' '+h);return s;}
    var TINTS=['#aee5c2','#a8d4f0','#f3c5a3','#d8c4f0','#f2ddb0'];
    function drawBar(spec){
      var data=(spec.data||[]).slice(0,8);if(!data.length)return null;
      var W=560,H=240,pad=34,bw=(W-pad*2)/data.length,max=Math.max.apply(null,data.map(function(d){return +d.value||0}))||1;
      var svg=svgEl(W,H),rc=rough.svg(svg);
      data.forEach(function(d,i){
        var bh=Math.max(2,((+d.value||0)/max)*(H-70)),x=pad+i*bw+bw*0.16,y=H-40-bh,w=bw*0.68;
        svg.appendChild(rc.rectangle(x,y,w,bh,{fill:TINTS[i%5],fillStyle:'solid',roughness:1.6,stroke:'#37352f',strokeWidth:1.3}));
        svg.appendChild(txt(x+w/2,H-22,trunc(d.label||'',12),11,'#787066'));
        svg.appendChild(txt(x+w/2,y-7,String(d.value),12,'#37352f',700));
      });
      return svg;
    }
    // Vertical flow — boxes stacked top→bottom with down-arrows, wide enough for multi-word steps.
    function drawFlow(spec){
      var steps=(spec.steps||[]).slice(0,7);if(!steps.length)return null;
      var W=520,bh=46,gap=24,x=70,w=W-140,H=steps.length*(bh+gap)-gap+12;
      var svg=svgEl(W,H),rc=rough.svg(svg);
      steps.forEach(function(s,i){
        var y=i*(bh+gap)+4;
        svg.appendChild(rc.rectangle(x,y,w,bh,{fill:TINTS[i%5],fillStyle:'solid',roughness:1.5,stroke:'#37352f',strokeWidth:1.3}));
        svg.appendChild(txt(W/2,y+bh/2+5,trunc(s,48),13,'#37352f',600));
        if(i<steps.length-1)svg.appendChild(rc.line(W/2,y+bh,W/2,y+bh+gap,{roughness:1.4,stroke:'#787066',strokeWidth:1.6}));
      });
      return svg;
    }
    function trunc(s,n){s=String(s);return s.length>n?s.slice(0,n-1)+'…':s;}
    function txt(x,y,s,size,fill,weight,anchor){var t=document.createElementNS('http://www.w3.org/2000/svg','text');
      t.setAttribute('x',x);t.setAttribute('y',y);t.setAttribute('text-anchor',anchor||'middle');
      t.setAttribute('font-size',size);t.setAttribute('fill',fill);t.setAttribute('font-family','Inter,sans-serif');
      if(weight)t.setAttribute('font-weight',weight);t.textContent=s;return t;}

    // Line / trend — points connected, dots, baseline + x labels.
    function drawLine(spec){
      var data=(spec.data||[]).slice(0,12);if(data.length<2)return null;
      var W=560,H=240,pX=42,pY=32,vals=data.map(function(d){return +d.value||0});
      var max=Math.max.apply(null,vals),min=Math.min.apply(null,vals);if(max===min)max=min+1;
      var svg=svgEl(W,H),rc=rough.svg(svg);
      var X=function(i){return pX+i*((W-pX*2)/(data.length-1))},Y=function(v){return H-pY-((v-min)/(max-min))*(H-pY*2)};
      svg.appendChild(rc.line(pX,H-pY,W-pX,H-pY,{roughness:1,stroke:'#d8d3ca',strokeWidth:1}));
      svg.appendChild(rc.linearPath(data.map(function(d,i){return [X(i),Y(+d.value||0)]}),{roughness:1.2,stroke:'#37352f',strokeWidth:2}));
      data.forEach(function(d,i){
        svg.appendChild(rc.circle(X(i),Y(+d.value||0),9,{fill:TINTS[1],fillStyle:'solid',roughness:1,stroke:'#37352f',strokeWidth:1.2}));
        svg.appendChild(txt(X(i),H-pY+16,trunc(d.label||'',9),10,'#787066'));
      });
      return svg;
    }
    // Compare — two series side by side per label (spec.data:[{label,a,b}], legend:[A,B]).
    function drawCompare(spec){
      var data=(spec.data||[]).slice(0,6);if(!data.length)return null;
      var W=560,H=250,pad=36,gw=(W-pad*2)/data.length,bw=Math.min(34,gw*0.3);
      var max=Math.max.apply(null,data.map(function(d){return Math.max(+d.a||0,+d.b||0)}))||1;
      var svg=svgEl(W,H),rc=rough.svg(svg);
      data.forEach(function(d,i){
        var c=pad+i*gw+gw/2,aV=+d.a||0,bV=+d.b||0,ah=Math.max(2,(aV/max)*(H-78)),bh=Math.max(2,(bV/max)*(H-78));
        var x0=c-bw-3,x1=c+3;
        svg.appendChild(rc.rectangle(x0,H-46-ah,bw,ah,{fill:TINTS[0],fillStyle:'solid',roughness:1.5,stroke:'#37352f',strokeWidth:1.2}));
        svg.appendChild(rc.rectangle(x1,H-46-bh,bw,bh,{fill:TINTS[1],fillStyle:'solid',roughness:1.5,stroke:'#37352f',strokeWidth:1.2}));
        svg.appendChild(txt(x0+bw/2,H-50-ah,String(aV),10,'#37352f',700));
        svg.appendChild(txt(x1+bw/2,H-50-bh,String(bV),10,'#37352f',700));
        svg.appendChild(txt(c,H-24,trunc(d.label||'',12),11,'#787066'));
      });
      return svg;
    }
    // Donut — proportions, with a side legend + percentages.
    function drawDonut(spec){
      var data=(spec.data||[]).slice(0,6);if(!data.length)return null;
      var total=data.reduce(function(s,d){return s+(+d.value||0)},0)||1;
      var W=440,H=Math.max(220,data.length*26+40),cx=120,cy=110,r=82;
      var svg=svgEl(W,H),rc=rough.svg(svg),a0=-Math.PI/2;
      data.forEach(function(d,i){var a1=a0+((+d.value||0)/total)*Math.PI*2;
        svg.appendChild(rc.arc(cx,cy,r*2,r*2,a0,a1,true,{fill:TINTS[i%5],fillStyle:'solid',roughness:1.3,stroke:'#37352f',strokeWidth:1.2}));a0=a1;});
      svg.appendChild(rc.circle(cx,cy,r,{fill:'#ffffff',fillStyle:'solid',roughness:0.6,stroke:'#ffffff',strokeWidth:1}));
      data.forEach(function(d,i){var ly=34+i*26;
        svg.appendChild(rc.rectangle(248,ly,13,13,{fill:TINTS[i%5],fillStyle:'solid',roughness:1,stroke:'#37352f',strokeWidth:1}));
        svg.appendChild(txt(270,ly+11,trunc(d.label||'',18)+'  '+Math.round((+d.value||0)/total*100)+'%',12,'#37352f',500,'start'));});
      return svg;
    }

    function stat(v,l){return '<div class="s"><b>'+v+'</b><span>'+l+'</span></div>';}
    function finish(){
      $('#meta').style.display='none';
      $('#activity').open=false;  // auto-collapse the agents + digests into one foldable
      var agents=order.length,src=0,pages=0;
      order.forEach(function(id){src+=tk[id].srcN;pages+=tk[id].read;});
      $('#actsum').textContent=agents+' agents · '+pages+' pages read · '+src+' sources';
      var secs=Math.max(1,Math.round((Date.now()-t0)/1000));
      var costStr=usd>0?('$'+usd.toFixed(usd<0.01?4:3)):'—';
      var s=$('#summary');s.className='summary on';
      s.innerHTML=stat(agents,'agents')+stat(src,'sources')+stat(pages,'pages read')+stat(secs+'s','elapsed')+
        stat(costStr,'real cost')+stat(((tin+tout)/1000).toFixed(1)+'k','tokens');
    }

    function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]});}
  })();
  </script>

  <!-- Dictation runs ENTIRELY in the browser: Moonshine (ONNX) via transformers.js. The mic audio
       never leaves the page — no nexus, no server STT. An example of client-side speech-to-text. -->
  <script type="module">
    import { pipeline } from 'https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.5.1';
    const mic = document.getElementById('mic'), q = document.getElementById('q');
    const cbody = document.querySelector('.cbody');
    const MIC = mic.innerHTML;
    const STOP = '<svg viewBox="0 0 24 24"><rect x="6.5" y="6.5" width="11" height="11" rx="2.5" fill="currentColor"></rect></svg>';
    let asr = null, modelP = null, recording = false;
    let ac = null, proc = null, srcNode = null, stream = null;
    let chunks = [], busy = false, timer = null, baseText = '';

    function loadModel(){
      if (!modelP) modelP = pipeline('automatic-speech-recognition', 'onnx-community/moonshine-base-ONNX').then(m => (asr = m));
      return modelP;
    }

    // Concatenate captured chunks and (cheaply) resample to 16 kHz mono — what Moonshine expects.
    function buffer16k(){
      let n = 0; for (const c of chunks) n += c.length;
      const buf = new Float32Array(n); let o = 0; for (const c of chunks){ buf.set(c, o); o += c.length; }
      const rate = ac.sampleRate;
      if (rate === 16000) return buf;
      const ratio = rate / 16000, len = Math.floor(buf.length / ratio), out = new Float32Array(len);
      for (let i = 0; i < len; i++){ const idx = i * ratio, lo = idx | 0, hi = Math.min(lo + 1, buf.length - 1), f = idx - lo; out[i] = buf[lo] * (1 - f) + buf[hi] * f; }
      return out;
    }

    // Re-transcribe the growing buffer; since we re-run the whole clip each pass, the text refines live.
    async function transcribe(){
      if (busy || !asr || !chunks.length) return;
      busy = true;
      try {
        const audio = buffer16k();
        if (audio.length > 1600){
          const out = await asr(audio);
          const text = ((out && out.text) || '').trim();
          if (text){ q.value = (baseText ? baseText + ' ' : '') + text; q.dispatchEvent(new Event('input')); }
        }
      } catch (e){ /* keep listening */ }
      finally { busy = false; }
    }

    mic.addEventListener('click', async () => {
      if (!recording){
        try { stream = await navigator.mediaDevices.getUserMedia({ audio: true }); }
        catch (e){ mic.title = 'Microphone permission denied'; return; }
        loadModel();
        baseText = q.value.trim();
        try { ac = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: 16000 }); }
        catch (e){ ac = new (window.AudioContext || window.webkitAudioContext)(); }
        srcNode = ac.createMediaStreamSource(stream);
        proc = ac.createScriptProcessor(4096, 1, 1);
        chunks = []; proc.onaudioprocess = e => chunks.push(new Float32Array(e.inputBuffer.getChannelData(0)));
        srcNode.connect(proc); proc.connect(ac.destination);   // ScriptProcessor outputs silence (no feedback)
        recording = true;
        mic.classList.add('rec'); mic.innerHTML = STOP; mic.title = 'Stop';
        cbody.classList.add('active'); q.readOnly = true;
        timer = setInterval(transcribe, 700);                  // live updates as you speak
      } else {
        recording = false; clearInterval(timer);
        proc.disconnect(); srcNode.disconnect(); stream.getTracks().forEach(t => t.stop());
        mic.classList.remove('rec'); mic.innerHTML = MIC; mic.title = 'Dictate — Moonshine, runs in your browser';
        if (!asr) await loadModel();
        await transcribe();                                    // one final pass for the complete clip
        try { ac.close(); } catch (e){}
        cbody.classList.remove('active'); q.readOnly = false; q.focus();
      }
    });
  </script>
end
