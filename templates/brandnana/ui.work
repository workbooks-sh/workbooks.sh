# The interface

A `client` block — the browser island. Enter a brand domain; it opens an `EventSource` on the
`brand` live source and renders the brand book live: logo, palette swatches, typography, an imagery
grid, and the voice brief.

client :app do
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root{ --paper:#fff; --bg:#f7f6f3; --ink:#37352f; --soft:#787066; --line:#ece9e3; --accent:#ffe08a; --radius:14px; }
    *{box-sizing:border-box}
    body{max-width:none!important;margin:0!important;padding:0!important;background:var(--bg)!important;
      color:var(--ink)!important;font:16px/1.6 'Inter',system-ui,sans-serif!important}
    nav.wb-nav, section.file > h1, section.file > h2, section.file > h3, section.file > h4,
    section.file > p, section.file > ul, section.file > pre, section.file > .decl, section.file > figure{display:none!important}
    section.file{display:block;margin:0;padding:0;max-width:none;border:0}
    .paper{position:fixed;inset:0;pointer-events:none;z-index:0;
      background-image:linear-gradient(rgba(55,53,47,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(55,53,47,.05) 1px,transparent 1px);
      background-size:26px 26px;
      -webkit-mask-image:radial-gradient(78% 78% at 100% 100%,#000,transparent 44%),radial-gradient(62% 62% at 0% 0%,#000,transparent 44%);
      mask-image:radial-gradient(78% 78% at 100% 100%,#000,transparent 44%),radial-gradient(62% 62% at 0% 0%,#000,transparent 44%)}
    #ss{position:relative;z-index:1;max-width:920px;margin:0 auto;padding:38px 22px 120px}

    #intro{min-height:calc(100vh - 76px);display:flex;flex-direction:column;justify-content:center}
    #intro .top{text-align:center;margin:0 0 26px}
    #intro .mark{font-size:34px;font-weight:700;letter-spacing:-.02em;display:inline-flex;gap:10px;align-items:center}
    #intro .tag{color:var(--soft);margin-top:10px;font-size:16px}
    .composer{background:var(--paper);border:1px solid var(--line);border-radius:18px;box-shadow:0 14px 44px rgba(55,53,47,.08);
      padding:16px 18px;margin:28px auto 14px;width:100%;max-width:620px;display:flex;gap:12px;align-items:center}
    .composer input{flex:1;border:0;outline:0;font:17px 'Inter';color:var(--ink);background:transparent}
    .composer input::placeholder{color:#b6afa4}
    .go{border:0;background:var(--ink);color:#fff;font:600 15px 'Inter';padding:11px 20px;border-radius:11px;cursor:pointer}
    .go:hover{transform:translateY(-1px)}
    .chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;max-width:620px;margin:0 auto}
    .chip{background:var(--paper);border:1px solid var(--line);border-radius:20px;padding:7px 14px;font-size:14px;color:var(--soft);cursor:pointer}
    .chip:hover{color:var(--ink)}

    #results{display:none}
    .rbar{display:flex;align-items:center;gap:14px;padding:6px 0 18px;border-bottom:1px solid var(--line);margin-bottom:22px}
    .rbar .home{font-size:18px;font-weight:700;cursor:pointer;display:flex;gap:7px;align-items:center}
    .rbar .grow{flex:1}
    .rbar .ns{border:1px solid var(--line);background:var(--paper);border-radius:10px;padding:8px 14px;font:500 14px 'Inter';cursor:pointer}
    .prog{display:flex;gap:10px;align-items:center;color:var(--soft);font-size:14px;margin-bottom:20px}
    .prog .dot{width:7px;height:7px;border-radius:50%;background:var(--accent);animation:pulse 1.1s infinite}
    @keyframes pulse{0%,100%{opacity:.35;transform:scale(.85)}50%{opacity:1;transform:scale(1.15)}}

    .book{display:none;background:var(--paper);border:1px solid var(--line);border-radius:18px;overflow:hidden}
    .book.on{display:block}
    .hero{padding:46px 44px;display:flex;gap:26px;align-items:center;border-bottom:1px solid var(--line)}
    .hero .logo{width:104px;height:104px;border-radius:18px;border:1px solid var(--line);background:var(--bg);
      display:grid;place-items:center;flex:none;overflow:hidden}
    .hero .logo img{max-width:80%;max-height:80%;object-fit:contain}
    .hero h1{font-size:30px;font-weight:700;letter-spacing:-.02em;margin:0 0 6px}
    .hero .tagline{font-size:17px;color:var(--soft)}
    .hero .dom{font-size:13px;color:#b6afa4;margin-top:8px}
    .sec{padding:28px 44px;border-bottom:1px solid var(--line)}
    .sec:last-child{border-bottom:0}
    .sec h3{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:#b6afa4;margin:0 0 16px}
    .palette{display:flex;gap:0;border-radius:12px;overflow:hidden;border:1px solid var(--line)}
    .sw{flex:1;height:96px;display:flex;align-items:flex-end;padding:9px;min-width:0}
    .sw code{font-size:11px;font-weight:600;background:rgba(255,255,255,.85);padding:2px 6px;border-radius:5px;color:#37352f}
    .fonts{display:flex;flex-direction:column;gap:12px}
    .font{font-size:26px;font-weight:600;color:var(--ink)}
    .font small{display:block;font-size:12px;font-weight:500;color:var(--soft);letter-spacing:.04em;text-transform:uppercase}
    .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
    .grid .ph{aspect-ratio:4/3;border-radius:11px;background:var(--bg);border:1px solid var(--line);overflow:hidden}
    .grid .ph img{width:100%;height:100%;object-fit:cover;display:block}
    .voice{font-size:16px;line-height:1.7;color:#2c2a26;max-width:640px}
  </style>

  <div class="paper"></div>
  <div id="ss">
    <div id="intro">
      <div class="top">
        <div class="mark">🍌 <span>Brandnana</span></div>
        <div class="tag">Build a brand book from any domain — logo, palette, type, imagery, voice.</div>
      </div>
      <div class="composer">
        <input id="q" type="text" placeholder="nike.com" autocomplete="off" />
        <button class="go" id="go" type="button">Build</button>
      </div>
      <div class="chips" id="chips">
        <span class="chip">nike.com</span><span class="chip">glossier.com</span>
        <span class="chip">notion.so</span><span class="chip">patagonia.com</span>
      </div>
      <div class="recent" id="recent" style="max-width:620px;margin:22px auto 0"></div>
    </div>

    <div id="results">
      <div class="rbar">
        <div class="home" id="home">🍌 <span>Brandnana</span></div>
        <div class="grow"></div>
        <button class="ns" id="ns" type="button">+ New brand</button>
      </div>
      <div class="prog" id="prog"><span class="dot"></span><span id="ptxt">Starting…</span></div>
      <div class="book" id="book"></div>
    </div>
  </div>

  <script>
  (function(){
    var $=function(s){return document.querySelector(s)};
    var es=null, B={};
    function dom(u){try{return new URL(u).hostname.replace('www.','')}catch(e){return u}}
    function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]})}

    $('#go').addEventListener('click',start);
    $('#q').addEventListener('keydown',function(e){if(e.key==='Enter')start();});
    $('#ns').addEventListener('click',home); $('#home').addEventListener('click',home);
    [].forEach.call(document.querySelectorAll('#chips .chip'),function(c){c.addEventListener('click',function(){$('#q').value=c.textContent;start();});});
    loadRecent();

    function home(){ if(es)es.close(); $('#results').style.display='none'; $('#intro').style.display='flex'; $('#q').value=''; loadRecent(); }
    function loadRecent(){
      if(!window.nexus||!nexus.data)return;
      nexus.data.all('Book').then(function(rows){
        rows=(rows||[]).slice(-6).reverse(); if(!rows.length)return;
        $('#recent').innerHTML='<div style="font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:#b6afa4;margin-bottom:8px">Recent</div>'+
          rows.map(function(r){return '<div class="chip" data-d="'+esc(r.domain)+'" style="display:inline-block;margin:0 6px 6px 0">'+esc(r.name||r.domain)+'</div>'}).join('');
        [].forEach.call(document.querySelectorAll('#recent .chip'),function(x){x.addEventListener('click',function(){$('#q').value=x.dataset.d;start();});});
      }).catch(function(){});
    }

    function start(){
      var q=$('#q').value.trim(); if(!q)return;
      if(es)es.close(); B={};
      $('#intro').style.display='none'; $('#results').style.display='block';
      $('#prog').style.display='flex'; $('#ptxt').textContent='Starting…';
      $('#book').className='book'; $('#book').innerHTML=''; render();
      es=new EventSource('/live/brand?q='+encodeURIComponent(q));
      es.onmessage=function(e){var d;try{d=JSON.parse(e.data)}catch(_){return} on(d);};
    }

    function on(d){
      if(d.type==='step') $('#ptxt').textContent=d.label;
      else if(d.type==='logo'){B.logo=d.url; render();}
      else if(d.type==='imagery'){B.shots=d.urls||[]; render();}
      else if(d.type==='palette'){B.palette=d.colors||[]; render();}
      else if(d.type==='fonts'){B.fonts=d.fonts||[]; render();}
      else if(d.type==='brief'){B.name=d.name; B.tagline=d.tagline; B.voice=d.voice; render();}
      else if(d.type==='done'||d.type==='end'){ $('#prog').style.display='none'; if(es)es.close(); loadRecent(); }
    }

    function render(){
      var b=$('#book'); b.className='book on';
      var h='<div class="hero"><div class="logo">'+(B.logo?'<img src="'+esc(B.logo)+'" onerror="this.style.display=\'none\'">':'🍌')+'</div>'+
        '<div><h1>'+esc(B.name||'…')+'</h1>'+(B.tagline?'<div class="tagline">'+esc(B.tagline)+'</div>':'')+
        (B.domain?'<div class="dom">'+esc(B.domain)+'</div>':'')+'</div></div>';
      if(B.palette&&B.palette.length){
        h+='<div class="sec"><h3>Palette</h3><div class="palette">'+B.palette.map(function(c){
          return '<div class="sw" style="background:'+esc(c)+'"><code>'+esc(c)+'</code></div>'}).join('')+'</div></div>';
      }
      if(B.fonts&&B.fonts.length){
        h+='<div class="sec"><h3>Typography</h3><div class="fonts">'+B.fonts.map(function(f){
          return '<div class="font" style="font-family:\''+esc(f)+'\',Inter,sans-serif"><small>'+esc(f)+'</small>Aa Bb Cc 123</div>'}).join('')+'</div></div>';
      }
      if(B.shots&&B.shots.length){
        h+='<div class="sec"><h3>Imagery</h3><div class="grid">'+B.shots.map(function(u){
          return '<div class="ph"><img src="'+esc(u)+'" loading="lazy" onerror="this.parentNode.style.display=\'none\'"></div>'}).join('')+'</div></div>';
      }
      if(B.voice){ h+='<div class="sec"><h3>Voice</h3><div class="voice">'+esc(B.voice)+'</div></div>'; }
      b.innerHTML=h;
    }
  })();
  </script>
end
