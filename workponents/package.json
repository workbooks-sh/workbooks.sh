{
  "name": "@work.books/workponents",
  "version": "0.0.0",
  "description": "Workbooks web-component SDK — themed, framework-agnostic <work-*> custom elements. One substrate, many domains. Runs in the desktop app, any workbook (plain HTML), and as a public dev-kit.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.js",
    "./dist": "./dist/workponents.js",
    "./dist/theme.css": "./dist/theme.css",
    "./theme.css": "./src/theme/tokens.css",
    "./elements/*": "./src/elements/*.js"
  },
  "files": [
    "src",
    "dist",
    "registry"
  ],
  "scripts": {
    "demo": "python3 -m http.server 5340",
    "build": "node tools/build.js",
    "cem": "node tools/cem.mjs",
    "lint:design": "node tools/design-lint.mjs",
    "gate": "node tools/gate/run.js",
    "gate:all": "node tools/gate/run.js --strict",
    "gate:baseline": "node tools/gate/run.js --update-baseline",
    "test:gitviz": "node --test tools/gitviz/work-diff.test.mjs && node tools/gitviz/work-history-graph.test.mjs",
    "new": "node tools/scaffold.mjs",
    "test:scaffold": "node --test tools/scaffold.test.mjs",
    "registry": "node tools/registry.mjs"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "workbooks",
    "design-system",
    "agnostic"
  ]
}
