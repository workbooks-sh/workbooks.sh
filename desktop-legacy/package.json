{
  "name": "@workbooks/desktop",
  "private": true,
  "version": "0.0.1",
  "description": "Workbooks Desktop — Tauri local-first IDE for OQL agents + workbooks. See bd epic wb-i38o.",
  "type": "module",
  "scripts": {
    "gen:api": "node scripts/gen-engine-api.mjs",
    "dev": "node scripts/gen-engine-api.mjs && vite dev",
    "build": "node scripts/gen-engine-api.mjs && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --features ui-automation",
    "tauri:build": "tauri build",
    "typecheck": "node scripts/gen-engine-api.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^25.6.0",
    "@types/phoenix": "^1.6.7",
    "svelte": "^5.46.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
